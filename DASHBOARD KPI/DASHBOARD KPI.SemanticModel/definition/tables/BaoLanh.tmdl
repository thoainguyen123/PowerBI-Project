	column 'Thứ tự dòng Excel'
		dataType: int64
		isHidden
		lineageTag: 78ed10b4-8b54-4b56-aa84-e7f71c31ced8
		summarizeBy: none
		sourceColumn: Thứ tự dòng Excel

	partition BaoLanh = m
		mode: import
		source =
				let
				    Source =
				        SharePoint.Contents(
				            "https://novaland.sharepoint.com/sites/PRT",
				            [ApiVersion = 15]
				        ),
				
				    Documents = Source{[Name="Documents"]}[Content],
				
				    PRC = Documents{[Name="PRC"]}[Content],
				
				    NovaGen = PRC{[Name="00. NovaGen"]}[Content],
				
				    NghiepVu = NovaGen{[Name="07. Các nghiệp vụ"]}[Content],
				
				    PAS = NghiepVu{[Name="05. PAS"]}[Content],
				
				    FolderHD = PAS{[Name="01. THEO DOI HD & CPC"]}[Content],
				
				    File =
				        FolderHD{
				            [
				                Name =
				                "NVLG-PTC-REG03.F04 BANG THEO DOI TINH TRANG BAO HANH-BAO LANH.xlsx"
				            ]
				        }[Content],
				
				    Excel =
				        Excel.Workbook(
				            File,
				            null,
				            true
				        ),
				
				    Sheet =
				        Excel{
				            [
				                Item = "THEO DÕI BẢO HÀNH-BOND",
				                Kind = "Sheet"
				            ]
				        }[Data],
				    #"Removed Top Rows" = Table.Skip(Sheet,6),
				    #"Promoted Headers" = Table.PromoteHeaders(#"Removed Top Rows", [PromoteAllScalars=true]),
				    // Chuẩn hóa giá trị hợp đồng từ các biến thể tên cột cũ và mới trước khi ép kiểu.
				    #"Added Normalized Contract Value" =
				        Table.AddColumn(
				            #"Promoted Headers",
				            "__GIÁ TRỊ HĐ+PS (GỒM VAT)",
				            each
				                let
				                    Candidates = {
				                        Record.FieldOrDefault(_, "GIÁ TRỊ HĐ+PS (GỒM VAT)", null),
				                        Record.FieldOrDefault(_, "GIÁ TRỊ HĐ+PS #(lf)(GỒM VAT)", null),
				                        Record.FieldOrDefault(_, "GIÁ TRỊ HĐ+PS (GỒM VAT)1", null),
				                        Record.FieldOrDefault(_, "GIÁ TRỊ HĐ+PS #(lf)(GỒM VAT)1", null)
				                    },
				                    NonBlank = List.Select(Candidates, each _ <> null and Text.Trim(Text.From(_)) <> ""),
				                    ContractValue = if List.IsEmpty(NonBlank) then null else List.First(NonBlank)
				                in
				                    try Number.From(ContractValue) otherwise null,
				            type number
				        ),
				    #"Removed Contract Value Variants" =
				        Table.RemoveColumns(
				            #"Added Normalized Contract Value",
				            {
				                "GIÁ TRỊ HĐ+PS (GỒM VAT)",
				                "GIÁ TRỊ HĐ+PS #(lf)(GỒM VAT)",
				                "GIÁ TRỊ HĐ+PS (GỒM VAT)1",
				                "GIÁ TRỊ HĐ+PS #(lf)(GỒM VAT)1"
				            },
				            MissingField.Ignore
				        ),
				    #"Renamed Normalized Contract Value" =
				        Table.RenameColumns(
				            #"Removed Contract Value Variants",
				            {{"__GIÁ TRỊ HĐ+PS (GỒM VAT)", "GIÁ TRỊ HĐ+PS (GỒM VAT)"}}
				        ),
				    TypeMappings = {{"c", type any}, {"Column2", type any}, {"STT", Int64.Type}, {"SỐ HĐ TRÊN SAP/SỐ HĐ CHÍNH", type text}, {"SỐ HĐ CHÍNH", type text}, {"SỐ PLHĐ", type text}, {"DỰ ÁN", type text}, {"TÊN VIẾT TẮT DỰ ÁN/#(lf)ĐƠN VỊ", type text}, {"KHU VỰC", type text}, {"HẠNG MỤC HH-DV", type any}, {"NỘI DUNG HỢP ĐỒNG", type text}, {"LOẠI HĐ", type text}, {"PHÁP NHÂN KÝ HĐ/PLHĐ", type text}, {"NT/NCC/TV ", type text}, {"GIÁ TRỊ HĐ+PS #(lf)(GỒM VAT)", type number}, {"GIÁ TRỊ HĐ+PS (GỒM VAT)", type number}, {"TIỀN BẢO HÀNH GIỮ LẠI CHƯA VAT", type any}, {"NGÀY KÝ TOC HOẶC BIÊN BẢN BÀN GIAO HÀNG HÓA ĐỢT CUỐI", type any}, {"THỜI HẠN BẢO HÀNH", type any}, {"NGÀY HẾT HẠN BẢO HÀNH", type any}, {"HÌNH THỨC THANH TOÁN BẢO HÀNH", type text}, {"TÊN NGÂN HÀNG TẠM ỨNG", type text}, {"NGÀY BẮT ĐẦU HIỆU LỰC BẢO LÃNH TẠM ỨNG", type date}, {"NGÀY HẾT HIỆU LỰC TẠM ỨNG", type date}, {"GIÁ TRỊ TẠM ỨNG", Int64.Type}, {"CẢNH BÁO TẠM ỨNG", type text}, {"TÌNH TRẠNG TẠM ỨNG", type text}, {"TÊN NGÂN HÀNG THHĐ", type text}, {"NGÀY BẮT ĐẦU HIỆU LỰC BẢO LÃNH THHĐ", type date}, {"NGÀY HẾT HIỆU LỰC THHĐ", type date}, {"GIÁ TRỊ THHĐ", Int64.Type}, {"CẢNH BÁO THHĐ", type text}, {"TÌNH TRẠNG THHĐ", type text}, {"TÊN NGÂN HÀNG BẢO HÀNH", type text}, {"NGÀY BẮT ĐẦU HIỆU LỰC BẢO HÀNH", type date}, {"NGÀY HẾT HIỆU LỰC BẢO HÀNH", type date}, {"GIÁ TRỊ BẢO HÀNH", Int64.Type}, {"TÌNH TRẠNG BẢO HÀNH", type text}, {"GHI CHÚ", type text}, {"PIC THỰC HIỆN", type text}, {"Column40", type date}, {"Column41", type any}, {"Column42", type any}, {"Column43", type any}, {"Column44", type any}, {"Column45", type any}, {"Column46", type any}},
				
				    ExistingTypeMappings =
				        List.Select(
				            TypeMappings,
				            each Table.HasColumns(
				                #"Renamed Normalized Contract Value",
				                {_{0}}
				            )
				        ),
				
				    #"Changed Type" =
				        Table.TransformColumnTypes(
				            #"Renamed Normalized Contract Value",
				            ExistingTypeMappings
				        ),
				
				    #"Removed Columns" =
				        Table.RemoveColumns(
				            #"Changed Type",
				            {"c", "Column2", "Column40", "Column41", "Column42", "Column43", "Column44", "Column45", "Column46"},
				            MissingField.Ignore
				        ),
				
				    RequiredColumns = {
				        "STT",
				        "SỐ HĐ TRÊN SAP/SỐ HĐ CHÍNH",
				        "SỐ HĐ CHÍNH",
				        "SỐ PLHĐ",
				        "DỰ ÁN",
				        "TÊN VIẾT TẮT DỰ ÁN/ĐƠN VỊ",
				        "KHU VỰC",
				        "HẠNG MỤC HH-DV",
				        "NỘI DUNG HỢP ĐỒNG",
				        "LOẠI HĐ",
				        "PHÁP NHÂN KÝ HĐ/PLHĐ",
				        "NT/NCC/TV ",
				        "GIÁ TRỊ HĐ+PS (GỒM VAT)",
				        "TIỀN BẢO HÀNH GIỮ LẠI CHƯA VAT",
				        "NGÀY KÝ TOC HOẶC BIÊN BẢN BÀN GIAO HÀNG HÓA ĐỢT CUỐI",
				        "THỜI HẠN BẢO HÀNH",
				        "NGÀY HẾT HẠN BẢO HÀNH",
				        "HÌNH THỨC THANH TOÁN BẢO HÀNH",
				        "TÊN NGÂN HÀNG TẠM ỨNG",
				        "NGÀY BẮT ĐẦU HIỆU LỰC BẢO LÃNH TẠM ỨNG",
				        "NGÀY HẾT HIỆU LỰC TẠM ỨNG",
				        "GIÁ TRỊ TẠM ỨNG",
				        "CẢNH BÁO TẠM ỨNG",
				        "TÌNH TRẠNG TẠM ỨNG",
				        "TÊN NGÂN HÀNG THHĐ",
				        "NGÀY BẮT ĐẦU HIỆU LỰC BẢO LÃNH THHĐ",
				        "NGÀY HẾT HIỆU LỰC THHĐ",
				        "GIÁ TRỊ THHĐ",
				        "CẢNH BÁO THHĐ",
				        "TÌNH TRẠNG THHĐ",
				        "TÊN NGÂN HÀNG BẢO HÀNH",
				        "NGÀY BẮT ĐẦU HIỆU LỰC BẢO HÀNH",
				        "NGÀY HẾT HIỆU LỰC BẢO HÀNH",
				        "GIÁ TRỊ BẢO HÀNH",
				        "TÌNH TRẠNG BẢO HÀNH",
				        "GHI CHÚ",
				        "PIC THỰC HIỆN"
				    },
				
				    #"Ensured Required Columns" =
				        List.Accumulate(
				            RequiredColumns,
				            #"Removed Columns",
				            (State, ColumnName) =>
				                if Table.HasColumns(State, {ColumnName}) then
				                    State
				                else
				                    Table.AddColumn(
				                        State,
				                        ColumnName,
				                        each null,
				                        type any
				                    )
				        ),
				
				    #"Removed Legacy Schema Columns" =
				        Table.RemoveColumns(
				            #"Ensured Required Columns",
				            {"TÊN VIẾT TẮT DỰ ÁN/#(lf)ĐƠN VỊ", "GIÁ TRỊ HĐ+PS #(lf)(GỒM VAT)", "TÊN VIẾT TẮT DỰ ÁN/ĐƠN VỊ1", "GIÁ TRỊ HĐ+PS (GỒM VAT)1"},
				            MissingField.Ignore
				        ),
				
				    #"Replaced All Errors With Null" =
				        Table.ReplaceErrorValues(
				            #"Removed Legacy Schema Columns",
				            List.Transform(
				                Table.ColumnNames(#"Removed Legacy Schema Columns"),
				                each {_, null}
				            )
				        )
				in
				    Table.AddIndexColumn(#"Replaced All Errors With Null", "Thứ tự dòng Excel", 1, 1, Int64.Type)

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


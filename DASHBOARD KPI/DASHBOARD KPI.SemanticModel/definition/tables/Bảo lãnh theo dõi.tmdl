			        SELECTEDVALUE ( 'Bảo lãnh theo dõi'[Cảnh báo] ),
			        KEEPFILTERS ( 'Bảo lãnh theo dõi'[Là bản ghi mới nhất] = TRUE () )
			    )
			)
		displayFolder: Chi tiết Bảo lãnh
		lineageTag: 8d91ec10-7562-4fae-a563-ffea2e81ea61

	measure 'BL Tình trạng (dòng)' =
			IF (
			    ISINSCOPE ( 'Bảo lãnh theo dõi'[Nhà thầu] ),
			    CALCULATE (
			        SELECTEDVALUE ( 'Bảo lãnh theo dõi'[Tình trạng] ),
			        KEEPFILTERS ( 'Bảo lãnh theo dõi'[Là bản ghi mới nhất] = TRUE () )
			    )
			)
		displayFolder: Chi tiết Bảo lãnh
		lineageTag: 046270a3-bd9a-436e-ace6-460216d7183a

	measure 'BL PIC (dòng)' =
			IF (
			    ISINSCOPE ( 'Bảo lãnh theo dõi'[Nhà thầu] ),
			    CALCULATE (
			        SELECTEDVALUE ( 'Bảo lãnh theo dõi'[PIC] ),
			        KEEPFILTERS ( 'Bảo lãnh theo dõi'[Là bản ghi mới nhất] = TRUE () )
			    )
			)
		displayFolder: Chi tiết Bảo lãnh
		lineageTag: e9079f87-a433-457b-acb8-0e6a9397e825

	/// Chỉ hiện số hợp đồng ở cấp Nhà thầu; không lấy First/Min tại cấp tổng hợp.
	measure 'BL Số HĐ chính (scope)' =
			IF (
			    ISINSCOPE ( 'Bảo lãnh theo dõi'[Nhà thầu] ),
			    CALCULATE (
			        SELECTEDVALUE ( 'Bảo lãnh theo dõi'[Số HĐ chính] ),
			        KEEPFILTERS ( 'Bảo lãnh theo dõi'[Là bản ghi mới nhất] = TRUE () )
			    )
			)
		displayFolder: Chi tiết Bảo lãnh
		lineageTag: 9f5e2cd7-b181-4f5d-bfd2-5e9a96fdcb01

	/// Chỉ hiện số phụ lục ở cấp Nhà thầu; để trống khi có nhiều phụ lục trong cùng ngữ cảnh.
	measure 'BL Số PLHĐ (scope)' =
			IF (
			    ISINSCOPE ( 'Bảo lãnh theo dõi'[Nhà thầu] ),
			    CALCULATE (
			        SELECTEDVALUE ( 'Bảo lãnh theo dõi'[Số PLHĐ] ),
			        KEEPFILTERS ( 'Bảo lãnh theo dõi'[Là bản ghi mới nhất] = TRUE () )
			    )
			)
		displayFolder: Chi tiết Bảo lãnh
		lineageTag: f3cf1108-fb25-40b8-bc5f-d6a14fa10c8c

	/// Giá trị hợp đồng và phát sinh gồm VAT của dòng bảo lãnh đang chọn; không cộng gộp giữa Tạm ứng và THHĐ.
	measure 'BL Giá trị HĐ+PS gồm VAT (dòng)' =
			IF (
			    ISINSCOPE ( 'Bảo lãnh theo dõi'[Số HĐ chính] ),
			    CALCULATE (
			        SELECTEDVALUE ( 'Bảo lãnh theo dõi'[Giá trị HĐ+PS gồm VAT] ),
			        KEEPFILTERS ( 'Bảo lãnh theo dõi'[Là bản ghi mới nhất] = TRUE () )
			    )
			)
		formatString: #,##0
		displayFolder: Chi tiết Bảo lãnh
		lineageTag: 2d8ed333-b696-4b27-a635-abb625e4862f


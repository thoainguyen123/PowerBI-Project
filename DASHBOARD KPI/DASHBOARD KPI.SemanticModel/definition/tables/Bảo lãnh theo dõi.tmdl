table 'Bảo lãnh theo dõi'
	lineageTag: 7b6c8e28-6da8-4c2d-bdfc-2f5461219d77

	/// Số dòng bảo lãnh theo loại và các điều kiện lọc chung; không gom theo HĐ hoặc phụ lục.
	measure 'BL Số lượng' = COUNTROWS ( 'Bảo lãnh theo dõi' )
		formatString: #,##0
		displayFolder: KPI Bảo lãnh
		lineageTag: d71c84d0-269c-411b-90fc-2cd8aabf3301

	/// Tổng giá trị của toàn bộ dòng bảo lãnh theo loại và các điều kiện lọc chung, quy đổi sang tỷ đồng.
	measure 'BL Tổng giá trị (tỷ)' =
			DIVIDE (
			    SUM ( 'Bảo lãnh theo dõi'[Giá trị] ),
			    1000000000
			)
		formatString: #,##0.0
		displayFolder: KPI Bảo lãnh
		lineageTag: c190ef3e-eed4-4a7d-89c5-691537f0a0ea

	measure 'BL Số lượng Chưa gia hạn' =
			CALCULATE (
			    [BL Số lượng],
			    KEEPFILTERS ( 'Bảo lãnh theo dõi'[Tình trạng] = "Chưa gia hạn" )
			)
		formatString: #,##0
		displayFolder: KPI Bảo lãnh
		lineageTag: e1d0e670-5233-4752-8947-312a5a4b22db

	measure 'BL Giá trị Chưa gia hạn (tỷ)' =
			CALCULATE (
			    [BL Tổng giá trị (tỷ)],
			    KEEPFILTERS ( 'Bảo lãnh theo dõi'[Tình trạng] = "Chưa gia hạn" )
			)
		formatString: #,##0.0
		displayFolder: KPI Bảo lãnh
		lineageTag: 91d27e28-5ad2-4f31-9968-88cc4a401818

	measure 'BL Số lượng Sắp đến hạn' =
			CALCULATE (
			    [BL Số lượng],
			    KEEPFILTERS ( 'Bảo lãnh theo dõi'[Tình trạng] = "Sắp đến hạn" )
			)
		formatString: #,##0
		displayFolder: KPI Bảo lãnh
		lineageTag: 94edc74a-8cf4-4d6c-a6ef-b75053c6ba20

	measure 'BL Giá trị Sắp đến hạn (tỷ)' =
			CALCULATE (
			    [BL Tổng giá trị (tỷ)],
			    KEEPFILTERS ( 'Bảo lãnh theo dõi'[Tình trạng] = "Sắp đến hạn" )
			)
		formatString: #,##0.0
		displayFolder: KPI Bảo lãnh
		lineageTag: 79c7bb05-b268-4f69-a8b4-b456ff77acd0

	measure 'BL Số lượng Chưa đến hạn' =
			CALCULATE (
			    [BL Số lượng],
			    KEEPFILTERS ( 'Bảo lãnh theo dõi'[Tình trạng] = "Chưa đến hạn" )
			)
		formatString: #,##0
		displayFolder: KPI Bảo lãnh
		lineageTag: 8b907f63-2cda-44f5-8583-96385a3651a8

	measure 'BL Giá trị Chưa đến hạn (tỷ)' =
			CALCULATE (
			    [BL Tổng giá trị (tỷ)],
			    KEEPFILTERS ( 'Bảo lãnh theo dõi'[Tình trạng] = "Chưa đến hạn" )
			)
		formatString: #,##0.0
		displayFolder: KPI Bảo lãnh
		lineageTag: 4b414aba-d6d9-410f-bf86-6ff9c9731697

	/// Giá trị cần hành động gồm Chưa gia hạn và Sắp đến hạn.
	measure 'BL Giá trị cần xử lý (tỷ)' =
			CALCULATE (
			    [BL Tổng giá trị (tỷ)],
			    KEEPFILTERS ( 'Bảo lãnh theo dõi'[Tình trạng] IN { "Chưa gia hạn", "Sắp đến hạn" } )
			)
		formatString: #,##0.0
		displayFolder: KPI Bảo lãnh
		lineageTag: 8d4450a5-24fa-46b4-8715-ae090aa97f61

	measure 'BL Giá trị chi tiết' = SUM ( 'Bảo lãnh theo dõi'[Giá trị] )
		formatString: #,##0
		displayFolder: Chi tiết Bảo lãnh
		lineageTag: 08fe7a2e-d32b-4b9a-ad18-c37f4f713095

	measure 'BL Ngày bắt đầu (dòng)' =
			IF (
			    ISINSCOPE ( 'Bảo lãnh theo dõi'[Nhà thầu] ),
			    CALCULATE (
			        SELECTEDVALUE ( 'Bảo lãnh theo dõi'[Ngày bắt đầu] ),
			        KEEPFILTERS ( 'Bảo lãnh theo dõi'[Là bản ghi mới nhất] = TRUE () )
			    )
			)
		formatString: dd/MM/yyyy
		displayFolder: Chi tiết Bảo lãnh
		lineageTag: 950d2c8f-ac03-4f31-89e6-c37adb08a85e

	measure 'BL Ngày hết hiệu lực (dòng)' =
			IF (
			    ISINSCOPE ( 'Bảo lãnh theo dõi'[Nhà thầu] ),
			    CALCULATE (
			        SELECTEDVALUE ( 'Bảo lãnh theo dõi'[Ngày hết hiệu lực] ),
			        KEEPFILTERS ( 'Bảo lãnh theo dõi'[Là bản ghi mới nhất] = TRUE () )
			    )
			)
		formatString: dd/MM/yyyy
		displayFolder: Chi tiết Bảo lãnh
		lineageTag: 3cc2d47e-ea2a-42cd-98e0-7f233c4175a7

	measure 'BL Ngân hàng (dòng)' =
			IF (
			    ISINSCOPE ( 'Bảo lãnh theo dõi'[Nhà thầu] ),
			    CALCULATE (
			        SELECTEDVALUE ( 'Bảo lãnh theo dõi'[Ngân hàng] ),
			        KEEPFILTERS ( 'Bảo lãnh theo dõi'[Là bản ghi mới nhất] = TRUE () )
			    )
			)
		displayFolder: Chi tiết Bảo lãnh
		lineageTag: a377938d-0076-47ec-af34-83d466f5b1fe

	measure 'BL Cảnh báo (dòng)' =
			IF (
			    ISINSCOPE ( 'Bảo lãnh theo dõi'[Nhà thầu] ),

	/// Giá trị hợp đồng và phát sinh gồm VAT của dòng hợp đồng; hiển thị riêng theo loại bảo lãnh đang được chọn.
	column 'Giá trị HĐ+PS gồm VAT'
		dataType: decimal
		formatString: #,##0
		lineageTag: fc443ace-790c-4ec0-97ac-90bdb39988c1
		summarizeBy: sum
		sourceColumn: [Giá trị HĐ+PS gồm VAT]

		annotation SummarizationSetBy = Automatic

	partition 'Bảo lãnh theo dõi' = calculated
		mode: import
		source =
				VAR _TamUng =
				    SELECTCOLUMNS (
				        FILTER (
				            BaoLanh,
				            NOT ISBLANK ( BaoLanh[NGÀY HẾT HIỆU LỰC TẠM ỨNG] )
				                || NOT ISBLANK ( BaoLanh[GIÁ TRỊ TẠM ỨNG] )
				                || NOT ISBLANK ( BaoLanh[TÌNH TRẠNG TẠM ỨNG] )
				        ),
				        "Loại bảo lãnh", "Tạm ứng",
				        "Khóa HĐ-PL", COALESCE ( TRIM ( BaoLanh[SỐ HĐ CHÍNH] ), "Chưa có HĐ" ) & "|" & COALESCE ( TRIM ( BaoLanh[SỐ PLHĐ] ), "" ),
				        "Dòng nguồn", BaoLanh[STT],
				        "Số HĐ chính", BaoLanh[SỐ HĐ CHÍNH],
				        "Số PLHĐ", BaoLanh[SỐ PLHĐ],
				        "Dự án", COALESCE ( BaoLanh[TÊN VIẾT TẮT DỰ ÁN/ĐƠN VỊ], BaoLanh[DỰ ÁN], "Chưa xác định" ),
				        "Khu vực", COALESCE ( BaoLanh[KHU VỰC], "Chưa xác định" ),
				        "Nội dung HĐ", BaoLanh[NỘI DUNG HỢP ĐỒNG],
				        "Pháp nhân", BaoLanh[PHÁP NHÂN KÝ HĐ/PLHĐ],
				        "Giá trị HĐ+PS gồm VAT", IFERROR ( VALUE ( BaoLanh[GIÁ TRỊ HĐ+PS (GỒM VAT)] ), BLANK () ),
				        "Nhà thầu", BaoLanh[NT/NCC/TV ],
				        "Ngân hàng", BaoLanh[TÊN NGÂN HÀNG TẠM ỨNG],
				        "Ngày bắt đầu", BaoLanh[NGÀY BẮT ĐẦU HIỆU LỰC BẢO LÃNH TẠM ỨNG],
				        "Ngày hết hiệu lực", BaoLanh[NGÀY HẾT HIỆU LỰC TẠM ỨNG],
				        "Giá trị", BaoLanh[GIÁ TRỊ TẠM ỨNG],
				        "Cảnh báo", BaoLanh[CẢNH BÁO TẠM ỨNG],
				        "Tình trạng", BaoLanh[TÌNH TRẠNG TẠM ỨNG],
				        "PIC", BaoLanh[PIC THỰC HIỆN]
				    )
				VAR _THHD =
				    SELECTCOLUMNS (
				        FILTER (
				            BaoLanh,
				            NOT ISBLANK ( BaoLanh[NGÀY HẾT HIỆU LỰC THHĐ] )
				                || NOT ISBLANK ( BaoLanh[GIÁ TRỊ THHĐ] )
				                || NOT ISBLANK ( BaoLanh[TÌNH TRẠNG THHĐ] )
				        ),
				        "Loại bảo lãnh", "THHĐ",
				        "Khóa HĐ-PL", COALESCE ( TRIM ( BaoLanh[SỐ HĐ CHÍNH] ), "Chưa có HĐ" ) & "|" & COALESCE ( TRIM ( BaoLanh[SỐ PLHĐ] ), "" ),
				        "Dòng nguồn", BaoLanh[STT],
				        "Số HĐ chính", BaoLanh[SỐ HĐ CHÍNH],
				        "Số PLHĐ", BaoLanh[SỐ PLHĐ],
				        "Dự án", COALESCE ( BaoLanh[TÊN VIẾT TẮT DỰ ÁN/ĐƠN VỊ], BaoLanh[DỰ ÁN], "Chưa xác định" ),
				        "Khu vực", COALESCE ( BaoLanh[KHU VỰC], "Chưa xác định" ),
				        "Nội dung HĐ", BaoLanh[NỘI DUNG HỢP ĐỒNG],
				        "Pháp nhân", BaoLanh[PHÁP NHÂN KÝ HĐ/PLHĐ],
				        "Giá trị HĐ+PS gồm VAT", IFERROR ( VALUE ( BaoLanh[GIÁ TRỊ HĐ+PS (GỒM VAT)] ), BLANK () ),
				        "Nhà thầu", BaoLanh[NT/NCC/TV ],
				        "Ngân hàng", BaoLanh[TÊN NGÂN HÀNG THHĐ],
				        "Ngày bắt đầu", BaoLanh[NGÀY BẮT ĐẦU HIỆU LỰC BẢO LÃNH THHĐ],
				        "Ngày hết hiệu lực", BaoLanh[NGÀY HẾT HIỆU LỰC THHĐ],
				        "Giá trị", BaoLanh[GIÁ TRỊ THHĐ],
				        "Cảnh báo", BaoLanh[CẢNH BÁO THHĐ],
				        "Tình trạng", BaoLanh[TÌNH TRẠNG THHĐ],
				        "PIC", BaoLanh[PIC THỰC HIỆN]
				    )
				VAR _TatCa = UNION ( _TamUng, _THHD )
				RETURN
				    ADDCOLUMNS (
				        _TatCa,
				        "Năm hết hiệu lực", IF ( NOT ISBLANK ( [Ngày hết hiệu lực] ), YEAR ( [Ngày hết hiệu lực] ) ),
				        "Tháng hết hiệu lực", IF ( NOT ISBLANK ( [Ngày hết hiệu lực] ), DATE ( YEAR ( [Ngày hết hiệu lực] ), MONTH ( [Ngày hết hiệu lực] ), 1 ) ),
				        "Là bản ghi mới nhất",
				            VAR _Khoa = [Khóa HĐ-PL]
				            VAR _Loai = [Loại bảo lãnh]
				            VAR _NgayHetHan = [Ngày hết hiệu lực]
				            VAR _DongNguon = [Dòng nguồn]
				            VAR _NgayMoiNhat =
				                MAXX (
				                    FILTER ( _TatCa, [Khóa HĐ-PL] = _Khoa && [Loại bảo lãnh] = _Loai ),
				                    [Ngày hết hiệu lực]
				                )
				            VAR _DongMoiNhat =
				                MAXX (
				                    FILTER (
				                        _TatCa,
				                        [Khóa HĐ-PL] = _Khoa
				                            && [Loại bảo lãnh] = _Loai
				                            && [Ngày hết hiệu lực] = _NgayMoiNhat
				                    ),
				                    [Dòng nguồn]
				                )
				            RETURN
				                NOT ISBLANK ( _NgayHetHan )
				                    && _NgayHetHan = _NgayMoiNhat
				                    && _DongNguon = _DongMoiNhat
				    )

	annotation PBI_Id = 4f887c1d65534b9cb2549e5d0db2cb91


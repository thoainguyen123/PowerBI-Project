		dataType: string
		lineageTag: 720f286d-14f0-41fa-ab0a-b0b2c31f7486
		summarizeBy: none
		sourceColumn: NGÀY DUYỆT CTCT

	column 'NGÀY DUYỆT CTQT'
		dataType: string
		lineageTag: 4ab9d635-1322-4cc9-ac94-853799238913
		summarizeBy: none
		sourceColumn: NGÀY DUYỆT CTQT

		annotation SummarizationSetBy = Automatic

	/// Ngày mục tiêu chuẩn hóa dạng Date để phục vụ so sánh tiến độ.
	column 'Ngày mục tiêu date' =
			VAR _s = TRIM ( SUBSTITUTE ( SUBSTITUTE ( Data[NGÀY MỤC TIÊU], UNICHAR ( 10 ), "" ), UNICHAR ( 13 ), "" ) )
			VAR _dt = IFERROR ( DATEVALUE ( _s ), BLANK () )
			VAR _slashCount = LEN ( _s ) - LEN ( SUBSTITUTE ( _s, "/", "" ) )
			VAR _dtSlash =
			    IF (
			        _slashCount = 2,
			        VAR _p1 = IFERROR ( VALUE ( PATHITEM ( SUBSTITUTE ( _s, "/", "|" ), 1 ) ), BLANK () )
			        VAR _p2 = IFERROR ( VALUE ( PATHITEM ( SUBSTITUTE ( _s, "/", "|" ), 2 ) ), BLANK () )
			        VAR _p3 = IFERROR ( VALUE ( PATHITEM ( SUBSTITUTE ( _s, "/", "|" ), 3 ) ), BLANK () )
			        RETURN
			            IF (
			                _p1 >= 1 && _p1 <= 31 && _p2 >= 1 && _p2 <= 12 && _p3 >= 2000 && _p3 <= 2100,
			                DATE ( _p3, _p2, _p1 )
			            )
			    )
			RETURN
			    COALESCE ( _dt, _dtSlash )
		dataType: dateTime
		formatString: dd/mm/yyyy
		displayFolder: Phân loại\Tiến độ mục tiêu
		lineageTag: a1c84112-9c44-489e-b123-74a9812b4568
		summarizeBy: none

		variation Variation
			isDefault
			relationship: b8bbd728-40f3-47a0-9ce1-bb7d33a5d6fa
			defaultHierarchy: LocalDateTable_597fd025-25ed-4732-accf-25b1bb53fb76.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Ngày duyệt CTQT chuẩn hóa dạng Date (ưu tiên NGÀY DUYỆT CTCT, dự phòng NGÀY KÝ BIÊN BẢN QUYẾT TOÁN).
	column 'Ngày duyệt CTQT date' =
			VAR _NgayDuyet = TRIM ( COALESCE ( Data[NGÀY DUYỆT CTCT], "" ) )
			VAR _NgayKy = TRIM ( COALESCE ( Data[NGÀY KÝ BIÊN BẢN QUYẾT TOÁN], "" ) )
			VAR _s = SUBSTITUTE ( SUBSTITUTE ( IF ( _NgayDuyet <> "", _NgayDuyet, _NgayKy ), UNICHAR ( 10 ), "" ), UNICHAR ( 13 ), "" )
			VAR _dt = IFERROR ( DATEVALUE ( _s ), BLANK () )
			VAR _slashCount = LEN ( _s ) - LEN ( SUBSTITUTE ( _s, "/", "" ) )
			VAR _dtSlash =
			    IF (
			        _slashCount = 2,
			        VAR _p1 = IFERROR ( VALUE ( PATHITEM ( SUBSTITUTE ( _s, "/", "|" ), 1 ) ), BLANK () )
			        VAR _p2 = IFERROR ( VALUE ( PATHITEM ( SUBSTITUTE ( _s, "/", "|" ), 2 ) ), BLANK () )
			        VAR _p3 = IFERROR ( VALUE ( PATHITEM ( SUBSTITUTE ( _s, "/", "|" ), 3 ) ), BLANK () )
			        RETURN
			            IF (
			                _p1 >= 1 && _p1 <= 31 && _p2 >= 1 && _p2 <= 12 && _p3 >= 2000 && _p3 <= 2100,
			                DATE ( _p3, _p2, _p1 )
			            )
			    )
			RETURN
			    COALESCE ( _dt, _dtSlash )
		dataType: dateTime
		formatString: dd/mm/yyyy
		displayFolder: Phân loại\Tiến độ mục tiêu
		lineageTag: b2d95223-9c44-489e-b123-74a9812b4569
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 796f0967-aa0a-4737-b480-ff293a73795d
			defaultHierarchy: LocalDateTable_aae978d4-a3a3-4e8f-939d-84c524d1e3f7.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	/// Cờ đánh dấu đạt tiến độ: NGÀY DUYỆT CTQT <= NGÀY MỤC TIÊU (hỗ trợ cả cấp ngày chính xác lẫn cấp Quý/Năm).
	column 'Đạt tiến độ mục tiêu' =
			VAR _ngayMT = Data[Ngày mục tiêu date]
			VAR _ngayDuyet = Data[Ngày duyệt CTQT date]
			VAR _namMT = Data[Năm mục tiêu]
			VAR _namDuyet = Data[Năm ký quyết toán]
			VAR _quyMTVal = IFERROR ( VALUE ( RIGHT ( Data[Quý mục tiêu], 1 ) ), BLANK () )
			VAR _quyDuyetVal = IFERROR ( VALUE ( RIGHT ( Data[Quý quyết toán], 1 ) ), BLANK () )
			RETURN
			    IF (
			        NOT ISBLANK ( _ngayMT ) && NOT ISBLANK ( _ngayDuyet ),
			        _ngayDuyet <= _ngayMT,
			        IF (
			            NOT ISBLANK ( _namMT ) && NOT ISBLANK ( _namDuyet ),
			            IF (
			                NOT ISBLANK ( _quyMTVal ) && NOT ISBLANK ( _quyDuyetVal ),
			                ( _namDuyet * 10 + _quyDuyetVal ) <= ( _namMT * 10 + _quyMTVal ),
			                _namDuyet <= _namMT
			            ),
			            FALSE ()
			        )
			    )
		dataType: boolean
		displayFolder: Phân loại\Tiến độ mục tiêu
		lineageTag: c3e06334-9c44-489e-b123-74a9812b4570
		summarizeBy: none

		annotation SummarizationSetBy = Automatic


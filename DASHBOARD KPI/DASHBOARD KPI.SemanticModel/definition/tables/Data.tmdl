	/// Tiền bảo hành giữ lại theo từng dòng: 5% giá trị Workdone/hóa đơn chưa VAT khi giá trị Workdone gồm VAT khác CPC gồm ứng và Workdone.
	column 'Tiền bảo hành giữ lại dòng' =
			VAR _HoaDonVAT = COALESCE ( Data[Giá trị workdone gồm VAT], 0 )
			VAR _CPC = COALESCE ( Data[Giá trị CPC gồm ứng + workdone số], 0 )
			VAR _HoaDonChuaVAT = COALESCE ( Data[Giá trị workdone chưa VAT số], 0 )
			RETURN
			    ROUND ( IF ( _HoaDonVAT <> _CPC, _HoaDonChuaVAT * 0.05, 0 ), 0 )
		dataType: double
		isHidden
		formatString: #,##0
		displayFolder: Công nợ\Cột số
		lineageTag: e24d3980-de56-4470-b231-f08d3b1778f6
		summarizeBy: sum

	/// Quý của NGÀY MỤC TIÊU (vd: "Quý 1", "Quý 2", "Quý 3", "Quý 4"). Trả "Chưa xác định quý" cho ô không thể xác định quý.
	column 'Quý mục tiêu' =
			VAR _s = TRIM ( SUBSTITUTE ( SUBSTITUTE ( Data[NGÀY MỤC TIÊU], UNICHAR ( 10 ), "" ), UNICHAR ( 13 ), "" ) )
			VAR _dt = IFERROR ( DATEVALUE ( _s ), BLANK () )
			VAR _qFromDate = IF ( NOT ISBLANK ( _dt ), "Quý " & INT ( ( MONTH ( _dt ) - 1 ) / 3 ) + 1 )
			VAR _qFromStr =
			    SWITCH (
			        TRUE (),
			        CONTAINSSTRING ( UPPER ( _s ), "Q1" ) || CONTAINSSTRING ( UPPER ( _s ), "QUÝ 1" ) || CONTAINSSTRING ( UPPER ( _s ), "QUY 1" ), "Quý 1",
			        CONTAINSSTRING ( UPPER ( _s ), "Q2" ) || CONTAINSSTRING ( UPPER ( _s ), "QUÝ 2" ) || CONTAINSSTRING ( UPPER ( _s ), "QUY 2" ), "Quý 2",
			        CONTAINSSTRING ( UPPER ( _s ), "Q3" ) || CONTAINSSTRING ( UPPER ( _s ), "QUÝ 3" ) || CONTAINSSTRING ( UPPER ( _s ), "QUY 3" ), "Quý 3",
			        CONTAINSSTRING ( UPPER ( _s ), "Q4" ) || CONTAINSSTRING ( UPPER ( _s ), "QUÝ 4" ) || CONTAINSSTRING ( UPPER ( _s ), "QUY 4" ), "Quý 4",
			        BLANK ()
			    )
			RETURN
			    COALESCE ( _qFromDate, _qFromStr, "Chưa xác định quý" )
		dataType: string
		displayFolder: Phân loại
		lineageTag: a3f87b12-9c44-489e-b123-74a9812b4567
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Tên nhà thầu chuẩn dùng chung cho các file nguồn có schema khác nhau. Ưu tiên NT/NCC/TV; nếu trống thì dùng TÊN NHÀ THẦU.
	column 'Nhà thầu chuẩn' =
			
			VAR _NhaThauChinh =
			    TRIM ( COALESCE ( Data[NT/NCC/TV ], "" ) )
			RETURN
			    IF (
			        _NhaThauChinh <> "",
			        _NhaThauChinh,
			        BLANK ()
			    )
		dataType: string
		displayFolder: Phân loại
		lineageTag: a0c30ed8-74da-4fb0-965e-6b83f150ca0a
		summarizeBy: none

	/// Quý hoàn thành quyết toán, ưu tiên NGÀY DUYỆT CTCT và dự phòng ngày ký biên bản quyết toán.
	column 'Quý quyết toán' =
			VAR _NgayDuyet = TRIM ( COALESCE ( Data[NGÀY DUYỆT CTCT], "" ) )
			VAR _NgayKy = TRIM ( COALESCE ( Data[NGÀY KÝ BIÊN BẢN QUYẾT TOÁN], "" ) )
			VAR _s = TRIM ( SUBSTITUTE ( SUBSTITUTE ( IF ( _NgayDuyet <> "", _NgayDuyet, _NgayKy ), UNICHAR ( 10 ), "" ), UNICHAR ( 13 ), "" ) )
			VAR _dt = IFERROR ( DATEVALUE ( _s ), BLANK () )
			VAR _qFromDate = IF ( NOT ISBLANK ( _dt ), "Quý " & INT ( ( MONTH ( _dt ) - 1 ) / 3 ) + 1 )
			VAR _slashCount = LEN ( _s ) - LEN ( SUBSTITUTE ( _s, "/", "" ) )
			VAR _mFromSlash =
			    IF (
			        _slashCount = 2,
			        VAR _p2 = IFERROR ( VALUE ( PATHITEM ( SUBSTITUTE ( _s, "/", "|" ), 2 ) ), BLANK () )
			        RETURN IF ( _p2 >= 1 && _p2 <= 12, _p2 )
			    )
			VAR _qFromSlash = IF ( NOT ISBLANK ( _mFromSlash ), "Quý " & INT ( ( _mFromSlash - 1 ) / 3 ) + 1 )
			VAR _qFromStr =
			    SWITCH (
			        TRUE (),
			        CONTAINSSTRING ( UPPER ( _s ), "Q1" ) || CONTAINSSTRING ( UPPER ( _s ), "QUÝ 1" ) || CONTAINSSTRING ( UPPER ( _s ), "QUY 1" ), "Quý 1",
			        CONTAINSSTRING ( UPPER ( _s ), "Q2" ) || CONTAINSSTRING ( UPPER ( _s ), "QUÝ 2" ) || CONTAINSSTRING ( UPPER ( _s ), "QUY 2" ), "Quý 2",
			        CONTAINSSTRING ( UPPER ( _s ), "Q3" ) || CONTAINSSTRING ( UPPER ( _s ), "QUÝ 3" ) || CONTAINSSTRING ( UPPER ( _s ), "QUY 3" ), "Quý 3",
			        CONTAINSSTRING ( UPPER ( _s ), "Q4" ) || CONTAINSSTRING ( UPPER ( _s ), "QUÝ 4" ) || CONTAINSSTRING ( UPPER ( _s ), "QUY 4" ), "Quý 4",
			        BLANK ()
			    )
			RETURN
			    COALESCE ( _qFromDate, _qFromSlash, _qFromStr, "Chưa xác định quý" )
		dataType: string
		displayFolder: Phân loại\Tiến độ mục tiêu
		lineageTag: aee7149a-6b5b-4b9c-bc64-9ca561767e2d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Công nợ chưa thanh toán gồm VAT đã đổi từ text nguồn sang số.

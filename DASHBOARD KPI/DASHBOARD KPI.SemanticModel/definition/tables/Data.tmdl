	/// TÌNH TRẠNG QUYẾT TOÁN đã chuẩn hóa: TRIM khoảng trắng thừa, gộp biến thể viết khác nhau, ô trống thành 'Chưa cập nhật'. Dùng cho biểu đồ tròn / cột chồng.
	column 'Tình trạng quyết toán (chuẩn)' =
			VAR _t =
			    TRIM ( COALESCE ( Data[TÌNH TRẠNG QUYẾT TOÁN], "" ) )
			VAR _u = UPPER ( _t )
			RETURN
			    SWITCH (
			        TRUE (),
			        _u = "", "Chưa cập nhật",
			        _u = "ĐÃ QUYẾT TOÁN", "Đã quyết toán",
			        _u IN { "ĐÃ QUYẾT TOÁN/ THANH LÝ", "ĐÃ QUYẾT TOÁN/THANH LÝ" }, "Đã quyết toán/thanh lý",
			        _u IN { "NT ĐÃ NỘP (THẤT LẠC HS)", "NT ĐÃ NỘP(THẤT LẠC HS)" }, "NT đã nộp (thất lạc HS)",
			        _u = "HOÀN THÀNH", "Hoàn thành",
			        _t
			    )
		dataType: string
		displayFolder: Phân loại
		lineageTag: ea4b58a3-c5ea-42b8-8dfa-881c4fc167f3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic


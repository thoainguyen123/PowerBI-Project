				        "TÌNH TRẠNG QUYẾT TOÁN",
				        "NGÀY KÝ BIÊN BẢN QUYẾT TOÁN",
				        "PIC XÂY DỰNG/CUNG ỨNG",
				        "PIC MEP",
				        "PIC SITE1",
				        "PIC SITE2",
				        "PHÂN LOẠI BỘ PHẬN",
				        "PHÂN LOẠI THEO BỘ MÔN",
				        "Phân loại ưu tiên",
				        "NGÀY MỤC TIÊU",
				        "LÝ DO KHÔNG ĐẠT",
				        "KPI QUYẾT TOÁN",
				        "File",
				        "GIÁ TRỊ HỢP ĐỒNG (CHƯA GỒM VAT)",
				        "GIÁ TRỊ ĐIỀU CHỈNH/PHÁT SINH(CHƯA GỒM VAT)",
				        "TỔNG GIÁ TRỊ HĐ BAO GỒM PHÁT SINH CHƯA VATM VAT)",
				        "THUẾ VAT",
				        "GIÁ TRỊ HĐ+PS (GỒM VAT)",
				        "KHẤU TRỪ TẠM ỨNG",
				        "GHI CHÚ",
				        "TÊN VIẾT TẮT DỰ ÁN",
				        "NGÀY HẾT HIỆU LỰC HĐ",
				        "KÝ QUA GMC",
				        "DỰ ÁN/ĐƠN VỊ",
				        "CỤM LAND/PLAY/STAY",
				        "Phân loại ưu tiên4",
				        "TÌNH TRẠNG HỢP ĐỒNG",
				        "TIẾN ĐỘ THỰC HIỆN HĐ(ngày)1",
				        " GIÁ TRỊ HỢP ĐỒNG(CHƯA GỒM VAT) 1",
				        " GIÁ TRỊ ĐIỀU CHỈNH/PHÁT SINH(CHƯA GỒM VAT) 1",
				        " GIÁ TRỊ HĐ+PS(GỒM VAT) 1",
				        "GIÁ TRỊ WORKDONE(GỒM VAT)1",
				        "GIÁ TRỊ HĐ CHƯA THỰC HIỆN(GỒM VAT)1",
				        "GIÁ TRỊ CÔNG NỢ ĐÃ CÓ CPC GỒM ỨNG +WORKDONE(GỒM VAT)1",
				        "GIÁ TRỊ ĐÃ THANH TOÁN(GỒM VAT)1",
				        "GIÁ TRỊ TĐSP(GỒM VAT)1",
				        "GIÁ TRỊ CÔNG NỢ CHƯA THANH TOÁN(GỒM VAT)1",
				        "MÃ VENDOR",
				        "GIÁ TRỊ HỢP ĐỒNG (CHƯA GỒM VAT)1",
				        "GIÁ TRỊ ĐIỀU CHỈNH/PHÁT SINH(CHƯA GỒM VAT)1",
				        "GIÁ TRỊ HĐ+PS (GỒM VAT)1",
				        "Column2",
				        "MẢ VENDOR",
				        "NGÀY DUYỆT CTCT",
				        "NGÀY DUYỆT CTQT"
				    },
				
				    Source =
				        SharePoint.Contents(
				            "https://novaland.sharepoint.com/sites/PRT",
				            [ApiVersion = 15]
				        ),
				
				    Documents =
				        Source{[Name = "Documents"]}[Content],
				
				    PRC =
				        Documents{[Name = "PRC"]}[Content],
				
				    NovaGen =
				        PRC{[Name = "00. NovaGen"]}[Content],
				
				    NghiepVu =
				        NovaGen{[Name = "07. Các nghiệp vụ"]}[Content],
				
				    PAS =
				        NghiepVu{[Name = "05. PAS"]}[Content],
				
				    TheoDoiFolder =
				        PAS{[Name = "01. THEO DOI HD & CPC"]}[Content],
				
				    #"Filtered Rows" =
				        Table.SelectRows(
				            TheoDoiFolder,
				            each
				                [Extension] <> null
				                and List.Contains(
				                    {".xlsx", ".xlsm", ".xls"},
				                    Text.Lower([Extension])
				                )
				                and not Text.StartsWith([Name], "~$")
				                and Text.StartsWith(
				                    Text.Upper(Text.Trim([Name])),
				                    "THEO DOI HD"
				                )
				        ),
				
				    #"Kept Columns" =
				        Table.SelectColumns(
				            #"Filtered Rows",
				            {"Name", "Content"}
				        ),
				
				    #"Added Workbook" =
				        Table.AddColumn(
				            #"Kept Columns",
				            "Workbook",
				            each try Excel.Workbook([Content], null, true) otherwise null
				        ),
				
				    #"Removed Invalid Workbooks" =
				        Table.SelectRows(
				            #"Added Workbook",
				            each [Workbook] <> null
				        ),
				
				    #"Expanded Workbook" =
				        Table.ExpandTableColumn(
				            #"Removed Invalid Workbooks",
				            "Workbook",
				            {"Item", "Kind", "Hidden", "Data"},
				            {"SheetName", "Kind", "Hidden", "Data"}
				        ),
				
				    #"Filtered Sheet" =
				        Table.SelectRows(
				            #"Expanded Workbook",
				            each
				                [Kind] = "Sheet"
				                and Text.Upper(Text.Trim([SheetName])) = "THEO DÕI HĐ"
				                and ([Hidden] = false or [Hidden] = null)
				        ),
				
				    #"Cleaned Each Sheet" =
				        Table.AddColumn(
				            #"Filtered Sheet",
				            "CleanData",
				            each
				                let
				                    FileName = [Name],
				                    RawData = [Data],
				                    #"Replaced Raw Errors" =
				                        Table.ReplaceErrorValues(
				                            RawData,
				                            List.Transform(Table.ColumnNames(RawData), each {_, null})
				                        ),
				                    RawRows = Table.ToRows(#"Replaced Raw Errors"),
				                    HeaderRowIndex =
				                        List.PositionOf(
				                            List.Transform(
				                                RawRows,
				                                each
				                                    List.AnyTrue(
				                                        List.Transform(
				                                            _,
				                                            (CellValue) => NormalizeName(CellValue) = "STT"
				                                        )
				                                    )
				                            ),
				                            true
				                        ),
				                    HeaderValues =
				                        if HeaderRowIndex = -1 then
				                            {}
				                        else
				                            RawRows{HeaderRowIndex},
				                    SttColumnIndex =
				                        List.PositionOf(
				                            List.Transform(HeaderValues, each NormalizeName(_)),
				                            "STT"
				                        ),
				                    CleanData =
				                        if HeaderRowIndex = -1 or SttColumnIndex = -1 then
				                            #table({}, {})
				                        else
				                            let
				                                ColumnsFromStt = List.Skip(Table.ColumnNames(#"Replaced Raw Errors"), SttColumnIndex),
				                                #"Skipped To Header" = Table.Skip(#"Replaced Raw Errors", HeaderRowIndex),
				                                #"Selected Columns From STT" = Table.SelectColumns(#"Skipped To Header", ColumnsFromStt),
				                                #"Promoted Headers" = Table.PromoteHeaders(#"Selected Columns From STT", [PromoteAllScalars = true]),
				                                #"Replaced Header Errors" =
				                                    Table.ReplaceErrorValues(
				                                        #"Promoted Headers",
				                                        List.Transform(Table.ColumnNames(#"Promoted Headers"), each {_, null})
				                                    ),
				                                #"Standardized Source Schema" =
				                                    List.Accumulate(
				                                        CanonicalMappings,
				                                        #"Replaced Header Errors",
				                                        (State, Mapping) => EnsureColumn(State, Mapping{0}, Mapping{1})
				                                    ),
				                                #"Added Source File" =
				                                    Table.AddColumn(
				                                        #"Standardized Source Schema",
				                                        "Source.FileName",
				                                        each FileName,
				                                        type text
				                                    )
				                            in
				                                #"Added Source File"
				                in
				                    CleanData
				        ),
				
				    #"Combined Data" =
				        if Table.RowCount(#"Cleaned Each Sheet") = 0 then
				            #table({}, {})
				        else
				            Table.Combine(
				                #"Cleaned Each Sheet"[CleanData]
				            ),
				
				    #"Normalized File Column" =
				        if Table.HasColumns(#"Combined Data", {"Source.FileName"}) then
				            let
				                WithoutExistingFile =
				                    Table.RemoveColumns(
				                        #"Combined Data",
				                        {"File"},
				                        MissingField.Ignore
				                    )
				            in
				                Table.RenameColumns(
				                    WithoutExistingFile,
				                    {{"Source.FileName", "File"}},
				                    MissingField.Ignore
				                )
				        else
				            #"Combined Data",
				
				    #"Ensured Required Columns" =
				        List.Accumulate(
				            List.Distinct(List.Combine({RequiredColumns, ModelRequiredColumns})),
				            #"Normalized File Column",
				            (State, ColumnName) =>
				                if Table.HasColumns(State, {ColumnName}) then
				                    State
				                else
				                    Table.AddColumn(
				                        State,
				                        ColumnName,
				                        each null,
				                        type any
				                    )
				        ),
				
				    #"Removed Legacy Schema Columns" =
				        #"Ensured Required Columns",
				
				    #"Removed Errors" =
				        Table.RemoveRowsWithErrors(
				            #"Removed Legacy Schema Columns",
				            {"STT"}
				        ),
				
				    #"Filtered Valid Contracts" =
				        Table.SelectRows(
				            #"Removed Errors",
				            each
				                let
				                    ContractNumber =
				                        try Text.Trim(
				                            Text.From([SỐ HỢP ĐỒNG CHÍNH])
				                        )
				                        otherwise ""
				                in
				                    ContractNumber <> ""
				        ),
				
				    MonetaryColumns = {
				        " GIÁ TRỊ HỢP ĐỒNG(CHƯA GỒM VAT) ",
				        " TỔNG GIÁ TRỊ HĐ BAO GỒM PHÁT SINH CHƯA VATM VAT) ",
				        " GIÁ TRỊ ĐIỀU CHỈNH/PHÁT SINH(CHƯA GỒM VAT) ",
				        " THUẾ VAT ",
				        " GIÁ TRỊ HĐ+PS(GỒM VAT) ",
				        "GIÁ TRỊ WORKDONE (CHƯA GỒM VAT)",
				        "GIÁ TRỊ WORKDONE(GỒM VAT)",
				        "GIÁ TRỊ HĐ CHƯA THỰC HIỆN(GỒM VAT)",
				        "GIÁ TRỊ CÔNG NỢ ĐÃ CÓ CPC GỒM ỨNG +WORKDONE(GỒM VAT)",
				        "GIÁ TRỊ ĐÃ THANH TOÁN(GỒM VAT)",
				        "GIÁ TRỊ TĐSP(GỒM VAT)",
				        "GIÁ TRỊ CÔNG NỢ CHƯA THANH TOÁN(GỒM VAT)",
				        "GIÁ TRỊ TẠM ỨNG CHƯA VAT",
				        "GIÁ TRỊ KHẤU TRỪ TẠM ỨNG",
				        "GIÁ TRỊ TẠM ỨNG CÒN LẠI CHƯA KHẤU TRỪ",
				        "GIÁ TRỊ HỢP ĐỒNG (CHƯA GỒM VAT)",
				        "GIÁ TRỊ ĐIỀU CHỈNH/PHÁT SINH(CHƯA GỒM VAT)",
				        "TỔNG GIÁ TRỊ HĐ BAO GỒM PHÁT SINH CHƯA VATM VAT)",
				        "THUẾ VAT",
				        "GIÁ TRỊ HĐ+PS (GỒM VAT)",
				        "KHẤU TRỪ TẠM ỨNG"
				    },
				
				    #"Preserved Monetary Precision" =
				        Table.TransformColumns(
				            #"Filtered Valid Contracts",
				            List.Transform(
				                List.Select(
				                    MonetaryColumns,
				                    (ColumnName) => Table.HasColumns(#"Filtered Valid Contracts", {ColumnName})
				                ),
				                (ColumnName) => {ColumnName, PreserveMonetaryText, type text}
				            )
				        ),
				
				    #"Ensured Legacy Schema" =
				        if Table.HasColumns(#"Preserved Monetary Precision", {"Column2"}) then
				            #"Preserved Monetary Precision"
				        else
				            Table.AddColumn(
				                #"Preserved Monetary Precision",
				                "Column2",
				                each null,
				                type text
				            ),
				
				    #"Changed Type" =
				        Table.TransformColumns(
				            #"Ensured Legacy Schema",
				            {
				                {
				                    "GIÁ TRỊ TẠM ỨNG CÒN LẠI CHƯA KHẤU TRỪ",
				                    each try Int64.From(_) otherwise null,
				                    Int64.Type
				                }
				            }
				        )
				in
				    #"Changed Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


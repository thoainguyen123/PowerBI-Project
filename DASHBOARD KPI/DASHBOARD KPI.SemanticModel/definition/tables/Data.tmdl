table Data
	lineageTag: 5ae4b80b-a693-414e-b542-ba6aeb077eb9

	/// Số HĐ thuộc phạm vi quyết toán. Dùng KPI QUYẾT TOÁN; riêng nguồn Hồ Tràm fallback sang HĐ có NGÀY MỤC TIÊU.
	measure 'Số HĐ cần quyết toán' =
			CALCULATE(
			    COUNTROWS(Data),
			    NOT ISBLANK(Data[NGÀY MỤC TIÊU])
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: 9639839e-bdf7-4962-91fe-352b8252e2fd

	/// Số HĐ thuộc phạm vi quyết toán có năm mục tiêu bằng năm hiện tại.
	measure 'Số HĐ cần quyết toán (năm nay)' =
			CALCULATE(
			    [Số HĐ cần quyết toán],
			    Data[Năm mục tiêu] = YEAR(TODAY())
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: 680dcc39-2c65-4006-a0ae-93249c299933

	/// Số HĐ thuộc phạm vi quyết toán có tình trạng 'Đã quyết toán'.
	measure 'Số HĐ hoàn thành' =
			CALCULATE(
			    [Số HĐ cần quyết toán],
			    Data[TÌNH TRẠNG QUYẾT TOÁN] = "Đã quyết toán"
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: b991a008-7b8b-44ea-97a5-0d18340df600

	/// Tỷ lệ HĐ đã quyết toán trên tổng HĐ thuộc phạm vi.
	measure '% Hoàn thành' =
			DIVIDE(
			    [Số HĐ hoàn thành],
			    [Số HĐ cần quyết toán]
			)
		formatString: 0.00%
		displayFolder: KPI quyết toán
		lineageTag: bd4af6de-d836-43ba-a0bb-089ae0f999a4

	measure 'Hôm nay' =
			
			"Ngày " &
			DAY(TODAY()) &
			" tháng " &
			MONTH(TODAY()) &
			" năm " &
			YEAR(TODAY())
		lineageTag: 1496c56c-ec7a-4b71-a761-657cc45f5c57

	/// Năm kỳ báo cáo. Mọi measure 2026 đều tham chiếu measure này - sang năm chỉ cần sửa 1 chỗ thành 2027.
	measure 'Năm báo cáo' = YEAR(TODAY())
		formatString: 0
		displayFolder: Tracking quyết toán\00. Tham số
		lineageTag: 89907072-6fee-429b-90a6-61719de11b2a

	/// (1) Tổng số HĐ cần quyết toán: HĐ có ngày mục tiêu; không bị giới hạn bởi slicer Kỳ mục tiêu nhưng vẫn giữ các bộ lọc khu vực, dự án và nhà thầu.
	measure '(1) Số HĐ cần quyết toán' =
			CALCULATE (
			    COUNTROWS ( Data ),
			    NOT ISBLANK ( Data[NGÀY MỤC TIÊU] ),
			    REMOVEFILTERS ( Data[Năm mục tiêu] ),
			    REMOVEFILTERS ( Data[Quý mục tiêu] ),
			    REMOVEFILTERS ( Data[Kỳ mục tiêu] )
			)
		formatString: #,##0
		displayFolder: Tracking quyết toán\01. Kế hoạch (Cột 1-4)
		lineageTag: b7a8cfac-2b95-4436-a8a5-73c824afa134

	/// Measure alias tương thích cho các visual đang dùng tên cũ '(2) Số HĐ cần quyết toán năm nay'.
	measure '(2) Số HĐ cần quyết toán năm nay' = [(2) Số HĐ cần quyết toán theo kỳ]
		formatString: #,##0
		displayFolder: Tracking quyết toán\01. Kế hoạch (Cột 1-4)
		lineageTag: 5d7f758b-f71e-41f2-b669-e2f5bba45b5d

	/// (2.1) KPI đã đăng ký: HĐ có ngày mục tiêu trong kỳ và KPI QUYẾT TOÁN chứa chữ 'KPI'.
	measure '(2.1) KPI đã đăng ký' =
			CALCULATE (
			    COUNTROWS ( Data ),
			    KEEPFILTERS ( NOT ISBLANK ( Data[NGÀY MỤC TIÊU] ) ),
			    KEEPFILTERS (
			        CONTAINSSTRING (
			            UPPER ( COALESCE ( Data[KPI QUYẾT TOÁN], "" ) ),
			            "KPI"
			        )
			    )
			)
		formatString: #,##0
		displayFolder: Tracking quyết toán\01. Kế hoạch (Cột 1-4)
		lineageTag: ce0c6fa3-e822-4ebe-b9cf-b0ed4a31a5bf

	/// (2.2) Đăng ký thêm: HĐ có ngày mục tiêu trong kỳ và KPI QUYẾT TOÁN chứa chữ 'NGOÀI'.
	measure '(2.2) Đăng ký thêm' =
			CALCULATE (
			    COUNTROWS ( Data ),
			    KEEPFILTERS ( NOT ISBLANK ( Data[NGÀY MỤC TIÊU] ) ),
			    KEEPFILTERS ( CONTAINSSTRING ( UPPER ( COALESCE ( Data[KPI QUYẾT TOÁN], "" ) ), "NGOÀI" ) )
			)
		formatString: #,##0
		displayFolder: Tracking quyết toán\01. Kế hoạch (Cột 1-4)
		lineageTag: 33907bf9-caa8-4525-8451-39b13813bf75

	/// Phần mục tiêu trong kỳ đang chọn không thuộc KPI đã đăng ký hoặc đăng ký thêm. Dùng kiểm tra cân đối: (2) = (2.1) + (2.2) + (2.3).
	measure '(2.3) Chưa phân loại KPI' =
			COUNTROWS (
			    FILTER (
			        Data,
			        NOT ISBLANK ( Data[NGÀY MỤC TIÊU] )
			            && NOT Data[Nhóm KPI quyết toán] IN { "KPI đã đăng ký", "Đăng ký thêm" }
			    )
			)
		formatString: #,##0
		displayFolder: Tracking quyết toán\01. Kế hoạch (Cột 1-4)
		lineageTag: ec6113a3-f53b-4154-ad02-dadce520b10f

	/// Measure alias tương thích cho các visual đang dùng tên cũ '(3) Số HĐ hoàn thành hiện tại'.
	measure '(3) Số HĐ hoàn thành hiện tại' = [(3) Hoàn thành trong kỳ]
		formatString: #,##0
		displayFolder: Tracking quyết toán\02. Hoàn thành (Cột 5, 7, 9, 10)
		lineageTag: 7a8ef4e3-c6fd-468c-b111-78cd8c72bf99

	/// Measure alias tương thích cho tên cũ.
	measure '% Hoàn thành theo KPI đã đăng ký' = [% Hoàn thành KPI]
		formatString: 0.00%
		displayFolder: Tracking quyết toán\03. Tỷ lệ % (Cột 6, 8)
		lineageTag: 9f7ec36e-171f-43bd-898a-cfb5f0923b36

	/// Measure alias tương thích cho tên cũ.
	measure '% Hoàn thành năm hiện tại' = [% Hoàn thành trong kỳ]
		formatString: 0.00%
		displayFolder: Tracking quyết toán\03. Tỷ lệ % (Cột 6, 8)
		lineageTag: 17a588a8-92aa-4060-aa4c-f3836255d11e

	/// Measure alias tương thích cho tên cũ.
	measure 'Giá trị đã quyết toán' = [Giá trị quyết toán trong kỳ]
		formatString: #,##0
		displayFolder: Tracking quyết toán\04. Giá trị (Cột 11)
		lineageTag: 4f9001f2-2631-40d4-af61-f7c4daa7a374

	/// Bản mở rộng của (3): mọi HĐ ký biên bản từ 2026, kể cả HĐ có mục tiêu năm khác hoặc không có mục tiêu. KHÔNG dùng làm tử số cho % vì sẽ vượt mẫu số.
	measure '(3b) Số HĐ hoàn thành (ký từ 2026, mọi kỳ)' =
			VAR _Nam = [Năm báo cáo]
			RETURN
			    CALCULATE (
			        COUNTROWS ( Data ),
			        Data[Năm ký quyết toán] >= _Nam
			    )
		formatString: #,##0
		displayFolder: Tracking quyết toán\05. Tham chiếu khác
		lineageTag: 84d5ac15-4875-4773-a96c-d75eb7533810

	/// Giá trị workdone tương ứng với (3b).
	measure 'Giá trị đã quyết toán (ký từ 2026, mọi kỳ)' =
			VAR _Nam = [Năm báo cáo]
			RETURN
			    CALCULATE (
			        SUM ( Data[Giá trị workdone gồm VAT] ),
			        Data[Năm ký quyết toán] >= _Nam
			    )
		formatString: #,##0
		displayFolder: Tracking quyết toán\05. Tham chiếu khác
		lineageTag: 73e2f5cb-31e8-492c-abe8-dc47ea8df7fc

	/// Measure alias tương thích cho các visual đang dùng tên cũ '(3.1) Số HĐ hoàn thành thuộc KPI đã đăng ký'.
	measure '(3.1) Số HĐ hoàn thành thuộc KPI đã đăng ký' = [(3.1) Hoàn thành theo KPI]
		formatString: #,##0
		displayFolder: Tracking quyết toán\02. Hoàn thành (Cột 5, 7, 9, 10)
		lineageTag: 8a4346cd-7bbb-4436-b504-3faaacc48f6d

	/// Tỷ lệ hoàn thành chặt trong cùng nhóm KPI đã đăng ký và cùng kỳ mục tiêu; luôn không vượt 100%.
	measure '% Hoàn thành KPI đăng ký (chặt)' = DIVIDE ( [(3.1) Hoàn thành theo KPI], [(2.1) KPI đã đăng ký] )
		formatString: 0.00%
		displayFolder: Tracking quyết toán\03. Tỷ lệ % (Cột 6, 8)
		lineageTag: 2d234267-28ad-4837-81fc-5ca518d3440e

	/// Tổng giá trị hợp đồng và phát sinh gồm VAT theo filter hiện tại.
	measure 'Giá trị HĐ + PS gồm VAT' = SUM ( Data[Giá trị HĐ + PS gồm VAT số] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\01. Giá trị nguồn
		lineageTag: 4bc29028-fb58-469e-9e7e-d897f7bf0445

	/// Tổng giá trị Workdone/hóa đơn chưa VAT theo mapping của template công nợ.
	measure 'Giá trị hóa đơn chưa VAT' = SUM ( Data[Giá trị workdone chưa VAT số] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\01. Giá trị nguồn
		lineageTag: 8347d0b7-76ec-4d0a-8e23-3f8f49475f5c

	/// Tổng giá trị Workdone/hóa đơn gồm VAT theo mapping của template công nợ.
	measure 'Giá trị hóa đơn gồm VAT' = SUM ( Data[Giá trị workdone gồm VAT] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\01. Giá trị nguồn
		lineageTag: c51eb780-20a3-4410-82bc-e9f61602352d

	/// Tổng giá trị tạm ứng theo filter hiện tại.
	measure 'Giá trị tạm ứng' = SUM ( Data[Giá trị tạm ứng số] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\01. Giá trị nguồn
		lineageTag: 70449c24-619b-44ce-b38c-5ea7e4ae311e

	/// Tổng giá trị đã khấu trừ tạm ứng theo filter hiện tại.
	measure '(3) Khấu trừ tạm ứng' = SUM ( Data[Giá trị khấu trừ tạm ứng số] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\01. Giá trị nguồn
		lineageTag: ab9c58bb-9954-408b-936a-821357bfc848

	/// (4) Giá trị tạm ứng chưa thu hồi = Giá trị tạm ứng - (3) Khấu trừ tạm ứng.
	measure '(4) Tạm ứng chưa thu hồi' = [Giá trị tạm ứng] - [(3) Khấu trừ tạm ứng]
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\02. Chỉ tiêu template
		lineageTag: 5a3f0876-5e8c-4c8c-8789-68cc6a82896b

	/// (5) Giá trị công nợ đã có CPC gồm tạm ứng và Workdone, gồm VAT.
	measure '(5) Công nợ đã có CPC' = SUM ( Data[Giá trị CPC gồm ứng + workdone số] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\02. Chỉ tiêu template
		lineageTag: b2181008-5ba0-4a38-86a9-df3560d98412

	/// (6) Giá trị đã thanh toán gồm tạm ứng và Workdone, gồm VAT.
	measure '(6) Đã thanh toán' = SUM ( Data[Giá trị đã thanh toán số] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\02. Chỉ tiêu template
		lineageTag: 69a157b6-bc8b-47f9-a738-8ea1a442887b

	/// (7) Giá trị TĐSP/Swap gồm VAT.
	measure '(7) Giá trị Swap' = SUM ( Data[Giá trị swap số] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\02. Chỉ tiêu template
		lineageTag: edbc1a0f-ffc2-4ffd-8eed-a04fa929117e

	/// (8) Công nợ CPC còn lại chưa thanh toán = (5) - (6) - (7).
	measure '(8) Công nợ CPC còn lại' = [(5) Công nợ đã có CPC] - [(6) Đã thanh toán] - [(7) Giá trị Swap]
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\02. Chỉ tiêu template
		lineageTag: bc5c7109-a9e0-4207-a41c-b2b23dd0c274

	/// (9) Công nợ sau khi trừ tạm ứng chưa thu hồi = (8) - (4).
	measure '(9) Công nợ sau trừ tạm ứng' = [(8) Công nợ CPC còn lại] - [(4) Tạm ứng chưa thu hồi]
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\02. Chỉ tiêu template
		lineageTag: dafbb8f9-96f2-4de7-a867-90606c761086

	/// (10) Tổng nợ phải trả gồm VAT = Giá trị hóa đơn gồm VAT - (6) - (7).
	measure '(10) Tổng nợ phải trả' = [Giá trị hóa đơn gồm VAT] - [(6) Đã thanh toán] - [(7) Giá trị Swap]
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\02. Chỉ tiêu template
		lineageTag: 57ce1bd7-1485-4249-a3f2-06424c04c0f7

	/// (11) Tiền bảo hành giữ lại theo logic 5% ở từng dòng của template.
	measure '(11) Tiền bảo hành giữ lại' = SUM ( Data[Tiền bảo hành giữ lại dòng] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\02. Chỉ tiêu template
		lineageTag: 3ab6ceb9-5420-4910-a25d-97e2493f487a

	/// (12) Tổng còn lại phải trả gồm VAT = (10) - (11).
	measure '(12) Tổng còn lại phải trả' = [(10) Tổng nợ phải trả] - [(11) Tiền bảo hành giữ lại]
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ\02. Chỉ tiêu template
		lineageTag: 2ae0bd27-647f-4cd2-80e0-79c4182ff959

	/// (8) Công nợ CPC còn lại quy đổi sang tỷ đồng, dùng cho card và biểu đồ.
	measure '(8) Công nợ CPC còn lại (tỷ)' = DIVIDE ( [(8) Công nợ CPC còn lại], 1000000000 )
		formatString: #,##0.0
		displayFolder: Công nợ\03. Hiển thị tỷ đồng
		lineageTag: 6977552c-0853-4395-bc37-c71d1ae76a64

	/// (9) Công nợ sau trừ tạm ứng quy đổi sang tỷ đồng, dùng cho card.
	measure '(9) Công nợ sau trừ tạm ứng (tỷ)' = DIVIDE ( [(9) Công nợ sau trừ tạm ứng], 1000000000 )
		formatString: #,##0.0
		displayFolder: Công nợ\03. Hiển thị tỷ đồng
		lineageTag: 47353f1b-ff46-4fe2-a8d5-7ebd5eb41c59

	/// (10) Tổng nợ phải trả quy đổi sang tỷ đồng, dùng cho card.
	measure '(10) Tổng nợ phải trả (tỷ)' = DIVIDE ( [(10) Tổng nợ phải trả], 1000000000 )
		formatString: #,##0.0
		displayFolder: Công nợ\03. Hiển thị tỷ đồng
		lineageTag: 5814eb12-afd4-489d-bf4c-4995af8d6978

	/// (11) Tiền bảo hành giữ lại quy đổi sang tỷ đồng, dùng cho card.
	measure '(11) Tiền bảo hành giữ lại (tỷ)' = DIVIDE ( [(11) Tiền bảo hành giữ lại], 1000000000 )
		formatString: #,##0.0
		displayFolder: Công nợ\03. Hiển thị tỷ đồng
		lineageTag: f5d98e73-8a40-4bbe-89e3-422155b70a45

	/// (12) Tổng còn lại phải trả quy đổi sang tỷ đồng, dùng cho card và biểu đồ.
	measure '(12) Tổng còn lại phải trả (tỷ)' = DIVIDE ( [(12) Tổng còn lại phải trả], 1000000000 )
		formatString: #,##0.0
		displayFolder: Công nợ\03. Hiển thị tỷ đồng
		lineageTag: 7415c17e-a002-4efd-86af-508eac1590c3

	/// Hiển thị tình trạng hợp đồng tại cấp Số hợp đồng gốc trong matrix Công nợ; để trống tại subtotal và grand total.
	measure 'Tình trạng HĐ (dòng)' =
			IF (
			    ISINSCOPE ( 'Data'[SỐ HỢP ĐỒNG CHÍNH] ),
			    SELECTEDVALUE ( 'Data'[TÌNH TRẠNG HỢP ĐỒNG] )
			)
		formatString: @
		displayFolder: Công nợ\04. Hiển thị bảng
		lineageTag: 6aa1cf2f-7653-4f28-884c-3f9f96633b1a

	/// Hiển thị tình trạng quyết toán tại cấp Số hợp đồng gốc trong matrix Công nợ; để trống tại subtotal và grand total.
	measure 'Tình trạng quyết toán (dòng)' =
			IF (
			    ISINSCOPE ( 'Data'[SỐ HỢP ĐỒNG CHÍNH] ),
			    SELECTEDVALUE ( 'Data'[Tình trạng quyết toán (chuẩn)] )
			)
		formatString: @
		displayFolder: Công nợ\04. Hiển thị bảng
		lineageTag: 4429458c-0078-4559-ba9a-676cc3dbab8c

	/// Hiển thị nội dung hợp đồng trong matrix Công nợ chỉ tại cấp Số hợp đồng gốc; để trống tại subtotal và grand total.
	measure 'Nội dung gói thầu (dòng)' =
			IF (
			    ISINSCOPE ( Data[SỐ HỢP ĐỒNG CHÍNH] ),
			    SELECTEDVALUE ( Data[NỘI DUNG HỢP ĐỒNG] )
			)
		formatString: @
		displayFolder: Công nợ\04. Hiển thị bảng
		lineageTag: 33d8ef85-4ccd-4fac-9c14-848ed6708e49

	/// Hiển thị giá trị ngày ký hợp đồng đã được Power Query chuẩn hóa vào cột NGÀY BẮT ĐẦU HIỆU LỰC HĐ; chỉ hiển thị tại cấp Số hợp đồng gốc trong matrix Công nợ và để trống tại subtotal/grand total.
	measure 'Ngày ký HĐ (dòng)' =
			IF (
			    ISINSCOPE ( 'Data'[SỐ HỢP ĐỒNG CHÍNH] ),
			    SELECTEDVALUE ( 'Data'[NGÀY BẮT ĐẦU HIỆU LỰC HĐ] )
			)
		formatString: @
		displayFolder: Công nợ\04. Hiển thị bảng
		lineageTag: 249413ab-b800-4955-a4e8-5e6e017b068a

	/// Hiển thị Pháp nhân ký HĐ trong matrix Công nợ chỉ tại cấp Số hợp đồng gốc; để trống tại subtotal và grand total.
	measure 'Pháp nhân ký HĐ (dòng)' =
			IF (
			    ISINSCOPE ( Data[SỐ HỢP ĐỒNG CHÍNH] ),
			    SELECTEDVALUE ( Data[PHÁP NHÂN KÝ HĐ/PLHĐ] )
			)
		formatString: @
		displayFolder: Công nợ\04. Hiển thị bảng
		lineageTag: 1b419953-9dd5-47cd-9f4a-3153ee945793

	/// Tổng công nợ đã có CPC gồm ứng và Workdone, quy đổi sang tỷ đồng.
	measure 'KPI Công nợ cần thanh toán (tỷ)' = DIVIDE ( SUM ( Data[Giá trị CPC gồm ứng + workdone số] ), 1000000000 )
		formatString: #,##0.0
		displayFolder: Công nợ\03. Hiển thị tỷ đồng
		lineageTag: 22af153c-37fe-4941-86d0-66e81b30a2b0

	/// Tổng giá trị đã thanh toán và TĐSP, quy đổi sang tỷ đồng.
	measure 'KPI Đã thanh toán (tỷ)' =
			VAR _DaThanhToan = SUM ( Data[Giá trị đã thanh toán số] )
			VAR _Tdsp = SUM ( Data[Giá trị swap số] )
			RETURN
				DIVIDE ( _DaThanhToan + _Tdsp, 1000000000 )
		formatString: #,##0.0
		displayFolder: Công nợ\03. Hiển thị tỷ đồng
		lineageTag: 8bb40652-af2c-4ca1-9fe5-4f4e6c92f26b

	/// Tổng công nợ chưa thanh toán lấy trực tiếp từ cột nguồn, quy đổi sang tỷ đồng.
	measure 'KPI Công nợ chưa thanh toán (tỷ)' = DIVIDE ( SUM ( Data[Giá trị công nợ chưa thanh toán số] ), 1000000000 )
		formatString: #,##0.0
		displayFolder: Công nợ\03. Hiển thị tỷ đồng
		lineageTag: fe149669-fb8d-4fb9-aeb6-2f0e8bf09d9e

	/// Tổng tạm ứng còn lại chưa khấu trừ lấy trực tiếp từ cột nguồn, quy đổi sang tỷ đồng.
	measure 'KPI Tạm ứng chưa thu hồi (tỷ)' = DIVIDE ( SUM ( Data[GIÁ TRỊ TẠM ỨNG CÒN LẠI CHƯA KHẤU TRỪ] ), 1000000000 )
		formatString: #,##0.0
		displayFolder: Công nợ\03. Hiển thị tỷ đồng
		lineageTag: 756d6073-4859-4e50-8dda-34a71ba742e0

	/// Đếm phân biệt cụm dự án còn dữ liệu theo filter của page Công nợ theo nhà thầu.
	measure 'CNNT Số cụm dự án' =
			CALCULATE (
			    DISTINCTCOUNT ( Data[CỤM LAND/PLAY/STAY] ),
			    Data[CỤM LAND/PLAY/STAY] <> BLANK ()
			)
		formatString: #,##0
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 14c2f381-8dd3-42a8-b8e4-45dca52683c2

	/// Đếm phân biệt dự án còn dữ liệu theo filter của page Công nợ theo nhà thầu.
	measure 'CNNT Số dự án' =
			COALESCE (
			    CALCULATE (
			        DISTINCTCOUNT ( Data[TÊN VIẾT TẮT DỰ ÁN/ĐƠN VỊ] ),
			        KEEPFILTERS ( Data[TÊN VIẾT TẮT DỰ ÁN/ĐƠN VỊ] <> BLANK () )
			    ),
			    0
			)
		formatString: #,##0
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 59c528a1-b735-4eac-9163-7074202db64b

	/// Đếm phân biệt số hợp đồng chính còn dữ liệu theo filter hiện tại.
	measure 'CNNT Tổng số HĐ' =
			CALCULATE (
			    DISTINCTCOUNT ( Data[SỐ HỢP ĐỒNG CHÍNH] ),
			    Data[SỐ HỢP ĐỒNG CHÍNH] <> BLANK ()
			)
		formatString: #,##0
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 45d522c7-42b3-41b6-8223-68b207a3430f

	/// Đếm phân biệt hợp đồng đã quyết toán hoặc đã quyết toán/thanh lý.
	measure 'CNNT Số HĐ đã QT' =
			CALCULATE (
			    DISTINCTCOUNT ( Data[SỐ HỢP ĐỒNG CHÍNH] ),
			    Data[SỐ HỢP ĐỒNG CHÍNH] <> BLANK (),
			    Data[Tình trạng quyết toán (chuẩn)] IN { "Đã quyết toán", "Đã quyết toán/thanh lý" }
			)
		formatString: #,##0
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 797b785e-0c8e-4418-b513-f3e6212b557d

	/// Số hợp đồng chưa quyết toán bằng tổng hợp đồng trừ số hợp đồng đã quyết toán.
	measure 'CNNT Số HĐ chưa QT' = [CNNT Tổng số HĐ] - [CNNT Số HĐ đã QT]
		formatString: #,##0
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 400f8e35-6148-4954-94ae-dc2f911c64e7

	/// Tổng giá trị hợp đồng và phát sinh gồm VAT, quy đổi sang tỷ đồng.
	measure 'CNNT Tổng giá trị HĐ (tỷ)' = DIVIDE ( SUM ( Data[Giá trị HĐ + PS gồm VAT số] ), 1000000000 )
		formatString: #,##0.0
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 3b176941-7bda-4f8b-a997-ddd623483ea6

	/// Tổng công nợ đã có CPC gồm ứng và Workdone, quy đổi sang tỷ đồng.
	measure 'CNNT Tổng công nợ (tỷ)' = DIVIDE ( SUM ( Data[Giá trị CPC gồm ứng + workdone số] ), 1000000000 )
		formatString: #,##0.0
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 22376a4b-9850-45fc-a843-0c0473d1fa5d

	/// Tổng đã thanh toán gồm thanh toán tiền và TĐSP, quy đổi sang tỷ đồng.
	measure 'CNNT Tổng đã thanh toán (tỷ)' =
			DIVIDE (
			    SUM ( Data[Giá trị đã thanh toán số] ) + SUM ( Data[Giá trị swap số] ),
			    1000000000
			)
		formatString: #,##0.0
		displayFolder: Công nợ theo nhà thầu
		lineageTag: b639752b-e875-4445-a344-0448740bfff3

	/// Tổng công nợ chưa thanh toán lấy trực tiếp từ cột nguồn, quy đổi sang tỷ đồng.
	measure 'CNNT Tổng còn lại (tỷ)' = DIVIDE ( SUM ( Data[Giá trị công nợ chưa thanh toán số] ), 1000000000 )
		formatString: #,##0.0
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 91fb2dae-7957-4b02-acb1-c865110993d5

	/// Nội dung hợp đồng chỉ hiển thị tại cấp số hợp đồng chính trong matrix.
	measure 'CNNT Nội dung HĐ (dòng)' =
			IF (
			    ISINSCOPE ( Data[SỐ HỢP ĐỒNG CHÍNH] ),
			    SELECTEDVALUE ( Data[NỘI DUNG HỢP ĐỒNG] )
			)
		formatString: @
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 7c27a548-d5eb-40ef-a368-f9ebb3b84515

	/// Ngày bắt đầu hiệu lực chỉ hiển thị tại cấp số hợp đồng chính trong matrix.
	measure 'CNNT Ngày hiệu lực (dòng)' =
			IF (
			    ISINSCOPE ( Data[SỐ HỢP ĐỒNG CHÍNH] ),
			    SELECTEDVALUE ( Data[NGÀY BẮT ĐẦU HIỆU LỰC HĐ] )
			)
		formatString: @
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 02fc6bba-075a-400b-bf91-0204cf4aea59

	/// Tình trạng quyết toán chuẩn chỉ hiển thị tại cấp số hợp đồng chính trong matrix.
	measure 'CNNT Tình trạng QT (dòng)' =
			IF (
			    ISINSCOPE ( Data[SỐ HỢP ĐỒNG CHÍNH] ),
			    SELECTEDVALUE ( Data[Tình trạng quyết toán (chuẩn)] )
			)
		formatString: @
		displayFolder: Công nợ theo nhà thầu
		lineageTag: b3464349-e56b-4ecc-9a33-f6380d6553ff

	/// Giá trị đã thanh toán gồm thanh toán tiền và TĐSP tại cấp chi tiết hiện tại.
	measure 'CNNT Giá trị đã thanh toán' = SUM ( Data[Giá trị đã thanh toán số] ) + SUM ( Data[Giá trị swap số] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 56fbeec4-fe87-4458-bfe6-ff08dfa69a43

	/// Giá trị còn lại lấy trực tiếp từ cột công nợ chưa thanh toán của nguồn.
	measure 'CNNT Giá trị còn lại' = SUM ( Data[Giá trị công nợ chưa thanh toán số] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ theo nhà thầu
		lineageTag: b041b051-bc81-492f-8c86-2110291ebde8

	/// Số thứ tự động của hợp đồng trong tập dữ liệu đang được lọc trên page.
	measure 'CNNT STT (dòng)' =
			IF (
			    ISINSCOPE ( Data[SỐ HỢP ĐỒNG CHÍNH] ),
			    RANK (
			        DENSE,
			        ALL ( Data[SỐ HỢP ĐỒNG CHÍNH] ),
			        ORDERBY ( Data[SỐ HỢP ĐỒNG CHÍNH], ASC )
			    )
			)
		formatString: #,##0
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 6d90c16c-9be6-4163-a7da-8103de564afa

	measure 'CNNT Tình trạng HĐ (dòng)' =
			IF (
			    ISINSCOPE ( Data[SỐ HỢP ĐỒNG CHÍNH] ),
			    SELECTEDVALUE ( Data[TÌNH TRẠNG HỢP ĐỒNG] )
			)
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 1db82ed8-09d7-465d-9306-4ade82f3d206

	/// Tổng tạm ứng chưa thu hồi dùng cùng measure (4) với bảng chi tiết, quy đổi sang tỷ đồng.
	measure 'CNNT Tổng Tạm Ứng Chưa Thu Hồi (tỷ)' = DIVIDE ( [(4) Tạm ứng chưa thu hồi], 1000000000 )
		formatString: 0.0000
		lineageTag: e10a897c-a62e-48fc-abe0-97b659652a09

	/// (2) Kế hoạch quyết toán theo kỳ: HĐ có ngày mục tiêu trong kỳ slicer đang chọn.
	measure '(2) Số HĐ cần quyết toán theo kỳ' =
			CALCULATE (
			    COUNTROWS ( Data ),
			    KEEPFILTERS ( NOT ISBLANK ( Data[NGÀY MỤC TIÊU] ) )
			)
		formatString: #,##0
		displayFolder: Tracking quyết toán\01. Kế hoạch (Cột 1-4)
		lineageTag: a3e51240-a1b2-4c89-b001-c85240de0102

	/// (3.2) Hoàn thành đạt mục tiêu: NGÀY DUYỆT CTQT <= NGÀY MỤC TIÊU, trong đó cả ngày duyệt và ngày mục tiêu đều nằm trong kỳ slicer đang chọn.
	measure '(3.2) Hoàn thành đạt mục tiêu' =
			VAR _LocNam = ISFILTERED ( Data[Năm mục tiêu] )
			VAR _LocQuy = ISFILTERED ( Data[Quý mục tiêu] )
			VAR _NamDaChon = VALUES ( Data[Năm mục tiêu] )
			VAR _QuyDaChon = VALUES ( Data[Quý mục tiêu] )
			RETURN
			    COUNTROWS (
			        FILTER (
			            Data,
			            NOT ISBLANK ( Data[NGÀY MỤC TIÊU] )
			                && NOT ISBLANK ( Data[Năm ký quyết toán] )
			                && Data[Đạt tiến độ mục tiêu] = TRUE ()
			                && ( NOT _LocNam || Data[Năm ký quyết toán] IN _NamDaChon )
			                && ( NOT _LocQuy || Data[Quý quyết toán] IN _QuyDaChon )
			                && ( NOT _LocNam || Data[Năm mục tiêu] IN _NamDaChon )
			                && ( NOT _LocQuy || Data[Quý mục tiêu] IN _QuyDaChon )
			        )
			    )
		formatString: #,##0
		displayFolder: Tracking quyết toán\02. Hoàn thành (Cột 5, 7, 9, 10)
		lineageTag: e8a91204-1234-4567-89ab-cdef01234567

	/// (3.3) Hoàn thành vượt mục tiêu: NGÀY DUYỆT CTQT <= NGÀY MỤC TIÊU, trong đó ngày duyệt nằm trong kỳ slicer đang chọn còn ngày mục tiêu lớn hơn kỳ slicer.
	measure '(3.3) Hoàn thành vượt mục tiêu' =
			VAR _LocNam = ISFILTERED ( Data[Năm mục tiêu] )
			VAR _LocQuy = ISFILTERED ( Data[Quý mục tiêu] )
			VAR _NamDaChon = VALUES ( Data[Năm mục tiêu] )
			VAR _QuyDaChon = VALUES ( Data[Quý mục tiêu] )
			VAR _MaxNam = MAXX ( _NamDaChon, Data[Năm mục tiêu] )
			VAR _MaxQuy = MAXX ( _QuyDaChon, IFERROR ( VALUE ( RIGHT ( Data[Quý mục tiêu], 1 ) ), 4 ) )
			VAR _MaxSlicerSort =
			    IF (
			        _LocQuy && NOT ISBLANK ( _MaxQuy ) && NOT ISBLANK ( _MaxNam ),
			        _MaxNam * 10 + _MaxQuy,
			        IF ( _LocNam && NOT ISBLANK ( _MaxNam ), _MaxNam * 10 + 4, BLANK () )
			    )
			RETURN
			    IF (
			        NOT _LocNam && NOT _LocQuy,
			        0,
			        CALCULATE (
			            COUNTROWS (
			                FILTER (
			                    Data,
			                    NOT ISBLANK ( Data[NGÀY MỤC TIÊU] )
			                        && NOT ISBLANK ( Data[Năm ký quyết toán] )
			                        && Data[Đạt tiến độ mục tiêu] = TRUE ()
			                        && ( NOT _LocNam || Data[Năm ký quyết toán] IN _NamDaChon )
			                        && ( NOT _LocQuy || Data[Quý quyết toán] IN _QuyDaChon )
			                        && (
			                            VAR _TargetSort = Data[Năm mục tiêu] * 10 + IFERROR ( VALUE ( RIGHT ( Data[Quý mục tiêu], 1 ) ), 4 )
			                            RETURN _TargetSort > _MaxSlicerSort
			                        )
			                )
			            ),
			            REMOVEFILTERS ( Data[Năm mục tiêu] ),
			            REMOVEFILTERS ( Data[Quý mục tiêu] ),
			            REMOVEFILTERS ( Data[Kỳ mục tiêu] )
			        )
			    )
		formatString: #,##0
		displayFolder: Tracking quyết toán\02. Hoàn thành (Cột 5, 7, 9, 10)
		lineageTag: f9ba2315-2345-5678-90bc-def012345678

	/// (3) Hoàn thành trong kỳ: Tổng số HĐ hoàn thành đạt mục tiêu và vượt mục tiêu trong kỳ slicer đang chọn.
	measure '(3) Hoàn thành trong kỳ' = COALESCE ( [(3.2) Hoàn thành đạt mục tiêu], 0 ) + COALESCE ( [(3.3) Hoàn thành vượt mục tiêu], 0 )
		formatString: #,##0
		displayFolder: Tracking quyết toán\02. Hoàn thành (Cột 5, 7, 9, 10)
		lineageTag: 84bef4e3-c6fd-468c-b111-78cd8c72bf82

	/// (3.1) Hoàn thành theo KPI: NGÀY DUYỆT CTQT <= NGÀY MỤC TIÊU, trong đó cả ngày duyệt và ngày mục tiêu đều nằm trong kỳ slicer đang chọn và KPI QUYẾT TOÁN chứa 'KPI'.
	measure '(3.1) Hoàn thành theo KPI' =
			VAR _LocNam = ISFILTERED ( Data[Năm mục tiêu] )
			VAR _LocQuy = ISFILTERED ( Data[Quý mục tiêu] )
			VAR _NamDaChon = VALUES ( Data[Năm mục tiêu] )
			VAR _QuyDaChon = VALUES ( Data[Quý mục tiêu] )
			RETURN
			    COUNTROWS (
			        FILTER (
			            Data,
			            NOT ISBLANK ( Data[NGÀY MỤC TIÊU] )
			                && NOT ISBLANK ( Data[Năm ký quyết toán] )
			                && Data[Đạt tiến độ mục tiêu] = TRUE ()
			                && CONTAINSSTRING ( UPPER ( COALESCE ( Data[KPI QUYẾT TOÁN], "" ) ), "KPI" )
			                && ( NOT _LocNam || Data[Năm ký quyết toán] IN _NamDaChon )
			                && ( NOT _LocQuy || Data[Quý quyết toán] IN _QuyDaChon )
			                && ( NOT _LocNam || Data[Năm mục tiêu] IN _NamDaChon )
			                && ( NOT _LocQuy || Data[Quý mục tiêu] IN _QuyDaChon )
			        )
			    )
		formatString: #,##0
		displayFolder: Tracking quyết toán\02. Hoàn thành (Cột 5, 7, 9, 10)
		lineageTag: 14c346cd-7bbb-4436-b504-3faaacc48f6c

	/// Tỷ lệ hoàn thành của nhóm KPI đã đăng ký trong kỳ mục tiêu đang chọn.
	measure '% Hoàn thành KPI' = DIVIDE ( [(3.1) Hoàn thành theo KPI], [(2.1) KPI đã đăng ký] )
		formatString: 0.00%
		displayFolder: Tracking quyết toán\03. Tỷ lệ % (Cột 6, 8)
		lineageTag: 8f7ec36e-171f-43bd-898a-cfb5f0923b35

	/// Tỷ lệ hoàn thành theo kỳ mục tiêu đang chọn.
	measure '% Hoàn thành trong kỳ' = DIVIDE ( [(3) Hoàn thành trong kỳ], [(2) Số HĐ cần quyết toán theo kỳ] )
		formatString: 0.00%
		displayFolder: Tracking quyết toán\03. Tỷ lệ % (Cột 6, 8)
		lineageTag: 07a588a8-92aa-4060-aa4c-f3836255d11d

	/// Tổng giá trị HĐ + PS gồm VAT của các hợp đồng hoàn thành trong kỳ mục tiêu đang chọn.
	measure 'Giá trị quyết toán trong kỳ' =
			VAR _LocNam = ISFILTERED ( Data[Năm mục tiêu] )
			VAR _LocQuy = ISFILTERED ( Data[Quý mục tiêu] )
			VAR _NamDaChon = VALUES ( Data[Năm mục tiêu] )
			VAR _QuyDaChon = VALUES ( Data[Quý mục tiêu] )
			VAR _MaxNam = MAXX ( _NamDaChon, Data[Năm mục tiêu] )
			VAR _MaxQuy = MAXX ( _QuyDaChon, IFERROR ( VALUE ( RIGHT ( Data[Quý mục tiêu], 1 ) ), 4 ) )
			VAR _MaxSlicerSort =
			    IF (
			        _LocQuy && NOT ISBLANK ( _MaxQuy ) && NOT ISBLANK ( _MaxNam ),
			        _MaxNam * 10 + _MaxQuy,
			        IF ( _LocNam && NOT ISBLANK ( _MaxNam ), _MaxNam * 10 + 4, BLANK () )
			    )
			RETURN
			    CALCULATE (
			        SUMX (
			            FILTER (
			                Data,
			                NOT ISBLANK ( Data[NGÀY MỤC TIÊU] )
			                    && NOT ISBLANK ( Data[Năm ký quyết toán] )
			                    && Data[Đạt tiến độ mục tiêu] = TRUE ()
			                    && ( NOT _LocNam || Data[Năm ký quyết toán] IN _NamDaChon )
			                    && ( NOT _LocQuy || Data[Quý quyết toán] IN _QuyDaChon )
			                    && (
			                        NOT _LocNam
			                            || (
			                                VAR _TargetSort = Data[Năm mục tiêu] * 10 + IFERROR ( VALUE ( RIGHT ( Data[Quý mục tiêu], 1 ) ), 4 )
			                                RETURN ( Data[Năm mục tiêu] IN _NamDaChon && ( NOT _LocQuy || Data[Quý mục tiêu] IN _QuyDaChon ) )
			                                    || ( _TargetSort > _MaxSlicerSort )
			                            )
			                    )
			            ),
			            Data[Giá trị HĐ + PS gồm VAT số]
			        ),
			        REMOVEFILTERS ( Data[Năm mục tiêu] ),
			        REMOVEFILTERS ( Data[Quý mục tiêu] ),
			        REMOVEFILTERS ( Data[Kỳ mục tiêu] )
			    )
		formatString: #,##0
		displayFolder: Tracking quyết toán\04. Giá trị (Cột 11)
		lineageTag: 3f9001f2-2631-40d4-af61-f7c4daa7a373

	/// Ngày hết hạn hợp đồng dùng cho bảng chi tiết Công nợ dự án. Ưu tiên NGÀY HẾT HIỆU LỰC HĐ và dùng NGÀY HẾT HẠN THỰC HIỆN HĐ khi trường thứ nhất trống; làm sạch khoảng trắng và chỉ hiển thị tại cấp Số hợp đồng gốc.
	measure 'Ngày hết hạn HĐ (dòng)' =
			IF (
			    ISINSCOPE ( 'Data'[SỐ HỢP ĐỒNG CHÍNH] ),
			    VAR _ngayHetHieuLuc =
			        TRIM (
			            SUBSTITUTE (
			                COALESCE ( SELECTEDVALUE ( 'Data'[NGÀY HẾT HIỆU LỰC HĐ] ), "" ),
			                UNICHAR ( 160 ),
			                " "
			            )
			        )
			    VAR _ngayHetHanThucHien =
			        TRIM (
			            SUBSTITUTE (
			                COALESCE ( SELECTEDVALUE ( 'Data'[NGÀY HẾT HẠN THỰC HIỆN HĐ] ), "" ),
			                UNICHAR ( 160 ),
			                " "
			            )
			        )
			    RETURN
			        IF ( _ngayHetHieuLuc <> "", _ngayHetHieuLuc, _ngayHetHanThucHien )
			)
		formatString: @
		displayFolder: Công nợ\04. Hiển thị bảng
		lineageTag: 1ef395ba-c77e-492a-8ce6-c3286dfd18bc

	/// Đếm số khu vực có dữ liệu, loại dòng trống dùng cho các KPI card dự án.
	measure 'CNNT Số khu vực' = COALESCE ( CALCULATE ( DISTINCTCOUNT ( Data[KHU VỰC] ), KEEPFILTERS ( Data[KHU VỰC] <> BLANK () ), KEEPFILTERS ( Data[KHU VỰC] <> "" ) ), 0 )
		formatString: #,##0
		displayFolder: Công nợ theo nhà thầu
		lineageTag: 970e5f65-fa80-4996-85c2-2501f4865bae


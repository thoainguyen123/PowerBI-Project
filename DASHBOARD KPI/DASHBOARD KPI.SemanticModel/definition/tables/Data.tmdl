	partition Data = m
		mode: import
		source =
				let
				    NormalizeName = (Value as any) as text =>
				        Text.Upper(
				            Text.Remove(
				                Text.Clean(Text.Trim(Text.From(Value ?? ""))),
				                {" ", Character.FromNumber(160), "#(tab)", "#(cr)", "#(lf)"}
				            )
				        ),
				
				    PreserveMonetaryText = (InputValue as any) as nullable text =>
				        if InputValue = null then
				            null
				        else if Value.Is(InputValue, type number) then
				            Number.ToText(Number.From(InputValue), "0.################", "en-US")
				        else
				            Text.Trim(Text.From(InputValue)),
				
				    FindColumn = (InputTable as table, Candidates as list) as nullable text =>
				        let
				            ExistingColumns = Table.ColumnNames(InputTable),
				            MatchesByPriority =
				                List.Transform(
				                    Candidates,
				                    (Candidate) =>
				                        List.First(
				                            List.Select(
				                                ExistingColumns,
				                                (ColumnName) => NormalizeName(ColumnName) = NormalizeName(Candidate)
				                            ),
				                            null
				                        )
				                )
				        in
				            List.First(List.RemoveNulls(MatchesByPriority), null),
				
				    EnsureColumn = (InputTable as table, Target as text, Aliases as list) as table =>
				        let
				            SourceColumn = FindColumn(InputTable, List.Combine({{Target}, Aliases}))
				        in
				            if Table.HasColumns(InputTable, {Target}) then
				                InputTable
				            else if SourceColumn = null then
				                InputTable
				            else
				                Table.AddColumn(
				                    InputTable,
				                    Target,
				                    each Record.Field(_, SourceColumn),
				                    type any
				                ),
				
				    CanonicalMappings = {
				        {"SỐ HĐ SAP/SỐ HĐ CHÍNH", {"SỐ HĐ SAP/NGOÀI SAP"}},
				        {"SỐ HỢP ĐỒNG CHÍNH", {"SỐ HỢP ĐỒNG"}},

	/// Năm hoàn thành quyết toán, ưu tiên NGÀY DUYỆT CTCT và dự phòng ngày ký biên bản quyết toán.
	column 'Năm ký quyết toán' =
			VAR _NgayDuyet = TRIM ( COALESCE ( Data[NGÀY DUYỆT CTCT], "" ) )
			VAR _NgayKy = TRIM ( COALESCE ( Data[NGÀY KÝ BIÊN BẢN QUYẾT TOÁN], "" ) )
			VAR _s = SUBSTITUTE ( SUBSTITUTE ( IF ( _NgayDuyet <> "", _NgayDuyet, _NgayKy ), UNICHAR ( 10 ), "" ), UNICHAR ( 13 ), "" )
			VAR _dt = IFERROR ( DATEVALUE ( _s ), BLANK () )
			VAR _y = IFERROR ( VALUE ( RIGHT ( _s, 4 ) ), BLANK () )
			RETURN
			    IF ( NOT ISBLANK ( _dt ), YEAR ( _dt ), IF ( _y >= 2000 && _y <= 2100, _y ) )
		dataType: int64
		formatString: 0
		displayFolder: Phân loại
		lineageTag: b33b7ae4-56f5-4304-987f-1f5db32b828e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	/// Chuẩn hóa cột KPI QUYẾT TOÁN: Chứa "KPI" là "KPI đã đăng ký", chứa "NGOÀI" là "Đăng ký thêm".
	column 'Nhóm KPI quyết toán' =
			VAR _k =
			    UPPER ( TRIM ( COALESCE ( Data[KPI QUYẾT TOÁN], "" ) ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        CONTAINSSTRING ( _k, "KPI" ), "KPI đã đăng ký",
			        CONTAINSSTRING ( _k, "NGOÀI" ), "Đăng ký thêm",
			        _k = "", "Chưa phân loại",
			        "Khác"
			    )
		dataType: string
		displayFolder: Phân loại
		lineageTag: 0e849c2e-f70f-4b2c-ac89-712f1f619f8c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// GIÁ TRỊ WORKDONE(GỒM VAT) đã đổi sang kiểu số để tính tổng (cột gốc lưu dạng text).
	column 'Giá trị workdone gồm VAT' = IFERROR ( VALUE ( Data[GIÁ TRỊ WORKDONE(GỒM VAT)] ), BLANK () )
		dataType: double

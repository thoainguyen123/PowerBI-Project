/// Bảng dẫn xuất ghép bảo lãnh cũ với lần hiệu lực kế tiếp theo HĐ-PL-loại bảo lãnh.
table 'KPI GHBL'
	lineageTag: c3bc4b5e-8b1c-4759-88eb-0dbc9a8f51ac

	/// Số Bond theo từng dòng nguồn có tên ngân hàng Tạm ứng hoặc THHĐ. Một dòng có cả hai ngân hàng tính 2 Bond; không loại vì thiếu ngày hết hiệu lực. Áp dụng cùng bộ lọc với Đạt/Không đạt và điểm bình quân.
	measure 'GHBL Số cặp đánh giá' = COALESCE(COUNTROWS('KPI GHBL'),0)
		formatString: #,##0
		displayFolder: KPI
		lineageTag: 2c2075ae-da9d-459f-87d1-b243957cac2b

	/// Đếm mỗi bond có tên ngân hàng đạt 100%: bắt đầu mới < hạn cũ < hạn mới, hoặc bond đầu tiên của HĐ+PL+loại. Không xét tình trạng hiện tại.
	measure 'GHBL Đạt' = COALESCE(CALCULATE(COUNTROWS('KPI GHBL'),KEEPFILTERS('KPI GHBL'[ĐIỂM HOÀN THÀNH]=1)),0)
		formatString: #,##0
		displayFolder: KPI
		lineageTag: 73de653a-2e4f-4e59-a99f-41970a5401f1

	/// Đếm từng Bond có tên ngân hàng có điểm 0%, trên cùng tập dòng của Số lượng Bond. Đạt + Không đạt = Số lượng Bond trong cùng bộ lọc.
	measure 'GHBL Không đạt' = COALESCE(CALCULATE(COUNTROWS('KPI GHBL'),KEEPFILTERS('KPI GHBL'[ĐIỂM HOÀN THÀNH]=0)),0)
		formatString: #,##0
		displayFolder: KPI
		lineageTag: c3b1610c-c904-44ec-b50e-a4893f0c23eb

	/// Trung bình cộng điểm từng Bond có tên ngân hàng trong bộ lọc hiện tại, không tính trung bình theo PIC hoặc theo khóa HĐ+PL+loại.
	measure 'GHBL Điểm bình quân' = AVERAGE('KPI GHBL'[ĐIỂM HOÀN THÀNH])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: 03358b95-4200-4931-9c2e-8ea8283fa440

	/// Điểm từng Bond có tên ngân hàng; dòng tổng lấy trung bình cộng điểm tất cả Bond đang lọc.
	measure 'GHBL Điểm dòng' = AVERAGE('KPI GHBL'[ĐIỂM HOÀN THÀNH])
		formatString: 0.00%
		displayFolder: Chi tiết
		lineageTag: 320ca0a0-bdf5-4f18-99be-aa7d44a1991a


	partition 'KPI GHBL' = calculated
		mode: import
		source =
				VAR _TamUng =
				    SELECTCOLUMNS (
				        FILTER (
				            BaoLanh,
				            LEN ( TRIM ( SUBSTITUTE ( COALESCE ( BaoLanh[TÊN NGÂN HÀNG TẠM ỨNG], "" ), UNICHAR(160), " " ) ) ) > 0
				        ),
				        "Loại bảo lãnh", "Tạm ứng",
				        "Khóa HĐ-PL", COALESCE ( TRIM ( BaoLanh[SỐ HĐ CHÍNH] ), "Chưa có HĐ" ) & "|" & COALESCE ( TRIM ( BaoLanh[SỐ PLHĐ] ), "" ),
				        "Dòng nguồn", BaoLanh[Thứ tự dòng Excel],
				        "Số HĐ chính", BaoLanh[SỐ HĐ CHÍNH],
				        "Số PLHĐ", BaoLanh[SỐ PLHĐ],
				        "Dự án", COALESCE ( BaoLanh[TÊN VIẾT TẮT DỰ ÁN/ĐƠN VỊ], BaoLanh[DỰ ÁN], "Chưa xác định" ),
				        "Khu vực", COALESCE ( BaoLanh[KHU VỰC], "Chưa xác định" ),
				        "Nội dung HĐ", BaoLanh[NỘI DUNG HỢP ĐỒNG],
				        "Pháp nhân", BaoLanh[PHÁP NHÂN KÝ HĐ/PLHĐ],
				        "Giá trị HĐ+PS gồm VAT", IFERROR ( VALUE ( BaoLanh[GIÁ TRỊ HĐ+PS (GỒM VAT)] ), BLANK () ),
				        "Nhà thầu", BaoLanh[NT/NCC/TV ],
				        "Ngân hàng", BaoLanh[TÊN NGÂN HÀNG TẠM ỨNG],
				        "Ngày bắt đầu", BaoLanh[NGÀY BẮT ĐẦU HIỆU LỰC BẢO LÃNH TẠM ỨNG],
				        "Ngày hết hiệu lực", BaoLanh[NGÀY HẾT HIỆU LỰC TẠM ỨNG],
				        "Giá trị", BaoLanh[GIÁ TRỊ TẠM ỨNG],
				        "Cảnh báo", BaoLanh[CẢNH BÁO TẠM ỨNG],
				        "Tình trạng", BaoLanh[TÌNH TRẠNG TẠM ỨNG],
				        "PIC", BaoLanh[PIC THỰC HIỆN]
				    )
				VAR _THHD =
				    SELECTCOLUMNS (
				        FILTER (
				            BaoLanh,
				            LEN ( TRIM ( SUBSTITUTE ( COALESCE ( BaoLanh[TÊN NGÂN HÀNG THHĐ], "" ), UNICHAR(160), " " ) ) ) > 0
				        ),
				        "Loại bảo lãnh", "THHĐ",
				        "Khóa HĐ-PL", COALESCE ( TRIM ( BaoLanh[SỐ HĐ CHÍNH] ), "Chưa có HĐ" ) & "|" & COALESCE ( TRIM ( BaoLanh[SỐ PLHĐ] ), "" ),
				        "Dòng nguồn", BaoLanh[Thứ tự dòng Excel],
				        "Số HĐ chính", BaoLanh[SỐ HĐ CHÍNH],
				        "Số PLHĐ", BaoLanh[SỐ PLHĐ],
				        "Dự án", COALESCE ( BaoLanh[TÊN VIẾT TẮT DỰ ÁN/ĐƠN VỊ], BaoLanh[DỰ ÁN], "Chưa xác định" ),
				        "Khu vực", COALESCE ( BaoLanh[KHU VỰC], "Chưa xác định" ),
				        "Nội dung HĐ", BaoLanh[NỘI DUNG HỢP ĐỒNG],
				        "Pháp nhân", BaoLanh[PHÁP NHÂN KÝ HĐ/PLHĐ],
				        "Giá trị HĐ+PS gồm VAT", IFERROR ( VALUE ( BaoLanh[GIÁ TRỊ HĐ+PS (GỒM VAT)] ), BLANK () ),
				        "Nhà thầu", BaoLanh[NT/NCC/TV ],
				        "Ngân hàng", BaoLanh[TÊN NGÂN HÀNG THHĐ],
				        "Ngày bắt đầu", BaoLanh[NGÀY BẮT ĐẦU HIỆU LỰC BẢO LÃNH THHĐ],
				        "Ngày hết hiệu lực", BaoLanh[NGÀY HẾT HIỆU LỰC THHĐ],
				        "Giá trị", BaoLanh[GIÁ TRỊ THHĐ],
				        "Cảnh báo", BaoLanh[CẢNH BÁO THHĐ],
				        "Tình trạng", BaoLanh[TÌNH TRẠNG THHĐ],
				        "PIC", BaoLanh[PIC THỰC HIỆN]
				    )
				VAR _All = UNION(_TamUng, _THHD)
				// Order each contract/addendum/bond-type history by source expiry ascending.
				// Blank expiry goes last; original Excel row breaks ties without losing identity.
				VAR _Base =
				 ADDCOLUMNS(_All, "__Thứ tự Bond",
				  VAR _Key=[Khóa HĐ-PL]
				  VAR _Type=[Loại bảo lãnh]
				  VAR _End=[Ngày hết hiệu lực]
				  VAR _SourceRow=[Dòng nguồn]
				  RETURN 1 + COALESCE(COUNTROWS(FILTER(_All,
				   [Khóa HĐ-PL]=_Key && [Loại bảo lãnh]=_Type
				    && (
				     (NOT ISBLANK([Ngày hết hiệu lực]) && ISBLANK(_End))
				     || (NOT ISBLANK([Ngày hết hiệu lực]) && NOT ISBLANK(_End) && [Ngày hết hiệu lực]<_End)
				     || ([Ngày hết hiệu lực] == _End && [Dòng nguồn]<_SourceRow)
				    ))),0))
				VAR _WithOldEnd =
				 ADDCOLUMNS(_Base,"__Ngày hết cũ",
				  VAR _Key=[Khóa HĐ-PL]
				  VAR _Type=[Loại bảo lãnh]
				  VAR _Order=[__Thứ tự Bond]
				  VAR _PrevRow=MAXX(FILTER(_Base,[Khóa HĐ-PL]=_Key && [Loại bảo lãnh]=_Type && [__Thứ tự Bond]<_Order),[__Thứ tự Bond])
				  VAR _PrevEnd=MAXX(FILTER(_Base,[Khóa HĐ-PL]=_Key && [Loại bảo lãnh]=_Type && [__Thứ tự Bond]=_PrevRow),[Ngày hết hiệu lực])
				  RETURN IF(NOT ISBLANK(_PrevRow),_PrevEnd,COALESCE([Ngày bắt đầu],[Ngày hết hiệu lực])))
				RETURN SELECTCOLUMNS(_WithOldEnd,
				 "MÃ CẶP",[Khóa HĐ-PL]&"|"&[Loại bảo lãnh],
				 "MÃ LƯỢT",[Khóa HĐ-PL]&"|"&[Loại bảo lãnh]&"|"&FORMAT([Dòng nguồn],"0"),
				 "DÒNG NGUỒN",[Dòng nguồn],
				 "NỘI DUNG HỢP ĐỒNG",[Nội dung HĐ],
				 "PHÁP NHÂN",[Pháp nhân],
				 "GIÁ TRỊ HĐ+PS GỒM VAT",[Giá trị HĐ+PS gồm VAT],
				 "GIÁ TRỊ BẢO LÃNH",[Giá trị],
				 "LOẠI BẢO LÃNH",[Loại bảo lãnh],
				 "SỐ HỢP ĐỒNG",TRIM([Số HĐ chính]),
				 "SỐ PLHĐ",TRIM([Số PLHĐ]),
				 "DỰ ÁN",[Dự án],
				 "KHU VỰC",[Khu vực],
				 "NHÀ THẦU",[Nhà thầu],
				 "PIC",[PIC],
				 "NGÀY HẾT HẠN CŨ",[__Ngày hết cũ],
				 "NGÀY BẮT ĐẦU MỚI",[Ngày bắt đầu],
				 "NGÀY HẾT HẠN MỚI",[Ngày hết hiệu lực],
				 "TÌNH TRẠNG",TRIM(SUBSTITUTE(COALESCE([Tình trạng],""),UNICHAR(160)," ")),
				 "LÝ DO MIỄN",
				   VAR _Status=UPPER(COALESCE([Tình trạng],""))
				   RETURN IF(CONTAINSSTRING(_Status,"KHẤU TRỪ TẠM ỨNG") || CONTAINSSTRING(_Status,"MIỄN"),[Tình trạng],BLANK()),
				 "KỲ MỤC TIÊU",IF(ISBLANK([__Ngày hết cũ]),BLANK(),"Quý "&FORMAT([__Ngày hết cũ],"q")&" - "&FORMAT([__Ngày hết cũ],"yyyy")),
				 "KỲ MỤC TIÊU SORT",IF(ISBLANK([__Ngày hết cũ]),BLANK(),YEAR([__Ngày hết cũ])*10+QUARTER([__Ngày hết cũ])),
				 "NĂM MỤC TIÊU",IF(ISBLANK([__Ngày hết cũ]),BLANK(),YEAR([__Ngày hết cũ])),
				 "QUÝ MỤC TIÊU",IF(ISBLANK([__Ngày hết cũ]),BLANK(),"Quý "&FORMAT([__Ngày hết cũ],"q")),
				 "ĐIỂM HOÀN THÀNH",
				   VAR _Order=[__Thứ tự Bond]
				   VAR _OldEnd=[__Ngày hết cũ]
				   VAR _NewStart=[Ngày bắt đầu]
				   VAR _NewEnd=[Ngày hết hiệu lực]
				   VAR _DatePass=NOT ISBLANK(_OldEnd) && NOT ISBLANK(_NewStart) && NOT ISBLANK(_NewEnd)
				      && _OldEnd>_NewStart && _OldEnd<_NewEnd
				   VAR _FirstPass=_Order=1
				   RETURN IF(_DatePass || _FirstPass,1,0)
				)


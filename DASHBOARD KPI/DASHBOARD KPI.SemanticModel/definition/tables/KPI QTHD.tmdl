/// Bridge KPI quyết toán từ Data, tách một dòng cho từng PIC và giữ khóa hợp đồng để không đếm trùng ở cấp phòng.
table 'KPI QTHD'
	lineageTag: 0dae5e0d-f7e7-4bd0-9143-493eb97028f8

	measure 'QTHD Số hợp đồng' = DISTINCTCOUNT('KPI QTHD'[MÃ HỢP ĐỒNG])
		formatString: #,0
		displayFolder: KPI
		lineageTag: 9fe49bb7-4f69-47d6-b98d-c8c231456b65

	measure 'QTHD Số được chấm' = VAR _T = SUMMARIZE('KPI QTHD', 'KPI QTHD'[MÃ HỢP ĐỒNG], "_Score", MAX('KPI QTHD'[ĐIỂM HOÀN THÀNH])) RETURN COUNTROWS(FILTER(_T, NOT ISBLANK([_Score])))
		formatString: #,0
		displayFolder: KPI
		lineageTag: 803b4e68-c976-439f-97e7-a8a20bebaaff

	measure 'QTHD Đúng hạn' = VAR _T = SUMMARIZE('KPI QTHD', 'KPI QTHD'[MÃ HỢP ĐỒNG], "_Score", MAX('KPI QTHD'[ĐIỂM HOÀN THÀNH])) RETURN COUNTROWS(FILTER(_T, [_Score] >= 1))
		formatString: #,0
		displayFolder: KPI
		lineageTag: b63cdec2-61bc-4ead-8bff-af663b9908f0

	measure 'QTHD Không đạt' = VAR _T = SUMMARIZE('KPI QTHD', 'KPI QTHD'[MÃ HỢP ĐỒNG], "_Score", MAX('KPI QTHD'[ĐIỂM HOÀN THÀNH])) RETURN COUNTROWS(FILTER(_T, NOT ISBLANK([_Score]) && [_Score] < 1))
		formatString: #,0
		displayFolder: KPI
		lineageTag: 8ab771e0-56f1-4012-83ee-ace7ccc2bf7a

	measure 'QTHD Điểm bình quân' = VAR _T = SUMMARIZE('KPI QTHD', 'KPI QTHD'[MÃ HỢP ĐỒNG], "_Score", MAX('KPI QTHD'[ĐIỂM HOÀN THÀNH])) RETURN AVERAGEX(FILTER(_T, NOT ISBLANK([_Score])), [_Score])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: 51eec30a-1183-4833-b03a-c07e0190d36a

	measure 'QTHD Điểm dòng' = MAX('KPI QTHD'[ĐIỂM HOÀN THÀNH])
		formatString: 0.00%
		displayFolder: Chi tiết
		lineageTag: c756f2e3-ab02-4d82-90c7-f481e1c88d5b

	/// Số hợp đồng có ngày mục tiêu trong kỳ chọn và KPI quyết toán chứa KPI.
	measure 'QTHD KPI trong kỳ' =
			VAR _Selected = VALUES('DimDate'[Năm Quý Sort])
			RETURN CALCULATE(DISTINCTCOUNT('KPI QTHD'[MÃ HỢP ĐỒNG]), FILTER('KPI QTHD', 'KPI QTHD'[KỲ MỤC TIÊU SORT] IN _Selected && CONTAINSSTRING(UPPER(COALESCE('KPI QTHD'[KPI QUYẾT TOÁN], "")), "KPI")))
		formatString: #,##0
		displayFolder: KPI
		lineageTag: dd5bbcae-8e06-4b77-bd48-3acd43d7cd0f

	/// Số hợp đồng có ngày mục tiêu trong kỳ chọn và KPI quyết toán chứa NGOÀI.
	measure 'QTHD KPI bổ sung' =
			VAR _Selected = VALUES('DimDate'[Năm Quý Sort])
			RETURN CALCULATE(DISTINCTCOUNT('KPI QTHD'[MÃ HỢP ĐỒNG]), FILTER('KPI QTHD', 'KPI QTHD'[KỲ MỤC TIÊU SORT] IN _Selected && CONTAINSSTRING(UPPER(COALESCE('KPI QTHD'[KPI QUYẾT TOÁN], "")), "NGOÀI")))
		formatString: #,##0
		displayFolder: KPI
		lineageTag: 2aa7a965-efa1-4053-8daf-f51e7f1fedb6

	/// Mục tiêu và ngày duyệt đều thuộc toàn bộ kỳ slicer đang chọn, duyệt không trễ mục tiêu. Đếm duy nhất File + HĐ + PL.
	measure 'QTHD Hoàn thành đạt mục tiêu' =
			VAR _Selected = VALUES('DimDate'[Năm Quý Sort])
			VAR _MaxSelected = MAXX(_Selected,'DimDate'[Năm Quý Sort])
			RETURN CALCULATE(DISTINCTCOUNT('KPI QTHD'[MÃ HỢP ĐỒNG]),FILTER('KPI QTHD',VAR _Target = 'KPI QTHD'[NGÀY MỤC TIÊU] VAR _Done = 'KPI QTHD'[NGÀY HOÀN THÀNH]
			VAR _TargetKey = 'KPI QTHD'[KỲ MỤC TIÊU SORT]
			VAR _DoneKey = IF(NOT ISBLANK(_Done),YEAR(_Done)*10+QUARTER(_Done))
			RETURN NOT ISBLANK(_Target) && NOT ISBLANK(_Done) && _Done<=_Target && _TargetKey IN _Selected && _DoneKey IN _Selected))
		formatString: #,##0
		displayFolder: KPI
		lineageTag: 39629512-83aa-4724-bd1d-61909d3bceb7

	/// Ngày duyệt trong kỳ slicer, mục tiêu sau cuối kỳ đang chọn; đếm duy nhất File + HĐ + PL.
	measure 'QTHD Vượt mục tiêu' =
			VAR _Selected = VALUES('DimDate'[Năm Quý Sort])
			VAR _MaxSelected = MAXX(_Selected,'DimDate'[Năm Quý Sort])
			RETURN CALCULATE(DISTINCTCOUNT('KPI QTHD'[MÃ HỢP ĐỒNG]),FILTER('KPI QTHD',VAR _Target = 'KPI QTHD'[NGÀY MỤC TIÊU] VAR _Done = 'KPI QTHD'[NGÀY HOÀN THÀNH]
			VAR _TargetKey = 'KPI QTHD'[KỲ MỤC TIÊU SORT]
			VAR _DoneKey = IF(NOT ISBLANK(_Done),YEAR(_Done)*10+QUARTER(_Done))
			RETURN NOT ISBLANK(_Target) && NOT ISBLANK(_Done) && _Done<=_Target && _DoneKey IN _Selected && _TargetKey>_MaxSelected))
		formatString: #,##0
		displayFolder: KPI
		lineageTag: 25855cff-0f8d-455d-b0de-f1fc2fc32624

	/// Số hợp đồng hoàn thành đúng hạn trong quý mục tiêu hoặc vượt mục tiêu ở quý trước.
	measure 'QTHD Hoàn thành trong kỳ' = COALESCE([QTHD Hoàn thành đạt mục tiêu], 0) + COALESCE([QTHD Vượt mục tiêu], 0)
		formatString: #,##0
		displayFolder: KPI
		lineageTag: 0e60083a-d90e-48c6-85a4-57a41ba0f93a

	/// Số hợp đồng duyệt CTQT sau ngày mục tiêu, có ngày mục tiêu trong kỳ chọn.
	measure 'QTHD Hoàn thành trễ hạn' =
			VAR _Selected = VALUES('DimDate'[Năm Quý Sort])
			RETURN CALCULATE(DISTINCTCOUNT('KPI QTHD'[MÃ HỢP ĐỒNG]), FILTER('KPI QTHD', 'KPI QTHD'[KỲ MỤC TIÊU SORT] IN _Selected && NOT ISBLANK('KPI QTHD'[NGÀY HOÀN THÀNH]) && 'KPI QTHD'[NGÀY HOÀN THÀNH] > 'KPI QTHD'[NGÀY MỤC TIÊU]))
		formatString: #,##0
		displayFolder: KPI
		lineageTag: b7a02d7e-e481-4f70-b54b-018e21e26dbb

	/// Số hợp đồng có ngày mục tiêu trong kỳ chọn nhưng chưa duyệt CTQT.
	measure 'QTHD Chưa hoàn thành' =
			VAR _Selected = VALUES('DimDate'[Năm Quý Sort])
			RETURN CALCULATE(DISTINCTCOUNT('KPI QTHD'[MÃ HỢP ĐỒNG]), FILTER('KPI QTHD', 'KPI QTHD'[KỲ MỤC TIÊU SORT] IN _Selected && ISBLANK('KPI QTHD'[NGÀY HOÀN THÀNH])))
		formatString: #,##0
		displayFolder: KPI
		lineageTag: a0733f56-19c8-42c2-81d2-dbbab5c39fa8

	/// Lọc bảng chi tiết để gồm gói mục tiêu trong kỳ hoặc hoàn thành sớm trong kỳ.
	measure 'QTHD Hiển thị dòng' =
			VAR _Selected = VALUES('DimDate'[Năm Quý Sort])
			VAR _MaxSelected = MAXX(_Selected,'DimDate'[Năm Quý Sort])
			VAR _TargetKey=SELECTEDVALUE('KPI QTHD'[KỲ MỤC TIÊU SORT])
			VAR _Done=SELECTEDVALUE('KPI QTHD'[NGÀY HOÀN THÀNH])
			VAR _DoneKey=IF(NOT ISBLANK(_Done),YEAR(_Done)*10+QUARTER(_Done))
			RETURN IF(_TargetKey IN _Selected || (NOT ISBLANK(_Done) && _DoneKey IN _Selected && _TargetKey>_MaxSelected),1,0)
		formatString: #,##0
		displayFolder: KPI
		lineageTag: fe6d9b66-f816-48cb-80f4-c1b70a333a07

	/// Theo toàn bộ kỳ slicer: đạt hoặc vượt = 1; chưa duyệt hoặc duyệt trễ và mục tiêu trong kỳ = 0; thiếu mục tiêu hoặc hoàn thành trước kỳ = rỗng. Không chấm lặp PIC.
	measure 'QTHD Điểm gói' =
			VAR _Selected = VALUES('DimDate'[Năm Quý Sort])
			VAR _MaxSelected = MAXX(_Selected,'DimDate'[Năm Quý Sort])
			VAR _Target=SELECTEDVALUE('KPI QTHD'[NGÀY MỤC TIÊU])
			VAR _TargetKey=SELECTEDVALUE('KPI QTHD'[KỲ MỤC TIÊU SORT])
			VAR _Done=SELECTEDVALUE('KPI QTHD'[NGÀY HOÀN THÀNH])
			VAR _DoneKey=IF(NOT ISBLANK(_Done),YEAR(_Done)*10+QUARTER(_Done))
			RETURN IF(ISBLANK(_Target),BLANK(),IF(ISBLANK(_Done),IF(_TargetKey IN _Selected,0,BLANK()),IF(_Done<=_Target && _DoneKey IN _Selected && (_TargetKey IN _Selected || _TargetKey>_MaxSelected),1,IF(_TargetKey IN _Selected && _Done>_Target,0,BLANK()))))
		formatString: #,##0
		displayFolder: KPI
		lineageTag: f15e8401-06de-4ec6-8504-693b2383f191

	/// Tổng điểm gói quyết toán trong kỳ chọn; cộng một điểm mỗi hợp đồng hoàn thành đạt hoặc vượt mục tiêu.
	measure 'QTHD Tổng điểm' = SUMX(VALUES('KPI QTHD'[MÃ HỢP ĐỒNG]), [QTHD Điểm gói])
		formatString: #,##0
		displayFolder: KPI
		lineageTag: 69f2aac9-5e2b-437d-81d5-f6419259662d

	/// Số hợp đồng theo khu vực và tình trạng; gói vượt mục tiêu được ghi nhận vào quý hoàn thành, các trạng thái còn lại theo quý mục tiêu.
	measure 'QTHD Tình hình theo kỳ' = VAR _Selected = VALUES('DimDate'[Năm Quý Sort]) RETURN CALCULATE(DISTINCTCOUNT('KPI QTHD'[MÃ HỢP ĐỒNG]), FILTER('KPI QTHD', VAR _Done = 'KPI QTHD'[NGÀY HOÀN THÀNH] VAR _DoneKey = IF(NOT ISBLANK(_Done), YEAR(_Done)*10+QUARTER(_Done)) RETURN IF('KPI QTHD'[TÌNH TRẠNG QTHD] = "Vượt mục tiêu", _DoneKey IN _Selected, 'KPI QTHD'[KỲ MỤC TIÊU SORT] IN _Selected)))
		formatString: #,##0
		displayFolder: KPI
		lineageTag: bd4dc544-6522-4a86-bc45-d899941ea060

	/// Đếm mỗi mã hợp đồng một lần trong từng tình trạng, khu vực hoặc PIC; ngày mục tiêu thuộc các ngày được chọn trên slicer.
	measure 'QTHD Số hợp đồng theo tình trạng' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			RETURN CALCULATE(DISTINCTCOUNT('KPI QTHD'[MÃ HỢP ĐỒNG]), KEEPFILTERS(TREATAS(_SelectedDates,'KPI QTHD'[NGÀY MỤC TIÊU])))
		formatString: #,##0
		displayFolder: Biểu đồ
		lineageTag: e99d6408-fcae-41d7-a788-57b3ee764bc9

	/// Hợp đồng chưa có ngày duyệt CTQT, ngày mục tiêu thuộc kỳ chọn và tình trạng hợp đồng Hoàn thành - Cần quyết toán. Đếm mã hợp đồng duy nhất trong từng PIC.
	measure 'QTHD Tồn đọng chưa quyết toán' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			RETURN CALCULATE(DISTINCTCOUNT('KPI QTHD'[MÃ HỢP ĐỒNG]), KEEPFILTERS(TREATAS(_SelectedDates,'KPI QTHD'[NGÀY MỤC TIÊU])), KEEPFILTERS('KPI QTHD'[NGÀY HOÀN THÀNH] = BLANK()), KEEPFILTERS('KPI QTHD'[TÌNH TRẠNG HỢP ĐỒNG] = "Hoàn thành - Cần quyết toán"))
		formatString: #,##0
		displayFolder: Biểu đồ
		lineageTag: 1a92dedd-fbe4-4016-bd1c-666ed4dac26b

	/// Hoàn thành trong kỳ / KPI trong kỳ theo các bộ lọc hiện tại; giới hạn tối đa 120%. Mẫu số bằng 0 hoặc rỗng trả về rỗng.
	measure 'QTHD Điểm hoàn thành' =
			VAR _Ratio = DIVIDE([QTHD Hoàn thành trong kỳ], [QTHD KPI trong kỳ])
			RETURN IF(ISBLANK(_Ratio), BLANK(), MIN(_Ratio, 1.2))
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: a9c0ee2c-dee6-4ab5-9249-42d1a6cd7503


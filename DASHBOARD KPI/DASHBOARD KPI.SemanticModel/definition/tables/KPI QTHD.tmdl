	/// Phân loại hợp đồng theo ngày duyệt CTQT và ngày mục tiêu; vượt mục tiêu là hoàn thành ở quý trước quý mục tiêu.
	column 'TÌNH TRẠNG QTHD' = VAR _Target = 'KPI QTHD'[NGÀY MỤC TIÊU] VAR _Done = 'KPI QTHD'[NGÀY HOÀN THÀNH] VAR _TargetKey = YEAR(_Target)*10+QUARTER(_Target) VAR _DoneKey = YEAR(_Done)*10+QUARTER(_Done) RETURN SWITCH(TRUE(), ISBLANK(_Done), "Chưa hoàn thành", _Done > _Target, "Trễ hạn", _DoneKey < _TargetKey, "Vượt mục tiêu", "Đạt mục tiêu")
		dataType: string
		lineageTag: f1f4236c-4c42-461c-8578-60f605cb9a56
		summarizeBy: none

		annotation SummarizationSetBy = Automatic


	partition 'KPI QTHD' = calculated
		mode: import
		source =
					VAR _Base =
					    FILTER ( 'Data', NOT ISBLANK ( 'Data'[Ngày mục tiêu date] ) )
					VAR _XD =
					    SELECTCOLUMNS (
					        FILTER ( _Base, NOT ISBLANK ( 'Data'[PIC XÂY DỰNG/CUNG ỨNG] ) ),
					        "MÃ HỢP ĐỒNG", COALESCE('Data'[File],"") & "|" & COALESCE('Data'[SỐ HỢP ĐỒNG CHÍNH],"") & "|" & COALESCE('Data'[SỐ PLHĐ],""),
					        "DỰ ÁN", 'Data'[TÊN VIẾT TẮT DỰ ÁN],
					        "KHU VỰC", 'Data'[Khu vực chuẩn],
					        "SỐ HỢP ĐỒNG", 'Data'[SỐ HỢP ĐỒNG CHÍNH],
				        "NỘI DUNG", 'Data'[NỘI DUNG HỢP ĐỒNG],
				        "GIÁ TRỊ HĐ+PS GỒM VAT", 'Data'[Giá trị HĐ + PS gồm VAT số],
				        "BỘ MÔN", 'Data'[PHÂN LOẠI THEO BỘ MÔN],
				        "KPI QUYẾT TOÁN", 'Data'[KPI QUYẾT TOÁN],
				        "TÌNH TRẠNG QUYẾT TOÁN", 'Data'[Tình trạng quyết toán (chuẩn)],
				        "TÌNH TRẠNG HỢP ĐỒNG", 'Data'[TÌNH TRẠNG HỢP ĐỒNG],
				        "NHÀ THẦU", 'Data'[Nhà thầu chuẩn],
				        "PIC XÂY DỰNG/CUNG ỨNG", 'Data'[PIC XÂY DỰNG/CUNG ỨNG],
				        "PIC MEP", 'Data'[PIC MEP],
				        "PIC SITE1", 'Data'[PIC SITE1],
				        "PIC SITE2", 'Data'[PIC SITE2],
					        "PIC", 'Data'[PIC XÂY DỰNG/CUNG ỨNG],
					        "NHÓM PIC", "XD/CUNG ỨNG",
					        "NGÀY MỤC TIÊU", 'Data'[Ngày mục tiêu date],
					        "NGÀY HOÀN THÀNH", 'Data'[Ngày duyệt CTQT date],
					        "KỲ MỤC TIÊU", "Quý " & FORMAT('Data'[Ngày mục tiêu date],"q") & " - " & FORMAT('Data'[Ngày mục tiêu date],"yyyy"),
					        "KỲ MỤC TIÊU SORT", YEAR('Data'[Ngày mục tiêu date])*10+QUARTER('Data'[Ngày mục tiêu date]),
					        "NĂM MỤC TIÊU", 'Data'[Năm mục tiêu],
					        "QUÝ MỤC TIÊU", 'Data'[Quý mục tiêu]
					    )
					VAR _MEP =
					    SELECTCOLUMNS (
					        FILTER ( _Base, NOT ISBLANK ( 'Data'[PIC MEP] ) ),
					        "MÃ HỢP ĐỒNG", COALESCE('Data'[File],"") & "|" & COALESCE('Data'[SỐ HỢP ĐỒNG CHÍNH],"") & "|" & COALESCE('Data'[SỐ PLHĐ],""),
					        "DỰ ÁN", 'Data'[TÊN VIẾT TẮT DỰ ÁN], "KHU VỰC", 'Data'[Khu vực chuẩn], "SỐ HỢP ĐỒNG", 'Data'[SỐ HỢP ĐỒNG CHÍNH],
				        "NỘI DUNG", 'Data'[NỘI DUNG HỢP ĐỒNG], "GIÁ TRỊ HĐ+PS GỒM VAT", 'Data'[Giá trị HĐ + PS gồm VAT số], "BỘ MÔN", 'Data'[PHÂN LOẠI THEO BỘ MÔN],
				        "KPI QUYẾT TOÁN", 'Data'[KPI QUYẾT TOÁN],
				        "TÌNH TRẠNG QUYẾT TOÁN", 'Data'[Tình trạng quyết toán (chuẩn)],
				        "TÌNH TRẠNG HỢP ĐỒNG", 'Data'[TÌNH TRẠNG HỢP ĐỒNG],
				        "NHÀ THẦU", 'Data'[Nhà thầu chuẩn],
				        "PIC XÂY DỰNG/CUNG ỨNG", 'Data'[PIC XÂY DỰNG/CUNG ỨNG],
				        "PIC MEP", 'Data'[PIC MEP],
				        "PIC SITE1", 'Data'[PIC SITE1],
				        "PIC SITE2", 'Data'[PIC SITE2],
					        "PIC", 'Data'[PIC MEP], "NHÓM PIC", "MEP", "NGÀY MỤC TIÊU", 'Data'[Ngày mục tiêu date],
					        "NGÀY HOÀN THÀNH", 'Data'[Ngày duyệt CTQT date], "KỲ MỤC TIÊU", "Quý " & FORMAT('Data'[Ngày mục tiêu date],"q") & " - " & FORMAT('Data'[Ngày mục tiêu date],"yyyy"),
					        "KỲ MỤC TIÊU SORT", YEAR('Data'[Ngày mục tiêu date])*10+QUARTER('Data'[Ngày mục tiêu date]),
					        "NĂM MỤC TIÊU", 'Data'[Năm mục tiêu], "QUÝ MỤC TIÊU", 'Data'[Quý mục tiêu]
					    )
					VAR _SITE1 =
					    SELECTCOLUMNS (
					        FILTER ( _Base, NOT ISBLANK ( 'Data'[PIC SITE1] ) ),
					        "MÃ HỢP ĐỒNG", COALESCE('Data'[File],"") & "|" & COALESCE('Data'[SỐ HỢP ĐỒNG CHÍNH],"") & "|" & COALESCE('Data'[SỐ PLHĐ],""),
					        "DỰ ÁN", 'Data'[TÊN VIẾT TẮT DỰ ÁN], "KHU VỰC", 'Data'[Khu vực chuẩn], "SỐ HỢP ĐỒNG", 'Data'[SỐ HỢP ĐỒNG CHÍNH],
				        "NỘI DUNG", 'Data'[NỘI DUNG HỢP ĐỒNG], "GIÁ TRỊ HĐ+PS GỒM VAT", 'Data'[Giá trị HĐ + PS gồm VAT số], "BỘ MÔN", 'Data'[PHÂN LOẠI THEO BỘ MÔN],
				        "KPI QUYẾT TOÁN", 'Data'[KPI QUYẾT TOÁN],
				        "TÌNH TRẠNG QUYẾT TOÁN", 'Data'[Tình trạng quyết toán (chuẩn)],
				        "TÌNH TRẠNG HỢP ĐỒNG", 'Data'[TÌNH TRẠNG HỢP ĐỒNG],
				        "NHÀ THẦU", 'Data'[Nhà thầu chuẩn],
				        "PIC XÂY DỰNG/CUNG ỨNG", 'Data'[PIC XÂY DỰNG/CUNG ỨNG],
				        "PIC MEP", 'Data'[PIC MEP],
				        "PIC SITE1", 'Data'[PIC SITE1],
				        "PIC SITE2", 'Data'[PIC SITE2],
					        "PIC", 'Data'[PIC SITE1], "NHÓM PIC", "SITE1", "NGÀY MỤC TIÊU", 'Data'[Ngày mục tiêu date],
					        "NGÀY HOÀN THÀNH", 'Data'[Ngày duyệt CTQT date], "KỲ MỤC TIÊU", "Quý " & FORMAT('Data'[Ngày mục tiêu date],"q") & " - " & FORMAT('Data'[Ngày mục tiêu date],"yyyy"),
					        "KỲ MỤC TIÊU SORT", YEAR('Data'[Ngày mục tiêu date])*10+QUARTER('Data'[Ngày mục tiêu date]),
					        "NĂM MỤC TIÊU", 'Data'[Năm mục tiêu], "QUÝ MỤC TIÊU", 'Data'[Quý mục tiêu]
					    )
					VAR _SITE2 =
					    SELECTCOLUMNS (
					        FILTER ( _Base, NOT ISBLANK ( 'Data'[PIC SITE2] ) ),
					        "MÃ HỢP ĐỒNG", COALESCE('Data'[File],"") & "|" & COALESCE('Data'[SỐ HỢP ĐỒNG CHÍNH],"") & "|" & COALESCE('Data'[SỐ PLHĐ],""),
					        "DỰ ÁN", 'Data'[TÊN VIẾT TẮT DỰ ÁN], "KHU VỰC", 'Data'[Khu vực chuẩn], "SỐ HỢP ĐỒNG", 'Data'[SỐ HỢP ĐỒNG CHÍNH],
				        "NỘI DUNG", 'Data'[NỘI DUNG HỢP ĐỒNG], "GIÁ TRỊ HĐ+PS GỒM VAT", 'Data'[Giá trị HĐ + PS gồm VAT số], "BỘ MÔN", 'Data'[PHÂN LOẠI THEO BỘ MÔN],
				        "KPI QUYẾT TOÁN", 'Data'[KPI QUYẾT TOÁN],
				        "TÌNH TRẠNG QUYẾT TOÁN", 'Data'[Tình trạng quyết toán (chuẩn)],
				        "TÌNH TRẠNG HỢP ĐỒNG", 'Data'[TÌNH TRẠNG HỢP ĐỒNG],
				        "NHÀ THẦU", 'Data'[Nhà thầu chuẩn],
				        "PIC XÂY DỰNG/CUNG ỨNG", 'Data'[PIC XÂY DỰNG/CUNG ỨNG],
				        "PIC MEP", 'Data'[PIC MEP],
				        "PIC SITE1", 'Data'[PIC SITE1],
				        "PIC SITE2", 'Data'[PIC SITE2],
					        "PIC", 'Data'[PIC SITE2], "NHÓM PIC", "SITE2", "NGÀY MỤC TIÊU", 'Data'[Ngày mục tiêu date],
					        "NGÀY HOÀN THÀNH", 'Data'[Ngày duyệt CTQT date], "KỲ MỤC TIÊU", "Quý " & FORMAT('Data'[Ngày mục tiêu date],"q") & " - " & FORMAT('Data'[Ngày mục tiêu date],"yyyy"),
					        "KỲ MỤC TIÊU SORT", YEAR('Data'[Ngày mục tiêu date])*10+QUARTER('Data'[Ngày mục tiêu date]),
					        "NĂM MỤC TIÊU", 'Data'[Năm mục tiêu], "QUÝ MỤC TIÊU", 'Data'[Quý mục tiêu]
					    )
					VAR _Unassigned =
					    SELECTCOLUMNS (
					        FILTER ( _Base, ISBLANK('Data'[PIC XÂY DỰNG/CUNG ỨNG]) && ISBLANK('Data'[PIC MEP]) && ISBLANK('Data'[PIC SITE1]) && ISBLANK('Data'[PIC SITE2]) ),
					        "MÃ HỢP ĐỒNG", COALESCE('Data'[File],"") & "|" & COALESCE('Data'[SỐ HỢP ĐỒNG CHÍNH],"") & "|" & COALESCE('Data'[SỐ PLHĐ],""),
					        "DỰ ÁN", 'Data'[TÊN VIẾT TẮT DỰ ÁN], "KHU VỰC", 'Data'[Khu vực chuẩn], "SỐ HỢP ĐỒNG", 'Data'[SỐ HỢP ĐỒNG CHÍNH],
				        "NỘI DUNG", 'Data'[NỘI DUNG HỢP ĐỒNG], "GIÁ TRỊ HĐ+PS GỒM VAT", 'Data'[Giá trị HĐ + PS gồm VAT số], "BỘ MÔN", 'Data'[PHÂN LOẠI THEO BỘ MÔN],
				        "KPI QUYẾT TOÁN", 'Data'[KPI QUYẾT TOÁN],
				        "TÌNH TRẠNG QUYẾT TOÁN", 'Data'[Tình trạng quyết toán (chuẩn)],
				        "TÌNH TRẠNG HỢP ĐỒNG", 'Data'[TÌNH TRẠNG HỢP ĐỒNG],
				        "NHÀ THẦU", 'Data'[Nhà thầu chuẩn],
				        "PIC XÂY DỰNG/CUNG ỨNG", 'Data'[PIC XÂY DỰNG/CUNG ỨNG],
				        "PIC MEP", 'Data'[PIC MEP],
				        "PIC SITE1", 'Data'[PIC SITE1],
				        "PIC SITE2", 'Data'[PIC SITE2],
					        "PIC", BLANK(), "NHÓM PIC", "CHƯA PHÂN CÔNG", "NGÀY MỤC TIÊU", 'Data'[Ngày mục tiêu date],
					        "NGÀY HOÀN THÀNH", 'Data'[Ngày duyệt CTQT date], "KỲ MỤC TIÊU", "Quý " & FORMAT('Data'[Ngày mục tiêu date],"q") & " - " & FORMAT('Data'[Ngày mục tiêu date],"yyyy"),
					        "KỲ MỤC TIÊU SORT", YEAR('Data'[Ngày mục tiêu date])*10+QUARTER('Data'[Ngày mục tiêu date]),
					        "NĂM MỤC TIÊU", 'Data'[Năm mục tiêu], "QUÝ MỤC TIÊU", 'Data'[Quý mục tiêu]
					    )
					VAR _Rows = UNION(_XD,_MEP,_SITE1,_SITE2,_Unassigned)
					RETURN
					    ADDCOLUMNS(_Rows,"ĐIỂM HOÀN THÀNH",IF(ISBLANK([NGÀY HOÀN THÀNH]),0,IF([NGÀY HOÀN THÀNH]<=[NGÀY MỤC TIÊU],1,0)))


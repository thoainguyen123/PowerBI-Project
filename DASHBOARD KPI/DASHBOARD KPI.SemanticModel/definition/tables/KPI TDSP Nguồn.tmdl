/// Nguồn SharePoint PL SWAP; bảng nguồn chuẩn hóa phục vụ bốn trang KPI mới. Giữ từng dòng gốc và các giá trị rỗng; chưa có quan hệ hay công thức chấm điểm.
table 'KPI TDSP Nguồn'
	lineageTag: 07ccf590-e318-4ee2-9971-ed762a6efd04

	/// Quý/năm hoàn thành suy ra ngày ký VBTT/HĐMB cấn trừ vì nguồn PL SWAP chưa có cột quý/năm riêng.
	measure 'TDSP Dòng thuộc kỳ' =
			VAR _Dates=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _Done=MAX('KPI TDSP Nguồn'[Ngày ký cấn trừ])
			RETURN IF(NOT ISFILTERED('Kỳ đánh giá đấu thầu') || (NOT ISBLANK(_Done) && _Done IN _Dates),1,BLANK())
		formatString: 0
		displayFolder: Bổ sung KPI
		lineageTag: f9429d9a-fb04-4619-93cf-d541501c4cb0

	measure 'TDSP Số dòng' = COUNTROWS(FILTER(VALUES('KPI TDSP Nguồn'[Dòng nguồn]),[TDSP Dòng thuộc kỳ]=1))
		formatString: #,##0
		displayFolder: Bổ sung KPI
		lineageTag: dcdb930b-0305-4c79-8462-ddb319d720e6

	/// Cộng theo dòng nguồn thuộc kỳ, không cộng lại theo PIC.
	measure 'TDSP Công nợ tỷ đồng' = VAR _Amount=SUMX(FILTER(VALUES('KPI TDSP Nguồn'[Dòng nguồn]),[TDSP Dòng thuộc kỳ]=1),CALCULATE(MAX('KPI TDSP Nguồn'[Giá trị công nợ cấn trừ giãn nợ]))) RETURN DIVIDE(CONVERT(_Amount,DOUBLE),1000000000)
		formatString: #,##0.00
		displayFolder: Bổ sung KPI
		lineageTag: 70f4646a-8995-425e-ae9d-c67708f731df

	/// Cộng theo dòng nguồn thuộc kỳ, không cộng lại theo PIC.
	measure 'TDSP BĐS tỷ đồng' = VAR _Amount=SUMX(FILTER(VALUES('KPI TDSP Nguồn'[Dòng nguồn]),[TDSP Dòng thuộc kỳ]=1),CALCULATE(MAX('KPI TDSP Nguồn'[Tổng giá trị BĐS]))) RETURN DIVIDE(CONVERT(_Amount,DOUBLE),1000000000)
		formatString: #,##0.00
		displayFolder: Bổ sung KPI
		lineageTag: d434fecf-a496-4557-a989-60f0c8f785b9

	/// Cộng theo dòng nguồn thuộc kỳ, không cộng lại theo PIC.
	measure 'TDSP Tổng số căn' = SUMX(FILTER(VALUES('KPI TDSP Nguồn'[Dòng nguồn]),[TDSP Dòng thuộc kỳ]=1),DIVIDE(CALCULATE(MAX('KPI TDSP Nguồn'[Số căn])),1))
		formatString: #,##0
		displayFolder: Bổ sung KPI
		lineageTag: bb30448f-e662-4675-a29f-ed68354070e2

	measure 'TDSP Quý hoàn thành' = IF(ISINSCOPE('KPI TDSP Nguồn'[STT]) && [TDSP Dòng thuộc kỳ]=1,VAR _D=MAX('KPI TDSP Nguồn'[Ngày ký cấn trừ]) RETURN IF(NOT ISBLANK(_D),"Q"&FORMAT(QUARTER(_D),"0")))
		displayFolder: Bổ sung KPI
		lineageTag: 4f414ae8-6e59-4ede-b6ab-8621e69a60b4

	measure 'TDSP Năm hoàn thành' = IF(ISINSCOPE('KPI TDSP Nguồn'[STT]) && [TDSP Dòng thuộc kỳ]=1,YEAR(MAX('KPI TDSP Nguồn'[Ngày ký cấn trừ])))
		formatString: 0
		displayFolder: Bổ sung KPI
		lineageTag: 64abcbb8-f7ca-4657-986f-a94cc4790f28

	measure 'TDSP Lưới Tình trạng' = IF(ISINSCOPE('KPI TDSP Nguồn'[STT]) && [TDSP Dòng thuộc kỳ]=1,SELECTEDVALUE('KPI TDSP Nguồn'[Tình trạng]))
		displayFolder: Lưới Excel
		lineageTag: b532b919-a520-499a-8fc7-dad47a820f8c

	measure 'TDSP Lưới Dự án BĐS' = IF(ISINSCOPE('KPI TDSP Nguồn'[STT]) && [TDSP Dòng thuộc kỳ]=1,SELECTEDVALUE('KPI TDSP Nguồn'[Dự án BĐS]))
		displayFolder: Lưới Excel
		lineageTag: 34de29f2-ea38-44ce-ab52-3aab216a0ac0

	measure 'TDSP Lưới Nhà thầu' = IF(ISINSCOPE('KPI TDSP Nguồn'[STT]) && [TDSP Dòng thuộc kỳ]=1,SELECTEDVALUE('KPI TDSP Nguồn'[Nhà thầu]))
		displayFolder: Lưới Excel
		lineageTag: eadab0c2-d1fa-4897-9957-d39dcdd4409d

	measure 'TDSP Lưới Ngày ký cấn trừ' = IF(ISINSCOPE('KPI TDSP Nguồn'[STT]) && [TDSP Dòng thuộc kỳ]=1,SELECTEDVALUE('KPI TDSP Nguồn'[Ngày ký cấn trừ]))
		formatString: dd/MM/yyyy
		displayFolder: Lưới Excel
		lineageTag: 0c69f495-c4ef-4acf-80bf-c92210879e9e

	measure 'TDSP Lưới Link minh chứng' = IF(ISINSCOPE('KPI TDSP Nguồn'[STT]) && [TDSP Dòng thuộc kỳ]=1,SELECTEDVALUE('KPI TDSP Nguồn'[Link minh chứng]))
		displayFolder: Lưới Excel
		lineageTag: 3cf86c4b-4a14-4315-9b84-cc921d90cf88

	measure 'TDSP Lưới PIC' = IF(ISINSCOPE('KPI TDSP Nguồn'[STT]) && [TDSP Dòng thuộc kỳ]=1,SELECTEDVALUE('KPI TDSP Nguồn'[PIC]))
		displayFolder: Lưới Excel
		lineageTag: 232145af-d038-4609-8975-a51087b9eb78

	measure 'TDSP Lưới Phòng' = IF(ISINSCOPE('KPI TDSP Nguồn'[STT]) && [TDSP Dòng thuộc kỳ]=1,SELECTEDVALUE('KPI TDSP Nguồn'[Phòng]))
		displayFolder: Lưới Excel
		lineageTag: 646cde41-2d90-4f44-b42f-66e4703104c3

	measure 'TDSP Lưới PIC TP' = IF(ISINSCOPE('KPI TDSP Nguồn'[STT]) && [TDSP Dòng thuộc kỳ]=1,SELECTEDVALUE('KPI TDSP Nguồn'[PIC TP]))
		displayFolder: Lưới Excel
		lineageTag: bf3665a3-78f6-40dd-9d23-9a35fe71eb89

	measure 'TDSP Lưới HRBP Note' = IF(ISINSCOPE('KPI TDSP Nguồn'[STT]) && [TDSP Dòng thuộc kỳ]=1,SELECTEDVALUE('KPI TDSP Nguồn'[HRBP Note]))
		displayFolder: Lưới Excel
		lineageTag: 6c15064d-aa2c-4655-951a-23eac6b296a4


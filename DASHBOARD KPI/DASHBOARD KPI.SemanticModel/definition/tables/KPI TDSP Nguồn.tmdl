	partition 'KPI TDSP Nguồn' = m
		mode: import
		source =
				let
				    URL = "https://novaland.sharepoint.com/sites/PRT/_api/web/GetFileById(guid'D4FA6E74-1B84-40F9-BBC6-E5A2BA0586C6')/$value",
				    Norm = (v as any) as text => Text.Upper(Text.Remove(Text.Clean(Text.From(v ?? "")), {" ", "_", Character.FromNumber(160), "#(lf)", "#(cr)", "#(tab)"})),
				    Workbook = Excel.Workbook(Web.Contents(URL), null, true),
				    Sheets = Table.SelectRows(Workbook, each [Kind] = "Sheet" and Norm([Item]) = "PLSWAP"),
				    Raw = if Table.RowCount(Sheets) = 1 then Sheets{0}[Data] else error "Không xác định được sheet PL SWAP / PL_SWAP",
				    HeaderIndex = List.PositionOf(List.Transform(Table.ToRows(Table.FirstN(Raw, 30)), each Norm(_{0}) = "STT"), true),
				    Header = if HeaderIndex >= 0 then Table.ToRows(Raw){HeaderIndex} else error "Không tìm thấy tiêu đề STT của PL SWAP",
				    Names = List.Transform(Header, each Norm(_)),
				    Body = Table.Skip(Raw, HeaderIndex + 1),
				    SourceNames = Table.ColumnNames(Raw),
				    Column = (aliases as list, isOptional as logical) as list =>
				        let Hits = List.Select(List.Positions(Names), (i) => List.Contains(List.Transform(aliases, each Norm(_)), Names{i}))
				        in if List.Count(Hits) = 1 then Table.Column(Body, SourceNames{Hits{0}})
				           else if List.Count(Hits) = 0 and isOptional then List.Repeat({null}, Table.RowCount(Body))
				           else error ("Không xác định duy nhất cột PL SWAP: " & Text.Combine(aliases, " / ")),
				    Mapping = {
				        {"STT", {"STT"}, false},
				        {"Tình trạng", {"Tình trạng"}, false},
				        {"Dự án BĐS", {"Dự án BĐS/ Dịch vụ", "Dự án BĐS"}, false},
				        {"Nhà thầu", {"Nhà thầu"}, false},
				        {"Ngày ký cấn trừ", {"Ngày ký VBTT/HĐMB cấn trừ", "Ngày ký cấn trừ"}, false},
				        {"Số căn", {"Số căn"}, false},
				        {"Tổng giá trị BĐS", {"Tổng GT BĐS (VND)", "Tổng giá trị BĐS"}, false},
				        {"Giá trị công nợ cấn trừ giãn nợ", {"GT Công nợ cấn trừ / giãn nợ (VND)", "Giá trị công nợ cấn trừ giãn nợ"}, false},
				        {"Link minh chứng", {"Link minh chứng"}, true},
				        {"PIC", {"Link minh chứng/PIC (người thực hiện)", "PIC"}, false},
				        {"Phòng", {"BP", "Phòng"}, false},
				        {"PIC TP", {"PIC/TP", "PIC TP"}, false},
				        {"HRBP Note", {"HRBP NOTE"}, true}
				    },
				    Projected = Table.FromColumns(
				        List.Combine({List.Transform(Mapping, each Column(_{1}, _{2})), {List.Numbers(HeaderIndex + 2, Table.RowCount(Body))}}),
				        List.Combine({List.Transform(Mapping, each _{0}), {"Dòng nguồn"}})
				    ),
				    Selected = Table.SelectRows(Projected, each (try Number.From([STT]) otherwise null) <> null and Norm([Nhà thầu]) <> ""),
				    Txt = (v as any) as nullable text => if v = null then null else Text.Trim(Text.From(v)),
				    Num = (v as any) as nullable number => if v = null or Text.Trim(Text.From(v)) = "" then null else try Number.From(v, "en-US") otherwise null,
				    Dt = (v as any) as nullable date => if v = null or Text.Trim(Text.From(v)) = "" then null else if Value.Is(v, type text) then try Date.FromText(Text.Trim(v), [Culture="en-GB"]) otherwise null else try Date.From(v) otherwise null,
				    Converted = Table.TransformColumns(Selected, {
				        {"STT", Num, Int64.Type}, {"Tình trạng", Txt, type text}, {"Dự án BĐS", Txt, type text},
				        {"Nhà thầu", Txt, type text}, {"Ngày ký cấn trừ", Dt, type date}, {"Số căn", Num, Int64.Type},
				        {"Tổng giá trị BĐS", Num, type number}, {"Giá trị công nợ cấn trừ giãn nợ", Num, type number},
				        {"Link minh chứng", Txt, type text}, {"PIC", Txt, type text}, {"Phòng", Txt, type text},
				        {"PIC TP", Txt, type text}, {"HRBP Note", Txt, type text}, {"Dòng nguồn", Num, Int64.Type}
				    })
				in
				    Converted


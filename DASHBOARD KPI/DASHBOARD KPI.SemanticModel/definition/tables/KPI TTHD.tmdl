	column 'DÒNG NGUỒN'
		dataType: int64
		isHidden
		lineageTag: 3f38c2b0-194a-4cbb-a717-cd209a288888
		summarizeBy: none
		sourceColumn: DÒNG NGUỒN

	partition 'KPI TTHD' = m
		mode: import
		source = ```
				let
				    Normalize = (v as any) as text => Text.Upper(Text.Remove(Text.Clean(Text.Trim(Text.From(v ?? ""))), {" ", Character.FromNumber(160), "#(tab)", "#(cr)", "#(lf)"})),
				    FileKey = (v as text) as text => Normalize(Text.TrimEnd(Text.BeforeDelimiter(v,".xlsx"),".")),
				    ToText = (v as any) as nullable text => if v=null then null else Text.Combine(List.Select(Text.Split(Text.Trim(Text.Clean(Text.Replace(Text.From(v),Character.FromNumber(160)," ")))," "),each _<>"")," "),
				    ToDate = (v as any) as nullable date => let d=try Date.From(v) otherwise null in if d=null or d<#date(2000,1,1) then null else d,
				    FindColumn = (t as table, names as list) as nullable text => List.First(List.RemoveNulls(List.Transform(names,(n)=>List.First(List.Select(Table.ColumnNames(t),(c)=>Normalize(c)=Normalize(n)),null))),null),
				    Expected = {
				        "THEO DOI HD KV BINH THUAN CON LAI.xlsx",
				        "THEO DOI HD KV HCM (23DA).xlsx",
				        "THEO DOI HD KV HO TRAM (23DA).xlsx",
				        "THEO DOI HD KV KHAC.xlsx",
				        "THEO DOI HD KV DONG NAI (23DA).xlsx",
				        "THEO DOI HD KV HCM CON LAI.xlsx",
				        "THEO DOI HD KV BINH THUAN 1.xlsx",
				        "THEO DOI CONG NO CHI PHI HOAT DONG.xlsx"
				    },
				    Source=SharePoint.Contents("https://novaland.sharepoint.com/sites/PRT",[ApiVersion=15]),
				    Documents=Source{[Name="Documents"]}[Content],
				    Folder=Documents{[Name="PRC"]}[Content]{[Name="00. NovaGen"]}[Content]{[Name="07. Các nghiệp vụ"]}[Content]{[Name="05. PAS"]}[Content]{[Name="01. THEO DOI HD & CPC"]}[Content],
				    ExcelFiles=Table.SelectRows(Folder,each [Extension]<>null and Text.Lower([Extension])=".xlsx" and not Text.StartsWith([Name],"~$")),
				    // Match the eight approved files only. A trailing extra dot is tolerated; old-project files are excluded.
				    Approved=List.Transform(Expected,(name)=>let matches=Table.SelectRows(ExcelFiles,each FileKey(Text.Lower([Name]))=FileKey(Text.Lower(name))) in
				        if Table.RowCount(matches)<>1 then error Error.Record("TTHD source", "Phải tìm thấy đúng một file: "&name,[Count=Table.RowCount(matches)]) else matches{0}),
				    ReadFile = (file as record) as table =>
				        let
				            IsOpex=FileKey(Text.Lower(file[Name]))=FileKey(Text.Lower(Expected{7})),
				            Sheet=if IsOpex then "CHI TIET CONG NO" else "THEO DÕI CPC",
				            Workbook=Excel.Workbook(file[Content],null,true),
				            Matching=Table.SelectRows(Workbook,each [Kind]="Sheet" and Normalize([Item])=Normalize(Sheet)),
				            Raw=if Table.RowCount(Matching)<>1 then error Error.Record("TTHD sheet",file[Name]&": thiếu sheet "&Sheet,null) else Matching{0}[Data],
				            Safe=Table.ReplaceErrorValues(Raw,List.Transform(Table.ColumnNames(Raw),each {_,null})),
				            HeaderIndex=List.PositionOf(List.Transform(Table.ToRows(Safe),each List.Contains(List.Transform(_,Normalize),"STT")),true),
				            Promoted=if HeaderIndex<0 then error Error.Record("TTHD header",file[Name]&": không tìm thấy dòng tiêu đề STT",null) else Table.PromoteHeaders(Table.Skip(Safe,HeaderIndex),[PromoteAllScalars=true]),
				            Mappings={
				                {"DỰ ÁN",if IsOpex then {"TÊN DỰ ÁN/ĐỊA CHỈ SỬ DỤNG"} else {"TÊN VIẾT TẮT DỰ ÁN"}},
				                {"KHU VỰC",{"KHU VỰC"}},
				                {"SỐ HỢP ĐỒNG",{"SỐ HỢP ĐỒNG","SỐ HỢP ĐỒNG CHÍNH","SỐ HĐ CHÍNH","SỐ HỢP ĐỒNG GỐC"}},
				                {"NHÀ THẦU",{"NT/NCC/TV","TÊN NHÀ THẦU","NHÀ THẦU","NHÀ CUNG CẤP"}},
				                {"NỘI DUNG",if IsOpex then {"NỘI DUNG THANH TOÁN"} else {"NỘI DUNG TT"}},
				                {"NGÀY NHẬN HS",if IsOpex then {"NGÀY NHẬN HSTT"} else {"NGÀY NHẬN HS TQT TẠI PAS HO"}},
				                {"NGÀY HOÀN THÀNH",{"NGÀY PHÁT HÀNH","NGÀY PHÁT HÀNH CPC"}},
				                {"PIC XÂY DỰNG/CUNG ỨNG",if IsOpex then {"PAYMENT PIC"} else {"PIC XÂY DỰNG/CUNG ỨNG","PIC XÂY DỰNG","PIC CUNG ỨNG"}},
				                {"PIC MEP",{"PIC MEP"}},
				                {"PIC SITE1",{"PIC SITE1","PIC SITE 1"}},
				                {"PIC SITE2",{"PIC SITE12","PIC SITE2","PIC SITE 2"}}
				            },
				            Required={"DỰ ÁN","SỐ HỢP ĐỒNG","NỘI DUNG","NGÀY NHẬN HS","NGÀY HOÀN THÀNH","PIC XÂY DỰNG/CUNG ỨNG"},
				            Projected=Table.FromColumns(List.Transform(Mappings,(m)=>let col=FindColumn(Promoted,m{1}) in if col=null and List.Contains(Required,m{0}) then error Error.Record("TTHD column",file[Name]&": thiếu "&Text.Combine(m{1}," / "),[Headers=Table.ColumnNames(Promoted)]) else if col=null then List.Repeat({null},Table.RowCount(Promoted)) else Table.Column(Promoted,col)),List.Transform(Mappings,each _{0})),
				            WithRegion=if IsOpex then Table.TransformColumns(Projected,{{"KHU VỰC",each "OPEX",type text}}) else Projected,
				            WithFile=Table.AddColumn(WithRegion,"FILE",each file[Name],type text),
				            Indexed=Table.AddIndexColumn(WithFile,"DÒNG FILE",1,1,Int64.Type),
				            Valid=Table.SelectRows(Indexed,each let contract=Normalize([SỐ HỢP ĐỒNG]) in contract<>"" and not List.Contains({"SỐHỢPĐỒNG","SỐHỢPĐỒNGCHÍNH","TOTAL","TỔNGCỘNG"},contract)),
				            Key=Table.AddColumn(Valid,"MÃ HỒ SƠ",each file[Name]&"|"&Text.From([DÒNG FILE]),type text)
				        in Key,
				    Combined=Table.Combine(List.Transform(Approved,ReadFile)),
				    TextColumns={"DỰ ÁN","KHU VỰC","SỐ HỢP ĐỒNG","NHÀ THẦU","NỘI DUNG","PIC XÂY DỰNG/CUNG ỨNG","PIC MEP","PIC SITE1","PIC SITE2"},
				    TextTyped=Table.TransformColumns(Combined,List.Transform(TextColumns,each {_,ToText,type text})),
				    Typed=Table.TransformColumns(TextTyped,{{"NGÀY NHẬN HS",ToDate,type date},{"NGÀY HOÀN THÀNH",ToDate,type date}}),
				    Indexed=Table.AddIndexColumn(Typed,"DÒNG NGUỒN",1,1,Int64.Type),
				    Target=Table.AddColumn(Indexed,"NGÀY QUY ĐỊNH",each if [NGÀY NHẬN HS]=null then null else
				        let
				            CandidateDays = List.Dates(Date.AddDays([NGÀY NHẬN HS],1),7,#duration(1,0,0,0)),
				            WorkingDays = List.Select(CandidateDays,each Date.DayOfWeek(_,Day.Monday)<5)
				        in WorkingDays{1},type date),
				    Flag=Table.AddColumn(Target,"TỶ LỆ HT",each if [NGÀY HOÀN THÀNH]=null or [NGÀY QUY ĐỊNH]=null then null else if [NGÀY HOÀN THÀNH]<=[NGÀY QUY ĐỊNH] then 1 else 0,Int64.Type),
				    Score=Table.AddColumn(Flag,"ĐIỂM HOÀN THÀNH",each if [NGÀY HOÀN THÀNH]=null or [NGÀY QUY ĐỊNH]=null then null else let raw=1+Duration.Days([NGÀY QUY ĐỊNH]-[NGÀY HOÀN THÀNH])/100 in if raw<1 then 0 else raw,type number),
				    Year=Table.AddColumn(Score,"NĂM MỤC TIÊU",each if [NGÀY NHẬN HS]=null then null else Date.Year([NGÀY NHẬN HS]),Int64.Type),
				    Quarter=Table.AddColumn(Year,"QUÝ MỤC TIÊU",each if [NGÀY NHẬN HS]=null then "Chưa xác định" else "Quý "&Text.From(Date.QuarterOfYear([NGÀY NHẬN HS])),type text),
				    Period=Table.AddColumn(Quarter,"KỲ MỤC TIÊU",each if [NGÀY NHẬN HS]=null then "Chưa có ngày nhận HS" else [QUÝ MỤC TIÊU]&" - "&Text.From([NĂM MỤC TIÊU]),type text),
				    PeriodSort=Table.AddColumn(Period,"KỲ MỤC TIÊU SORT",each if [NGÀY NHẬN HS]=null then null else [NĂM MỤC TIÊU]*10+Date.QuarterOfYear([NGÀY NHẬN HS]),Int64.Type),
				    PicList=Table.AddColumn(PeriodSort,"PIC LIST",each let text=Text.Combine(List.Transform({[#"PIC XÂY DỰNG/CUNG ỨNG"],[PIC MEP],[PIC SITE1],[PIC SITE2]},each Text.From(_ ?? "")),";"), names=List.Distinct(List.Select(List.Transform(Splitter.SplitTextByAnyDelimiter({";",",","#(lf)","#(cr)","|"},QuoteStyle.Csv)(text),ToText),each _<>null and _<>"")) in if List.IsEmpty(names) then {null} else names),
				    PicDisplay=Table.AddColumn(PicList,"PIC HỒ SƠ",each Text.Combine(List.RemoveNulls([PIC LIST]),"; "),type text),
				    Expanded=Table.ExpandListColumn(PicDisplay,"PIC LIST"),
				    Renamed=Table.RenameColumns(Expanded,{{"PIC LIST","PIC"}}),
				    Result=Table.SelectColumns(Renamed,{"MÃ HỒ SƠ","DỰ ÁN","KHU VỰC","SỐ HỢP ĐỒNG","NHÀ THẦU","NỘI DUNG","NGÀY NHẬN HS","NGÀY HOÀN THÀNH","NGÀY QUY ĐỊNH","PIC","PIC HỒ SƠ","DÒNG NGUỒN","TỶ LỆ HT","ĐIỂM HOÀN THÀNH","KỲ MỤC TIÊU","KỲ MỤC TIÊU SORT","NĂM MỤC TIÊU","QUÝ MỤC TIÊU","FILE"})
				in
				    Result
				
				
				```


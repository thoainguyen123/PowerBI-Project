/// PL.PTC.04 từ sheet THEO DÕI CPC; một mã hồ sơ có thể có nhiều dòng PIC nhưng measure đếm phân biệt mã hồ sơ.
table 'KPI TTHD'
	lineageTag: 001d8369-387e-46ab-9f2c-e85c8a1cf352

	/// Số hồ sơ riêng biệt có ngày nhận HS trong các ngày của kỳ đã chọn. Kỳ đánh giá theo NGÀY NHẬN HS; ngày quy định chỉ dùng đánh giá đúng/trễ.
	measure 'TTHD Số hồ sơ' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			VAR _HasPeriod = ISCROSSFILTERED('DimDate')
			VAR _Dates = SELECTCOLUMNS(
			 FILTER(ALL('KPI TTHD'[NGÀY NHẬN HS]), NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) &&
			 (NOT _HasPeriod || 'KPI TTHD'[NGÀY NHẬN HS] IN _SelectedDates)),
			 "_Date", 'KPI TTHD'[NGÀY NHẬN HS])
			VAR _Rows = CALCULATETABLE(
			 SUMMARIZE('KPI TTHD', 'KPI TTHD'[MÃ HỒ SƠ],
			 "_Target", MAX('KPI TTHD'[NGÀY QUY ĐỊNH]),
			 "_Done", MAX('KPI TTHD'[NGÀY HOÀN THÀNH]),
			 "_Score", MAX('KPI TTHD'[ĐIỂM HOÀN THÀNH])),
			 KEEPFILTERS(TREATAS(_Dates, 'KPI TTHD'[NGÀY NHẬN HS])))
			RETURN COALESCE(COUNTROWS(_Rows),0)
		formatString: #,##0
		displayFolder: TTHD
		lineageTag: 62291179-ccce-486a-9af2-e219c885c147

	/// Số hồ sơ có điểm; không dùng thay card hoàn thành đúng hạn. Kỳ đánh giá theo NGÀY NHẬN HS; ngày quy định chỉ dùng đánh giá đúng/trễ.
	measure 'TTHD Số được chấm' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			VAR _HasPeriod = ISCROSSFILTERED('DimDate')
			VAR _Dates = SELECTCOLUMNS(
			 FILTER(ALL('KPI TTHD'[NGÀY NHẬN HS]), NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) &&
			 (NOT _HasPeriod || 'KPI TTHD'[NGÀY NHẬN HS] IN _SelectedDates)),
			 "_Date", 'KPI TTHD'[NGÀY NHẬN HS])
			VAR _Rows = CALCULATETABLE(
			 SUMMARIZE('KPI TTHD', 'KPI TTHD'[MÃ HỒ SƠ],
			 "_Target", MAX('KPI TTHD'[NGÀY QUY ĐỊNH]),
			 "_Done", MAX('KPI TTHD'[NGÀY HOÀN THÀNH]),
			 "_Score", MAX('KPI TTHD'[ĐIỂM HOÀN THÀNH])),
			 KEEPFILTERS(TREATAS(_Dates, 'KPI TTHD'[NGÀY NHẬN HS])))
			RETURN COALESCE(COUNTROWS(FILTER(_Rows, NOT ISBLANK([_Score]))),0)
		formatString: #,##0
		displayFolder: TTHD
		lineageTag: 1de5460f-08c2-4cba-b440-80cf3c9adfcc

	/// Hồ sơ đã phát hành không muộn hơn ngày quy định; lọc kỳ theo ngày nhận HS, không theo số PIC. Kỳ đánh giá theo NGÀY NHẬN HS; ngày quy định chỉ dùng đánh giá đúng/trễ.
	measure 'TTHD Đúng hạn' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			VAR _HasPeriod = ISCROSSFILTERED('DimDate')
			VAR _Dates = SELECTCOLUMNS(
			 FILTER(ALL('KPI TTHD'[NGÀY NHẬN HS]), NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) &&
			 (NOT _HasPeriod || 'KPI TTHD'[NGÀY NHẬN HS] IN _SelectedDates)),
			 "_Date", 'KPI TTHD'[NGÀY NHẬN HS])
			VAR _Rows = CALCULATETABLE(
			 SUMMARIZE('KPI TTHD', 'KPI TTHD'[MÃ HỒ SƠ],
			 "_Target", MAX('KPI TTHD'[NGÀY QUY ĐỊNH]),
			 "_Done", MAX('KPI TTHD'[NGÀY HOÀN THÀNH]),
			 "_Score", MAX('KPI TTHD'[ĐIỂM HOÀN THÀNH])),
			 KEEPFILTERS(TREATAS(_Dates, 'KPI TTHD'[NGÀY NHẬN HS])))
			RETURN COALESCE(COUNTROWS(FILTER(_Rows, NOT ISBLANK([_Done]) && [_Done] <= [_Target])),0)
		formatString: #,##0
		displayFolder: TTHD
		lineageTag: cfdb7687-c927-42ce-8c72-13acb033f701

	/// Hồ sơ đã phát hành sau ngày quy định; hồ sơ chưa phát hành không bị coi là đã hoàn thành trễ. Kỳ đánh giá theo NGÀY NHẬN HS; ngày quy định chỉ dùng đánh giá đúng/trễ.
	measure 'TTHD Trễ hạn' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			VAR _HasPeriod = ISCROSSFILTERED('DimDate')
			VAR _Dates = SELECTCOLUMNS(
			 FILTER(ALL('KPI TTHD'[NGÀY NHẬN HS]), NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) &&
			 (NOT _HasPeriod || 'KPI TTHD'[NGÀY NHẬN HS] IN _SelectedDates)),
			 "_Date", 'KPI TTHD'[NGÀY NHẬN HS])
			VAR _Rows = CALCULATETABLE(
			 SUMMARIZE('KPI TTHD', 'KPI TTHD'[MÃ HỒ SƠ],
			 "_Target", MAX('KPI TTHD'[NGÀY QUY ĐỊNH]),
			 "_Done", MAX('KPI TTHD'[NGÀY HOÀN THÀNH]),
			 "_Score", MAX('KPI TTHD'[ĐIỂM HOÀN THÀNH])),
			 KEEPFILTERS(TREATAS(_Dates, 'KPI TTHD'[NGÀY NHẬN HS])))
			RETURN COALESCE(COUNTROWS(FILTER(_Rows, NOT ISBLANK([_Done]) && [_Done] > [_Target])),0)
		formatString: #,##0
		displayFolder: TTHD
		lineageTag: e2015555-6f16-4f51-bbae-d50dc653dcaf

	/// Trung bình cộng điểm từng hồ sơ có ngày nhận HS trong kỳ; loại điểm rỗng, mỗi hồ sơ một lần. Kỳ đánh giá theo NGÀY NHẬN HS; ngày quy định chỉ dùng đánh giá đúng/trễ.
	measure 'TTHD Điểm bình quân' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			VAR _HasPeriod = ISCROSSFILTERED('DimDate')
			VAR _Dates = SELECTCOLUMNS(
			 FILTER(ALL('KPI TTHD'[NGÀY NHẬN HS]), NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) &&
			 (NOT _HasPeriod || 'KPI TTHD'[NGÀY NHẬN HS] IN _SelectedDates)),
			 "_Date", 'KPI TTHD'[NGÀY NHẬN HS])
			VAR _Rows = CALCULATETABLE(
			 SUMMARIZE('KPI TTHD', 'KPI TTHD'[MÃ HỒ SƠ],
			 "_Target", MAX('KPI TTHD'[NGÀY QUY ĐỊNH]),
			 "_Done", MAX('KPI TTHD'[NGÀY HOÀN THÀNH]),
			 "_Score", MAX('KPI TTHD'[ĐIỂM HOÀN THÀNH])),
			 KEEPFILTERS(TREATAS(_Dates, 'KPI TTHD'[NGÀY NHẬN HS])))
			RETURN AVERAGEX(_Rows, [_Score])
		formatString: 0.00%
		displayFolder: TTHD
		lineageTag: 834601f8-6039-491c-98d8-9ee684f22cef

	/// Điểm từng hồ sơ và trung bình dòng tổng lưới; lọc ngày nhận HS theo Excel, không lặp do nhiều PIC.
	measure 'TTHD Điểm dòng' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			VAR _HasPeriod = ISCROSSFILTERED('DimDate')
			VAR _Dates = SELECTCOLUMNS(
			 FILTER(ALL('KPI TTHD'[NGÀY NHẬN HS]), NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) &&
			 (NOT _HasPeriod || 'KPI TTHD'[NGÀY NHẬN HS] IN _SelectedDates)),
			 "_Date", 'KPI TTHD'[NGÀY NHẬN HS])
			VAR _Rows = CALCULATETABLE(
			 SUMMARIZE('KPI TTHD','KPI TTHD'[MÃ HỒ SƠ],"_Score",MAX('KPI TTHD'[ĐIỂM HOÀN THÀNH])),
			 KEEPFILTERS(TREATAS(_Dates,'KPI TTHD'[NGÀY NHẬN HS])))
			RETURN AVERAGEX(_Rows,[_Score])
		formatString: 0.00%
		displayFolder: TTHD
		lineageTag: e2515b07-849a-4751-a677-d505c0b5a6fe

	/// Lưới gồm tất cả hồ sơ nhận trong kỳ, kể cả chưa có điểm.
	measure 'TTHD Lưới hiển thị' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			VAR _HasPeriod = ISCROSSFILTERED('DimDate')
			VAR _Dates = SELECTCOLUMNS(
			 FILTER(ALL('KPI TTHD'[NGÀY NHẬN HS]), NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) &&
			 (NOT _HasPeriod || 'KPI TTHD'[NGÀY NHẬN HS] IN _SelectedDates)),
			 "_Date", 'KPI TTHD'[NGÀY NHẬN HS])
			RETURN IF(CALCULATE(DISTINCTCOUNT('KPI TTHD'[MÃ HỒ SƠ]),KEEPFILTERS(TREATAS(_Dates,'KPI TTHD'[NGÀY NHẬN HS]))) > 0,1,BLANK())
		formatString: 0
		displayFolder: TTHD
		lineageTag: 75b37711-a088-4a50-ba6e-d2f9e3da0a99

	/// Dòng chi tiết 1/0/rỗng và tổng số hồ sơ đúng hạn.
	measure 'TTHD Đúng hạn lưới' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			VAR _HasPeriod = ISCROSSFILTERED('DimDate')
			VAR _Dates = SELECTCOLUMNS(
			 FILTER(ALL('KPI TTHD'[NGÀY NHẬN HS]), NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) &&
			 (NOT _HasPeriod || 'KPI TTHD'[NGÀY NHẬN HS] IN _SelectedDates)),
			 "_Date", 'KPI TTHD'[NGÀY NHẬN HS])
			RETURN CALCULATE(DISTINCTCOUNT('KPI TTHD'[MÃ HỒ SƠ]),KEEPFILTERS(TREATAS(_Dates,'KPI TTHD'[NGÀY NHẬN HS])),KEEPFILTERS('KPI TTHD'[TỶ LỆ HT]=1))
		formatString: 0
		displayFolder: TTHD
		lineageTag: 080a0edf-84c9-4751-8f67-9cf5ba5c8372

	/// Chi tiết 1 nếu đúng hạn, 0 nếu trễ; tổng đếm hồ sơ đúng hạn một lần.
	measure 'TTHD Tỷ lệ dòng' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			VAR _HasPeriod = ISCROSSFILTERED('DimDate')
			VAR _Dates = SELECTCOLUMNS(
			 FILTER(ALL('KPI TTHD'[NGÀY NHẬN HS]), NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) &&
			 (NOT _HasPeriod || 'KPI TTHD'[NGÀY NHẬN HS] IN _SelectedDates)),
			 "_Date", 'KPI TTHD'[NGÀY NHẬN HS])
			VAR _Rows = CALCULATETABLE(SUMMARIZE('KPI TTHD','KPI TTHD'[MÃ HỒ SƠ],"_Flag",MAX('KPI TTHD'[TỶ LỆ HT])),KEEPFILTERS(TREATAS(_Dates,'KPI TTHD'[NGÀY NHẬN HS])))
			RETURN IF(HASONEVALUE('KPI TTHD'[MÃ HỒ SƠ]),MAXX(_Rows,[_Flag]),COUNTROWS(FILTER(_Rows,[_Flag]==1)))
		formatString: 0
		displayFolder: TTHD
		lineageTag: 6d69da50-276d-446c-bd91-e2d7bb84cb58

	/// Phần chưa hoàn thành của tổng hồ sơ dùng trong cột chồng; không cộng tổng vào các thành phần. Kỳ đánh giá theo NGÀY NHẬN HS; ngày quy định chỉ dùng đánh giá đúng/trễ.
	measure 'TTHD Chưa hoàn thành' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			VAR _HasPeriod = ISCROSSFILTERED('DimDate')
			VAR _Dates = SELECTCOLUMNS(
			 FILTER(ALL('KPI TTHD'[NGÀY NHẬN HS]), NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) &&
			 (NOT _HasPeriod || 'KPI TTHD'[NGÀY NHẬN HS] IN _SelectedDates)),
			 "_Date", 'KPI TTHD'[NGÀY NHẬN HS])
			VAR _Rows = CALCULATETABLE(
			 SUMMARIZE('KPI TTHD', 'KPI TTHD'[MÃ HỒ SƠ],
			 "_Target", MAX('KPI TTHD'[NGÀY QUY ĐỊNH]),
			 "_Done", MAX('KPI TTHD'[NGÀY HOÀN THÀNH]),
			 "_Score", MAX('KPI TTHD'[ĐIỂM HOÀN THÀNH])),
			 KEEPFILTERS(TREATAS(_Dates, 'KPI TTHD'[NGÀY NHẬN HS])))
			RETURN COALESCE(COUNTROWS(FILTER(_Rows, ISBLANK([_Done]))),0)
		formatString: #,##0
		displayFolder: TTHD
		lineageTag: 40c48a6c-9f9d-4475-9960-2e4a8de3a32d

	/// STT liên tục bắt đầu từ 1 trong tập hồ sơ được lọc; không có STT dòng tổng.
	measure 'TTHD STT' =
			VAR _SelectedDates = VALUES('DimDate'[Date])
			VAR _HasPeriod = ISCROSSFILTERED('DimDate')
			VAR _Dates = SELECTCOLUMNS(
			 FILTER(ALL('KPI TTHD'[NGÀY NHẬN HS]), NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) &&
			 (NOT _HasPeriod || 'KPI TTHD'[NGÀY NHẬN HS] IN _SelectedDates)),
			 "_Date", 'KPI TTHD'[NGÀY NHẬN HS])
			VAR _Ordinal = MIN('KPI TTHD'[DÒNG NGUỒN])
			VAR _Selected = CALCULATETABLE(ALLSELECTED('KPI TTHD'),TREATAS(_Dates,'KPI TTHD'[NGÀY NHẬN HS]))
			VAR _Keys = SUMMARIZE(_Selected,'KPI TTHD'[MÃ HỒ SƠ],'KPI TTHD'[DÒNG NGUỒN])
			RETURN IF(HASONEVALUE('KPI TTHD'[MÃ HỒ SƠ]) && [TTHD Lưới hiển thị]=1,RANKX(_Keys,'KPI TTHD'[DÒNG NGUỒN],_Ordinal,ASC,DENSE))
		formatString: 0
		displayFolder: TTHD
		lineageTag: ac21d98e-2b1c-44cc-b71e-067642d1476b


/// Nguồn SharePoint PL.PTC.02; bảng nguồn chuẩn hóa phục vụ bốn trang KPI mới. Giữ từng dòng gốc và các giá trị rỗng; chưa có quan hệ hay công thức chấm điểm.
table 'KPI TUNC Nguồn'
	lineageTag: 620f55ac-1840-4b0e-9938-1e55056433dd

	/// Lưới theo ngày mục tiêu thuộc tập ngày slicer; giữ cả dòng loại khỏi KPI để đối chiếu.
	measure 'TUNC Dòng thuộc kỳ' =
			VAR _Dates=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _Target=MAX('KPI TUNC Nguồn'[Ngày mục tiêu])
			RETURN IF(NOT ISFILTERED('Kỳ đánh giá đấu thầu') || (NOT ISBLANK(_Target) && _Target IN _Dates),1,BLANK())
		formatString: 0
		displayFolder: Bổ sung KPI
		lineageTag: 9ba136a0-40b8-431a-949d-b324c6debc0d

	/// Giữ điểm nguồn PL.PTC.02; nội dung Loại khỏi danh sách không chuyển thành 0.
	measure 'TUNC Điểm dòng' = IF([TUNC Dòng thuộc kỳ]=1,IFERROR(VALUE(SELECTEDVALUE('KPI TUNC Nguồn'[Điểm nguồn])),BLANK()))
		formatString: 0.00%
		displayFolder: Bổ sung KPI
		lineageTag: 3e2bf93f-d1a6-4600-b7e5-8ecfdbbd53c8

	measure 'TUNC Số gói' = COALESCE(COUNTROWS(FILTER(VALUES('KPI TUNC Nguồn'[Dòng nguồn]),[TUNC Dòng thuộc kỳ]=1)),0)
		formatString: #,##0
		displayFolder: Bổ sung KPI
		lineageTag: a41580df-4a07-444c-9cb8-7be57106388b

	/// Dòng tổng Excel: đếm dòng điểm hoàn thành bằng 1, mỗi dòng nguồn một lần.
	measure 'TUNC Tổng hoàn thành' = COALESCE(COUNTROWS(FILTER(VALUES('KPI TUNC Nguồn'[Dòng nguồn]),[TUNC Điểm dòng]==1)),0)
		formatString: #,##0
		displayFolder: Bổ sung KPI
		lineageTag: 40a3cecd-be9d-4144-bb5d-b194aaab0641

	measure 'TUNC Gói loại khỏi KPI' = COALESCE(COUNTROWS(FILTER(VALUES('KPI TUNC Nguồn'[Dòng nguồn]),[TUNC Dòng thuộc kỳ]=1 && CALCULATE(SELECTEDVALUE('KPI TUNC Nguồn'[Tình trạng]))="BỎ")),0)
		formatString: #,##0
		displayFolder: Bổ sung KPI
		lineageTag: 869d5ef0-74c9-41c9-a62c-50a20d9ec33c

	/// Tổng đếm điểm bằng 1, chi tiết hiển thị điểm nguồn; giữ dòng điểm rỗng.
	measure 'TUNC Điểm hiển thị' = IF([TUNC Số gói]>0,IF(ISINSCOPE('KPI TUNC Nguồn'[STT]),IF(ISBLANK([TUNC Điểm dòng]),UNICHAR(8203),FORMAT([TUNC Điểm dòng],"0.00%")),FORMAT([TUNC Tổng hoàn thành],"#,##0")),BLANK())
		displayFolder: Bổ sung KPI
		lineageTag: 42feffe9-f40b-4a58-9c25-fb7693dd6716

	measure 'TUNC Lưới Hạng mục' = IF(ISINSCOPE('KPI TUNC Nguồn'[STT]) && [TUNC Dòng thuộc kỳ]=1,SELECTEDVALUE('KPI TUNC Nguồn'[Hạng mục]))
		displayFolder: Lưới Excel
		lineageTag: 1710b65b-a2ee-48b2-8ffd-1e23e1af3f5f

	measure 'TUNC Lưới Phòng' = IF(ISINSCOPE('KPI TUNC Nguồn'[STT]) && [TUNC Dòng thuộc kỳ]=1,SELECTEDVALUE('KPI TUNC Nguồn'[Phòng]))
		displayFolder: Lưới Excel

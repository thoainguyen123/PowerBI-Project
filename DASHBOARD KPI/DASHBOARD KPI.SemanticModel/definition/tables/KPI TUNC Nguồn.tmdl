		sourceColumn: Trình tờ trình kế hoạch

		annotation SummarizationSetBy = Automatic

	column 'Trình tờ trình thực tế'
		dataType: string
		lineageTag: 58c6ae22-9a48-4c9c-b014-a07f3382fa4b

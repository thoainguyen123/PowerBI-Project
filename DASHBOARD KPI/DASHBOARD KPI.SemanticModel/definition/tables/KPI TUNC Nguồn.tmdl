	column 'Ký HĐNT kế hoạch'
		dataType: string
		lineageTag: 993e1c9a-f525-4353-8e40-fb0db355a209
		summarizeBy: none
		sourceColumn: Ký HĐNT kế hoạch

		annotation SummarizationSetBy = Automatic

	column 'Ký HĐNT thực tế'
		dataType: string
		lineageTag: 8ac9ad5d-86c0-4262-92f2-4f2d032dafb2
		summarizeBy: none
		sourceColumn: Ký HĐNT thực tế

		annotation SummarizationSetBy = Automatic

	partition 'KPI TUNC Nguồn' = m
		mode: import
		source =
				let
				    URL="https://novaland.sharepoint.com/sites/PRT/_api/web/GetFileById(guid'D4FA6E74-1B84-40F9-BBC6-E5A2BA0586C6')/$value",
				    Sheet="PL.PTC.02",
				    Norm=(v as any) as text => Text.Upper(Text.Remove(Text.Clean(Text.From(v ?? "")),{" ",Character.FromNumber(160),"#(lf)","#(cr)","#(tab)"})),
				    Mapping={{"STT","Int64",{"STT"}},
				        {"Hạng mục","String",{"HẠNG MỤC HÀNG HÓA DỊCH VỤ","HẠNG MỤC","HẠNG MỤC HÀNG HÓA - DỊCH VỤ"}},
				        {"Phòng","String",{"PHÒNG","PHÒNG/BAN"}},
				        {"Ngày mục tiêu","DateTime",{"MỤC TIÊU","NGÀY MỤC TIÊU"}},
				        {"Cơ sở ghi nhận","String",{"CƠ SỞ GHI NHẬN"}},
				        {"Ngày hoàn thành","DateTime",{"KẾT QUẢ","NGÀY HOÀN THÀNH"}},
				        {"Điểm nguồn","String",{"TỶ LỆ HOÀN THÀNH (1=đạt, 0=không đạt)","TỶ LỆ HOÀN THÀNH","ĐIỂM NGUỒN"}},
				        {"Giải trình","String",{"GIẢI TRÌNH LÝ DO CHẬM TRỄ","GIẢI TRÌNH"}},
				        {"Link minh chứng","String",{"LINK MINH CHỨNG"}},
				        {"Ghi chú","String",{"GHI CHÚ"}},
				        {"PIC","String",{"PIC","PIC CẬP NHẬT"}},
				        {"Team","String",{"TEAM"}},
				        {"Tình trạng","String",{"TÌNH TRẠNG"}},
				        {"Quý mục tiêu nguồn","String",{"Quý MT","QUÝ MỤC TIÊU"}},
				        {"Chuẩn hóa BOQ kế hoạch","String",{"CHUẨN HÓA/ BOQ KH"}},
				        {"Chuẩn hóa BOQ thực tế","String",{"CHUẨN HÓA/ BOQ - THỰC TẾ"}},
				        {"Tender list kế hoạch","String",{"TENDER LIST - KH"}},
				        {"Tender list thực tế","String",{"TENDER LIST - THỰC TẾ"}},
				        {"Gom sản lượng kế hoạch","String",{"GOM SẢN LƯỢNG - KH (NẾU CÓ)"}},
				        {"Phát hành HSMT thực tế","String",{"PHÁT HÀNH HỒ SƠ MỜI THẦU - THỰC TẾ"}},
				        {"Ghi nhận loại khỏi KPI","String",{"BỎ 19 gói","GHI NHẬN LOẠI KHỎI KPI"}},
				        {"Căn cứ loại khỏi KPI","String",{"18 gói theo BBH 0095 + bổ sung ""Thi công hoàn thiện Nhôm kính"" (STT9) theo email a.Tuấn 20/07 → tổng 19 gói loại khỏi KPI3.","CĂN CỨ LOẠI KHỎI KPI"}},
				        {"Đánh giá R1 kế hoạch","String",{"ĐÁNH GIÁ/ THƯƠNG THẢO THẦU R1 - KH"}},
				        {"Đánh giá R1 thực tế","String",{"ĐÁNH GIÁ/ THƯƠNG THẢO THẦU R1 - THỰC TẾ"}},
				        {"Nhận báo giá R2 kế hoạch","String",{"NHẬN HỒ SƠ BÁO GIÁ R2 - KH"}},
				        {"Nhận báo giá R2 thực tế","String",{"NHẬN HỒ SƠ BÁO GIÁ R2 - THỰC TẾ"}},
				        {"Đánh giá R2 kế hoạch","String",{"ĐÁNH GIÁ/ THƯƠNG THẢO THẦU R2 - KH"}},
				        {"Đánh giá R2 thực tế","String",{"ĐÁNH GIÁ/ THƯƠNG THẢO THẦU R2 - THỰC TẾ"}},
				        {"Trình tờ trình kế hoạch","String",{"TRÌNH TỜ TRÌNH - KH"}},
				        {"Trình tờ trình thực tế","String",{"TRÌNH TỜ TRÌNH - THỰC TẾ"}},
				        {"Ký HĐNT kế hoạch","String",{"KÝ HDNT - KH"}},
				        {"Ký HĐNT thực tế","String",{"KÝ HDNT - THỰC TẾ"}}},
				    Workbook=Excel.Workbook(Web.Contents(URL),null,true),
				    Raw=Workbook{[Item=Sheet,Kind="Sheet"]}[Data],
				    HeaderRow=List.PositionOf(List.Transform(Table.ToRows(Table.FirstN(Raw,20)),(r)=>Norm(r{0})="STT"),true),
				    Checked=if HeaderRow<0 then error Error.Record("KPI source","Không tìm thấy tiêu đề STT trong "&Sheet,null) else Raw,
				    Headers=Record.FieldValues(Checked{HeaderRow}),
				    Resolve=(aliases as list) as nullable number =>
				        List.First(List.RemoveNulls(List.Transform(aliases,(a)=>let i=List.PositionOf(List.Transform(Headers,each Norm(_)),Norm(a)) in if i<0 then null else i)),null),
				    Resolved=List.Transform(Mapping,(m)=>{m{0},m{1},Resolve(m{2})}),
				    Required={"STT","Hạng mục","Phòng","Ngày mục tiêu","Điểm nguồn","PIC"},
				    Missing=List.Select(Resolved,each List.Contains(Required,_{0}) and _{2}=null),
				    SchemaChecked=if List.Count(Missing)>0 then error Error.Record("KPI source","Thiếu tiêu đề bắt buộc trong "&Sheet, List.Transform(Missing,each _{0})) else Checked,
				    Indexed=Table.AddIndexColumn(SchemaChecked,"Dòng nguồn",1,1,Int64.Type),
				    Body=Table.Skip(Indexed,HeaderRow+1),
				    SourceNames=Table.ColumnNames(Raw),
				    Projected=Table.FromColumns(
				        List.Combine({List.Transform(Resolved,(m)=>if m{2}=null then List.Repeat({null},Table.RowCount(Body)) else Table.Column(Body,SourceNames{m{2}})),{Table.Column(Body,"Dòng nguồn")}}),
				        List.Combine({List.Transform(Resolved,each _{0}),{"Dòng nguồn"}})),
				    Selected=Table.SelectRows(Projected,each (try Number.From([STT]) otherwise null)<>null and Norm([Hạng mục])<>""),
				    Txt=(v as any) as nullable text => if v=null then null else Text.Trim(Text.From(v)),
				    Num=(v as any) as nullable number => if v=null or Text.Trim(Text.From(v))="" then null else try Number.From(v,"en-US") otherwise null,
				    Dt=(v as any) as nullable date => if v=null or Text.Trim(Text.From(v))="" or v=0 then null else if Value.Is(v,type text) then try Date.FromText(Text.Trim(v),[Culture="en-GB"]) otherwise null else try Date.From(v) otherwise null,
				    Converted=Table.TransformColumns(Selected,List.Transform(Resolved,(m)=>{m{0},if m{1}="DateTime" then Dt else if m{1}="Int64" then Num else Txt,if m{1}="DateTime" then type date else if m{1}="Int64" then Int64.Type else type text}))
				in
				    Converted


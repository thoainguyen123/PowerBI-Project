/// PL.PTC.01 và PL.PTC.01-01 từ NVLG_PTC_2026.xlsx; chuẩn hóa ngày mục tiêu trung gian và điểm theo ngày làm việc.
table 'KPI Tiến độ thầu'
	lineageTag: bc6ffe58-916b-447b-be94-0f377a029190

	/// Đếm mã công việc duy nhất thuộc kỳ slicer; không nhân đôi do nhiều PIC.
	measure 'TĐT Số công việc' = COUNTROWS(FILTER(VALUES('KPI Tiến độ thầu'[MÃ CÔNG VIỆC]), [TĐT Gói thuộc kỳ] = 1))
		formatString: #,0
		displayFolder: KPI
		lineageTag: 4c769371-1d41-41c9-b705-478632002c84

	/// Đếm theo tỷ lệ hoàn thành gốc, giữ ý nghĩa đúng/trễ hạn; không dùng điểm đã kết hợp PCD để phân loại tiến độ.
	measure 'TĐT Số được chấm' = VAR _T = ADDCOLUMNS(VALUES('KPI Tiến độ thầu'[MÃ CÔNG VIỆC]), "_Score", [TĐT Tỷ lệ hoàn thành]) RETURN COUNTROWS(FILTER(_T, NOT ISBLANK([_Score])))
		formatString: #,0
		displayFolder: KPI
		lineageTag: 1edd4420-ed35-4979-a3c6-2c752af1e159

	/// Đếm theo tỷ lệ hoàn thành gốc, giữ ý nghĩa đúng/trễ hạn; không dùng điểm đã kết hợp PCD để phân loại tiến độ.
	measure 'TĐT Số đạt đúng hạn' = VAR _T = ADDCOLUMNS(VALUES('KPI Tiến độ thầu'[MÃ CÔNG VIỆC]), "_Score", [TĐT Tỷ lệ hoàn thành]) RETURN COUNTROWS(FILTER(_T, NOT ISBLANK([_Score]) && [_Score] >= 1))
		formatString: #,0
		displayFolder: KPI
		lineageTag: b9180d5f-af4d-4b3a-b50e-7c77dcde3077

	/// Đếm theo tỷ lệ hoàn thành gốc, giữ ý nghĩa đúng/trễ hạn; không dùng điểm đã kết hợp PCD để phân loại tiến độ.
	measure 'TĐT Số trễ không đạt' = VAR _T = ADDCOLUMNS(VALUES('KPI Tiến độ thầu'[MÃ CÔNG VIỆC]), "_Score", [TĐT Tỷ lệ hoàn thành]) RETURN COUNTROWS(FILTER(_T, NOT ISBLANK([_Score]) && [_Score] < 1))
		formatString: #,0
		displayFolder: KPI
		lineageTag: 1066337a-6210-4db6-a0ff-d093bbdb9aa1

	/// Trung bình cộng điểm không rỗng của mã công việc duy nhất: gói trong kỳ và vượt kỳ. Giữ điểm 0%, không nhân đôi theo PIC.
	measure 'TĐT Điểm bình quân' = VAR _T = ADDCOLUMNS(VALUES('KPI Tiến độ thầu'[MÃ CÔNG VIỆC]), "_Score", [TĐT Điểm dòng]) RETURN AVERAGEX(FILTER(_T, NOT ISBLANK([_Score])), [_Score])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: 754c5eaa-bcaa-4ccc-b94a-4fa8c5c681ac

	measure 'TĐT Số loại trừ/chưa dữ liệu' = [TĐT Số công việc] - [TĐT Số được chấm]
		formatString: #,0
		displayFolder: KPI
		lineageTag: 05fc2084-5edc-44e2-89d9-1675c59fafaf

	measure 'TĐT Tỷ lệ đúng hạn' = DIVIDE([TĐT Số đạt đúng hạn], [TĐT Số được chấm])
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: 26312538-7a51-422a-8a21-d4c3e8fd452e

	/// Theo nguồn NVLG_PTC_2026: OPEX (PHÒNG hoặc BỘ PHẬN) giữ nguyên tỷ lệ hoàn thành. Các gói khác: 80% tỷ lệ + 20% PCD kỳ báo cáo; rỗng nếu thiếu tỷ lệ/PCD. Tính từng MÃ CÔNG VIỆC trước khi bình quân.
	measure 'TĐT Điểm dòng' =
			VAR _Ratio=[TĐT Tỷ lệ hoàn thành]
			VAR _Department=UPPER(TRIM(SUBSTITUTE(MAX('KPI Tiến độ thầu'[PHÒNG]),UNICHAR(160)," ")))
			VAR _Team=UPPER(TRIM(SUBSTITUTE(MAX('KPI Tiến độ thầu'[BỘ PHẬN]),UNICHAR(160)," ")))
			VAR _IsOpex=_Department="OPEX" || _Team="OPEX"
			VAR _PCD=IF(NOT _IsOpex,[TĐT Điểm PCD])
			RETURN IF(ISBLANK(_Ratio),BLANK(),
			    IF(_IsOpex,_Ratio,
			        IF(NOT ISBLANK(_PCD),0.8*_Ratio+0.2*_PCD,BLANK())))
		formatString: 0.00%
		displayFolder: KPI
		lineageTag: f8d943bc-5b97-4831-b384-04cf7cc95b0e

	measure 'TĐT Số ngày chênh lệch' = MAX('KPI Tiến độ thầu'[SỐ NGÀY CHÊNH LỆCH LÀM VIỆC])
		formatString: #,0
		displayFolder: Chi tiết
		lineageTag: a15d5795-b88e-4a41-8729-66946dfeaadc

	/// Tổng gói thầu theo định nghĩa PL.PTC.01/01-01: hoàn thành, trong hạn, chưa đến hạn và trễ hạn.
	measure 'TĐT Tổng gói thầu' = [TĐT Hoàn thành] + [TĐT Trong hạn thực hiện] + [TĐT Chưa đến hạn] + [TĐT Trễ hạn]
		formatString: #,0
		displayFolder: Trạng thái gói thầu
		lineageTag: a2f6cbb0-5f5f-41f1-856b-c8aab71c09c6

	/// Số gói có trạng thái ĐÃ HOÀN THÀNH trong kỳ mục tiêu đã chọn.
	measure 'TĐT Hoàn thành' = COALESCE ( CALCULATE ( [TĐT Số công việc], KEEPFILTERS ( 'KPI Tiến độ thầu'[TÌNH TRẠNG] IN { "ĐÃ HOÀN THÀNH", "ĐÃ HOÀN HÀNH" } ) ), 0 )
		formatString: #,0
		displayFolder: Trạng thái gói thầu
		lineageTag: 7cc83caa-bfc8-4603-90d5-1518523de2f1

	/// Số gói đang trong hạn thực hiện trong kỳ mục tiêu đã chọn.
	measure 'TĐT Trong hạn thực hiện' = COALESCE ( CALCULATE ( [TĐT Số công việc], KEEPFILTERS ( 'KPI Tiến độ thầu'[TÌNH TRẠNG] = "TRONG HẠN THỰC HIỆN" ) ), 0 )
		formatString: #,0
		displayFolder: Trạng thái gói thầu
		lineageTag: 97b0488b-b10d-4c22-8914-9b441d1af74c

	/// Số gói có trạng thái CHƯA ĐẾN HẠN trong kỳ mục tiêu đã chọn.
	measure 'TĐT Chưa đến hạn' = COALESCE ( CALCULATE ( [TĐT Số công việc], KEEPFILTERS ( 'KPI Tiến độ thầu'[TÌNH TRẠNG] = "CHƯA ĐẾN HẠN" ) ), 0 )
		formatString: #,0
		displayFolder: Trạng thái gói thầu
		lineageTag: ece1d52f-0d79-4a04-bef6-69c8da18896e

	/// Số gói có trạng thái TRỄ HẠN trong kỳ mục tiêu đã chọn.
	measure 'TĐT Trễ hạn' = COALESCE ( CALCULATE ( [TĐT Số công việc], KEEPFILTERS ( 'KPI Tiến độ thầu'[TÌNH TRẠNG] = "TRỄ HẠN" ) ), 0 )
		formatString: #,0
		displayFolder: Trạng thái gói thầu
		lineageTag: 800030eb-d35c-44a3-9156-630b328518bd

	/// Gói có tình trạng cụ thể ĐANG THỰC HIỆN; dùng để theo dõi phần trễ đang xử lý.
	measure 'TĐT Trễ đang thực hiện' = COALESCE ( CALCULATE ( [TĐT Số công việc], KEEPFILTERS ( CONTAINSSTRING ( UPPER ( COALESCE ( 'KPI Tiến độ thầu'[TÌNH TRẠNG CỤ THỂ], "" ) ), "ĐANG THỰC HIỆN" ) ) ), 0 )
		formatString: #,0
		displayFolder: Trạng thái gói thầu
		lineageTag: ba78d35d-49fb-4703-84b7-8102b8969030

	/// Gói có tình trạng cụ thể CHƯA THỰC HIỆN.
	measure 'TĐT Chưa thực hiện' = COALESCE ( CALCULATE ( [TĐT Số công việc], KEEPFILTERS ( CONTAINSSTRING ( UPPER ( COALESCE ( 'KPI Tiến độ thầu'[TÌNH TRẠNG CỤ THỂ], "" ) ), "CHƯA THỰC HIỆN" ) ) ), 0 )
		formatString: #,0
		displayFolder: Trạng thái gói thầu
		lineageTag: db3819c2-3195-456e-9f33-4b315a4d56be

	/// Gói bị loại trừ do chưa đủ hồ sơ thực hiện; không nằm trong mẫu số tính điểm.
	measure 'TĐT Không đủ HS thực hiện' = COALESCE ( CALCULATE ( [TĐT Số công việc], KEEPFILTERS ( CONTAINSSTRING ( UPPER ( COALESCE ( 'KPI Tiến độ thầu'[TÌNH TRẠNG CỤ THỂ], "" ) ), "CHƯA ĐỦ HS THỰC HIỆN" ) ) ), 0 )
		formatString: #,0
		displayFolder: Trạng thái gói thầu
		lineageTag: c77b1173-7351-4afd-b00f-9651b439791e

	measure 'TĐT Gói phân công theo PIC' = VAR _PIC = SELECTEDVALUE ( 'KPI Tiến độ thầu'[PIC CẬP NHẬT] ) RETURN IF ( ISBLANK ( _PIC ) || TRIM ( _PIC ) = "", BLANK (), [TĐT Tổng gói thầu] )
		formatString: #,0
		displayFolder: Theo PIC
		lineageTag: 8f72b38e-86f8-4d10-872f-ec83510d8341

	measure 'TĐT Gói trễ theo PIC' = VAR _PIC = SELECTEDVALUE ( 'KPI Tiến độ thầu'[PIC CẬP NHẬT] ) RETURN IF ( ISBLANK ( _PIC ) || TRIM ( _PIC ) = "", BLANK (), [TĐT Trễ hạn] )
		formatString: #,0
		displayFolder: Theo PIC
		lineageTag: 0c716bd0-7318-4424-8c81-c9e079dd414c

	/// Số gói có ngày mục tiêu, dùng cho biểu đồ kế hoạch theo tháng-năm.
	measure 'TĐT Gói dự kiến thực hiện' = CALCULATE ( [TĐT Số công việc], KEEPFILTERS ( NOT ISBLANK ( 'KPI Tiến độ thầu'[NGÀY MỤC TIÊU TRUNG GIAN] ) ) )
		formatString: #,0
		displayFolder: Trạng thái gói thầu
		lineageTag: 7c56a527-b2d8-49fe-b699-e81cbb598a6d

	/// Bảng chi tiết TIẾN ĐỘ THẦU/TRONG KPI/NGOÀI KPI hiển thị tỷ lệ tiến độ gốc trước PCD. Dòng tổng là bình quân tỷ lệ gốc theo mã công việc duy nhất, bỏ rỗng và giữ 0%. Giữ điều kiện kỳ và ký tự ẩn cho điểm rỗng. Điểm KPI tổng hợp và TEMPLATE KPI vẫn dùng TĐT Điểm dòng/TĐT Điểm bình quân theo OPEX hoặc 80% tỷ lệ gốc + 20% PCD. Theo xác nhận ngày 16/11/2026.
	measure 'TĐT Điểm hiển thị lưới' =
			VAR _Row=ISINSCOPE('KPI Tiến độ thầu'[MÃ CÔNG VIỆC])
			VAR _Visible=IF(_Row,[TĐT Gói thuộc kỳ]=1,[TĐT Số công việc]>0)
			RETURN IF(_Visible,
			VAR _Ratio=IF(_Row,[TĐT Tỷ lệ hoàn thành],
			AVERAGEX(VALUES('KPI Tiến độ thầu'[MÃ CÔNG VIỆC]),[TĐT Tỷ lệ hoàn thành]))
			RETURN IF(ISBLANK(_Ratio),UNICHAR(8203),FORMAT(_Ratio,"0.00%")))
		displayFolder: KPI
		lineageTag: f9ebc78e-7fda-4186-a8cb-089452036a9c

	/// Hiện mục tiêu thuộc các ngày slicer chọn hoặc hoàn thành thuộc kỳ và mục tiêu sau cuối kỳ. Giữ gói có điểm rỗng; một mã gói một dòng.
	measure 'TĐT Gói thuộc kỳ' =
			VAR _Dates = VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _HasPeriod = ISFILTERED('Kỳ đánh giá đấu thầu')
			VAR _PeriodEnd = MAX('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _Target = MAX('KPI Tiến độ thầu'[NGÀY MỤC TIÊU TRUNG GIAN])
			VAR _Done = MAX('KPI Tiến độ thầu'[NGÀY HOÀN THÀNH])
			VAR _TargetIn = NOT ISBLANK(_Target) && _Target IN _Dates
			VAR _OverPeriod = NOT ISBLANK(_Target) && NOT ISBLANK(_Done) && _Done IN _Dates && _Target > _PeriodEnd
			RETURN IF(NOT _HasPeriod || _TargetIn || _OverPeriod, 1, BLANK())
		formatString: 0
		isHidden
		displayFolder: KPI
		lineageTag: 5be4e4bf-8e74-4845-826a-05d1449b974e

	/// PIC của dòng chi tiết: kiểm tra gói thuộc kỳ trực tiếp khi MÃ CÔNG VIỆC ở trong scope, gộp tên không rỗng tăng dần. Tránh lặp đếm lại mã công việc đã cố định trong từng dòng. Tối ưu 16/11/2026.
	measure 'TĐT PIC hiển thị lưới' =
			IF(ISINSCOPE('KPI Tiến độ thầu'[MÃ CÔNG VIỆC]),
			IF([TĐT Gói thuộc kỳ]=1,
			CONCATENATEX(FILTER(VALUES('KPI Tiến độ thầu'[PIC CẬP NHẬT]),NOT ISBLANK('KPI Tiến độ thầu'[PIC CẬP NHẬT])),'KPI Tiến độ thầu'[PIC CẬP NHẬT],"; ",'KPI Tiến độ thầu'[PIC CẬP NHẬT],ASC)))
		displayFolder: Chi tiết
		lineageTag: fa2912e5-44b2-48df-b33e-4ec025de7c89

	/// Đếm mã công việc duy nhất có TÌNH TRẠNG=TRỄ HẠN và TÌNH TRẠNG CỤ THỂ=PENDING DO THIẾU NGÂN SÁCH, không phân biệt hoa/thường/khoảng trắng đầu cuối. Ngày mục tiêu trung gian phải có và thuộc đúng kỳ đang chọn; không lấy vượt kỳ theo ngày hoàn thành. Giữ bộ lọc TRONG/NGOÀI KPI, dự án, PIC và các slicer khác; không có dữ liệu trả 0.
	measure 'TĐT Trễ thiếu ngân sách' =
			VAR _Dates=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _HasPeriod=ISFILTERED('Kỳ đánh giá đấu thầu')
			VAR _Rows=FILTER('KPI Tiến độ thầu',
			    UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[TÌNH TRẠNG],UNICHAR(160)," ")))="TRỄ HẠN" &&
			    UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[TÌNH TRẠNG CỤ THỂ],UNICHAR(160)," ")))="PENDING DO THIẾU NGÂN SÁCH" &&
			    NOT ISBLANK('KPI Tiến độ thầu'[NGÀY MỤC TIÊU TRUNG GIAN]) &&
			    (NOT _HasPeriod || 'KPI Tiến độ thầu'[NGÀY MỤC TIÊU TRUNG GIAN] IN _Dates))
			RETURN COALESCE(COUNTROWS(SUMMARIZE(_Rows,'KPI Tiến độ thầu'[MÃ CÔNG VIỆC])),0)
		formatString: #,##0
		displayFolder: KPI
		lineageTag: ac73223a-fedc-43d8-862d-353706e594c3

	/// Tỷ lệ gốc từ cột Tỷ lệ hoàn thành của nguồn, áp dụng điều kiện kỳ/PIC và ngoại lệ thiếu ngân sách đã duyệt; dự phòng công thức tiến độ khi nguồn rỗng. Dùng đếm đúng/trễ hạn trước khi kết hợp PCD.
	measure 'TĐT Tỷ lệ hoàn thành' =
			VAR _Dates = VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _HasPeriod = ISFILTERED('Kỳ đánh giá đấu thầu')
			VAR _PeriodEnd = MAX('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _Target = MAX('KPI Tiến độ thầu'[NGÀY MỤC TIÊU TRUNG GIAN])
			VAR _Done = MAX('KPI Tiến độ thầu'[NGÀY HOÀN THÀNH])
			VAR _Out = MAX('KPI Tiến độ thầu'[NGÀY OUT HS KHỎI PHÒNG])
			VAR _SourceRatio = MAX('KPI Tiến độ thầu'[TỶ LỆ HOÀN THÀNH NGUỒN])
			VAR _Days = MAX('KPI Tiến độ thầu'[SỐ NGÀY CHÊNH LỆCH LÀM VIỆC])
			VAR _HasPIC =
			    COUNTROWS(
			        FILTER(
			            VALUES('KPI Tiến độ thầu'[PIC CẬP NHẬT]),
			            LEN(TRIM(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(
			                'KPI Tiến độ thầu'[PIC CẬP NHẬT],
			                UNICHAR(160), " "), UNICHAR(9), ""), UNICHAR(10), ""), UNICHAR(13), ""))) > 0
			        )
			    ) > 0
			VAR _Detail = UPPER(TRIM(SUBSTITUTE(MAX('KPI Tiến độ thầu'[TÌNH TRẠNG CỤ THỂ]),UNICHAR(160)," ")))
			VAR _TargetIn = NOT ISBLANK(_Target) && _Target IN _Dates
			VAR _DoneIn = NOT ISBLANK(_Done) && _Done IN _Dates
			VAR _OutIn = NOT ISBLANK(_Out) && _Out IN _Dates
			VAR _PendingBudget = _Detail = "PENDING DO THIẾU NGÂN SÁCH"
			    && NOT ISBLANK(_Out) && NOT ISBLANK(_Target) && _Out < _Target
			    && IF(_HasPeriod, _TargetIn && _OutIn,
			        YEAR(_Out)=YEAR(_Target) && QUARTER(_Out)=QUARTER(_Target))
			VAR _OverPeriod = _DoneIn && _Target > _PeriodEnd
			VAR _WeekendBonus =
			    IF(
			        NOT ISBLANK(_Done) && NOT ISBLANK(_Target)
			            && _Done < _Target && WEEKDAY(_Target, 2) > 5,
			        1,
			        0
			    )
			VAR _RawPercent = DIVIDE(100 + _Days + _WeekendBonus, 100)
			RETURN
			    SWITCH(
			        TRUE(),
			        NOT _HasPIC || ISBLANK(_Target), BLANK(),
			        _HasPeriod && NOT (_TargetIn || _OverPeriod), BLANK(),
			        _PendingBudget, 1,
			        ISBLANK(_Done) && CONTAINSSTRING(_Detail,"CHƯA ĐỦ HS THỰC HIỆN"), BLANK(),
			        _HasPeriod && _TargetIn && NOT ISBLANK(_Done) && NOT _DoneIn && _Done < _Target, BLANK(),
			        NOT ISBLANK(_SourceRatio), _SourceRatio,
			        ISBLANK(_Done), 0,
			        _Done = _Target, 1,
			        ISBLANK(_Days), BLANK(),
			        _Days < -20, 0,
			        MIN(1.2, _RawPercent)
			    )
		formatString: 0.00%
		displayFolder: Tiến độ thầu\Thành phần điểm
		lineageTag: 20f81f5e-a3dd-47f0-a40d-46d6ba315541

	/// PCD Ban PTC theo quý/năm báo cáo trong BI DATA. Khi chọn nhiều quý/cả năm lấy bình quân các quý có điểm, giữ điểm 0. Không suy ra PCD theo quý mục tiêu từng công việc.
	measure 'TĐT Điểm PCD' =
			VAR _Dates=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _Periods=DISTINCT(SELECTCOLUMNS(_Dates,"_Year",YEAR('Kỳ đánh giá đấu thầu'[Ngày]),"_Quarter",QUARTER('Kỳ đánh giá đấu thầu'[Ngày])))
			VAR _Rows=FILTER(ALL('BI_Data'[Mã CV],'BI_Data'[Quý],'BI_Data'[Năm],'BI_Data'[PIC],'BI_Data'[Điểm hoàn thành]),
			    UPPER(TRIM('BI_Data'[PIC]))="BAN PTC" &&
			    UPPER(TRIM('BI_Data'[Mã CV]))="PCD"&FORMAT('BI_Data'[Quý],"0") &&
			    ('BI_Data'[Năm],'BI_Data'[Quý]) IN _Periods &&
			    NOT ISBLANK('BI_Data'[Điểm hoàn thành]) && LEN(TRIM('BI_Data'[Điểm hoàn thành]))>0)
			RETURN AVERAGEX(_Rows,IFERROR(VALUE('BI_Data'[Điểm hoàn thành]),BLANK()))
		formatString: 0.00%
		displayFolder: Tiến độ thầu\Thành phần điểm
		lineageTag: a0e55263-5d95-4913-9a16-e5bb71297ba3

	column 'MÃ CÔNG VIỆC'
		dataType: int64
		formatString: 0
		lineageTag: 85092258-8fe8-4a59-a25c-496a7c109ad4
		summarizeBy: sum
		sourceColumn: MÃ CÔNG VIỆC


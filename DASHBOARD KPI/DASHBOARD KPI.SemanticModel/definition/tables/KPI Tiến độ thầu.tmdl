	/// Tỷ lệ nguyên bản từ PL.PTC.01/01-01. TEMPLATE TDDT: Ngân sách Dự án = 80% tỷ lệ gốc + 20% PCD đúng quý báo cáo (rỗng=0); ngân sách còn lại giữ nguyên tỷ lệ gốc. Thay điều kiện OPEX cũ từ 20/11/2026.
	column 'TỶ LỆ HOÀN THÀNH NGUỒN'
		dataType: double
		formatString: 0.00%
		lineageTag: 612c2f51-2c04-4212-bea0-f9fc3f3bd0b5
		summarizeBy: none
		sourceColumn: TỶ LỆ HOÀN THÀNH NGUỒN

	column 'NGÂN SÁCH'
		dataType: string
		lineageTag: 994e5667-8ef6-431a-b67d-1469cd93f289
		summarizeBy: none
		sourceColumn: NGÂN SÁCH

		annotation SummarizationSetBy = Automatic

	partition 'KPI Tiến độ thầu' = m
		mode: import
		source =
				let
					    Normalize = (v as any) as text => Text.Upper(Text.Remove(Text.Clean(Text.Trim(Text.From(v ?? ""))), {" ", Character.FromNumber(160), "#(tab)", "#(cr)", "#(lf)"})),
					    FindColumn = (t as table, names as list) as nullable text =>
					        let cols = Table.ColumnNames(t),
					            hits = List.Transform(names, (n) => List.First(List.Select(cols, (c) => Normalize(c)=Normalize(n)), null))
					        in List.First(List.RemoveNulls(hits), null),
					    Ensure = (t as table, target as text, aliases as list) as table =>
					        let src = FindColumn(t, List.Combine({{target}, aliases}))
					        in if Table.HasColumns(t,{target}) then t else if src=null then Table.AddColumn(t,target,each null,type any) else Table.AddColumn(t,target,each Record.Field(_,src),type any),
					    CleanSheet = (wb as table, sheetName as text, kpiType as text) as table =>
					        let hit = Table.SelectRows(wb, each [Kind]="Sheet" and Normalize([Item])=Normalize(sheetName)),
					            raw = if Table.RowCount(hit)=0 then #table({}, {}) else hit{0}[Data],
					            safe = Table.ReplaceErrorValues(raw, List.Transform(Table.ColumnNames(raw), each {_,null})),
					            rows = Table.ToRows(safe),
					            idx = List.PositionOf(List.Transform(rows, each List.AnyTrue(List.Transform(_, (x)=> Normalize(x)="DỰÁN"))), true),
					            skipped = if idx<0 then safe else Table.Skip(safe,idx),
					            promoted = if idx<0 then #table({}, {}) else Table.PromoteHeaders(skipped,[PromoteAllScalars=true]),
					            mappings = {
					                {"DỰ ÁN",{}},
						                {"MÃ DỰ ÁN",{"MÃ DỰ ÁN/ĐƠN VỊ","MÃ DỰ ÁN/ĐV"}},
						                {"KHU VỰC",{"CỤM DỰ ÁN","CỤM DỰ ÁN (KHU VỰC)"}},
						                {"PBYC",{"PHÂN BỔ YÊU CẦU","PHÂN BỔ YC"}},
					                {"NGÂN SÁCH",{}},
				                {"PHÒNG",{"PHÒNG ","PHÒNG/BAN"}},
					                {"BỘ PHẬN",{"TEAM","NHÓM","BỘ PHẬN/TEAM"}},
					                {"HẠNG MỤC CUNG ỨNG - ĐẤU THẦU",{"HẠNG MỤC CÔNG VIỆC/GÓI THẦU","HẠNG MỤC ĐẤU THẦU","HẠNG MỤC"}},
					                {"PIC CẬP NHẬT",{"PIC","PIC THỰC HIỆN","PIC PHỤ TRÁCH"}},
					                {"NGÀY MỤC TIÊU BAN ĐẦU",{"MỤC TIÊU BAN ĐẦU","NGÀY MỤC TIÊU","MỤC TIÊU"}},
					                {"MỤC TIÊU ĐIỀU CHỈNH",{"NGÀY MỤC TIÊU ĐIỀU CHỈNH"}},
					                {"CƠ SỞ GHI NHẬN",{"CƠ SỞ GHI NHẬN "}},
					                {"NGÀY HOÀN THÀNH",{"KẾT QUẢ","NGÀY HOÀN TẤT"}},
				                {"NGÀY OUT HS KHỎI PHÒNG",{"NGÀY OUT HS","NGÀY CHUYỂN HS KHỎI PHÒNG"}},
					                {"TÌNH TRẠNG",{}},
					                {"TÌNH TRẠNG CỤ THỂ",{"TRẠNG THÁI CỤ THỂ"}},
					                {"GIẢI TRÌNH",{"Giải trình lí do chậm trễ (nếu có)","GIẢI TRÌNH LÝ DO CHẬM TRỄ"}},
					                {"LOẠI HS ĐẦU VÀO",{}},
				                {"TỶ LỆ HOÀN THÀNH NGUỒN",{"Tỷ lệ hoàn thành"}}
					            },
					            budgetChecked = if FindColumn(promoted,{"NGÂN SÁCH"})=null then error Error.Record("MissingBudgetColumn","Không tìm thấy cột Ngân sách trong sheet "&sheetName,[Sheet=sheetName]) else promoted,
				            standardized = List.Accumulate(mappings,budgetChecked,(s,m)=>Ensure(s,m{0},m{1})),
					            selected = Table.SelectColumns(standardized,List.Transform(mappings,each _{0}),MissingField.UseNull),
					            valid = Table.SelectRows(selected, each Text.Trim(Text.From([DỰ ÁN] ?? ""))<>""),
					            addType = Table.AddColumn(valid,"LOẠI KPI",each kpiType,type text)
					        in addType,
					    // Đọc trực tiếp file người dùng cung cấp để tránh phải liệt kê toàn bộ site PRT.
					    content = Web.Contents("https://novaland.sharepoint.com/sites/PRT/_api/web/GetFileById(guid'D4FA6E74-1B84-40F9-BBC6-E5A2BA0586C6')/$value"),
					    wb = Excel.Workbook(content,null,true),
					    combined = Table.Combine({CleanSheet(wb,"PL.PTC.01","TRONG KPI"),CleanSheet(wb,"PL.PTC.01-01","NGOÀI KPI")}),
					    typed = Table.TransformColumns(combined,{
					        {"DỰ ÁN", each try Text.Trim(Text.From(_)) otherwise null, type text},
					        {"MÃ DỰ ÁN", each try Text.Trim(Text.From(_)) otherwise null, type text},
					        {"KHU VỰC", each try Text.Trim(Text.From(_)) otherwise null, type text},
					        {"PBYC", each try Text.Trim(Text.From(_)) otherwise null, type text},
					        {"NGÂN SÁCH", each try Text.Trim(Text.Clean(Text.Replace(Text.From(_),Character.FromNumber(160)," "))) otherwise null, type text},
					        {"PHÒNG", each try Text.Trim(Text.From(_)) otherwise null, type text},
					        {"BỘ PHẬN", each try Text.Trim(Text.From(_)) otherwise null, type text},
					        {"HẠNG MỤC CUNG ỨNG - ĐẤU THẦU", each try Text.Trim(Text.From(_)) otherwise null, type text},
					        {"PIC CẬP NHẬT", each try Text.Trim(Text.From(_)) otherwise null, type text},
					        {"CƠ SỞ GHI NHẬN", each try Text.Trim(Text.From(_)) otherwise null, type text},
				        {"TÌNH TRẠNG", each let s = try Text.Upper(Text.Trim(Text.From(_))) otherwise null in if s = "ĐÃ HOÀN HÀNH" then "ĐÃ HOÀN THÀNH" else s, type text},
					        {"TÌNH TRẠNG CỤ THỂ", each try Text.Trim(Text.From(_)) otherwise null, type text},
					        {"GIẢI TRÌNH", each try Text.Trim(Text.From(_)) otherwise null, type text},
					        {"LOẠI HS ĐẦU VÀO", each try Text.Trim(Text.From(_)) otherwise null, type text},
					        {"NGÀY MỤC TIÊU BAN ĐẦU", each try Date.From(_) otherwise null, type date},
					        {"MỤC TIÊU ĐIỀU CHỈNH", each try Date.From(_) otherwise null, type date},
					        {"NGÀY HOÀN THÀNH", each try Date.From(_) otherwise null, type date},
				        {"NGÀY OUT HS KHỎI PHÒNG", each try Date.From(_) otherwise null, type date},
				        {"TỶ LỆ HOÀN THÀNH NGUỒN", each if _=null or Text.Trim(Text.From(_))="" then null else try Number.From(_) otherwise null, type number}
					    }),
					    indexedBase = Table.AddIndexColumn(typed,"MÃ CÔNG VIỆC",1,1,Int64.Type),
					    picList = Table.AddColumn(indexedBase,"PIC_LIST",each let p=Text.From([PIC CẬP NHẬT] ?? ""), xs=List.Transform(Splitter.SplitTextByAnyDelimiter({";",",","#(lf)","#(cr)","|"},QuoteStyle.Csv)(p), each Text.Trim(_)), ys=List.Distinct(List.Select(xs,each _<>"")) in if List.IsEmpty(ys) then {null} else ys),
					    expandedPic = Table.ExpandListColumn(picList,"PIC_LIST"),
					    removedPicSource = Table.RemoveColumns(expandedPic,{"PIC CẬP NHẬT"}),
					    normalizedPic = Table.RenameColumns(removedPicSource,{{"PIC_LIST","PIC CẬP NHẬT"}}),
					    addTarget = Table.AddColumn(normalizedPic,"NGÀY MỤC TIÊU TRUNG GIAN",each if [MỤC TIÊU ĐIỀU CHỈNH]=null then [NGÀY MỤC TIÊU BAN ĐẦU] else [MỤC TIÊU ĐIỀU CHỈNH],type date),
					    addStatus = Table.AddColumn(addTarget,"TÌNH TRẠNG ĐÁNH GIÁ",each Text.Trim(Text.Combine(List.RemoveNulls({[TÌNH TRẠNG],[TÌNH TRẠNG CỤ THỂ]})," - ")),type text),
					    addDays = Table.AddColumn(addStatus,"SỐ NGÀY CHÊNH LỆCH LÀM VIỆC",each
					        let t=[NGÀY MỤC TIÊU TRUNG GIAN], c=[NGÀY HOÀN THÀNH],
					            start=if t=null or c=null then null else if c<=t then c else t,
					            finish=if t=null or c=null then null else if c<=t then t else c,
					            n=if start=null then null else Duration.Days(finish-start),
					            ds=if n=null or n=0 then {} else List.Dates(Date.AddDays(start,1),n,#duration(1,0,0,0)),
					            wd=if n=null then null else List.Count(List.Select(ds, each Date.DayOfWeek(_,Day.Monday)<5))
					        in if wd=null then null else if c<=t then wd else -wd, Int64.Type),
					    addScore = Table.AddColumn(addDays,"ĐIỂM HOÀN THÀNH",each
				            let
				                p=Text.Trim(Text.Clean(Text.Replace(Text.From([PIC CẬP NHẬT] ?? ""),Character.FromNumber(160)," "))),
				                s=Text.Upper(Text.Trim(Text.Clean(Text.Replace([TÌNH TRẠNG CỤ THỂ] ?? "",Character.FromNumber(160)," ")))),
				                d=[SỐ NGÀY CHÊNH LỆCH LÀM VIỆC],
				                t=[NGÀY MỤC TIÊU TRUNG GIAN],
				                c=[NGÀY HOÀN THÀNH],
				                o=[NGÀY OUT HS KHỎI PHÒNG]
				            in
				                if p="" or t=null then null
				                else if s="PENDING DO THIẾU NGÂN SÁCH" and o<>null and o<t and Date.Year(o)=Date.Year(t) and Date.QuarterOfYear(o)=Date.QuarterOfYear(t) then 1
				                else if c=null and Text.Contains(s,"CHƯA ĐỦ HS THỰC HIỆN") then null
				                else if c=null then 0
				                else if c=t then 1
				                else if d=null then null
				                else if c<t then List.Min({1.2,1+d*0.01+(if Date.DayOfWeek(t,Day.Monday)>=5 then 0.01 else 0)})
				                else if Number.Abs(d)>20 then 0
				                else 1-Number.Abs(d)*0.01,
				            type number),
				        addRecognitionDate = Table.AddColumn(addScore,"NGÀY GHI NHẬN KỲ",each
					        let t=[NGÀY MỤC TIÊU TRUNG GIAN], c=[NGÀY HOÀN THÀNH],
					            targetKey=if t=null then null else Date.Year(t)*10+Date.QuarterOfYear(t),
					            completionKey=if c=null then null else Date.Year(c)*10+Date.QuarterOfYear(c)
					        in if t=null then null else if completionKey<>null and completionKey<targetKey then c else t, type date),
					    addRecognitionType = Table.AddColumn(addRecognitionDate,"LOẠI GHI NHẬN KỲ",each let t=[NGÀY MỤC TIÊU TRUNG GIAN], r=[NGÀY GHI NHẬN KỲ] in if t=null then "Chưa có mục tiêu" else if r<>t then "Vượt mục tiêu" else "Theo mục tiêu", type text),
					    recognized = addRecognitionType,
					    addYear = Table.AddColumn(recognized,"NĂM MỤC TIÊU",each if [NGÀY GHI NHẬN KỲ]=null then null else Date.Year([NGÀY GHI NHẬN KỲ]),Int64.Type),
					    addQuarter = Table.AddColumn(addYear,"QUÝ MỤC TIÊU",each if [NGÀY GHI NHẬN KỲ]=null then "Chưa xác định" else "Quý "&Text.From(Date.QuarterOfYear([NGÀY GHI NHẬN KỲ])),type text),
					    addPeriod = Table.AddColumn(addQuarter,"KỲ MỤC TIÊU",each if [NGÀY GHI NHẬN KỲ]=null then "Chưa có mục tiêu" else "Quý "&Text.From(Date.QuarterOfYear([NGÀY GHI NHẬN KỲ]))&" - "&Text.From([NĂM MỤC TIÊU]),type text),
					    addPeriodSort = Table.AddColumn(addPeriod,"KỲ MỤC TIÊU SORT",each if [NGÀY GHI NHẬN KỲ]=null then null else [NĂM MỤC TIÊU]*10+Date.QuarterOfYear([NGÀY GHI NHẬN KỲ]),Int64.Type),
					    addMonth = Table.AddColumn(addPeriodSort,"THÁNG MỤC TIÊU",each if [NGÀY MỤC TIÊU TRUNG GIAN]=null then null else #date(Date.Year([NGÀY MỤC TIÊU TRUNG GIAN]),Date.Month([NGÀY MỤC TIÊU TRUNG GIAN]),1),type date),
					    addMonthSort = Table.AddColumn(addMonth,"THÁNG MỤC TIÊU SORT",each if [NGÀY MỤC TIÊU TRUNG GIAN]=null then null else Date.Year([NGÀY MỤC TIÊU TRUNG GIAN])*100+Date.Month([NGÀY MỤC TIÊU TRUNG GIAN]),Int64.Type),
					    addBucket = Table.AddColumn(addMonthSort,"NHÓM NGÀY CHÊNH LỆCH",each let d=[SỐ NGÀY CHÊNH LỆCH LÀM VIỆC] in if d=null then "Chưa chấm" else if d>=0 then "Đúng/sớm hạn" else if d>=-5 then "Trễ 1-5 ngày" else if d>=-10 then "Trễ 6-10 ngày" else if d>=-20 then "Trễ 11-20 ngày" else "Trễ trên 20 ngày",type text),
					    reordered = Table.ReorderColumns(addBucket,{"MÃ CÔNG VIỆC","LOẠI KPI","DỰ ÁN","MÃ DỰ ÁN","KHU VỰC","PBYC","PHÒNG","BỘ PHẬN","HẠNG MỤC CUNG ỨNG - ĐẤU THẦU","PIC CẬP NHẬT","NGÀY MỤC TIÊU BAN ĐẦU","MỤC TIÊU ĐIỀU CHỈNH","NGÀY MỤC TIÊU TRUNG GIAN","NGÀY GHI NHẬN KỲ","LOẠI GHI NHẬN KỲ","CƠ SỞ GHI NHẬN","NGÀY HOÀN THÀNH","SỐ NGÀY CHÊNH LỆCH LÀM VIỆC","NHÓM NGÀY CHÊNH LỆCH","ĐIỂM HOÀN THÀNH","TÌNH TRẠNG","TÌNH TRẠNG CỤ THỂ","TÌNH TRẠNG ĐÁNH GIÁ","GIẢI TRÌNH","LOẠI HS ĐẦU VÀO","KỲ MỤC TIÊU","KỲ MỤC TIÊU SORT","NĂM MỤC TIÊU","QUÝ MỤC TIÊU","THÁNG MỤC TIÊU","THÁNG MỤC TIÊU SORT"})
					in
					    reordered

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Exception


	/// Đọc kết quả được tính sẵn khi refresh theo Dòng đăng ký; điều kiện chọn một PIC, năm và kỳ quý vẫn được kiểm tra khi hiển thị. Tối ưu A1 ngày 16/11/2026.
	measure 'Template Điểm QTHD Q4' =
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=4))>0
			VAR _ID=SELECTEDVALUE('KPI Đăng ký'[Dòng nguồn])
			RETURN IF(HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && [Template Dòng hiển thị]=1 && _QuarterIn,
			LOOKUPVALUE('Template KPI Kết quả lưu'[Điểm QTHD Q4],'Template KPI Kết quả lưu'[Dòng đăng ký],_ID))
		formatString: 0.00%
		displayFolder: TEMPLATE KPI
		lineageTag: 59d51d44-5393-43d4-921b-a58232a5b7d6

	/// Tính sẵn TEMPLATE theo dòng đăng ký khi refresh. TDDT: ngân sách Dự án = 80% tỷ lệ hoàn thành + 20% PCD đúng quý báo cáo; còn lại kể cả rỗng = nguyên tỷ lệ hoàn thành. Thay điều kiện OPEX cũ. PCD rỗng=0; Q4 tiến độ cả năm + PCD4. Giữ phạm vi CN/TH1/TH2 và trần các mã CV khác. Cập nhật 20/11/2026.
	measure 'Template Kết quả cá nhân Q1' =
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _PIC=SELECTEDVALUE('KPI Đăng ký'[PIC])
			VAR _Dept=UPPER(TRIM([Template Phòng theo DMNV]))
			VAR _Scope=UPPER(TRIM([Template Phạm vi ghi nhận]))
			VAR _Level=UPPER(TRIM([Template Cấp tính điểm]))
			VAR _ID=IFERROR(VALUE(SELECTEDVALUE('KPI Đăng ký'[Mã NV])),BLANK())
			VAR _Self=FILTER(ALL('KPI Nhân sự'),IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC))
			VAR _SelfID=MAXX(_Self,'KPI Nhân sự'[Mã NV chuẩn])
			VAR _Group=_Scope="BAN - PIC" && _PIC<>"BAN PTC" && (_Level="TH1" || LEFT(_Level,3)="TH2")
			VAR _Department=SWITCH(_Level,"TH2-PRO","PRO","TH2-BMD","BMD",BLANK())
			VAR _SelfCount=COUNTROWS(_Self)
			VAR _ApplyStaff=_Group || (_Scope="BAN - PIC" && _PIC<>"BAN PTC" && _SelfCount=1)
			VAR _EffectiveStaff=FILTER(ALL('KPI Nhân sự'),
			IF(_Group,IF(NOT ISBLANK(_Department),
			UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Phòng],UNICHAR(160)," ")))=_Department,
			NOT ISBLANK(_SelfID) && PATHCONTAINS('KPI Nhân sự'[Đường dẫn quản lý],_SelfID)),
			IF(_ApplyStaff,IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC),TRUE())))
			VAR _MemberNames=SELECTCOLUMNS(_EffectiveStaff,"_Name",UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Họ và tên],UNICHAR(160)," "))))
			VAR _UseTeam=_ApplyStaff
			VAR _AllBan=_PIC="BAN PTC" || _Scope="CHUNG" || (_Code="TDSP" && _Dept="PAS")
			VAR _DeptScope=_Scope="BAN - PHÒNG" && NOT _AllBan
			VAR _ValidScope=_AllBan || _Scope="BAN - PIC" || (_DeptScope && NOT ISBLANK(_Dept) && _Dept<>"")
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Unit = UPPER(TRIM(SUBSTITUTE([Template Đơn vị tính áp dụng],UNICHAR(160)," ")))
			VAR _Percent = CONTAINSSTRING(_Unit,"%")
			VAR _Count = _Unit IN {"SỐ LƯỢNG","SL"}
			VAR _Money = CONTAINSSTRING(_Unit,"TỶ")
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=1))>0
			VAR _Start=DATE(_Y,IF(_Count,1,1),1)
			VAR _End=EOMONTH(DATE(_Y,3,1),0)
			VAR _Dates=CALENDAR(_Start,_End)
			RETURN IF(HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && _QuarterIn && NOT ISBLANK(_PIC) && _ValidScope,
			SWITCH(_Code,
			"TDDT",VAR _Progress=FILTER(CALCULATETABLE(SUMMARIZE('KPI Tiến độ thầu','KPI Tiến độ thầu'[PIC CẬP NHẬT],'KPI Tiến độ thầu'[PHÒNG]),REMOVEFILTERS('KPI Tiến độ thầu')),_AllBan || IF(NOT ISBLANK(_Department),UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[PHÒNG],UNICHAR(160)," ")))=_Department,IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[PIC CẬP NHẬT],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[PIC CẬP NHẬT],UNICHAR(160)," ")))=UPPER(TRIM(_PIC)))))
			VAR _PCDQuarterDates=CALENDAR(DATE(_Y,1,1),EOMONTH(DATE(_Y,3,1),0))
			VAR _ReportPCD=COALESCE(CALCULATE([TĐT Điểm PCD],REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_PCDQuarterDates,'Kỳ đánh giá đấu thầu'[Ngày])),0)
			VAR _TenderScore=CALCULATE(
			    AVERAGEX(VALUES('KPI Tiến độ thầu'[MÃ CÔNG VIỆC]),
			        VAR _Ratio=[TĐT Tỷ lệ hoàn thành]
			        VAR _Budget=UPPER(TRIM(SUBSTITUTE(CALCULATE(MAX('KPI Tiến độ thầu'[NGÂN SÁCH])),UNICHAR(160)," ")))
			        RETURN IF(NOT ISBLANK(_Ratio),IF(_Budget="DỰ ÁN",0.8*_Ratio+0.2*_ReportPCD,_Ratio))),
			    REMOVEFILTERS('KPI Tiến độ thầu'),_Progress,
			    REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_Dates,'Kỳ đánh giá đấu thầu'[Ngày]))
			RETURN IF(_Percent && NOT ISBLANK(_TenderScore),100*_TenderScore),
			"TUNC",VAR _TU=FILTER(CALCULATETABLE(SUMMARIZE('KPI TUNC Nguồn','KPI TUNC Nguồn'[Phòng],'KPI TUNC Nguồn'[PIC]),REMOVEFILTERS('KPI TUNC Nguồn')),_AllBan || IF(_DeptScope,UPPER(TRIM('KPI TUNC Nguồn'[Phòng]))=_Dept || (_Dept="BMD" && UPPER(TRIM('KPI TUNC Nguồn'[Phòng])) IN {"BMD XD","BMD TV"}),'KPI TUNC Nguồn'[PIC]=_PIC))
			RETURN IF(_Count,CALCULATE([TUNC Tổng hoàn thành],REMOVEFILTERS('KPI TUNC Nguồn'),_TU,REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_Dates,'Kỳ đánh giá đấu thầu'[Ngày])),IF(_Percent,100*CALCULATE(AVERAGEX(VALUES('KPI TUNC Nguồn'[Dòng nguồn]),[TUNC Điểm dòng]),REMOVEFILTERS('KPI TUNC Nguồn'),_TU,REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_Dates,'Kỳ đánh giá đấu thầu'[Ngày])))),
			"QTHD",VAR _QT=FILTER(CALCULATETABLE(SUMMARIZE('KPI QTHD','KPI QTHD'[PIC]),REMOVEFILTERS('KPI QTHD')),_AllBan || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC))))
			RETURN IF(_Count,CALCULATE([QTHD Hoàn thành trong kỳ],REMOVEFILTERS('KPI QTHD'),_QT,REMOVEFILTERS('DimDate'),TREATAS(_Dates,'DimDate'[Date])),IF(_Percent,100*[Template Điểm QTHD cá nhân Q1])),
			"TTHD",VAR _TT=FILTER(CALCULATETABLE(SUMMARIZE('KPI TTHD','KPI TTHD'[PIC],'KPI TTHD'[NGÀY NHẬN HS]),REMOVEFILTERS('KPI TTHD')),(_AllBan || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI TTHD'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI TTHD'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC)))) && NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) && 'KPI TTHD'[NGÀY NHẬN HS]>=_Start && 'KPI TTHD'[NGÀY NHẬN HS]<=_End)
			RETURN IF(_Percent,100*CALCULATE(CALCULATE(AVERAGEX(VALUES('KPI TTHD'[MÃ HỒ SƠ]),CALCULATE(MAX('KPI TTHD'[ĐIỂM HOÀN THÀNH]))),KEEPFILTERS(TREATAS(VALUES('DimDate'[Date]),'KPI TTHD'[NGÀY NHẬN HS]))),REMOVEFILTERS('KPI TTHD'),_TT,REMOVEFILTERS('DimDate'),TREATAS(_Dates,'DimDate'[Date]))),
			"GHBL",VAR _BL=FILTER(CALCULATETABLE(SUMMARIZE('KPI GHBL','KPI GHBL'[PIC],'KPI GHBL'[NGÀY HẾT HẠN CŨ]),REMOVEFILTERS('KPI GHBL')),(_AllBan || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI GHBL'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI GHBL'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC)))) && NOT ISBLANK('KPI GHBL'[NGÀY HẾT HẠN CŨ]) && 'KPI GHBL'[NGÀY HẾT HẠN CŨ]>=_Start && 'KPI GHBL'[NGÀY HẾT HẠN CŨ]<=_End)
			RETURN IF(_Percent,100*CALCULATE(AVERAGEX(VALUES('KPI GHBL'[MÃ LƯỢT]),CALCULATE(MAX('KPI GHBL'[ĐIỂM HOÀN THÀNH]))),REMOVEFILTERS('KPI GHBL'),_BL,REMOVEFILTERS('DimDate'))),
			"TDSP",VAR _TD=FILTER(CALCULATETABLE(SUMMARIZE('KPI TDSP Nguồn','KPI TDSP Nguồn'[Phòng],'KPI TDSP Nguồn'[PIC],'KPI TDSP Nguồn'[PIC TP]),REMOVEFILTERS('KPI TDSP Nguồn')),_AllBan || IF(_DeptScope,UPPER(TRIM('KPI TDSP Nguồn'[Phòng]))=_Dept,'KPI TDSP Nguồn'[PIC]=_PIC || 'KPI TDSP Nguồn'[PIC TP]=_PIC))
			VAR _Ban=LOOKUPVALUE('BI_Data'[Điểm hoàn thành tính toán],'BI_Data'[Mã CV],_Code,'BI_Data'[Quý],1,'BI_Data'[Năm],_Y,'BI_Data'[PIC],"BAN PTC")
			RETURN IF(_Money,IF(_AllBan,_Ban,IF(_DeptScope,CALCULATE([TDSP Công nợ tỷ đồng],REMOVEFILTERS('KPI TDSP Nguồn'),_TD,REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(CALENDAR(DATE(_Y,1,1),_End),'Kỳ đánh giá đấu thầu'[Ngày])))),IF(_Percent && _Scope="CHUNG",100*_Ban)),
			VAR _Ban=LOOKUPVALUE('BI_Data'[Điểm hoàn thành tính toán],'BI_Data'[Mã CV],_Code,'BI_Data'[Quý],1,'BI_Data'[Năm],_Y,'BI_Data'[PIC],"BAN PTC")
			RETURN IF(_Percent && _Scope="CHUNG",100*_Ban)))
		displayFolder: TEMPLATE KPI\Cá nhân
		lineageTag: 6a8a3975-fb26-4bfd-bceb-3604abc671df

	/// Tính điểm nguồn trước điều kiện hiển thị, dùng để tính sẵn bảng Template KPI Kết quả lưu khi refresh. Quy tắc kỳ, CN/TH1/TH2, OPEX/PCD, trần QTHD/TDSP giữ nguyên.
	measure 'Template Điểm QTHD cá nhân Q1' =
			VAR _PIC=SELECTEDVALUE('KPI Đăng ký'[PIC])
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _Scope=UPPER(TRIM([Template Phạm vi ghi nhận]))
			VAR _Level=UPPER(TRIM([Template Cấp tính điểm]))
			VAR _ID=IFERROR(VALUE(SELECTEDVALUE('KPI Đăng ký'[Mã NV])),BLANK())
			VAR _Self=FILTER(ALL('KPI Nhân sự'),IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC))
			VAR _SelfID=MAXX(_Self,'KPI Nhân sự'[Mã NV chuẩn])
			VAR _Group=_Scope="BAN - PIC" && _PIC<>"BAN PTC" && (_Level="TH1" || LEFT(_Level,3)="TH2")
			VAR _Department=SWITCH(_Level,"TH2-PRO","PRO","TH2-BMD","BMD",BLANK())
			VAR _SelfCount=COUNTROWS(_Self)
			VAR _ApplyStaff=_Group || (_Scope="BAN - PIC" && _PIC<>"BAN PTC" && _SelfCount=1)
			VAR _EffectiveStaff=FILTER(ALL('KPI Nhân sự'),
			IF(_Group,IF(NOT ISBLANK(_Department),
			UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Phòng],UNICHAR(160)," ")))=_Department,
			NOT ISBLANK(_SelfID) && PATHCONTAINS('KPI Nhân sự'[Đường dẫn quản lý],_SelfID)),
			IF(_ApplyStaff,IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC),TRUE())))
			VAR _MemberNames=SELECTCOLUMNS(_EffectiveStaff,"_Name",UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Họ và tên],UNICHAR(160)," "))))
			VAR _UseTeam=_ApplyStaff
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=1))>0
			VAR _Dates=CALENDAR(DATE(_Y,1,1),EOMONTH(DATE(_Y,3,1),0))
			VAR _Rows=FILTER(CALCULATETABLE(SUMMARIZE('KPI QTHD','KPI QTHD'[PIC]),REMOVEFILTERS('KPI QTHD')),_PIC="BAN PTC" || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC))))
			RETURN IF(_Code="QTHD" && HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && _QuarterIn && NOT ISBLANK(_PIC) && (_PIC="BAN PTC" || _Scope="BAN - PIC"),
			CALCULATE([QTHD Điểm hoàn thành],REMOVEFILTERS('KPI QTHD'),_Rows,REMOVEFILTERS('DimDate'),TREATAS(_Dates,'DimDate'[Date])))
		formatString: 0.00%
		displayFolder: TEMPLATE KPI\Cá nhân
		lineageTag: 7a900516-bbe9-4941-9b01-d4505775ee3c

	/// Tính sẵn TEMPLATE theo dòng đăng ký khi refresh. TDDT: ngân sách Dự án = 80% tỷ lệ hoàn thành + 20% PCD đúng quý báo cáo; còn lại kể cả rỗng = nguyên tỷ lệ hoàn thành. Thay điều kiện OPEX cũ. PCD rỗng=0; Q4 tiến độ cả năm + PCD4. Giữ phạm vi CN/TH1/TH2 và trần các mã CV khác. Cập nhật 20/11/2026.
	measure 'Template Kết quả cá nhân Q2' =
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _PIC=SELECTEDVALUE('KPI Đăng ký'[PIC])
			VAR _Dept=UPPER(TRIM([Template Phòng theo DMNV]))
			VAR _Scope=UPPER(TRIM([Template Phạm vi ghi nhận]))
			VAR _Level=UPPER(TRIM([Template Cấp tính điểm]))
			VAR _ID=IFERROR(VALUE(SELECTEDVALUE('KPI Đăng ký'[Mã NV])),BLANK())
			VAR _Self=FILTER(ALL('KPI Nhân sự'),IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC))
			VAR _SelfID=MAXX(_Self,'KPI Nhân sự'[Mã NV chuẩn])
			VAR _Group=_Scope="BAN - PIC" && _PIC<>"BAN PTC" && (_Level="TH1" || LEFT(_Level,3)="TH2")
			VAR _Department=SWITCH(_Level,"TH2-PRO","PRO","TH2-BMD","BMD",BLANK())
			VAR _SelfCount=COUNTROWS(_Self)
			VAR _ApplyStaff=_Group || (_Scope="BAN - PIC" && _PIC<>"BAN PTC" && _SelfCount=1)
			VAR _EffectiveStaff=FILTER(ALL('KPI Nhân sự'),
			IF(_Group,IF(NOT ISBLANK(_Department),
			UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Phòng],UNICHAR(160)," ")))=_Department,
			NOT ISBLANK(_SelfID) && PATHCONTAINS('KPI Nhân sự'[Đường dẫn quản lý],_SelfID)),
			IF(_ApplyStaff,IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC),TRUE())))
			VAR _MemberNames=SELECTCOLUMNS(_EffectiveStaff,"_Name",UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Họ và tên],UNICHAR(160)," "))))
			VAR _UseTeam=_ApplyStaff
			VAR _AllBan=_PIC="BAN PTC" || _Scope="CHUNG" || (_Code="TDSP" && _Dept="PAS")
			VAR _DeptScope=_Scope="BAN - PHÒNG" && NOT _AllBan
			VAR _ValidScope=_AllBan || _Scope="BAN - PIC" || (_DeptScope && NOT ISBLANK(_Dept) && _Dept<>"")
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Unit = UPPER(TRIM(SUBSTITUTE([Template Đơn vị tính áp dụng],UNICHAR(160)," ")))
			VAR _Percent = CONTAINSSTRING(_Unit,"%")
			VAR _Count = _Unit IN {"SỐ LƯỢNG","SL"}
			VAR _Money = CONTAINSSTRING(_Unit,"TỶ")
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=2))>0
			VAR _Start=DATE(_Y,IF(_Count,1,4),1)
			VAR _End=EOMONTH(DATE(_Y,6,1),0)
			VAR _Dates=CALENDAR(_Start,_End)
			RETURN IF(HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && _QuarterIn && NOT ISBLANK(_PIC) && _ValidScope,
			SWITCH(_Code,
			"TDDT",VAR _Progress=FILTER(CALCULATETABLE(SUMMARIZE('KPI Tiến độ thầu','KPI Tiến độ thầu'[PIC CẬP NHẬT],'KPI Tiến độ thầu'[PHÒNG]),REMOVEFILTERS('KPI Tiến độ thầu')),_AllBan || IF(NOT ISBLANK(_Department),UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[PHÒNG],UNICHAR(160)," ")))=_Department,IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[PIC CẬP NHẬT],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[PIC CẬP NHẬT],UNICHAR(160)," ")))=UPPER(TRIM(_PIC)))))
			VAR _PCDQuarterDates=CALENDAR(DATE(_Y,4,1),EOMONTH(DATE(_Y,6,1),0))
			VAR _ReportPCD=COALESCE(CALCULATE([TĐT Điểm PCD],REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_PCDQuarterDates,'Kỳ đánh giá đấu thầu'[Ngày])),0)
			VAR _TenderScore=CALCULATE(
			    AVERAGEX(VALUES('KPI Tiến độ thầu'[MÃ CÔNG VIỆC]),
			        VAR _Ratio=[TĐT Tỷ lệ hoàn thành]
			        VAR _Budget=UPPER(TRIM(SUBSTITUTE(CALCULATE(MAX('KPI Tiến độ thầu'[NGÂN SÁCH])),UNICHAR(160)," ")))
			        RETURN IF(NOT ISBLANK(_Ratio),IF(_Budget="DỰ ÁN",0.8*_Ratio+0.2*_ReportPCD,_Ratio))),
			    REMOVEFILTERS('KPI Tiến độ thầu'),_Progress,
			    REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_Dates,'Kỳ đánh giá đấu thầu'[Ngày]))
			RETURN IF(_Percent && NOT ISBLANK(_TenderScore),100*_TenderScore),
			"TUNC",VAR _TU=FILTER(CALCULATETABLE(SUMMARIZE('KPI TUNC Nguồn','KPI TUNC Nguồn'[Phòng],'KPI TUNC Nguồn'[PIC]),REMOVEFILTERS('KPI TUNC Nguồn')),_AllBan || IF(_DeptScope,UPPER(TRIM('KPI TUNC Nguồn'[Phòng]))=_Dept || (_Dept="BMD" && UPPER(TRIM('KPI TUNC Nguồn'[Phòng])) IN {"BMD XD","BMD TV"}),'KPI TUNC Nguồn'[PIC]=_PIC))
			RETURN IF(_Count,CALCULATE([TUNC Tổng hoàn thành],REMOVEFILTERS('KPI TUNC Nguồn'),_TU,REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_Dates,'Kỳ đánh giá đấu thầu'[Ngày])),IF(_Percent,100*CALCULATE(AVERAGEX(VALUES('KPI TUNC Nguồn'[Dòng nguồn]),[TUNC Điểm dòng]),REMOVEFILTERS('KPI TUNC Nguồn'),_TU,REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_Dates,'Kỳ đánh giá đấu thầu'[Ngày])))),
			"QTHD",VAR _QT=FILTER(CALCULATETABLE(SUMMARIZE('KPI QTHD','KPI QTHD'[PIC]),REMOVEFILTERS('KPI QTHD')),_AllBan || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC))))
			RETURN IF(_Count,CALCULATE([QTHD Hoàn thành trong kỳ],REMOVEFILTERS('KPI QTHD'),_QT,REMOVEFILTERS('DimDate'),TREATAS(_Dates,'DimDate'[Date])),IF(_Percent,100*[Template Điểm QTHD cá nhân Q2])),
			"TTHD",VAR _TT=FILTER(CALCULATETABLE(SUMMARIZE('KPI TTHD','KPI TTHD'[PIC],'KPI TTHD'[NGÀY NHẬN HS]),REMOVEFILTERS('KPI TTHD')),(_AllBan || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI TTHD'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI TTHD'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC)))) && NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) && 'KPI TTHD'[NGÀY NHẬN HS]>=_Start && 'KPI TTHD'[NGÀY NHẬN HS]<=_End)
			RETURN IF(_Percent,100*CALCULATE(CALCULATE(AVERAGEX(VALUES('KPI TTHD'[MÃ HỒ SƠ]),CALCULATE(MAX('KPI TTHD'[ĐIỂM HOÀN THÀNH]))),KEEPFILTERS(TREATAS(VALUES('DimDate'[Date]),'KPI TTHD'[NGÀY NHẬN HS]))),REMOVEFILTERS('KPI TTHD'),_TT,REMOVEFILTERS('DimDate'),TREATAS(_Dates,'DimDate'[Date]))),
			"GHBL",VAR _BL=FILTER(CALCULATETABLE(SUMMARIZE('KPI GHBL','KPI GHBL'[PIC],'KPI GHBL'[NGÀY HẾT HẠN CŨ]),REMOVEFILTERS('KPI GHBL')),(_AllBan || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI GHBL'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI GHBL'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC)))) && NOT ISBLANK('KPI GHBL'[NGÀY HẾT HẠN CŨ]) && 'KPI GHBL'[NGÀY HẾT HẠN CŨ]>=_Start && 'KPI GHBL'[NGÀY HẾT HẠN CŨ]<=_End)
			RETURN IF(_Percent,100*CALCULATE(AVERAGEX(VALUES('KPI GHBL'[MÃ LƯỢT]),CALCULATE(MAX('KPI GHBL'[ĐIỂM HOÀN THÀNH]))),REMOVEFILTERS('KPI GHBL'),_BL,REMOVEFILTERS('DimDate'))),
			"TDSP",VAR _TD=FILTER(CALCULATETABLE(SUMMARIZE('KPI TDSP Nguồn','KPI TDSP Nguồn'[Phòng],'KPI TDSP Nguồn'[PIC],'KPI TDSP Nguồn'[PIC TP]),REMOVEFILTERS('KPI TDSP Nguồn')),_AllBan || IF(_DeptScope,UPPER(TRIM('KPI TDSP Nguồn'[Phòng]))=_Dept,'KPI TDSP Nguồn'[PIC]=_PIC || 'KPI TDSP Nguồn'[PIC TP]=_PIC))
			VAR _Ban=LOOKUPVALUE('BI_Data'[Điểm hoàn thành tính toán],'BI_Data'[Mã CV],_Code,'BI_Data'[Quý],2,'BI_Data'[Năm],_Y,'BI_Data'[PIC],"BAN PTC")
			RETURN IF(_Money,IF(_AllBan,_Ban,IF(_DeptScope,CALCULATE([TDSP Công nợ tỷ đồng],REMOVEFILTERS('KPI TDSP Nguồn'),_TD,REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(CALENDAR(DATE(_Y,1,1),_End),'Kỳ đánh giá đấu thầu'[Ngày])))),IF(_Percent && _Scope="CHUNG",100*_Ban)),
			VAR _Ban=LOOKUPVALUE('BI_Data'[Điểm hoàn thành tính toán],'BI_Data'[Mã CV],_Code,'BI_Data'[Quý],2,'BI_Data'[Năm],_Y,'BI_Data'[PIC],"BAN PTC")
			RETURN IF(_Percent && _Scope="CHUNG",100*_Ban)))
		displayFolder: TEMPLATE KPI\Cá nhân
		lineageTag: 45546d7d-99f2-46d5-a0e5-693f5bda4ed5

	/// Tính điểm nguồn trước điều kiện hiển thị, dùng để tính sẵn bảng Template KPI Kết quả lưu khi refresh. Quy tắc kỳ, CN/TH1/TH2, OPEX/PCD, trần QTHD/TDSP giữ nguyên.
	measure 'Template Điểm QTHD cá nhân Q2' =
			VAR _PIC=SELECTEDVALUE('KPI Đăng ký'[PIC])
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _Scope=UPPER(TRIM([Template Phạm vi ghi nhận]))
			VAR _Level=UPPER(TRIM([Template Cấp tính điểm]))
			VAR _ID=IFERROR(VALUE(SELECTEDVALUE('KPI Đăng ký'[Mã NV])),BLANK())
			VAR _Self=FILTER(ALL('KPI Nhân sự'),IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC))
			VAR _SelfID=MAXX(_Self,'KPI Nhân sự'[Mã NV chuẩn])
			VAR _Group=_Scope="BAN - PIC" && _PIC<>"BAN PTC" && (_Level="TH1" || LEFT(_Level,3)="TH2")
			VAR _Department=SWITCH(_Level,"TH2-PRO","PRO","TH2-BMD","BMD",BLANK())
			VAR _SelfCount=COUNTROWS(_Self)
			VAR _ApplyStaff=_Group || (_Scope="BAN - PIC" && _PIC<>"BAN PTC" && _SelfCount=1)
			VAR _EffectiveStaff=FILTER(ALL('KPI Nhân sự'),
			IF(_Group,IF(NOT ISBLANK(_Department),
			UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Phòng],UNICHAR(160)," ")))=_Department,
			NOT ISBLANK(_SelfID) && PATHCONTAINS('KPI Nhân sự'[Đường dẫn quản lý],_SelfID)),
			IF(_ApplyStaff,IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC),TRUE())))
			VAR _MemberNames=SELECTCOLUMNS(_EffectiveStaff,"_Name",UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Họ và tên],UNICHAR(160)," "))))
			VAR _UseTeam=_ApplyStaff
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=2))>0
			VAR _Dates=CALENDAR(DATE(_Y,4,1),EOMONTH(DATE(_Y,6,1),0))
			VAR _Rows=FILTER(CALCULATETABLE(SUMMARIZE('KPI QTHD','KPI QTHD'[PIC]),REMOVEFILTERS('KPI QTHD')),_PIC="BAN PTC" || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC))))
			RETURN IF(_Code="QTHD" && HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && _QuarterIn && NOT ISBLANK(_PIC) && (_PIC="BAN PTC" || _Scope="BAN - PIC"),
			CALCULATE([QTHD Điểm hoàn thành],REMOVEFILTERS('KPI QTHD'),_Rows,REMOVEFILTERS('DimDate'),TREATAS(_Dates,'DimDate'[Date])))
		formatString: 0.00%
		displayFolder: TEMPLATE KPI\Cá nhân
		lineageTag: 77791608-7457-4dba-b7df-2a1161a28691

	/// Tính sẵn TEMPLATE theo dòng đăng ký khi refresh. TDDT: ngân sách Dự án = 80% tỷ lệ hoàn thành + 20% PCD đúng quý báo cáo; còn lại kể cả rỗng = nguyên tỷ lệ hoàn thành. Thay điều kiện OPEX cũ. PCD rỗng=0; Q4 tiến độ cả năm + PCD4. Giữ phạm vi CN/TH1/TH2 và trần các mã CV khác. Cập nhật 20/11/2026.
	measure 'Template Kết quả cá nhân Q3' =
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _PIC=SELECTEDVALUE('KPI Đăng ký'[PIC])
			VAR _Dept=UPPER(TRIM([Template Phòng theo DMNV]))
			VAR _Scope=UPPER(TRIM([Template Phạm vi ghi nhận]))
			VAR _Level=UPPER(TRIM([Template Cấp tính điểm]))
			VAR _ID=IFERROR(VALUE(SELECTEDVALUE('KPI Đăng ký'[Mã NV])),BLANK())
			VAR _Self=FILTER(ALL('KPI Nhân sự'),IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC))
			VAR _SelfID=MAXX(_Self,'KPI Nhân sự'[Mã NV chuẩn])
			VAR _Group=_Scope="BAN - PIC" && _PIC<>"BAN PTC" && (_Level="TH1" || LEFT(_Level,3)="TH2")
			VAR _Department=SWITCH(_Level,"TH2-PRO","PRO","TH2-BMD","BMD",BLANK())
			VAR _SelfCount=COUNTROWS(_Self)
			VAR _ApplyStaff=_Group || (_Scope="BAN - PIC" && _PIC<>"BAN PTC" && _SelfCount=1)
			VAR _EffectiveStaff=FILTER(ALL('KPI Nhân sự'),
			IF(_Group,IF(NOT ISBLANK(_Department),
			UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Phòng],UNICHAR(160)," ")))=_Department,
			NOT ISBLANK(_SelfID) && PATHCONTAINS('KPI Nhân sự'[Đường dẫn quản lý],_SelfID)),
			IF(_ApplyStaff,IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC),TRUE())))
			VAR _MemberNames=SELECTCOLUMNS(_EffectiveStaff,"_Name",UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Họ và tên],UNICHAR(160)," "))))
			VAR _UseTeam=_ApplyStaff
			VAR _AllBan=_PIC="BAN PTC" || _Scope="CHUNG" || (_Code="TDSP" && _Dept="PAS")
			VAR _DeptScope=_Scope="BAN - PHÒNG" && NOT _AllBan
			VAR _ValidScope=_AllBan || _Scope="BAN - PIC" || (_DeptScope && NOT ISBLANK(_Dept) && _Dept<>"")
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Unit = UPPER(TRIM(SUBSTITUTE([Template Đơn vị tính áp dụng],UNICHAR(160)," ")))
			VAR _Percent = CONTAINSSTRING(_Unit,"%")
			VAR _Count = _Unit IN {"SỐ LƯỢNG","SL"}
			VAR _Money = CONTAINSSTRING(_Unit,"TỶ")
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=3))>0
			VAR _Start=DATE(_Y,IF(_Count,1,7),1)
			VAR _End=EOMONTH(DATE(_Y,9,1),0)
			VAR _Dates=CALENDAR(_Start,_End)
			RETURN IF(HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && _QuarterIn && NOT ISBLANK(_PIC) && _ValidScope,
			SWITCH(_Code,
			"TDDT",VAR _Progress=FILTER(CALCULATETABLE(SUMMARIZE('KPI Tiến độ thầu','KPI Tiến độ thầu'[PIC CẬP NHẬT],'KPI Tiến độ thầu'[PHÒNG]),REMOVEFILTERS('KPI Tiến độ thầu')),_AllBan || IF(NOT ISBLANK(_Department),UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[PHÒNG],UNICHAR(160)," ")))=_Department,IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[PIC CẬP NHẬT],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[PIC CẬP NHẬT],UNICHAR(160)," ")))=UPPER(TRIM(_PIC)))))
			VAR _PCDQuarterDates=CALENDAR(DATE(_Y,7,1),EOMONTH(DATE(_Y,9,1),0))
			VAR _ReportPCD=COALESCE(CALCULATE([TĐT Điểm PCD],REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_PCDQuarterDates,'Kỳ đánh giá đấu thầu'[Ngày])),0)
			VAR _TenderScore=CALCULATE(
			    AVERAGEX(VALUES('KPI Tiến độ thầu'[MÃ CÔNG VIỆC]),
			        VAR _Ratio=[TĐT Tỷ lệ hoàn thành]
			        VAR _Budget=UPPER(TRIM(SUBSTITUTE(CALCULATE(MAX('KPI Tiến độ thầu'[NGÂN SÁCH])),UNICHAR(160)," ")))
			        RETURN IF(NOT ISBLANK(_Ratio),IF(_Budget="DỰ ÁN",0.8*_Ratio+0.2*_ReportPCD,_Ratio))),
			    REMOVEFILTERS('KPI Tiến độ thầu'),_Progress,
			    REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_Dates,'Kỳ đánh giá đấu thầu'[Ngày]))
			RETURN IF(_Percent && NOT ISBLANK(_TenderScore),100*_TenderScore),
			"TUNC",VAR _TU=FILTER(CALCULATETABLE(SUMMARIZE('KPI TUNC Nguồn','KPI TUNC Nguồn'[Phòng],'KPI TUNC Nguồn'[PIC]),REMOVEFILTERS('KPI TUNC Nguồn')),_AllBan || IF(_DeptScope,UPPER(TRIM('KPI TUNC Nguồn'[Phòng]))=_Dept || (_Dept="BMD" && UPPER(TRIM('KPI TUNC Nguồn'[Phòng])) IN {"BMD XD","BMD TV"}),'KPI TUNC Nguồn'[PIC]=_PIC))
			RETURN IF(_Count,CALCULATE([TUNC Tổng hoàn thành],REMOVEFILTERS('KPI TUNC Nguồn'),_TU,REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_Dates,'Kỳ đánh giá đấu thầu'[Ngày])),IF(_Percent,100*CALCULATE(AVERAGEX(VALUES('KPI TUNC Nguồn'[Dòng nguồn]),[TUNC Điểm dòng]),REMOVEFILTERS('KPI TUNC Nguồn'),_TU,REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_Dates,'Kỳ đánh giá đấu thầu'[Ngày])))),
			"QTHD",VAR _QT=FILTER(CALCULATETABLE(SUMMARIZE('KPI QTHD','KPI QTHD'[PIC]),REMOVEFILTERS('KPI QTHD')),_AllBan || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC))))
			RETURN IF(_Count,CALCULATE([QTHD Hoàn thành trong kỳ],REMOVEFILTERS('KPI QTHD'),_QT,REMOVEFILTERS('DimDate'),TREATAS(_Dates,'DimDate'[Date])),IF(_Percent,100*[Template Điểm QTHD cá nhân Q3])),
			"TTHD",VAR _TT=FILTER(CALCULATETABLE(SUMMARIZE('KPI TTHD','KPI TTHD'[PIC],'KPI TTHD'[NGÀY NHẬN HS]),REMOVEFILTERS('KPI TTHD')),(_AllBan || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI TTHD'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI TTHD'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC)))) && NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) && 'KPI TTHD'[NGÀY NHẬN HS]>=_Start && 'KPI TTHD'[NGÀY NHẬN HS]<=_End)
			RETURN IF(_Percent,100*CALCULATE(CALCULATE(AVERAGEX(VALUES('KPI TTHD'[MÃ HỒ SƠ]),CALCULATE(MAX('KPI TTHD'[ĐIỂM HOÀN THÀNH]))),KEEPFILTERS(TREATAS(VALUES('DimDate'[Date]),'KPI TTHD'[NGÀY NHẬN HS]))),REMOVEFILTERS('KPI TTHD'),_TT,REMOVEFILTERS('DimDate'),TREATAS(_Dates,'DimDate'[Date]))),
			"GHBL",VAR _BL=FILTER(CALCULATETABLE(SUMMARIZE('KPI GHBL','KPI GHBL'[PIC],'KPI GHBL'[NGÀY HẾT HẠN CŨ]),REMOVEFILTERS('KPI GHBL')),(_AllBan || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI GHBL'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI GHBL'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC)))) && NOT ISBLANK('KPI GHBL'[NGÀY HẾT HẠN CŨ]) && 'KPI GHBL'[NGÀY HẾT HẠN CŨ]>=_Start && 'KPI GHBL'[NGÀY HẾT HẠN CŨ]<=_End)
			RETURN IF(_Percent,100*CALCULATE(AVERAGEX(VALUES('KPI GHBL'[MÃ LƯỢT]),CALCULATE(MAX('KPI GHBL'[ĐIỂM HOÀN THÀNH]))),REMOVEFILTERS('KPI GHBL'),_BL,REMOVEFILTERS('DimDate'))),
			"TDSP",VAR _TD=FILTER(CALCULATETABLE(SUMMARIZE('KPI TDSP Nguồn','KPI TDSP Nguồn'[Phòng],'KPI TDSP Nguồn'[PIC],'KPI TDSP Nguồn'[PIC TP]),REMOVEFILTERS('KPI TDSP Nguồn')),_AllBan || IF(_DeptScope,UPPER(TRIM('KPI TDSP Nguồn'[Phòng]))=_Dept,'KPI TDSP Nguồn'[PIC]=_PIC || 'KPI TDSP Nguồn'[PIC TP]=_PIC))
			VAR _Ban=LOOKUPVALUE('BI_Data'[Điểm hoàn thành tính toán],'BI_Data'[Mã CV],_Code,'BI_Data'[Quý],3,'BI_Data'[Năm],_Y,'BI_Data'[PIC],"BAN PTC")
			RETURN IF(_Money,IF(_AllBan,_Ban,IF(_DeptScope,CALCULATE([TDSP Công nợ tỷ đồng],REMOVEFILTERS('KPI TDSP Nguồn'),_TD,REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(CALENDAR(DATE(_Y,1,1),_End),'Kỳ đánh giá đấu thầu'[Ngày])))),IF(_Percent && _Scope="CHUNG",100*_Ban)),
			VAR _Ban=LOOKUPVALUE('BI_Data'[Điểm hoàn thành tính toán],'BI_Data'[Mã CV],_Code,'BI_Data'[Quý],3,'BI_Data'[Năm],_Y,'BI_Data'[PIC],"BAN PTC")
			RETURN IF(_Percent && _Scope="CHUNG",100*_Ban)))
		displayFolder: TEMPLATE KPI\Cá nhân
		lineageTag: 70e91200-4f79-44d1-b7bf-1a67d43d2de3

	/// Tính điểm nguồn trước điều kiện hiển thị, dùng để tính sẵn bảng Template KPI Kết quả lưu khi refresh. Quy tắc kỳ, CN/TH1/TH2, OPEX/PCD, trần QTHD/TDSP giữ nguyên.
	measure 'Template Điểm QTHD cá nhân Q3' =
			VAR _PIC=SELECTEDVALUE('KPI Đăng ký'[PIC])
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _Scope=UPPER(TRIM([Template Phạm vi ghi nhận]))
			VAR _Level=UPPER(TRIM([Template Cấp tính điểm]))
			VAR _ID=IFERROR(VALUE(SELECTEDVALUE('KPI Đăng ký'[Mã NV])),BLANK())
			VAR _Self=FILTER(ALL('KPI Nhân sự'),IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC))
			VAR _SelfID=MAXX(_Self,'KPI Nhân sự'[Mã NV chuẩn])
			VAR _Group=_Scope="BAN - PIC" && _PIC<>"BAN PTC" && (_Level="TH1" || LEFT(_Level,3)="TH2")
			VAR _Department=SWITCH(_Level,"TH2-PRO","PRO","TH2-BMD","BMD",BLANK())
			VAR _SelfCount=COUNTROWS(_Self)
			VAR _ApplyStaff=_Group || (_Scope="BAN - PIC" && _PIC<>"BAN PTC" && _SelfCount=1)
			VAR _EffectiveStaff=FILTER(ALL('KPI Nhân sự'),
			IF(_Group,IF(NOT ISBLANK(_Department),
			UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Phòng],UNICHAR(160)," ")))=_Department,
			NOT ISBLANK(_SelfID) && PATHCONTAINS('KPI Nhân sự'[Đường dẫn quản lý],_SelfID)),
			IF(_ApplyStaff,IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC),TRUE())))
			VAR _MemberNames=SELECTCOLUMNS(_EffectiveStaff,"_Name",UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Họ và tên],UNICHAR(160)," "))))
			VAR _UseTeam=_ApplyStaff
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=3))>0
			VAR _Dates=CALENDAR(DATE(_Y,7,1),EOMONTH(DATE(_Y,9,1),0))
			VAR _Rows=FILTER(CALCULATETABLE(SUMMARIZE('KPI QTHD','KPI QTHD'[PIC]),REMOVEFILTERS('KPI QTHD')),_PIC="BAN PTC" || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC))))
			RETURN IF(_Code="QTHD" && HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && _QuarterIn && NOT ISBLANK(_PIC) && (_PIC="BAN PTC" || _Scope="BAN - PIC"),
			CALCULATE([QTHD Điểm hoàn thành],REMOVEFILTERS('KPI QTHD'),_Rows,REMOVEFILTERS('DimDate'),TREATAS(_Dates,'DimDate'[Date])))
		formatString: 0.00%
		displayFolder: TEMPLATE KPI\Cá nhân
		lineageTag: 1c60f1c2-227c-4155-8eb8-d65946e393e9

	/// Tính sẵn TEMPLATE theo dòng đăng ký khi refresh. TDDT: ngân sách Dự án = 80% tỷ lệ hoàn thành + 20% PCD đúng quý báo cáo; còn lại kể cả rỗng = nguyên tỷ lệ hoàn thành. Thay điều kiện OPEX cũ. PCD rỗng=0; Q4 tiến độ cả năm + PCD4. Giữ phạm vi CN/TH1/TH2 và trần các mã CV khác. Cập nhật 20/11/2026.
	measure 'Template Kết quả cá nhân Q4' =
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _PIC=SELECTEDVALUE('KPI Đăng ký'[PIC])
			VAR _Dept=UPPER(TRIM([Template Phòng theo DMNV]))
			VAR _Scope=UPPER(TRIM([Template Phạm vi ghi nhận]))
			VAR _Level=UPPER(TRIM([Template Cấp tính điểm]))
			VAR _ID=IFERROR(VALUE(SELECTEDVALUE('KPI Đăng ký'[Mã NV])),BLANK())
			VAR _Self=FILTER(ALL('KPI Nhân sự'),IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC))
			VAR _SelfID=MAXX(_Self,'KPI Nhân sự'[Mã NV chuẩn])
			VAR _Group=_Scope="BAN - PIC" && _PIC<>"BAN PTC" && (_Level="TH1" || LEFT(_Level,3)="TH2")
			VAR _Department=SWITCH(_Level,"TH2-PRO","PRO","TH2-BMD","BMD",BLANK())
			VAR _SelfCount=COUNTROWS(_Self)
			VAR _ApplyStaff=_Group || (_Scope="BAN - PIC" && _PIC<>"BAN PTC" && _SelfCount=1)
			VAR _EffectiveStaff=FILTER(ALL('KPI Nhân sự'),
			IF(_Group,IF(NOT ISBLANK(_Department),
			UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Phòng],UNICHAR(160)," ")))=_Department,
			NOT ISBLANK(_SelfID) && PATHCONTAINS('KPI Nhân sự'[Đường dẫn quản lý],_SelfID)),
			IF(_ApplyStaff,IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC),TRUE())))
			VAR _MemberNames=SELECTCOLUMNS(_EffectiveStaff,"_Name",UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Họ và tên],UNICHAR(160)," "))))
			VAR _UseTeam=_ApplyStaff
			VAR _AllBan=_PIC="BAN PTC" || _Scope="CHUNG" || (_Code="TDSP" && _Dept="PAS")
			VAR _DeptScope=_Scope="BAN - PHÒNG" && NOT _AllBan
			VAR _ValidScope=_AllBan || _Scope="BAN - PIC" || (_DeptScope && NOT ISBLANK(_Dept) && _Dept<>"")
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Unit = UPPER(TRIM(SUBSTITUTE([Template Đơn vị tính áp dụng],UNICHAR(160)," ")))
			VAR _Percent = CONTAINSSTRING(_Unit,"%")
			VAR _Count = _Unit IN {"SỐ LƯỢNG","SL"}
			VAR _Money = CONTAINSSTRING(_Unit,"TỶ")
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=4))>0
			VAR _Start=DATE(_Y,1,1)
			VAR _End=EOMONTH(DATE(_Y,12,1),0)
			VAR _Dates=CALENDAR(_Start,_End)
			RETURN IF(HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && _QuarterIn && NOT ISBLANK(_PIC) && _ValidScope,
			SWITCH(_Code,
			"TDDT",VAR _Progress=FILTER(CALCULATETABLE(SUMMARIZE('KPI Tiến độ thầu','KPI Tiến độ thầu'[PIC CẬP NHẬT],'KPI Tiến độ thầu'[PHÒNG]),REMOVEFILTERS('KPI Tiến độ thầu')),_AllBan || IF(NOT ISBLANK(_Department),UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[PHÒNG],UNICHAR(160)," ")))=_Department,IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[PIC CẬP NHẬT],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI Tiến độ thầu'[PIC CẬP NHẬT],UNICHAR(160)," ")))=UPPER(TRIM(_PIC)))))
			VAR _PCDQuarterDates=CALENDAR(DATE(_Y,10,1),EOMONTH(DATE(_Y,12,1),0))
			VAR _ReportPCD=COALESCE(CALCULATE([TĐT Điểm PCD],REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_PCDQuarterDates,'Kỳ đánh giá đấu thầu'[Ngày])),0)
			VAR _TenderScore=CALCULATE(
			    AVERAGEX(VALUES('KPI Tiến độ thầu'[MÃ CÔNG VIỆC]),
			        VAR _Ratio=[TĐT Tỷ lệ hoàn thành]
			        VAR _Budget=UPPER(TRIM(SUBSTITUTE(CALCULATE(MAX('KPI Tiến độ thầu'[NGÂN SÁCH])),UNICHAR(160)," ")))
			        RETURN IF(NOT ISBLANK(_Ratio),IF(_Budget="DỰ ÁN",0.8*_Ratio+0.2*_ReportPCD,_Ratio))),
			    REMOVEFILTERS('KPI Tiến độ thầu'),_Progress,
			    REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_Dates,'Kỳ đánh giá đấu thầu'[Ngày]))
			RETURN IF(_Percent && NOT ISBLANK(_TenderScore),100*_TenderScore),
			"TUNC",VAR _TU=FILTER(CALCULATETABLE(SUMMARIZE('KPI TUNC Nguồn','KPI TUNC Nguồn'[Phòng],'KPI TUNC Nguồn'[PIC]),REMOVEFILTERS('KPI TUNC Nguồn')),_AllBan || IF(_DeptScope,UPPER(TRIM('KPI TUNC Nguồn'[Phòng]))=_Dept || (_Dept="BMD" && UPPER(TRIM('KPI TUNC Nguồn'[Phòng])) IN {"BMD XD","BMD TV"}),'KPI TUNC Nguồn'[PIC]=_PIC))
			RETURN IF(_Count,CALCULATE([TUNC Tổng hoàn thành],REMOVEFILTERS('KPI TUNC Nguồn'),_TU,REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_Dates,'Kỳ đánh giá đấu thầu'[Ngày])),IF(_Percent,100*CALCULATE(AVERAGEX(VALUES('KPI TUNC Nguồn'[Dòng nguồn]),[TUNC Điểm dòng]),REMOVEFILTERS('KPI TUNC Nguồn'),_TU,REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(_Dates,'Kỳ đánh giá đấu thầu'[Ngày])))),
			"QTHD",VAR _QT=FILTER(CALCULATETABLE(SUMMARIZE('KPI QTHD','KPI QTHD'[PIC]),REMOVEFILTERS('KPI QTHD')),_AllBan || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC))))
			RETURN IF(_Count,CALCULATE([QTHD Hoàn thành trong kỳ],REMOVEFILTERS('KPI QTHD'),_QT,REMOVEFILTERS('DimDate'),TREATAS(_Dates,'DimDate'[Date])),IF(_Percent,100*[Template Điểm QTHD cá nhân Q4])),
			"TTHD",VAR _TT=FILTER(CALCULATETABLE(SUMMARIZE('KPI TTHD','KPI TTHD'[PIC],'KPI TTHD'[NGÀY NHẬN HS]),REMOVEFILTERS('KPI TTHD')),(_AllBan || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI TTHD'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI TTHD'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC)))) && NOT ISBLANK('KPI TTHD'[NGÀY NHẬN HS]) && 'KPI TTHD'[NGÀY NHẬN HS]>=_Start && 'KPI TTHD'[NGÀY NHẬN HS]<=_End)
			RETURN IF(_Percent,100*CALCULATE(CALCULATE(AVERAGEX(VALUES('KPI TTHD'[MÃ HỒ SƠ]),CALCULATE(MAX('KPI TTHD'[ĐIỂM HOÀN THÀNH]))),KEEPFILTERS(TREATAS(VALUES('DimDate'[Date]),'KPI TTHD'[NGÀY NHẬN HS]))),REMOVEFILTERS('KPI TTHD'),_TT,REMOVEFILTERS('DimDate'),TREATAS(_Dates,'DimDate'[Date]))),
			"GHBL",VAR _BL=FILTER(CALCULATETABLE(SUMMARIZE('KPI GHBL','KPI GHBL'[PIC],'KPI GHBL'[NGÀY HẾT HẠN CŨ]),REMOVEFILTERS('KPI GHBL')),(_AllBan || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI GHBL'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI GHBL'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC)))) && NOT ISBLANK('KPI GHBL'[NGÀY HẾT HẠN CŨ]) && 'KPI GHBL'[NGÀY HẾT HẠN CŨ]>=_Start && 'KPI GHBL'[NGÀY HẾT HẠN CŨ]<=_End)
			RETURN IF(_Percent,100*CALCULATE(AVERAGEX(VALUES('KPI GHBL'[MÃ LƯỢT]),CALCULATE(MAX('KPI GHBL'[ĐIỂM HOÀN THÀNH]))),REMOVEFILTERS('KPI GHBL'),_BL,REMOVEFILTERS('DimDate'))),
			"TDSP",VAR _TD=FILTER(CALCULATETABLE(SUMMARIZE('KPI TDSP Nguồn','KPI TDSP Nguồn'[Phòng],'KPI TDSP Nguồn'[PIC],'KPI TDSP Nguồn'[PIC TP]),REMOVEFILTERS('KPI TDSP Nguồn')),_AllBan || IF(_DeptScope,UPPER(TRIM('KPI TDSP Nguồn'[Phòng]))=_Dept,'KPI TDSP Nguồn'[PIC]=_PIC || 'KPI TDSP Nguồn'[PIC TP]=_PIC))
			VAR _BanRows=FILTER(ALL('BI_Data'),'BI_Data'[Mã CV]=_Code && 'BI_Data'[Năm]=_Y && 'BI_Data'[PIC]="BAN PTC" && NOT ISBLANK('BI_Data'[Điểm hoàn thành tính toán]))
			VAR _Ban=IF(_Money,MAXX(TOPN(1,_BanRows,'BI_Data'[Quý],DESC),'BI_Data'[Điểm hoàn thành tính toán]),AVERAGEX(_BanRows,'BI_Data'[Điểm hoàn thành tính toán]))
			RETURN IF(_Money,IF(_AllBan,_Ban,IF(_DeptScope,CALCULATE([TDSP Công nợ tỷ đồng],REMOVEFILTERS('KPI TDSP Nguồn'),_TD,REMOVEFILTERS('Kỳ đánh giá đấu thầu'),TREATAS(CALENDAR(DATE(_Y,1,1),_End),'Kỳ đánh giá đấu thầu'[Ngày])))),IF(_Percent && _Scope="CHUNG",100*_Ban)),
			VAR _BanRows=FILTER(ALL('BI_Data'),'BI_Data'[Mã CV]=_Code && 'BI_Data'[Năm]=_Y && 'BI_Data'[PIC]="BAN PTC" && NOT ISBLANK('BI_Data'[Điểm hoàn thành tính toán]))
			VAR _Ban=IF(_Money,MAXX(TOPN(1,_BanRows,'BI_Data'[Quý],DESC),'BI_Data'[Điểm hoàn thành tính toán]),AVERAGEX(_BanRows,'BI_Data'[Điểm hoàn thành tính toán]))
			RETURN IF(_Percent && _Scope="CHUNG",100*_Ban)))
		displayFolder: TEMPLATE KPI\Cá nhân
		lineageTag: eb1f6ff5-bdbd-4ddb-9616-6054a748ef58

	/// Tính điểm nguồn trước điều kiện hiển thị, dùng để tính sẵn bảng Template KPI Kết quả lưu khi refresh. Quy tắc kỳ, CN/TH1/TH2, OPEX/PCD, trần QTHD/TDSP giữ nguyên.
	measure 'Template Điểm QTHD cá nhân Q4' =
			VAR _PIC=SELECTEDVALUE('KPI Đăng ký'[PIC])
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _Scope=UPPER(TRIM([Template Phạm vi ghi nhận]))
			VAR _Level=UPPER(TRIM([Template Cấp tính điểm]))
			VAR _ID=IFERROR(VALUE(SELECTEDVALUE('KPI Đăng ký'[Mã NV])),BLANK())
			VAR _Self=FILTER(ALL('KPI Nhân sự'),IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC))
			VAR _SelfID=MAXX(_Self,'KPI Nhân sự'[Mã NV chuẩn])
			VAR _Group=_Scope="BAN - PIC" && _PIC<>"BAN PTC" && (_Level="TH1" || LEFT(_Level,3)="TH2")
			VAR _Department=SWITCH(_Level,"TH2-PRO","PRO","TH2-BMD","BMD",BLANK())
			VAR _SelfCount=COUNTROWS(_Self)
			VAR _ApplyStaff=_Group || (_Scope="BAN - PIC" && _PIC<>"BAN PTC" && _SelfCount=1)
			VAR _EffectiveStaff=FILTER(ALL('KPI Nhân sự'),
			IF(_Group,IF(NOT ISBLANK(_Department),
			UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Phòng],UNICHAR(160)," ")))=_Department,
			NOT ISBLANK(_SelfID) && PATHCONTAINS('KPI Nhân sự'[Đường dẫn quản lý],_SelfID)),
			IF(_ApplyStaff,IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC),TRUE())))
			VAR _MemberNames=SELECTCOLUMNS(_EffectiveStaff,"_Name",UPPER(TRIM(SUBSTITUTE('KPI Nhân sự'[Họ và tên],UNICHAR(160)," "))))
			VAR _UseTeam=_ApplyStaff
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=4))>0
			VAR _Dates=CALENDAR(DATE(_Y,1,1),EOMONTH(DATE(_Y,12,1),0))
			VAR _Rows=FILTER(CALCULATETABLE(SUMMARIZE('KPI QTHD','KPI QTHD'[PIC]),REMOVEFILTERS('KPI QTHD')),_PIC="BAN PTC" || IF(_UseTeam,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," "))) IN _MemberNames,UPPER(TRIM(SUBSTITUTE('KPI QTHD'[PIC],UNICHAR(160)," ")))=UPPER(TRIM(_PIC))))
			RETURN IF(_Code="QTHD" && HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && _QuarterIn && NOT ISBLANK(_PIC) && (_PIC="BAN PTC" || _Scope="BAN - PIC"),
			CALCULATE([QTHD Điểm hoàn thành],REMOVEFILTERS('KPI QTHD'),_Rows,REMOVEFILTERS('DimDate'),TREATAS(_Dates,'DimDate'[Date])))
		formatString: 0.00%
		displayFolder: TEMPLATE KPI\Cá nhân
		lineageTag: 2c384f38-ec5a-4bba-acc1-cf9ae2a1e4cb

	/// Cấp tính điểm tra DMNV theo mã nhân viên; BAN PTC giữ mức Ban.
	measure 'Template Cấp tính điểm' =
			VAR _ID=IFERROR(VALUE(SELECTEDVALUE('KPI Đăng ký'[Mã NV])),BLANK())
			VAR _PIC=SELECTEDVALUE('KPI Đăng ký'[PIC])
			VAR _Staff=FILTER(ALL('KPI Nhân sự'),IF(NOT ISBLANK(_ID),IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=_ID,'KPI Nhân sự'[Họ và tên]=_PIC))
			RETURN IF(_PIC="BAN PTC","BAN",CALCULATE(SELECTEDVALUE('KPI Nhân sự'[Cấp tính điểm]),_Staff))
		displayFolder: TEMPLATE KPI
		lineageTag: 9fc048a4-9a54-4e2f-88ff-0a8d914dc1ec


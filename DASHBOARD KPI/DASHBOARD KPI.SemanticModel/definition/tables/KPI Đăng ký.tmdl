		formatStringDefinition = IF(CONTAINSSTRING([Template Đơn vị tính áp dụng],"%"),"0.00\%","#,##0.00")

	/// Tối ưu 16/11/2026: QTHD dùng điểm trang trực tiếp; chỉ tính kết quả và mục tiêu đăng ký cho các mã cần sử dụng.
	measure 'Template Tỷ lệ Q4' =
			SUMX(FILTER(VALUES('KPI Đăng ký'[Dòng nguồn]),[Template Dòng hiển thị]=1),
			VAR _Weight=CONVERT(CALCULATE(MAX('KPI Đăng ký'[Trọng số])),DOUBLE)
			VAR _Code=CALCULATE(SELECTEDVALUE('KPI Đăng ký'[Mã CV]))
			RETURN IF(_Code="QTHD",[Template Điểm QTHD Q4]*_Weight,
			VAR _Result=[Template Kết quả Q4]
			VAR _Target=[Template Mục tiêu Q4]
			VAR _Unit=CALCULATE([Template Đơn vị tính áp dụng])
			VAR _Rate=IF(CONTAINSSTRING(_Unit,"%"),DIVIDE(_Result,100),DIVIDE(_Result,_Target))
			VAR _Score=IF(_Code="TDSP" && NOT ISBLANK(_Rate),MIN(_Rate,1.2),_Rate)
			RETURN IF(NOT ISBLANK(_Result),_Score*_Weight)))
		formatString: 0.00%
		displayFolder: TEMPLATE KPI
		lineageTag: e089aedc-4eea-458b-ab68-610b4384ff12

	measure 'Template Mã CV' = IF(ISINSCOPE('KPI Đăng ký'[STT theo PIC]) && [Template Dòng hiển thị]=1,SELECTEDVALUE('KPI Đăng ký'[Mã CV]))
		displayFolder: TEMPLATE KPI
		lineageTag: 094f1815-3cef-4653-a14f-621017e8f85d

	/// Mục tiêu năm lấy mục tiêu Q4, giữ dấu so sánh và đơn vị của đăng ký.
	measure 'Template Mục tiêu năm' = [Template Mục tiêu Q4]
		displayFolder: TEMPLATE KPI
		lineageTag: 08c387ed-1b7b-4bd1-ae2d-fc466a3f1f34

		formatStringDefinition =
				VAR _Raw=TRIM(SELECTEDVALUE('KPI Đăng ký'[Mục tiêu Q4]))
				VAR _Sign=SWITCH(TRUE(),LEFT(_Raw,2)="<=","≤",LEFT(_Raw,2)=">=","≥",LEFT(_Raw,1)="≤","≤",LEFT(_Raw,1)="≥","≥",LEFT(_Raw,1)="<","<",LEFT(_Raw,1)=">",">","")
				VAR _Base=IF(CONTAINSSTRING([Template Đơn vị tính áp dụng],"%"),"0.00\%","#,##0.00")
				RETURN IF(_Sign<>"",UNICHAR(34)&_Sign&" "&UNICHAR(34)&_Base,_Base)

	/// Ưu tiên đơn vị của dòng đăng ký, dự phòng danh mục theo Mã CV. Dùng thống nhất để hiển thị và chọn kỳ %, số lượng hoặc giá trị.
	measure 'Template Đơn vị tính áp dụng' =
			VAR _Registered=SELECTEDVALUE('KPI Đăng ký'[Đơn vị tính])
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _Catalog=TOPN(1,FILTER(ALL('KPI Danh mục'),'KPI Danh mục'[Mã CV]=_Code),'KPI Danh mục'[Dòng nguồn],ASC)
			RETURN COALESCE(_Registered,CONCATENATEX(_Catalog,'KPI Danh mục'[Đơn vị tính],""))
		isHidden
		displayFolder: TEMPLATE KPI
		lineageTag: 2f00c8c5-56ee-4762-80e2-77ce117c95d1

	/// Phòng từ DMNV, đối chiếu mã NV (bỏ số 0 đầu); chỉ dùng tên khi đăng ký thiếu mã NV. Không suy đoán phòng từ đăng ký.
	measure 'Template Phòng theo DMNV' =
			VAR _ID=TRIM(SELECTEDVALUE('KPI Đăng ký'[Mã NV]) & "")
			VAR _PIC=SELECTEDVALUE('KPI Đăng ký'[PIC])
			VAR _Staff=FILTER(ALL('KPI Nhân sự'),IF(_ID<>"",IFERROR(VALUE('KPI Nhân sự'[Mã NV]),-1)=IFERROR(VALUE(_ID),-2),'KPI Nhân sự'[Họ và tên]=_PIC))
			RETURN IF(_PIC<>"BAN PTC",CALCULATE(SELECTEDVALUE('KPI Nhân sự'[Phòng]),_Staff))
		displayFolder: TEMPLATE KPI
		lineageTag: a658fb3e-1b39-4f57-a232-806dde28cc72

	/// Quy tắc ghi nhận theo mã CV trong DANH MUC; nhiều dòng cùng mã phải có cùng quy tắc.
	measure 'Template Phạm vi ghi nhận' =
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _Rules=FILTER(ALL('KPI Danh mục'),'KPI Danh mục'[Mã CV]=_Code)
			RETURN CALCULATE(SELECTEDVALUE('KPI Danh mục'[Phạm vi ghi nhận]),_Rules)
		displayFolder: TEMPLATE KPI
		lineageTag: 6e571e1d-1800-4f02-bf67-9a889f265576

	/// Đọc kết quả được tính sẵn khi refresh theo Dòng đăng ký; điều kiện chọn một PIC, năm và kỳ quý vẫn được kiểm tra khi hiển thị. Tối ưu A1 ngày 16/11/2026.
	measure 'Template Điểm QTHD Q1' =
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=1))>0
			VAR _ID=SELECTEDVALUE('KPI Đăng ký'[Dòng nguồn])
			RETURN IF(HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && [Template Dòng hiển thị]=1 && _QuarterIn,
			LOOKUPVALUE('Template KPI Kết quả lưu'[Điểm QTHD Q1],'Template KPI Kết quả lưu'[Dòng đăng ký],_ID))
		formatString: 0.00%
		displayFolder: TEMPLATE KPI
		lineageTag: e58810c8-3b00-4160-8720-b4e7510838f1

	/// Đọc kết quả được tính sẵn khi refresh theo Dòng đăng ký; điều kiện chọn một PIC, năm và kỳ quý vẫn được kiểm tra khi hiển thị. Tối ưu A1 ngày 16/11/2026.
	measure 'Template Điểm QTHD Q2' =
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=2))>0
			VAR _ID=SELECTEDVALUE('KPI Đăng ký'[Dòng nguồn])
			RETURN IF(HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && [Template Dòng hiển thị]=1 && _QuarterIn,
			LOOKUPVALUE('Template KPI Kết quả lưu'[Điểm QTHD Q2],'Template KPI Kết quả lưu'[Dòng đăng ký],_ID))
		formatString: 0.00%
		displayFolder: TEMPLATE KPI
		lineageTag: 3ad05890-d28c-4f5c-a46e-742a014db6c9

	/// Đọc kết quả được tính sẵn khi refresh theo Dòng đăng ký; điều kiện chọn một PIC, năm và kỳ quý vẫn được kiểm tra khi hiển thị. Tối ưu A1 ngày 16/11/2026.
	measure 'Template Điểm QTHD Q3' =
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=3))>0
			VAR _ID=SELECTEDVALUE('KPI Đăng ký'[Dòng nguồn])
			RETURN IF(HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && [Template Dòng hiển thị]=1 && _QuarterIn,
			LOOKUPVALUE('Template KPI Kết quả lưu'[Điểm QTHD Q3],'Template KPI Kết quả lưu'[Dòng đăng ký],_ID))
		formatString: 0.00%
		displayFolder: TEMPLATE KPI

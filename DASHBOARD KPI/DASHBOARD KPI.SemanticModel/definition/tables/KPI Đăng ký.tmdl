/// Nguồn SharePoint DANG KY KPI; bảng nguồn chuẩn hóa phục vụ bốn trang KPI mới. Giữ từng dòng gốc và các giá trị rỗng; chưa có quan hệ hay công thức chấm điểm.
table 'KPI Đăng ký'
	lineageTag: 5f664d5a-d0c6-48ea-901a-b7c48a65d8b0

	measure 'Template Dòng hiển thị' =
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Dates=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _SinglePIC=COUNTROWS(ALLSELECTED('KPI Đăng ký'[PIC]))=1
			RETURN IF(_SinglePIC && NOT ISBLANK(_Y) && (NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Dates,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y))>0),1,BLANK())
		formatString: 0
		displayFolder: TEMPLATE KPI
		lineageTag: 7a2ca0b7-0b64-4d8f-a0c5-19d3c44403c9

	/// Cộng trọng số theo từng dòng đăng ký của PIC và năm; không cộng theo từng quý.
	measure 'Template Trọng số' = SUMX(FILTER(VALUES('KPI Đăng ký'[Dòng nguồn]),[Template Dòng hiển thị]=1),CALCULATE(MAX('KPI Đăng ký'[Trọng số])))
		formatString: 0.00%
		displayFolder: TEMPLATE KPI
		lineageTag: aaf66a85-be9b-4a9c-9d10-dbcd773aaa88

	measure 'Template STT' = IF(ISINSCOPE('KPI Đăng ký'[Dòng nguồn]) && [Template Dòng hiển thị]=1,RANKX(ALLSELECTED('KPI Đăng ký'[Dòng nguồn]),CALCULATE(MAX('KPI Đăng ký'[Dòng nguồn])),,ASC,DENSE))
		formatString: 0
		displayFolder: TEMPLATE KPI
		lineageTag: 29092d5c-0693-4a19-a7a4-463e210af005

	/// VLOOKUP Mã CV trong DANH MUC: lấy lần xuất hiện đầu tiên theo dòng nguồn Excel.
	measure 'Template Mô tả công việc' =
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _Row=TOPN(1,FILTER(ALL('KPI Danh mục'),'KPI Danh mục'[Mã CV]=_Code),'KPI Danh mục'[Dòng nguồn],ASC)
			RETURN IF(ISINSCOPE('KPI Đăng ký'[STT theo PIC]) && [Template Dòng hiển thị]=1,CONCATENATEX(_Row,'KPI Danh mục'[Tên CV],""))
		displayFolder: TEMPLATE KPI
		lineageTag: 81ecd6ce-c6b4-4121-8e8b-cf4291f4dab5

	/// VLOOKUP Mã CV trong DANH MUC: lấy lần xuất hiện đầu tiên theo dòng nguồn Excel.
	measure 'Template Mô tả chi tiết' =
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _Row=TOPN(1,FILTER(ALL('KPI Danh mục'),'KPI Danh mục'[Mã CV]=_Code),'KPI Danh mục'[Dòng nguồn],ASC)
			RETURN IF(ISINSCOPE('KPI Đăng ký'[STT theo PIC]) && [Template Dòng hiển thị]=1,CONCATENATEX(_Row,'KPI Danh mục'[Mô tả chi tiết],""))
		displayFolder: TEMPLATE KPI
		lineageTag: df749742-a476-46d4-b62c-15a304292c40

	/// VLOOKUP Mã CV trong DANH MUC: lấy lần xuất hiện đầu tiên theo dòng nguồn Excel.
	measure 'Template Chỉ số đo lường' =
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _Row=TOPN(1,FILTER(ALL('KPI Danh mục'),'KPI Danh mục'[Mã CV]=_Code),'KPI Danh mục'[Dòng nguồn],ASC)
			RETURN IF(ISINSCOPE('KPI Đăng ký'[STT theo PIC]) && [Template Dòng hiển thị]=1,CONCATENATEX(_Row,'KPI Danh mục'[Chỉ số đo lường KPI],""))
		displayFolder: TEMPLATE KPI
		lineageTag: 743428e5-286c-4864-988d-2c9cbf29045a

	/// Đơn vị từ dòng đăng ký của PIC; dự phòng danh mục nếu trống. Thống nhất với cách tính kết quả theo quý/lũy kế.
	measure 'Template Đơn vị' = IF(ISINSCOPE('KPI Đăng ký'[STT theo PIC]) && [Template Dòng hiển thị]=1,[Template Đơn vị tính áp dụng])
		displayFolder: TEMPLATE KPI
		lineageTag: 79b4ca31-a5c3-4d89-bd16-5d88f0f3d715

	/// VLOOKUP Mã CV trong DANH MUC: lấy lần xuất hiện đầu tiên theo dòng nguồn Excel.
	measure 'Template Công thức tính' =
			VAR _Code=SELECTEDVALUE('KPI Đăng ký'[Mã CV])
			VAR _Row=TOPN(1,FILTER(ALL('KPI Danh mục'),'KPI Danh mục'[Mã CV]=_Code),'KPI Danh mục'[Dòng nguồn],ASC)
			RETURN IF(ISINSCOPE('KPI Đăng ký'[STT theo PIC]) && [Template Dòng hiển thị]=1,CONCATENATEX(_Row,'KPI Danh mục'[Công thức tính],""))
		displayFolder: TEMPLATE KPI
		lineageTag: 8923b25a-99de-4734-bff5-c20662f17b51

	/// Mục tiêu quý từ đăng ký; đọc ngưỡng số có dấu ≤/≥/</> và giữ dấu khi hiển thị. Đơn vị % chuẩn hóa sang thang 100. Không tự cộng các quý.
	measure 'Template Mục tiêu Q1' =
			VAR _Raw=TRIM(SELECTEDVALUE('KPI Đăng ký'[Mục tiêu Q1]))
			VAR _SignLength=SWITCH(TRUE(),LEFT(_Raw,2)="<="||LEFT(_Raw,2)=">=",2,LEFT(_Raw,1) IN {"≤","≥","<",">"},1,0)
			VAR _NumberText=TRIM(MID(_Raw,_SignLength+1,LEN(_Raw)+1))
			VAR _HasPercent=RIGHT(_NumberText,1)="%"
			VAR _NumericText=IF(_HasPercent,TRIM(LEFT(_NumberText,LEN(_NumberText)-1)),_NumberText)
			VAR _Value=IF(LEN(_NumericText)=0,BLANK(),IFERROR(VALUE(_NumericText),BLANK()))
			VAR _Percent=CONTAINSSTRING([Template Đơn vị tính áp dụng],"%")
			RETURN IF(HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && [Template Dòng hiển thị]=1,
			IF(_HasPercent,IF(_Percent,_Value,DIVIDE(_Value,100)),IF(_Percent && _Value>0 && _Value<=1,_Value*100,_Value)))
		displayFolder: TEMPLATE KPI
		lineageTag: 5a07599a-2902-4916-9e31-0b6c1050f658

		formatStringDefinition =
				VAR _Raw=TRIM(SELECTEDVALUE('KPI Đăng ký'[Mục tiêu Q1]))
				VAR _Sign=SWITCH(TRUE(),LEFT(_Raw,2)="<=","≤",LEFT(_Raw,2)=">=","≥",LEFT(_Raw,1)="≤","≤",LEFT(_Raw,1)="≥","≥",LEFT(_Raw,1)="<","<",LEFT(_Raw,1)=">",">","")
				VAR _Base=IF(CONTAINSSTRING([Template Đơn vị tính áp dụng],"%"),"0.00\%","#,##0.00")
				RETURN IF(_Sign<>"",UNICHAR(34)&_Sign&" "&UNICHAR(34)&_Base,_Base)

	/// Đọc kết quả được tính sẵn khi refresh theo Dòng đăng ký; điều kiện chọn một PIC, năm và kỳ quý vẫn được kiểm tra khi hiển thị. Tối ưu A1 ngày 16/11/2026.
	measure 'Template Kết quả Q1' =
			VAR _Y=SELECTEDVALUE('KPI Đăng ký'[Năm])
			VAR _Selected=VALUES('Kỳ đánh giá đấu thầu'[Ngày])
			VAR _QuarterIn=NOT ISFILTERED('Kỳ đánh giá đấu thầu') || COUNTROWS(FILTER(_Selected,YEAR('Kỳ đánh giá đấu thầu'[Ngày])=_Y && QUARTER('Kỳ đánh giá đấu thầu'[Ngày])=1))>0
			VAR _ID=SELECTEDVALUE('KPI Đăng ký'[Dòng nguồn])
			RETURN IF(HASONEVALUE('KPI Đăng ký'[Dòng nguồn]) && [Template Dòng hiển thị]=1 && _QuarterIn,
			LOOKUPVALUE('Template KPI Kết quả lưu'[Kết quả Q1],'Template KPI Kết quả lưu'[Dòng đăng ký],_ID))
		displayFolder: TEMPLATE KPI
		lineageTag: aaaa8291-23b5-40b0-9cc3-92d6ecc6e04e

		formatStringDefinition = IF(CONTAINSSTRING([Template Đơn vị tính áp dụng],"%"),"0.00\%","#,##0.00")

	/// Tối ưu 16/11/2026: QTHD dùng điểm trang trực tiếp; chỉ tính kết quả và mục tiêu đăng ký cho các mã cần sử dụng.
	measure 'Template Tỷ lệ Q1' =
			SUMX(FILTER(VALUES('KPI Đăng ký'[Dòng nguồn]),[Template Dòng hiển thị]=1),
			VAR _Weight=CONVERT(CALCULATE(MAX('KPI Đăng ký'[Trọng số])),DOUBLE)
			VAR _Code=CALCULATE(SELECTEDVALUE('KPI Đăng ký'[Mã CV]))
			RETURN IF(_Code="QTHD",[Template Điểm QTHD Q1]*_Weight,
			VAR _Result=[Template Kết quả Q1]
			VAR _Target=[Template Mục tiêu Q1]
			VAR _Unit=CALCULATE([Template Đơn vị tính áp dụng])
			VAR _Rate=IF(CONTAINSSTRING(_Unit,"%"),DIVIDE(_Result,100),DIVIDE(_Result,_Target))
			VAR _Score=IF(_Code="TDSP" && NOT ISBLANK(_Rate),MIN(_Rate,1.2),_Rate)
			RETURN IF(NOT ISBLANK(_Result),_Score*_Weight)))
		formatString: 0.00%
		displayFolder: TEMPLATE KPI
		lineageTag: 507d98ae-62f6-459b-91e7-eca2a9b88ba9

	/// Mục tiêu quý từ đăng ký; đọc ngưỡng số có dấu ≤/≥/</> và giữ dấu khi hiển thị. Đơn vị % chuẩn hóa sang thang 100. Không tự cộng các quý.

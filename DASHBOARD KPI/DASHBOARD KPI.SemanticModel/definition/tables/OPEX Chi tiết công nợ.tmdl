/// Chi tiết từng hồ sơ công nợ chi phí hoạt động từ sheet CHI TIET CONG NO; một hợp đồng có thể có nhiều dòng thanh toán.
table 'OPEX Chi tiết công nợ'
	lineageTag: 03806d00-54a3-4679-83c3-c9e117f30f29

	/// Tổng giá trị công nợ gồm VAT của các dòng chi tiết trong ngữ cảnh lọc.
	measure 'OPEX Công nợ gồm VAT' = SUM('OPEX Chi tiết công nợ'[Giá trị công nợ gồm VAT])
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ hoạt động\KPI
		lineageTag: 94384956-f743-4cbc-b553-6819a006bd85

	/// Tổng số tiền đã thanh toán cộng giá trị trao đổi sản phẩm.
	measure 'OPEX Giá trị đã thanh toán' = SUM('OPEX Chi tiết công nợ'[Số tiền đã thanh toán]) + SUM('OPEX Chi tiết công nợ'[Giá trị trao đổi sản phẩm])
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ hoạt động\KPI
		lineageTag: 5b618590-520e-48a2-b3ab-9461da7af64b

	/// Tổng giá trị công nợ chưa thanh toán trong ngữ cảnh lọc.
	measure 'OPEX Công nợ chưa thanh toán' = SUM('OPEX Chi tiết công nợ'[Giá trị công nợ chưa thanh toán])
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ hoạt động\KPI
		lineageTag: dd558cb8-01bd-4853-9e82-a8c8d401b1ca

	/// Tổng tạm ứng chưa khấu trừ từ bảng tổng; khi dùng bộ lọc của bảng chi tiết, measure áp dụng danh sách số hợp đồng tương ứng.
	measure 'OPEX Tạm ứng chưa thu hồi' =
			VAR _HasDetailFilter =
			    ISFILTERED('OPEX Chi tiết công nợ'[Nhà cung cấp])
			        || ISFILTERED('OPEX Chi tiết công nợ'[Pháp nhân ký HĐ])
			        || ISFILTERED('OPEX Chi tiết công nợ'[Năm đến hạn])
			        || ISFILTERED('OPEX Chi tiết công nợ'[Quý đến hạn])
			        || ISFILTERED('OPEX Chi tiết công nợ'[Payment PIC])
			VAR _Contracts = VALUES('OPEX Chi tiết công nợ'[Số hợp đồng])
			RETURN
			    IF(
			        _HasDetailFilter,
			        CALCULATE(
			            SUM('OPEX Tổng công nợ'[Giá trị tạm ứng chưa khấu trừ]),
			            TREATAS(_Contracts, 'OPEX Tổng công nợ'[Số hợp đồng])
			        ),
			        SUM('OPEX Tổng công nợ'[Giá trị tạm ứng chưa khấu trừ])
			    )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ hoạt động\KPI
		lineageTag: a1eb6ad4-5435-4d22-9bd3-ba68bf0959c7

	measure 'OPEX Công nợ gồm VAT (tỷ)' = DIVIDE ( [OPEX Công nợ gồm VAT], 1000000000 )
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Công nợ hoạt động\KPI
		lineageTag: 342f897a-e2c6-48f2-beb2-5849bd261007

	measure 'OPEX Giá trị đã thanh toán (tỷ)' = DIVIDE ( [OPEX Giá trị đã thanh toán], 1000000000 )
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Công nợ hoạt động\KPI
		lineageTag: 698b6014-6233-4041-a60f-86494407fe2c

	measure 'OPEX Công nợ chưa thanh toán (tỷ)' = DIVIDE ( [OPEX Công nợ chưa thanh toán], 1000000000 )
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Công nợ hoạt động\KPI
		lineageTag: bc817734-885d-4791-803b-b53bdc26fbe5

	measure 'OPEX Tạm ứng chưa thu hồi (tỷ)' = DIVIDE ( [OPEX Tạm ứng chưa thu hồi], 1000000000 )
		formatString: #,##0.0;-#,##0.0;-
		displayFolder: Công nợ hoạt động\KPI
		lineageTag: 4b891ab7-a82c-4cf6-b98d-e05c56160f98

	/// Hiển thị các nội dung thanh toán của hợp đồng tại cấp chi tiết trong matrix.
	measure 'OPEX Nội dung thanh toán (chi tiết)' =
			IF (
			    ISINSCOPE ( 'OPEX Chi tiết công nợ'[Số hợp đồng] ),
			    CONCATENATEX (
			        VALUES ( 'OPEX Chi tiết công nợ'[Nội dung thanh toán] ),
			        'OPEX Chi tiết công nợ'[Nội dung thanh toán],
			        " | ",
			        'OPEX Chi tiết công nợ'[Nội dung thanh toán], ASC
			    ),
			    BLANK ()
			)
		displayFolder: Công nợ hoạt động\Chi tiết
		lineageTag: 8554640f-a159-4335-b3d0-028e0cc7e647

	/// Hiển thị các ngày đến hạn thanh toán của hợp đồng tại cấp chi tiết trong matrix.
	measure 'OPEX Ngày đến hạn thanh toán (chi tiết)' =
			IF (
			    ISINSCOPE ( 'OPEX Chi tiết công nợ'[Số hợp đồng] ),
			    CONCATENATEX (
			        VALUES ( 'OPEX Chi tiết công nợ'[Ngày đến hạn thanh toán] ),
			        FORMAT ( 'OPEX Chi tiết công nợ'[Ngày đến hạn thanh toán], "dd/MM/yyyy" ),
			        " | ",
			        'OPEX Chi tiết công nợ'[Ngày đến hạn thanh toán], ASC
			    ),
			    BLANK ()
			)
		displayFolder: Công nợ hoạt động\Chi tiết
		lineageTag: d4dde6d7-f197-4d9d-801c-8732cdda6e4a

	/// Tổng riêng cột Số tiền đã thanh toán của sheet chi tiết công nợ.
	measure 'OPEX Số tiền đã thanh toán' = SUM ( 'OPEX Chi tiết công nợ'[Số tiền đã thanh toán] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ hoạt động\Chi tiết
		lineageTag: 0db1cb1d-0a5b-4c3e-90fa-cf7f925f998c

	/// Tổng riêng cột Giá trị trao đổi sản phẩm của sheet chi tiết công nợ.
	measure 'OPEX Giá trị trao đổi sản phẩm' = SUM ( 'OPEX Chi tiết công nợ'[Giá trị trao đổi sản phẩm] )
		formatString: #,##0;-#,##0;-
		displayFolder: Công nợ hoạt động\Chi tiết
		lineageTag: 5cb3110b-86b9-4f6a-854f-7fccbe075450

	/// Hiển thị các Payment PIC phụ trách hợp đồng tại cấp chi tiết trong matrix.
	measure 'OPEX Payment PIC (chi tiết)' =
			IF (
			    ISINSCOPE ( 'OPEX Chi tiết công nợ'[Số hợp đồng] ),
			    CONCATENATEX (
			        VALUES ( 'OPEX Chi tiết công nợ'[Payment PIC] ),
			        'OPEX Chi tiết công nợ'[Payment PIC],
			        " | ",
			        'OPEX Chi tiết công nợ'[Payment PIC], ASC
			    ),
			    BLANK ()
			)
		displayFolder: Công nợ hoạt động\Chi tiết
		lineageTag: d6e73a30-4a3a-44f6-9947-a2cf82f6df28


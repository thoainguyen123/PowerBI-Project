	/// Phân cấp thời gian đến hạn theo Năm rồi Quý.
	hierarchy 'Hạn thanh toán'
		lineageTag: 6df9ede3-b21d-4059-a909-ad6c09a54937

		level Năm
			lineageTag: 06bbd265-ed0c-44f3-8818-570514ec1613
			column: 'Năm đến hạn'

		level Quý
			lineageTag: dde27e24-f76b-48d7-9ebb-a38614157082
			column: 'Quý đến hạn'

	partition 'OPEX Chi tiết công nợ' = m
		mode: import
		source =
				let
				    NormalizeName = (Value as any) as text =>
				        Text.Upper(Text.Remove(Text.Clean(Text.Trim(Text.From(Value ?? ""))), {" ", Character.FromNumber(160), "#(tab)", "#(cr)", "#(lf)"})),
				    FindColumn = (InputTable as table, Candidates as list) as nullable text =>
				        let
				            Existing = Table.ColumnNames(InputTable),
				            Matches = List.Transform(Candidates, (Candidate) => List.First(List.Select(Existing, (Col) => NormalizeName(Col) = NormalizeName(Candidate)), null))
				        in
				            List.First(List.RemoveNulls(Matches), null),
				    ToNumber = (Value as any) as nullable number =>
				        if Value = null then null
				        else if Value.Is(Value, type number) then Number.From(Value)
				        else
				            let CleanText = Text.Replace(Text.Replace(Text.Trim(Text.From(Value)), ",", ""), " ", "")
				            in try Number.FromText(CleanText, "en-US") otherwise null,
				    Source = SharePoint.Contents("https://novaland.sharepoint.com/sites/PRT", [ApiVersion = 15]),
				    Documents = Source{[Name = "Documents"]}[Content],
				    PRC = Documents{[Name = "PRC"]}[Content],
				    NovaGen = PRC{[Name = "00. NovaGen"]}[Content],
				    NghiepVu = NovaGen{[Name = "07. Các nghiệp vụ"]}[Content],
				    PAS = NghiepVu{[Name = "05. PAS"]}[Content],
				    Folder = PAS{[Name = "01. THEO DOI HD & CPC"]}[Content],
				    FileBinary = Folder{[Name = "THEO DOI CONG NO CHI PHI HOAT DONG.xlsx"]}[Content],
				    Workbook = Excel.Workbook(FileBinary, null, true),
				    Raw = Workbook{[Item = "CHI TIET CONG NO", Kind = "Sheet"]}[Data],
				    Safe = Table.ReplaceErrorValues(Raw, List.Transform(Table.ColumnNames(Raw), each {_, null})),
				    Skipped = Table.Skip(Safe, 4),
				    Promoted = Table.PromoteHeaders(Skipped, [PromoteAllScalars = true]),
				    Mappings = {
				        {"Số hợp đồng", {"SỐ HỢP ĐỒNG"}},
				        {"Nhà cung cấp", {"NHÀ CUNG CẤP"}},
				        {"Pháp nhân ký HĐ", {"PHÁP NHÂN KÝ HĐ"}},
				        {"Nội dung thanh toán", {"NỘI DUNG THANH TOÁN"}},
				        {"Giá trị công nợ gồm VAT", {"GIÁ TRỊ CÔNG NỢ GỒM VAT"}},
				        {"Ngày đến hạn thanh toán", {"NGÀY ĐẾN HẠN TT", "NGÀY ĐẾN HẠN THANH TOÁN"}},
				        {"Số tiền đã thanh toán", {"SỐ TIỀN ĐÃ THANH TOÁN"}},
				        {"Giá trị trao đổi sản phẩm", {"GIÁ TRỊ TRAO ĐỔI SẢN PHẨM"}},
				        {"Giá trị công nợ chưa thanh toán", {"GIÁ TRỊ CÔNG NỢ CHƯA THANH TOÁN"}},
				        {"Payment PIC", {"PAYMENT PIC"}}
				    },
				    ExistingMappings = List.Select(List.Transform(Mappings, (Map) => {FindColumn(Promoted, Map{1}), Map{0}}), each _{0} <> null),
				    Selected = Table.SelectColumns(Promoted, List.Transform(ExistingMappings, each _{0})),
				    Renamed = Table.RenameColumns(Selected, ExistingMappings, MissingField.Ignore),
				    Required = List.Transform(Mappings, each _{0}),
				    Ensured = List.Accumulate(Required, Renamed, (State, Col) => if Table.HasColumns(State, {Col}) then State else Table.AddColumn(State, Col, each null, type any)),
				    Filtered = Table.SelectRows(Ensured, each let Contract = try Text.Trim(Text.From([Số hợp đồng])) otherwise "" in Contract <> "" and NormalizeName(Contract) <> NormalizeName("SỐ HỢP ĐỒNG")),
				    TypedText = Table.TransformColumns(Filtered, {
				        {"Số hợp đồng", each try Text.Trim(Text.From(_)) otherwise null, type text},
				        {"Nhà cung cấp", each try Text.Trim(Text.From(_)) otherwise null, type text},
				        {"Pháp nhân ký HĐ", each try Text.Trim(Text.From(_)) otherwise null, type text},
				        {"Nội dung thanh toán", each try Text.Trim(Text.From(_)) otherwise null, type text},
				        {"Payment PIC", each try Text.Trim(Text.From(_)) otherwise null, type text}
				    }),
				    TypedAmounts = Table.TransformColumns(TypedText, {
				        {"Giá trị công nợ gồm VAT", ToNumber, type number},
				        {"Số tiền đã thanh toán", ToNumber, type number},
				        {"Giá trị trao đổi sản phẩm", ToNumber, type number},
				        {"Giá trị công nợ chưa thanh toán", ToNumber, type number}
				    }),
				    TypedDate = Table.TransformColumns(TypedAmounts, {{"Ngày đến hạn thanh toán", each try Date.From(_) otherwise null, type date}}),
				    AddedYear = Table.AddColumn(TypedDate, "Năm đến hạn", each if [Ngày đến hạn thanh toán] = null then null else Date.Year([Ngày đến hạn thanh toán]), Int64.Type),
				    AddedQuarterNumber = Table.AddColumn(AddedYear, "Số quý đến hạn", each if [Ngày đến hạn thanh toán] = null then null else Date.QuarterOfYear([Ngày đến hạn thanh toán]), Int64.Type),
				    AddedQuarter = Table.AddColumn(AddedQuarterNumber, "Quý đến hạn", each if [Số quý đến hạn] = null then null else "Quý " & Text.From([Số quý đến hạn]), type text),
				    AddedPeriod = Table.AddColumn(AddedQuarter, "Kỳ đến hạn", each if [Năm đến hạn] = null or [Số quý đến hạn] = null then "Chưa xác định" else "Quý " & Text.From([Số quý đến hạn]) & " - " & Text.From([Năm đến hạn]), type text),
				    AddedSort = Table.AddColumn(AddedPeriod, "Thứ tự kỳ đến hạn", each if [Năm đến hạn] = null or [Số quý đến hạn] = null then 99999 else [Năm đến hạn] * 10 + [Số quý đến hạn], Int64.Type)
				in
				    AddedSort


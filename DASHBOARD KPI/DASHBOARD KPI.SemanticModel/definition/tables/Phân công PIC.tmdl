/// Bảng phân công theo vai trò, tạo một dòng cho mỗi lượt HĐ-PIC. Một HĐ có cả PIC Xây dựng/Cung ứng và PIC MEP sẽ xuất hiện hai lượt để không mất trách nhiệm phối hợp.
table 'Phân công PIC'
	lineageTag: e4ece5ba-98d8-42f5-9fdb-ca0b7971d330

	/// Số lượt HĐ thuộc phạm vi quyết toán theo PIC; bao gồm fallback ngày mục tiêu của nguồn Hồ Tràm.
	measure 'Số lượt HĐ cần quyết toán' =
			CALCULATE(
			    COUNTROWS('Phân công PIC'),
			    NOT ISBLANK('Phân công PIC'[Ngày mục tiêu])
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: cf0dc78b-72b7-46a1-b773-0db54645d1f0

	/// Số lượt HĐ thuộc phạm vi theo PIC có năm mục tiêu bằng năm hiện tại.
	measure 'Số lượt HĐ cần quyết toán (năm nay)' =
			CALCULATE(
			    [Số lượt HĐ cần quyết toán],
			    'Phân công PIC'[Năm mục tiêu] = YEAR(TODAY())
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: 2ae6e687-6091-442d-99f7-2bc58eb5ced4

	/// Số lượt HĐ thuộc phạm vi theo PIC có tình trạng 'Đã quyết toán'.
	measure 'Số lượt HĐ hoàn thành' =
			CALCULATE(
			    [Số lượt HĐ cần quyết toán],
			    'Phân công PIC'[Tình trạng quyết toán] = "Đã quyết toán"
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: 2c784507-cd82-4686-87cf-08726dc40d86

	/// Tỷ lệ hoàn thành theo lượt HĐ thuộc phạm vi được phân công cho PIC.
	measure '% Hoàn thành PIC' =
			DIVIDE(
			    [Số lượt HĐ hoàn thành],
			    [Số lượt HĐ cần quyết toán]
			)
		formatString: 0.00%
		displayFolder: KPI quyết toán
		lineageTag: 70813dfb-a52a-480c-a3d2-9fd403b7d3b0

	/// (1) Tổng số lượt phân công có ngày mục tiêu; không bị giới hạn bởi slicer Kỳ mục tiêu.
	measure '(1) Số lượt cần quyết toán' =
			CALCULATE (
			    COUNTROWS ( 'Phân công PIC' ),
			    NOT ISBLANK ( 'Phân công PIC'[Ngày mục tiêu] ),
			    REMOVEFILTERS ( 'Phân công PIC'[Năm mục tiêu] ),
			    REMOVEFILTERS ( 'Phân công PIC'[Quý mục tiêu] ),
			    REMOVEFILTERS ( 'Phân công PIC'[Kỳ mục tiêu] )
			)
		formatString: #,##0
		displayFolder: Tracking theo PIC\01. Kế hoạch (Cột 1-4)
		lineageTag: 97de1068-05ee-44ed-bd63-6c5337defc02

	/// Measure alias tương thích cho các visual đang dùng tên cũ '(2) Số lượt cần quyết toán 2026'.
	measure '(2) Số lượt cần quyết toán 2026' = [(2) Số lượt cần quyết toán theo kỳ]
		formatString: #,##0
		displayFolder: Tracking theo PIC\01. Kế hoạch (Cột 1-4)
		lineageTag: c6e8fcd8-12dc-4b0c-96ef-2f8e67c7ea92

	/// (2.1) KPI đã đăng ký theo PIC: Lượt phân công có Ngày mục tiêu trong kỳ và KPI quyết toán chứa chữ 'KPI'.
	measure '(2.1) KPI đã đăng ký (PIC)' =
			CALCULATE (
			    COUNTROWS ( 'Phân công PIC' ),
			    KEEPFILTERS ( NOT ISBLANK ( 'Phân công PIC'[Ngày mục tiêu] ) ),
			    KEEPFILTERS ( CONTAINSSTRING ( UPPER ( COALESCE ( 'Phân công PIC'[KPI quyết toán], "" ) ), "KPI" ) )
			)
		formatString: #,##0
		displayFolder: Tracking theo PIC\01. Kế hoạch (Cột 1-4)
		lineageTag: 11a41e12-8e41-425c-bbf7-b9833aa8b208

	/// (2.2) Đăng ký thêm theo PIC: Lượt phân công có Ngày mục tiêu trong kỳ và KPI quyết toán chứa chữ 'NGOÀI'.
	measure '(2.2) Đăng ký thêm (PIC)' =
			CALCULATE (
			    COUNTROWS ( 'Phân công PIC' ),
			    KEEPFILTERS ( NOT ISBLANK ( 'Phân công PIC'[Ngày mục tiêu] ) ),
			    KEEPFILTERS ( CONTAINSSTRING ( UPPER ( COALESCE ( 'Phân công PIC'[KPI quyết toán], "" ) ), "NGOÀI" ) )
			)
		formatString: #,##0
		displayFolder: Tracking theo PIC\01. Kế hoạch (Cột 1-4)
		lineageTag: 0a1f7e11-f093-4559-ad34-96dc5140c3ce

	/// Phần còn lại để cân đối: (2) = (2.1) + (2.2) + (2.3).
	measure '(2.3) Chưa phân loại KPI (PIC)' =
			COUNTROWS (
			    FILTER (
			        'Phân công PIC',
			        NOT ISBLANK ( 'Phân công PIC'[Ngày mục tiêu] )
			            && NOT 'Phân công PIC'[Nhóm KPI quyết toán] IN { "KPI đã đăng ký", "Đăng ký thêm" }
			    )
			)
		formatString: #,##0
		displayFolder: Tracking theo PIC\01. Kế hoạch (Cột 1-4)
		lineageTag: 04e16605-4e37-40d8-ac92-42ed59f8070e

	/// Measure alias tương thích cho các visual đang dùng tên cũ '(3) Số lượt hoàn thành 2026'.
	measure '(3) Số lượt hoàn thành 2026' = [(3) Số lượt hoàn thành trong kỳ]
		formatString: #,##0
		displayFolder: Tracking theo PIC\02. Hoàn thành (Cột 5, 7, 9, 10)
		lineageTag: 83a81616-7ba3-4542-8dab-baba86f7c766

	/// Measure alias tương thích cho tên cũ.
	measure '% Hoàn thành theo KPI đã đăng ký (PIC)' = [% Hoàn thành KPI (PIC)]
		formatString: 0.00%
		displayFolder: Tracking theo PIC\03. Tỷ lệ % (Cột 6, 8)
		lineageTag: ec3878e2-6aaa-4370-b342-aec5712f3263

	/// Measure alias tương thích cho tên cũ.
	measure '% Hoàn thành 2026 (PIC)' = [% Hoàn thành trong kỳ (PIC)]
		formatString: 0.00%
		displayFolder: Tracking theo PIC\03. Tỷ lệ % (Cột 6, 8)
		lineageTag: e1da3afd-c86a-4c38-b755-ed41abafdafd

	/// Measure alias tương thích cho tên cũ.
	measure 'Giá trị đã quyết toán 2026 (PIC)' = [Giá trị quyết toán trong kỳ (PIC)]
		formatString: #,##0
		displayFolder: Tracking theo PIC\04. Giá trị (Cột 11)
		lineageTag: dd2b57d3-5953-47d3-803e-a14847d0e213

	/// Measure alias tương thích cho tên cũ.
	measure '(3.1) Số lượt hoàn thành thuộc KPI đã đăng ký' = [(3.1) Lượt hoàn thành theo KPI (PIC)]
		formatString: #,##0
		displayFolder: Tracking theo PIC\02. Hoàn thành (Cột 5, 7, 9, 10)
		lineageTag: 82390f8d-f60a-4926-b34f-9d01af510afd

	/// (3.1) / (2.1) theo PIC - luôn <= 100%.
	measure '% Hoàn thành KPI đăng ký (chặt) (PIC)' = DIVIDE ( [(3.1) Lượt hoàn thành theo KPI (PIC)], [(2.1) KPI đã đăng ký (PIC)] )
		formatString: 0.00%
		displayFolder: Tracking theo PIC\03. Tỷ lệ % (Cột 6, 8)
		lineageTag: 71cf155d-30a3-47ba-9ab3-85bebfd929dd

	measure 'Số lượng gói (Ngày mục tiêu) PIC' =
			CALCULATE(
			    COUNTROWS('Phân công PIC'),
			    USERELATIONSHIP(DimDate[Năm Quý Sort], 'Phân công PIC'[Muctieukey])
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: b6375c46-2ea6-44df-a486-fbf8f596a169

	measure 'Số lượng gói (Ngày quyết toán) PIC' =
			CALCULATE(
			    COUNTROWS('Phân công PIC'),
			    USERELATIONSHIP(DimDate[Năm Quý Sort], 'Phân công PIC'[QuyetToankey])
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: b545011b-80e1-4bbd-b61e-aaaedccb7b86

	/// (2) Kế hoạch theo kỳ: Lượt phân công có ngày mục tiêu trong kỳ slicer đang chọn.
	measure '(2) Số lượt cần quyết toán theo kỳ' =
			CALCULATE (
			    COUNTROWS ( 'Phân công PIC' ),
			    KEEPFILTERS ( NOT ISBLANK ( 'Phân công PIC'[Ngày mục tiêu] ) )
			)
		formatString: #,##0
		displayFolder: Tracking theo PIC\01. Kế hoạch (Cột 1-4)
		lineageTag: b1e51240-a1b2-4c89-b001-c85240de0103

	/// (3.2) Lượt hoàn thành đạt mục tiêu (PIC): NGÀY DUYỆT CTQT <= NGÀY MỤC TIÊU, cả duyệt và mục tiêu nằm trong kỳ slicer đang chọn.
	measure '(3.2) Lượt hoàn thành đạt mục tiêu (PIC)' =
			VAR _LocNam = ISFILTERED ( 'Phân công PIC'[Năm mục tiêu] )
			VAR _LocQuy = ISFILTERED ( 'Phân công PIC'[Quý mục tiêu] )
			VAR _NamDaChon = VALUES ( 'Phân công PIC'[Năm mục tiêu] )
			VAR _QuyDaChon = VALUES ( 'Phân công PIC'[Quý mục tiêu] )
			RETURN
			    COUNTROWS (
			        FILTER (
			            'Phân công PIC',
			            NOT ISBLANK ( 'Phân công PIC'[Ngày mục tiêu] )
			                && NOT ISBLANK ( 'Phân công PIC'[Năm ký quyết toán] )
			                && 'Phân công PIC'[Đạt tiến độ mục tiêu] = TRUE ()
			                && ( NOT _LocNam || 'Phân công PIC'[Năm ký quyết toán] IN _NamDaChon )
			                && ( NOT _LocQuy || 'Phân công PIC'[Quý quyết toán] IN _QuyDaChon )
			                && ( NOT _LocNam || 'Phân công PIC'[Năm mục tiêu] IN _NamDaChon )
			                && ( NOT _LocQuy || 'Phân công PIC'[Quý mục tiêu] IN _QuyDaChon )
			        )
			    )
		formatString: #,##0
		displayFolder: Tracking theo PIC\02. Hoàn thành (Cột 5, 7, 9, 10)
		lineageTag: a7b8c9d0-1234-5678-90ab-cdef01234567

	/// (3.3) Lượt hoàn thành vượt mục tiêu (PIC): NGÀY DUYỆT CTQT <= NGÀY MỤC TIÊU, duyệt trong kỳ slicer, mục tiêu ở kỳ tương lai.
	measure '(3.3) Lượt hoàn thành vượt mục tiêu (PIC)' =
			VAR _LocNam = ISFILTERED ( 'Phân công PIC'[Năm mục tiêu] )
			VAR _LocQuy = ISFILTERED ( 'Phân công PIC'[Quý mục tiêu] )
			VAR _NamDaChon = VALUES ( 'Phân công PIC'[Năm mục tiêu] )
			VAR _QuyDaChon = VALUES ( 'Phân công PIC'[Quý mục tiêu] )
			VAR _MaxNam = MAXX ( _NamDaChon, 'Phân công PIC'[Năm mục tiêu] )
			VAR _MaxQuy = MAXX ( _QuyDaChon, IFERROR ( VALUE ( RIGHT ( 'Phân công PIC'[Quý mục tiêu], 1 ) ), 4 ) )
			VAR _MaxSlicerSort =
			    IF (
			        _LocQuy && NOT ISBLANK ( _MaxQuy ) && NOT ISBLANK ( _MaxNam ),
			        _MaxNam * 10 + _MaxQuy,
			        IF ( _LocNam && NOT ISBLANK ( _MaxNam ), _MaxNam * 10 + 4, BLANK () )
			    )
			RETURN
			    IF (
			        NOT _LocNam && NOT _LocQuy,
			        0,
			        CALCULATE (
			            COUNTROWS (
			                FILTER (
			                    'Phân công PIC',
			                    NOT ISBLANK ( 'Phân công PIC'[Ngày mục tiêu] )
			                        && NOT ISBLANK ( 'Phân công PIC'[Năm ký quyết toán] )
			                        && 'Phân công PIC'[Đạt tiến độ mục tiêu] = TRUE ()
			                        && ( NOT _LocNam || 'Phân công PIC'[Năm ký quyết toán] IN _NamDaChon )
			                        && ( NOT _LocQuy || 'Phân công PIC'[Quý quyết toán] IN _QuyDaChon )
			                        && (
			                            VAR _TargetSort = 'Phân công PIC'[Năm mục tiêu] * 10 + IFERROR ( VALUE ( RIGHT ( 'Phân công PIC'[Quý mục tiêu], 1 ) ), 4 )
			                            RETURN _TargetSort > _MaxSlicerSort
			                        )
			                )
			            ),
			            REMOVEFILTERS ( 'Phân công PIC'[Năm mục tiêu] ),
			            REMOVEFILTERS ( 'Phân công PIC'[Quý mục tiêu] ),
			            REMOVEFILTERS ( 'Phân công PIC'[Kỳ mục tiêu] )
			        )
			    )
		formatString: #,##0
		displayFolder: Tracking theo PIC\02. Hoàn thành (Cột 5, 7, 9, 10)
		lineageTag: b8c9d0e1-2345-6789-01bc-def012345678

	/// (3) Số lượt hoàn thành trong kỳ: Tổng số lượt hoàn thành đạt mục tiêu và vượt mục tiêu trong kỳ slicer đang chọn.
	measure '(3) Số lượt hoàn thành trong kỳ' = COALESCE ( [(3.2) Lượt hoàn thành đạt mục tiêu (PIC)], 0 ) + COALESCE ( [(3.3) Lượt hoàn thành vượt mục tiêu (PIC)], 0 )
		formatString: #,##0
		displayFolder: Tracking theo PIC\02. Hoàn thành (Cột 5, 7, 9, 10)
		lineageTag: 93a81616-7ba3-4542-8dab-baba86f7c765

	/// (3.1) Lượt hoàn thành theo KPI (PIC): NGÀY DUYỆT CTQT <= NGÀY MỤC TIÊU, cả duyệt và mục tiêu nằm trong kỳ slicer đang chọn và KPI quyết toán chứa 'KPI'.
	measure '(3.1) Lượt hoàn thành theo KPI (PIC)' =
			VAR _LocNam = ISFILTERED ( 'Phân công PIC'[Năm mục tiêu] )
			VAR _LocQuy = ISFILTERED ( 'Phân công PIC'[Quý mục tiêu] )
			VAR _NamDaChon = VALUES ( 'Phân công PIC'[Năm mục tiêu] )
			VAR _QuyDaChon = VALUES ( 'Phân công PIC'[Quý mục tiêu] )
			RETURN
			    COUNTROWS (
			        FILTER (
			            'Phân công PIC',
			            NOT ISBLANK ( 'Phân công PIC'[Ngày mục tiêu] )
			                && NOT ISBLANK ( 'Phân công PIC'[Năm ký quyết toán] )
			                && 'Phân công PIC'[Đạt tiến độ mục tiêu] = TRUE ()
			                && CONTAINSSTRING ( UPPER ( COALESCE ( 'Phân công PIC'[KPI quyết toán], "" ) ), "KPI" )
			                && ( NOT _LocNam || 'Phân công PIC'[Năm ký quyết toán] IN _NamDaChon )
			                && ( NOT _LocQuy || 'Phân công PIC'[Quý quyết toán] IN _QuyDaChon )
			                && ( NOT _LocNam || 'Phân công PIC'[Năm mục tiêu] IN _NamDaChon )
			                && ( NOT _LocQuy || 'Phân công PIC'[Quý mục tiêu] IN _QuyDaChon )
			        )
			    )
		formatString: #,##0
		displayFolder: Tracking theo PIC\02. Hoàn thành (Cột 5, 7, 9, 10)
		lineageTag: 92390f8d-f60a-4926-b34f-9d01af510afc

	/// Tỷ lệ hoàn thành của nhóm KPI đã đăng ký theo PIC.
	measure '% Hoàn thành KPI (PIC)' = DIVIDE ( [(3.1) Lượt hoàn thành theo KPI (PIC)], [(2.1) KPI đã đăng ký (PIC)] )
		formatString: 0.00%
		displayFolder: Tracking theo PIC\03. Tỷ lệ % (Cột 6, 8)
		lineageTag: fc3878e2-6aaa-4370-b342-aec5712f3262

	/// (3) / (2) theo từng PIC trong kỳ.
	measure '% Hoàn thành trong kỳ (PIC)' = DIVIDE ( [(3) Số lượt hoàn thành trong kỳ], [(2) Số lượt cần quyết toán theo kỳ] )
		formatString: 0.00%
		displayFolder: Tracking theo PIC\03. Tỷ lệ % (Cột 6, 8)
		lineageTag: f1da3afd-c86a-4c38-b755-ed41abafdafc

	/// Tổng giá trị HĐ + PS gồm VAT theo PIC cho các lượt hoàn thành trong kỳ.
	measure 'Giá trị quyết toán trong kỳ (PIC)' =
			VAR _LocNam = ISFILTERED ( 'Phân công PIC'[Năm mục tiêu] )
			VAR _LocQuy = ISFILTERED ( 'Phân công PIC'[Quý mục tiêu] )
			VAR _NamDaChon = VALUES ( 'Phân công PIC'[Năm mục tiêu] )
			VAR _QuyDaChon = VALUES ( 'Phân công PIC'[Quý mục tiêu] )
			VAR _MaxNam = MAXX ( _NamDaChon, 'Phân công PIC'[Năm mục tiêu] )
			VAR _MaxQuy = MAXX ( _QuyDaChon, IFERROR ( VALUE ( RIGHT ( 'Phân công PIC'[Quý mục tiêu], 1 ) ), 4 ) )
			VAR _MaxSlicerSort =
			    IF (
			        _LocQuy && NOT ISBLANK ( _MaxQuy ) && NOT ISBLANK ( _MaxNam ),
			        _MaxNam * 10 + _MaxQuy,
			        IF ( _LocNam && NOT ISBLANK ( _MaxNam ), _MaxNam * 10 + 4, BLANK () )
			    )
			RETURN
			    CALCULATE (
			        SUMX (
			            FILTER (
			                'Phân công PIC',
			                NOT ISBLANK ( 'Phân công PIC'[Ngày mục tiêu] )
			                    && NOT ISBLANK ( 'Phân công PIC'[Năm ký quyết toán] )
			                    && 'Phân công PIC'[Đạt tiến độ mục tiêu] = TRUE ()
			                    && ( NOT _LocNam || 'Phân công PIC'[Năm ký quyết toán] IN _NamDaChon )
			                    && ( NOT _LocQuy || 'Phân công PIC'[Quý quyết toán] IN _QuyDaChon )
			                    && (
			                        NOT _LocNam
			                            || (
			                                VAR _TargetSort = 'Phân công PIC'[Năm mục tiêu] * 10 + IFERROR ( VALUE ( RIGHT ( 'Phân công PIC'[Quý mục tiêu], 1 ) ), 4 )
			                                RETURN ( 'Phân công PIC'[Năm mục tiêu] IN _NamDaChon && ( NOT _LocQuy || 'Phân công PIC'[Quý mục tiêu] IN _QuyDaChon ) )
			                                    || ( _TargetSort > _MaxSlicerSort )
			                            )
			                    )
			            ),
			            'Phân công PIC'[Giá trị HĐ + PS gồm VAT]
			        ),
			        REMOVEFILTERS ( 'Phân công PIC'[Năm mục tiêu] ),
			        REMOVEFILTERS ( 'Phân công PIC'[Quý mục tiêu] ),
			        REMOVEFILTERS ( 'Phân công PIC'[Kỳ mục tiêu] )
			    )
		formatString: #,##0
		displayFolder: Tracking theo PIC\04. Giá trị (Cột 11)
		lineageTag: ed2b57d3-5953-47d3-803e-a14847d0e212


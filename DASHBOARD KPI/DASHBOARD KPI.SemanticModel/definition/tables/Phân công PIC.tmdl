	column 'Ngày mục tiêu'
		dataType: string
		displayFolder: Tracking theo PIC\Tiến độ mục tiêu
		lineageTag: 71cf155d-30a3-47ba-9ab3-85bebfd929db
		summarizeBy: none
		isNameInferred
		sourceColumn: [Ngày mục tiêu]

		annotation SummarizationSetBy = Automatic

	hierarchy 'Kỳ mục tiêu phân cấp'
		lineageTag: e8a91254-4b21-4f81-9b12-58ab12345679

		level Năm
			lineageTag: 22345678-1234-1234-1234-123456789a01
			column: 'Năm mục tiêu'

		level Quý
			lineageTag: 22345678-1234-1234-1234-123456789a02
			column: 'Quý mục tiêu'

	partition 'Phân công PIC' = calculated
		mode: import
		source =
				
				VAR _XayDung =
				    SELECTCOLUMNS (
				        FILTER (
				            Data,
				            NOT ISBLANK ( Data[PIC XÂY DỰNG/CUNG ỨNG] )
				                && TRIM ( Data[PIC XÂY DỰNG/CUNG ỨNG] ) <> ""
				        ),
				        "Mã hợp đồng", Data[File] & "|" & FORMAT ( Data[STT], "0" ),
				        "PIC phụ trách", TRIM ( Data[PIC XÂY DỰNG/CUNG ỨNG] ),
				        "Nhóm PIC", "Xây dựng/Cung ứng",
				        "File", Data[File],
				        "Khu vực", Data[Khu vực chuẩn],
				        "Dự án", Data[TÊN VIẾT TẮT DỰ ÁN/ĐƠN VỊ],
				        "Kỳ mục tiêu", Data[Kỳ mục tiêu],
				        "Năm mục tiêu", Data[Năm mục tiêu],
				        "Quý mục tiêu", Data[Quý mục tiêu],
				        "Ngày mục tiêu", Data[NGÀY MỤC TIÊU],
				        "Năm ký quyết toán", Data[Năm ký quyết toán],
				        "Quý quyết toán", Data[Quý quyết toán],
				        "Đạt tiến độ mục tiêu", Data[Đạt tiến độ mục tiêu],
				        "Nhóm KPI quyết toán", Data[Nhóm KPI quyết toán],
				        "Giá trị workdone gồm VAT", Data[Giá trị workdone gồm VAT],
				        "Giá trị HĐ + PS gồm VAT", Data[Giá trị HĐ + PS gồm VAT số],
				        "Thuộc phạm vi quyết toán", Data[Thuộc phạm vi quyết toán],
				        "KPI quyết toán", Data[KPI QUYẾT TOÁN],
				        "Tình trạng quyết toán", Data[TÌNH TRẠNG QUYẾT TOÁN],
				        "Tình trạng quyết toán (chuẩn)", Data[TÌNH TRẠNG QUYẾT TOÁN (chuẩn)]
				    )
				
				VAR _MEP =
				    SELECTCOLUMNS (
				        FILTER (
				            Data,
				            NOT ISBLANK ( Data[PIC MEP] )
				                && TRIM ( Data[PIC MEP] ) <> ""
				        ),
				        "Mã hợp đồng", Data[File] & "|" & FORMAT ( Data[STT], "0" ),
				        "PIC phụ trách", TRIM ( Data[PIC MEP] ),
				        "Nhóm PIC", "MEP",
				        "File", Data[File],
				        "Khu vực", Data[Khu vực chuẩn],
				        "Dự án", Data[TÊN VIẾT TẮT DỰ ÁN/ĐƠN VỊ],
				        "Kỳ mục tiêu", Data[Kỳ mục tiêu],
				        "Năm mục tiêu", Data[Năm mục tiêu],
				        "Quý mục tiêu", Data[Quý mục tiêu],
				        "Ngày mục tiêu", Data[NGÀY MỤC TIÊU],
				        "Năm ký quyết toán", Data[Năm ký quyết toán],
				        "Quý quyết toán", Data[Quý quyết toán],
				        "Đạt tiến độ mục tiêu", Data[Đạt tiến độ mục tiêu],
				        "Nhóm KPI quyết toán", Data[Nhóm KPI quyết toán],
				        "Giá trị workdone gồm VAT", Data[Giá trị workdone gồm VAT],
				        "Giá trị HĐ + PS gồm VAT", Data[Giá trị HĐ + PS gồm VAT số],
				        "Thuộc phạm vi quyết toán", Data[Thuộc phạm vi quyết toán],
				        "KPI quyết toán", Data[KPI QUYẾT TOÁN],
				        "Tình trạng quyết toán", Data[TÌNH TRẠNG QUYẾT TOÁN],
				        "Tình trạng quyết toán (chuẩn)", Data[TÌNH TRẠNG QUYẾT TOÁN (chuẩn)]
				    )
				
				RETURN
				    UNION ( _XayDung, _MEP )


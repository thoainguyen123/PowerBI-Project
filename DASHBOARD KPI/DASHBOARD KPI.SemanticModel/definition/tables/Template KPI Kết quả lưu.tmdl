	partition 'Template KPI Kết quả lưu' = calculated
		mode: import
		source =
				VAR _Rows=ADDCOLUMNS(SUMMARIZE('KPI Đăng ký','KPI Đăng ký'[Dòng nguồn]),
				"__R1",CALCULATE([Template Kết quả cá nhân Q1],ALLEXCEPT('KPI Đăng ký','KPI Đăng ký'[Dòng nguồn]),REMOVEFILTERS('Kỳ đánh giá đấu thầu')),
				"__P1",CALCULATE([Template Điểm QTHD cá nhân Q1],ALLEXCEPT('KPI Đăng ký','KPI Đăng ký'[Dòng nguồn]),REMOVEFILTERS('Kỳ đánh giá đấu thầu')),
				"__R2",CALCULATE([Template Kết quả cá nhân Q2],ALLEXCEPT('KPI Đăng ký','KPI Đăng ký'[Dòng nguồn]),REMOVEFILTERS('Kỳ đánh giá đấu thầu')),
				"__P2",CALCULATE([Template Điểm QTHD cá nhân Q2],ALLEXCEPT('KPI Đăng ký','KPI Đăng ký'[Dòng nguồn]),REMOVEFILTERS('Kỳ đánh giá đấu thầu')),
				"__R3",CALCULATE([Template Kết quả cá nhân Q3],ALLEXCEPT('KPI Đăng ký','KPI Đăng ký'[Dòng nguồn]),REMOVEFILTERS('Kỳ đánh giá đấu thầu')),
				"__P3",CALCULATE([Template Điểm QTHD cá nhân Q3],ALLEXCEPT('KPI Đăng ký','KPI Đăng ký'[Dòng nguồn]),REMOVEFILTERS('Kỳ đánh giá đấu thầu')),
				"__R4",CALCULATE([Template Kết quả cá nhân Q4],ALLEXCEPT('KPI Đăng ký','KPI Đăng ký'[Dòng nguồn]),REMOVEFILTERS('Kỳ đánh giá đấu thầu')),
				"__P4",CALCULATE([Template Điểm QTHD cá nhân Q4],ALLEXCEPT('KPI Đăng ký','KPI Đăng ký'[Dòng nguồn]),REMOVEFILTERS('Kỳ đánh giá đấu thầu')))
				RETURN SELECTCOLUMNS(_Rows,
				"Dòng đăng ký",'KPI Đăng ký'[Dòng nguồn],
				"Kết quả Q1",[__R1],
				"Điểm QTHD Q1",[__P1],
				"Kết quả Q2",[__R2],
				"Điểm QTHD Q2",[__P2],
				"Kết quả Q3",[__R3],
				"Điểm QTHD Q3",[__P3],
				"Kết quả Q4",[__R4],
				"Điểm QTHD Q4",[__P4])


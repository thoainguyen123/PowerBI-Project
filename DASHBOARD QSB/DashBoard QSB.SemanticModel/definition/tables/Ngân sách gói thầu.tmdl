				  Typed = Table.TransformColumnTypes(Selected,{{"Cụm", type text}, {"Dự án", type text}, {"Gói thầu", type text}, {"Số căn", type text}, {"Khu", type text}, {"Ngân sách gói thầu(A)", Int64.Type}, {"Đã giao thầu(B)", Int64.Type}, {"Ngân sách gói thầu còn lại(A-B)", Int64.Type}, {"Tỉ lệ còn lại(%)", type number}})

table 'Tab tình trạng thực hiện BOQ'
	lineageTag: 42f155dc-3039-4189-9fc7-4673b7cb2e90

	/// Tổng số dòng theo dõi BOQ trong ngữ cảnh bộ lọc hiện tại.
	measure 'Tổng line BOQ' = COUNTROWS('Tab tình trạng thực hiện BOQ')
		formatString: #,##0
		displayFolder: BOQ KPIs
		lineageTag: 6ce7ad8c-d76f-4b57-9239-cdec94195b27

	/// Số dòng BOQ được phân loại đúng tiến độ trong ngữ cảnh bộ lọc hiện tại.
	measure 'Đúng tiến độ BOQ' = CALCULATE([Tổng line BOQ], KEEPFILTERS('Tab tình trạng thực hiện BOQ'[Trễ hạn/ Đúng tiến độ/ Đang thực hiện] = "Đúng tiến độ"))
		formatString: #,##0
		displayFolder: BOQ KPIs
		lineageTag: c3467992-e870-4cff-a68d-b58546c89e45

	/// Số dòng BOQ được phân loại trễ hạn trong ngữ cảnh bộ lọc hiện tại.
	measure 'Trễ hạn BOQ' = CALCULATE([Tổng line BOQ], KEEPFILTERS('Tab tình trạng thực hiện BOQ'[Trễ hạn/ Đúng tiến độ/ Đang thực hiện] = "Trễ hạn"))
		formatString: #,##0
		displayFolder: BOQ KPIs
		lineageTag: 3c5ef168-0399-4796-bf54-c743fad4b837

	/// Số dòng BOQ được phân loại ngoài kế hoạch trong ngữ cảnh bộ lọc hiện tại.
	measure 'Ngoài kế hoạch BOQ' = CALCULATE([Tổng line BOQ], KEEPFILTERS('Tab tình trạng thực hiện BOQ'[Trễ hạn/ Đúng tiến độ/ Đang thực hiện] = "Ngoài kế hoạch"))
		formatString: #,##0
		displayFolder: BOQ KPIs
		lineageTag: 009eb8b6-242c-47e7-a5e4-f97a787ac2d4

	/// Tỷ lệ dòng BOQ đúng tiến độ trên tổng số dòng BOQ trong ngữ cảnh bộ lọc hiện tại.
	measure 'Tỷ lệ đúng tiến độ BOQ' = DIVIDE([Đúng tiến độ BOQ], [Tổng line BOQ], 0)
		formatString: 0.0%
		displayFolder: BOQ KPIs
		lineageTag: 2365e92a-040b-4ec9-a3fa-31b5d340d50a


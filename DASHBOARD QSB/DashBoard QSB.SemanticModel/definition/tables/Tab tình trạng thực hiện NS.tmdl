	column 'Tình trạng nguồn'
		dataType: string
		lineageTag: b43ae3a7-0149-4973-8650-651b22d08bf8
		summarizeBy: none
		sourceColumn: Tình trạng nguồn

		annotation SummarizationSetBy = Automatic

	partition 'Tab tình trạng thực hiện NS' = m
		mode: import
		source =
				let
				  Source = Excel.Workbook(Web.Contents("https://novaland.sharepoint.com/sites/qs-projectcost/Documents/00.%20NOVAGEN-QSB/08.%20Nhat%20ky%20cong%20viec/00.%20Dashboard%20b%C3%A1o%20c%C3%A1o/01.%20Link%20dashboard/QSB_%20dashboard%20bao%20cao.xlsx"), null, true),
				  Raw = Source{[Item = "3. Tab tình trạng thực hiện NS", Kind = "Sheet"]}[Data],
				  PromotedHeaders = Table.PromoteHeaders(Raw, [PromoteAllScalars = true]),
				  Renamed = Table.RenameColumns(PromotedHeaders, {{"CỤM DỰ ÁN", "Nhóm dự án"}, {"DỰ ÁN", "Dự án"}, {"TÌNH TRẠNG", "Nội dung tình trạng"}, {"Tiến độ MTL", "Tiến độ gốc"}, {"Tình trạng tiến độ", "Tình trạng nguồn"}, {"Ưu tiên", "Ưu tiên"}}, MissingField.Ignore),
				  Selected = Table.SelectColumns(Renamed, {"Nhóm dự án", "Dự án", "Nội dung tình trạng", "Tiến độ gốc", "Tình trạng nguồn", "Ưu tiên"}, MissingField.UseNull),
				  TypedText = Table.TransformColumns(Selected, {
				    {"Nhóm dự án", each let v = if _ = null then null else Text.Trim(Text.From(_)) in if v = "" then null else v, type text},
				    {"Dự án", each let v = if _ = null then null else Text.Trim(Text.From(_)) in if v = "" then null else v, type text},
				    {"Nội dung tình trạng", each let v = if _ = null then null else Text.Trim(Text.From(_)) in if v = "" then null else v, type text},
				    {"Tình trạng nguồn", each let v = if _ = null then null else Text.Trim(Text.From(_)) in if v = "" then null else v, type text},
				    {"Ưu tiên", each let v = if _ = null then null else Text.Trim(Text.From(_)) in if v = "" then null else v, type text}
				  }),
				  FilledGroup = Table.FillDown(TypedText, {"Nhóm dự án"}),
				  GroupHeadings = {"NGÂN SÁCH THỰC THI", "AQUA", "PHAN THIẾT", "HỒ TRÀM", "CẦU ĐẤT", "TPHCM", "ĐB SCL", "DỰ TOÁN", "NVW.PT", "ĐỒNG NAI 2", "ĐỒNG NAI 3", "THƯ VIỆN MẪU NHÀ VÀ DATA SUẤT ĐẦU TƯ"},
				  AddedGroupFallback = Table.AddColumn(FilledGroup, "Nhóm dự án chuẩn", each if [Nhóm dự án] <> null then [Nhóm dự án] else if [Dự án] <> null and List.Contains(GroupHeadings, Text.Upper([Dự án])) then [Dự án] else null, type text),
				  RemovedOldGroup = Table.RemoveColumns(AddedGroupFallback, {"Nhóm dự án"}),
				  RenamedGroup = Table.RenameColumns(RemovedOldGroup, {{"Nhóm dự án chuẩn", "Nhóm dự án"}}),
				  FilledFallbackGroup = Table.FillDown(RenamedGroup, {"Nhóm dự án"}),
				  AddedDate = Table.AddColumn(FilledFallbackGroup, "Ngày tiến độ", each try Date.From([Tiến độ gốc]) otherwise try Date.FromText(Text.From([Tiến độ gốc]), [Culture = "vi-VN"]) otherwise try Date.AddDays(#date(1899, 12, 30), Number.FromText(Text.From([Tiến độ gốc]), "en-US")) otherwise null, type date),
				  AddedDateDisplay = Table.AddColumn(AddedDate, "Ngày tiến độ hiển thị", each if [Ngày tiến độ] <> null then Date.ToText([Ngày tiến độ], "dd/MM/yyyy", "vi-VN") else "-", type text),
				  DetailOnly = Table.SelectRows(AddedDateDisplay, each [Dự án] <> null and [Nội dung tình trạng] <> null and not List.Contains(GroupHeadings, Text.Upper([Dự án]))),
				  AddedNormalizedStatus = Table.AddColumn(DetailOnly, "Tình trạng chuẩn hóa", each
				    let
				      SourceStatus = if [Tình trạng nguồn] = null then "" else Text.Lower([Tình trạng nguồn]),
				      StatusText = Text.Lower([Nội dung tình trạng]),
				      IsComplete = Text.Contains(SourceStatus, "hoàn thành") or List.AnyTrue(List.Transform({"hoàn thành", "đã duyệt", "đã gửi"}, (token) => Text.Contains(StatusText, token))),
				      IsExplicitLate = Text.Contains(SourceStatus, "trễ") or Text.Contains(SourceStatus, "chậm") or List.AnyTrue(List.Transform({"trễ hạn", "chậm", "quá hạn"}, (token) => Text.Contains(StatusText, token))),
				      IsPastDue = [Ngày tiến độ] <> null and [Ngày tiến độ] < Date.From(DateTime.LocalNow())
				    in
				      if IsComplete then "Hoàn thành" else if IsExplicitLate or IsPastDue then "Chậm tiến độ" else "Đang thực hiện",
				    type text),
				  AddedStatusOrder = Table.AddColumn(AddedNormalizedStatus, "Thứ tự tình trạng", each if [Tình trạng chuẩn hóa] = "Chậm tiến độ" then 3 else if [Tình trạng chuẩn hóa] = "Đang thực hiện" then 2 else 1, Int64.Type),
				  FinalTyped = Table.TransformColumns(AddedStatusOrder, {{"Tiến độ gốc", each if _ = null then null else Text.From(_, "vi-VN"), type text}})
				in
				  FinalTyped

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation


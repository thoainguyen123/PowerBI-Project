	column Hierachy_Path = PATH(Directory[_id],Directory[ParentId])
		lineageTag: 3147b907-4abf-46f0-b381-7bf11f729831
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Lv1_Name =
			
			VAR _Lv1_ID = PATHITEM(Directory[Hierachy_Path], 1, TEXT)
			RETURN
			    LOOKUPVALUE(Directory[name], Directory[_id], _Lv1_ID)
		lineageTag: 74326d69-19ad-4a94-b1b5-4cb86fc20a21
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Lv2_Name = ```
			
			VAR _Lv2_ID = PATHITEM(Directory[Hierachy_Path], 2, TEXT)
			RETURN
			    IF(
			        ISBLANK(_Lv2_ID), 
			        BLANK(), 
			        LOOKUPVALUE(Directory[name], Directory[_id], _Lv2_ID)
			    )
			```
		lineageTag: 303b8362-299d-4706-b1b2-60d0da30221f

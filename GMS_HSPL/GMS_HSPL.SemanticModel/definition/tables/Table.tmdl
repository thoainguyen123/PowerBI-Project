	measure Luy_Ke_Distinct_ID =
			
			VAR _MaxDate = MAX(HSPL[createdAt])
			RETURN
			    CALCULATE(
			        DISTINCTCOUNT(HSPL[_id]),
			        FILTER(
			            ALLSELECTED(HSPL),
			            HSPL[createdAt] <= _MaxDate
			        )
			    )
		formatString: 0
		lineageTag: e2ec9f35-af53-4e34-a623-abf6f2e98d35


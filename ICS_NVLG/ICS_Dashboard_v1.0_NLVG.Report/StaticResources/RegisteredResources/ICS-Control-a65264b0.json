{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.153.json",
  "name": "ICS-Control-a65264b0.json",
  "dataColors": [
    "#0E7490",
    "#2563EB",
    "#7C3AED",
    "#D97706",
    "#0F766E",
    "#B45309",
    "#C2410C",
    "#64748B"
  ],
  "good": "#0F766E",
  "neutral": "#D97706",
  "bad": "#C2410C",
  "maximum": "#2563EB",
  "center": "#D97706",
  "minimum": "#D9EAF2",
  "null": "#94A3B8",
  "foreground": "#102A43",
  "foregroundNeutralSecondary": "#52667A",
  "foregroundNeutralTertiary": "#829AB1",
  "backgroundLight": "#F4F7FB",
  "backgroundNeutral": "#D9E2EC",
  "background": "#FFFFFF",
  "tableAccent": "#0E7490",
  "textClasses": {
    "callout": {
      "fontSize": 28,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F2747"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#0F2747"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#102A43"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#102A43"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "dropShadow": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#E7EDF3"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#E7EDF3"
              }
            }
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "cardCalloutArea": [
          {
            "paddingUniform": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "backColor": {
              "solid": {
                "color": "#0F4660"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F7FAFC"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#102A43"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#102A43"
              }
            }
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "labelPosition": "Above",
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false
          }
        ]
      }
    },
    "clusteredBarChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false
          }
        ]
      }
    }
  }
}
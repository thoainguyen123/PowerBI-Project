	partition DateTable = calculated
		mode: import
		source = ```
				
				VAR StartDate = DATE(2025, 1, 1) -- Ngày bắt đầu: 01/01/2025
				VAR EndDate = DATE(2026, 12, 31)   -- Ngày kết thúc: 31/12/2026
				VAR BaseCalendar = CALENDAR(StartDate, EndDate) 
				
				RETURN
				    ADDCOLUMNS (
				        BaseCalendar,
				        "Năm", YEAR([Date]),
				        "Tháng Số", MONTH([Date]),
				        "Tên Tháng", "Tháng " & MONTH([Date]), -- Hiển thị: Tháng 1, Tháng 2...
				        "Tên Tháng Ngắn", FORMAT([Date], "mmm"), -- Hiển thị: Jan, Feb...
				        "Quý", "Quý " & QUARTER([Date]), -- Hiển thị: Quý 1, Quý 2...
				        "Tuần", "Tuần " & WEEKNUM([Date], 2), -- Số 2 là tính Thứ 2 là đầu tuần
				        "Ngày trong tuần", WEEKDAY([Date], 2), -- 1 là Thứ 2, 7 là CN
				        "Năm - Tháng", FORMAT([Date], "yyyy-MM"),
				        "Week num", WEEKNUM([Date], 2),
				        "YearWeekSort", YEAR([Date]) * 100 + WEEKNUM([Date], 2), -- Dùng để sắp xếp biểu đồ
				        
				        -- CỘT THÊM MỚI: Khoảng thời gian của tuần (Thứ 2 - Chủ Nhật)
				        "Khoảng thời gian tuần", 
				            VAR StartOfWeek = [Date] - WEEKDAY([Date], 2) + 1
				            VAR EndOfWeek = [Date] - WEEKDAY([Date], 2) + 7
				            RETURN "(" & FORMAT(StartOfWeek, "dd/MM/yy") & " - " & FORMAT(EndOfWeek, "dd/MM/yy") & ")"
				    )
				```

	annotation PBI_Id = e72fe8db2c414bc1a834861f0e037d85


	measure 'Violation (Chờ xử lý) trì trệ' = ```
			
			-- 1. Xác định ngày hôm nay (theo giờ Việt Nam)
			VAR _HomNay = DATE(YEAR(NOW()+7/24), MONTH(NOW()+7/24), DAY(NOW()+7/24))
			
			-- 2. Tính ngày mốc (Lùi lại 3 tháng so với hôm nay)
			-- Ví dụ: Hôm nay 27/01/2026 -> Mốc là 27/10/2025
			VAR _NgayMoc = EDATE(_HomNay, -3)
			
			-- 3. Tính toán số lượng
			VAR x = CALCULATE(
			    DISTINCTCOUNTNOBLANK(ICS[violation_code]), 
			    ICS[isViolation] = TRUE(), 
			    ICS[violation_status] = "Chờ xử lý", 
			    
			    -- Lọc những ngày NHỎ HƠN ngày mốc (Tức là cũ hơn 3 tháng)
			    'DateTable'[Date] < _NgayMoc
			)
			 
			RETURN 
			    IF(ISBLANK(x), 0, x)
			```
		formatString: 0
		lineageTag: 77e9f1dc-699d-4357-b5ea-4e121fd0ae8a

	measure 'KP-NN count' =
			
			var x = [action_count]
			Return if(x>0,x,0)

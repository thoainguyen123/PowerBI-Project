	measure Text_Bao_Cao_Tinh_Hinh = ```
			
			VAR HR_Violation = [Violation (Ghi nhận)]
			VAR DVCM_Violation = [Violation (Chờ xử lý)]
			VAR Tre_Han_Total = [action_tre_han_total]
			VAR Enter = UNICHAR(13) & UNICHAR(10) 
			RETURN
			"𝐓𝐢̀𝐧𝐡 𝐡𝐢̀𝐧𝐡 𝐗𝐮̛̉ 𝐥𝐲́ 𝐯𝐢 𝐩𝐡𝐚̣𝐦 - 𝐊𝐡𝐚̆́𝐜 𝐩𝐡𝐮̣𝐜 - 𝐍𝐠𝐚̆𝐧 𝐧𝐠𝐮̛̀𝐚:" 
			    & Enter & "  • Vi phạm chờ tại HR: " & FORMAT(DVCM_Violation, "#,##0") 
			    & Enter & "  • Vi phạm chờ tại ĐVCM KSTT: " & FORMAT(HR_Violation, "#,##0") 
			    & Enter & "  • Kế hoạch KP-NN trễ hạn: " & FORMAT(Tre_Han_Total, "#,##0") 
			```

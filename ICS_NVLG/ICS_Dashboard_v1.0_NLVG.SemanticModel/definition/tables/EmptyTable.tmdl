	measure HTML_Top_Violation_Info =
			
			VAR TenBranch = [Divison_Vi_Pham_Nhieu_Nhat]
			VAR SoVu = [So_Vu_Vi_Pham_Max]
			RETURN
			    IF(
			        NOT(ISBLANK(SoVu)),
			        "<div style='font-family: Segoe UI; font-size: 24px;'>
			            <span style='color: #749892; font-weight: bold;'>" & TenBranch & "</span>
			            <br/>
			            <b style='color: #D62828; font-size: 18px;'>" & SoVu & " Vi phạm</b>
			         </div>",
			        "<span style='color: #749892;'>Không có ghi nhận vi phạm.</span>"
			    )
		lineageTag: 5934268b-9270-4d21-8c16-1791382c2364


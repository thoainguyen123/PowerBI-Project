	measure MucDoViPham_NangNhat = ```
			
			VAR MinSoThuTu = 
			    MINX(
			        'ICS', 
			        -- Khai báo 2 cột đang xét trên dòng hiện tại
			        VAR HinhThuc = 'ICS'[laborRuleViolationSeverity_name]
			        VAR MucDo = 'ICS'[severity_level]
			        
			        RETURN
			        -- Xét ưu tiên từ trên xuống dưới, trúng cái nào lấy số đó luôn
			        SWITCH(
			            TRUE(),
			            HinhThuc = "Sa thải", 1,
			            HinhThuc = "Chấm dứt HĐLĐ", 2,
			            HinhThuc = "Cách chức", 3,
			            HinhThuc = "Kéo dài thời hạn nâng lương", 4,
			            HinhThuc = "Khiển trách", 5,
			            
			            -- Nếu 5 cái trên không có, bắt đầu xét qua cột severity_level
			            MucDo = "Mức 3 - Cao", 6,
			            MucDo = "Mức 2 - Trung bình", 7,
			            MucDo = "Mức 1 - Thấp", 8,
			            
			            -- Nếu cả 2 cột đều trống hoặc không khớp chữ nào
			            9
			        )
			    )
			
			-- Dịch số nhỏ nhất tìm được ra lại thành chữ để hiển thị
			RETURN 
			    SWITCH(
			        MinSoThuTu,
			        1, "Sa thải",
			        2, "Chấm dứt HĐLĐ",
			        3, "Cách chức",
			        4, "Kéo dài thời hạn nâng lương",
			        5, "Khiển trách",
			        6, "Mức 3 - Cao",
			        7, "Mức 2 - Trung bình",
			        8, "Mức 1 - Thấp",
			        "Không"
			    )
			```
		lineageTag: 2f6d1d18-7e0e-4a00-9845-a2e380f54908

	measure Divison_Vi_Pham_Nhieu_Nhat = ```
			
			VAR TopBranchTable = 
			    TOPN(
			        1, 
			        ALLSELECTED('ICS'[division_name]), -- Quét qua tất cả chi nhánh đang được chọn lọc
			        [Sự vụ (vi phạm)], -- Dựa trên số lượng vi phạm
			        DESC -- Sắp xếp giảm dần để ông nhiều nhất lên đầu
			    )
			RETURN
			    MAXX(TopBranchTable, 'ICS'[division_name])
			```
		lineageTag: 8356f031-53ac-4a76-a05b-1d95a347d649


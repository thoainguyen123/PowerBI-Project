	measure So_Vu_Tai_Dien_Sau_Ngan_Nguoc =
			VAR _CurrentBehavior = SELECTEDVALUE(ICS[behavior_name])
			VAR _CurrentDept = SELECTEDVALUE(ICS[department_name])
			VAR _PreventionDoneDate =
			    CALCULATE(
			        MAX(ICS[actualCompletionDate]),
			        ICS[action_plant_type] = "Ngăn ngừa",
			        ICS[action_plant_status] = "Đã hoàn thành",
			        REMOVEFILTERS(ICS[case_code])
			    )
			RETURN
			    IF(
			        ISBLANK(_PreventionDoneDate),
			        0,
			        CALCULATE(
			            DISTINCTCOUNTNOBLANK(ICS[case_code]),
			            ICS[recognizedDate] > _PreventionDoneDate
			        )
			    )
		formatString: #,0
		lineageTag: a7b10294-4d8e-4f11-921a-3e8102948104

	measure Trang_Thai_Tai_Dien_Label =
			VAR _RecurrenceCount = [So_Vu_Tai_Dien_Sau_Ngan_Nguoc]
			RETURN
			    IF(
			        _RecurrenceCount > 0,
			        "⚠️ Tái diễn (" & _RecurrenceCount & " sự vụ sau ngăn ngừa)",
			        "✅ Đã kiểm soát tốt"
			    )
		lineageTag: a7b10294-4d8e-4f11-921a-3e8102948105

	measure De_Xuat_Chot_Kiem_Soat =
			VAR _Group = SELECTEDVALUE(ICS[behavior_group_name])
			RETURN
			    SWITCH(
			        TRUE(),
			        CONTAINSSTRING(_Group, "Quy trình") || CONTAINSSTRING(_Group, "Thủ tục"), "🔒 Thêm Chốt phê duyệt tự động trên hệ thống ERP/BPM trước khi ký duyệt.",
			        CONTAINSSTRING(_Group, "Hồ sơ") || CONTAINSSTRING(_Group, "Chứng từ"), "📋 Thiết lập Checklist nghiệm thu/thanh toán bắt buộc trước khi chuyển Kế toán.",
			        CONTAINSSTRING(_Group, "Nhân sự") || CONTAINSSTRING(_Group, "Chính sách"), "👨‍💼 Tăng cường Đào tạo lại Quy trình và Gắn KPI tuân thủ vào Đánh giá Hiệu quả.",
			        CONTAINSSTRING(_Group, "Thi công") || CONTAINSSTRING(_Group, "Kỹ thuật"), "🔍 Kiểm tra Xác suất Đột xuất tại Công trường & Phạt Hợp đồng theo Chế tài.",
			        CONTAINSSTRING(_Group, "Đấu thầu") || CONTAINSSTRING(_Group, "Mua sắm"), "⚖️ Thẩm định độc lập Danh mục Nhà thầu & So sánh Giá thị trường theo Quý.",
			        "🛡️ Thiết lập Chốt Kiểm soát Khẩn cấp & Kiểm tra Tuân thủ Định kỳ Hàng tháng."
			    )
		lineageTag: a7b10294-4d8e-4f11-921a-3e8102948106


	measure So_Hanh_Vi_Lap_Lai =
			VAR _Behaviors =
			    FILTER(
			        SUMMARIZE(
			            ICS,
			            ICS[behavior_name]
			        ),
			        NOT ISBLANK(ICS[behavior_name])
			            && CALCULATE(DISTINCTCOUNTNOBLANK(ICS[case_code])) >= 2
			    )
			RETURN
			    COUNTROWS(_Behaviors)
		formatString: #,0
		lineageTag: a7b10294-4d8e-4f11-921a-3e8102948101

	measure So_Vu_Lap_Lai =
			VAR _RecurringBehaviors =
			    FILTER(
			        VALUES(ICS[behavior_name]),
			        NOT ISBLANK(ICS[behavior_name])
			            && CALCULATE(
			                DISTINCTCOUNTNOBLANK(ICS[case_code]),
			                ALLSELECTED(ICS[case_code]),
			                ALLSELECTED(ICS[inspectionDate])
			            ) >= 2
			    )
			RETURN
			    CALCULATE(
			        DISTINCTCOUNTNOBLANK(ICS[case_code]),
			        KEEPFILTERS(_RecurringBehaviors)
			    )
		formatString: #,0
		lineageTag: a7b10294-4d8e-4f11-921a-3e8102948102


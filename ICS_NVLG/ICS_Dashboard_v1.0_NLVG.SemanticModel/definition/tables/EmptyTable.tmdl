	measure Path_Moi_Nhat = ```
			
			MAXX(
			    TOPN(
			        1, 
			        // BƯỚC 1: Lọc bỏ các dòng bị BLANK hoặc rỗng
			        FILTER(
			            'File', 
			            NOT ISBLANK('File'[api]) && 'File'[api] <> ""
			        ), 
			        // BƯỚC 2: Sắp xếp lấy 1 dòng có ngày mới nhất
			        'File'[Date], 
			        DESC
			    ),
			    // BƯỚC 3: Trích xuất thẳng cột api từ dòng vừa tìm được
			    'File'[api]
			)
			```
		lineageTag: 14b43cde-2b58-4278-a594-4016d456a7bc
		dataCategory: ImageUrl


table HO_Axis
	lineageTag: b11fe9c1-df38-4627-ad95-78abd7a038ea

	column division_name
		lineageTag: a3b8d309-c89e-4e00-9a8e-b4740930dabe
		summarizeBy: none
		isNameInferred
		sourceColumn: ICS[division_name]

		annotation SummarizationSetBy = Automatic

	partition HO_Axis = calculated

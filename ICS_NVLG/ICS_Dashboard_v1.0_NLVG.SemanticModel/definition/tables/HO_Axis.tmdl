				    DISTINCT(ICS[division_name]),
				    ICS[corporation_name] = "NOVALAND GROUP" -- Điền chính xác tên cột Tập đoàn của bạn ở đây
				    && ICS[company_name] = "HEAD OFFICE (HO-NVLG)"
				)

	annotation PBI_Id = 5cf5a2ef77d34ca9ac588cb1091a485d


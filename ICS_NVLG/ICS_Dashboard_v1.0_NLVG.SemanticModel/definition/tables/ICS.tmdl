 branch_name,#(lf)    CD.name AS compliance_department_name#(lf)#(lf)FROM all_cases A#(lf)LEFT JOIN behavior_detail B #(lf)    ON A.behaviorDetailId = B.id#(lf)LEFT JOIN [behavior] BE ON B.behaviorId = BE.id#(lf)LEFT JOIN dropdown_option C #(lf)    ON A.violation_statusId = C.id AND C.dropdownCode = 'violation_status'#(lf)LEFT JOIN dropdown_option D #(lf)    ON A.action_statusId = D.id AND D.dropdownCode = 'action_plan_status'#(lf)LEFT JOIN dropdown_option E #(lf)    ON A.actionPlanGroupId = E.id AND E.dropdownCode = 'action_plan_group'#(lf)LEFT JOIN dropdown_option F #(lf)    ON A.severityRecommendedId = F.id AND F.dropdownCode = 'violation_severity'#(lf)LEFT JOIN dropdown_option G #(lf)    ON A.causeId = G.id AND G.dropdownCode = 'violation_cause'#(lf)LEFT JOIN employee H ON A.cbId = H.id#(lf)LEFT JOIN employee K ON A.hrbpId = K.id#(lf)LEFT JOIN employee I ON A.violation_inspectorId = I.id#(lf)LEFT JOIN employee J ON A.assigneeId = J.id#(lf)LEFT JOIN employee L ON A.violatorId  = L.id#(lf)LEFT JOIN inspection_type M ON A.inspectionTypeId = M.id#(lf)LEFT JOIN position N ON A.positionId = N.id#(lf)LEFT JOIN dbo.[user] O ON A.case_createdById = O.id#(lf)LEFT JOIN (SELECT * FROM org_tree WHERE LevelNum <= 5) P #(lf)    ON A.complianceDepartmentId = P.id#(lf)LEFT JOIN (SELECT * FROM org_tree WHERE LevelNum <= 5) S #(lf)    ON A.violation_departmentId = S.id#(lf)LEFT JOIN dropdown_option Q ON A.resolutionMethodId = Q.id#(lf)LEFT JOIN dropdown_option R ON A.laborRuleViolationSeverityId = R.id#(lf)LEFT JOIN inspection_record T ON A.inspectionRecordId = T.id#(lf)LEFT JOIN [dbo].[organization] Y ON A.corporationId = Y.id#(lf)LEFT JOIN [dbo].[organization] U ON A.groupId = U.id#(lf)LEFT JOIN [dbo].[organization] Z ON A.companyId = Z.id#(lf)LEFT JOIN [dbo].[organization] X ON A.branchId = X.id#(lf)LEFT JOIN [dbo].[organization] DP ON A.violation_departmentId = DP.id#(lf)LEFT JOIN [dbo].[organization] DV ON A.divisionId = DV.id#(lf)LEFT JOIN [dbo].[organization] HO ON A.divisionId = HO.id#(lf)LEFT JOIN [dbo].[organization] CD ON A.complianceDepartmentId = CD.id#(lf)LEFT JOIN [dbo].[position] JB  ON A.positionId = JB.id#(lf)#(lf)#(lf)#(lf)", CreateNavigationProperties=false]),

	column action_status =
			
			VAR EndDate     = ICS[endDate]
			VAR ActualDate  = ICS[actualCompletionDate]
			VAR CurrentDate = TODAY()
			VAR Label       = ICS[action_plant_status]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(EndDate), "Trống",
			    Label = "Hoàn thành",
			        IF(EndDate >= ActualDate || ISBLANK(ActualDate) = True, "Đúng hạn", "Trễ hạn (Đã xử lý)"),
			    Label = "Chờ thực hiện",
			        IF(EndDate >= CurrentDate, "Chưa tới hạn (Chưa xử lý)", "Trễ hạn (Chưa xử lý)")
			)
		lineageTag: 3cd170b5-e1eb-4368-8841-ddae683e2f92
		summarizeBy: none

		annotation SummarizationSetBy = Automatic


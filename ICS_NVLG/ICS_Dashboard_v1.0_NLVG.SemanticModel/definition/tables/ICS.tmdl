	partition ICS = m
		mode: import
		source =
				let
				    Source = Sql.Database("10.16.19.14", "VIOLATION_REPORT", [Query=";WITH all_cases AS (#(lf)    SELECT #(lf)        -- Case table columns#(lf)        t1.isDeactivated AS case_isDeactivated,#(lf)        t1.id AS case_id,#(lf)        t1.createdAt AS case_createdAt,#(lf)        t1.updatedAt AS case_updatedAt,#(lf)        t1.deletedAt AS case_deletedAt,#(lf)        t1.createdById AS case_createdById,#(lf)        t1.updatedById AS case_updatedById,#(lf)        t1.deletedById AS case_deletedById,#(lf)        t1.code AS case_code,#(lf)        t1.inspectionDate,#(lf)        t1.statusId AS case_statusId,#(lf)        t1.remediationStatusId AS case_remediationStatusId,#(lf)        t1.preventionStatusId AS case_preventionStatusId,#(lf)        t1.complianceDepartmentId,#(lf)        t1.inspectionTypeId,#(lf)        t1.inspectionLocationId,#(lf)        t1.inspectorId AS case_inspectorId,#(lf)        t1.corporationId,#(lf)        t1.groupId,#(lf)        t1.companyId,#(lf)        t1.branchId,#(lf)        t1.lastAction AS case_lastAction,#(lf)        t1.inspectionRecordId,#(lf)#(lf)        -- Violation table columns#(lf)        t2.isDeactivated AS violation_isDeactivated,#(lf)        t2.id AS violation_id,#(lf)        t2.createdAt AS violation_createdAt,#(lf)        t2.updatedAt AS violation_updatedAt,#(lf)        t2.deletedAt AS violation_deletedAt,#(lf)        t2.createdById AS violation_createdById,#(lf)        t2.updatedById AS violation_updatedById,#(lf)        t2.deletedById AS violation_deletedById,#(lf)        t2.isViolation,#(lf)        t2.caseId AS violation_caseId,#(lf)        t2.code AS violation_code,#(lf)        t2.summary AS violation_summary,#(lf)        t2.content AS violation_content,#(lf)        t2.note,#(lf)        t2.recognizedDate,#(lf)        t2.violationDate,#(lf)        t2.departmentSentDate,#(lf)        t2.hrReceivedDate,#(lf)        t2.processedDate,#(lf)        t2.frequency,#(lf)        t2.severityRecommendedId,#(lf)        t2.severityId,#(lf)       
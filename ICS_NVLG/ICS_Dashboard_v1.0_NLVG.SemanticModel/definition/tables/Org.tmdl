	partition Org = m
		mode: import
		source =
				let
				    Source = Sql.Database("10.16.19.14", "VIOLATION_REPORT", [Query="With org_tree AS (#(lf)    SELECT #(lf)        o.id,#(lf)        o.name,#(lf)        o.parentId,#(lf)        o.isDeactivated,#(lf)        o.createdAt,#(lf)        o.updatedAt,#(lf)        o.deletedAt,#(lf)        o.createdById,#(lf)        o.updatedById,#(lf)        o.deletedById,#(lf)        o.sourceId,#(lf)        o.parentSourceId,#(lf)        o.source,#(lf)        o.type,#(lf)        o.parentCode,#(lf)        o.startDate,#(lf)        o.endDate,#(lf)        o.head,#(lf)        o.status,#(lf)        o.note,#(lf)        o.path,#(lf)        o.level,#(lf)        o.groupCode,#(lf)        o.headId,#(lf)        o.isVirtual,#(lf)        o.virtualOrganizationId,#(lf)        o.lastAction,#(lf)        CAST(o.name AS NVARCHAR(MAX)) AS FullPath,#(lf)        1 AS LevelNum#(lf)    FROM [VIOLATION_REPORT].[dbo].[organization] o#(lf)    WHERE o.level = 1#(lf)#(lf)    UNION ALL#(lf)#(lf)    SELECT #(lf)        c.id,#(lf)        c.name,#(lf)        c.parentId,#(lf)        c.isDeactivated,#(lf)        c.createdAt,#(lf)        c.updatedAt,#(lf)        c.deletedAt,#(lf)        c.createdById,#(lf)        c.updatedById,#(lf)        c.deletedById,#(lf)        c.sourceId,#(lf)        c.parentSourceId,#(lf)        c.source,#(lf)        c.type,#(lf)        c.parentCode,#(lf)        c.startDate,#(lf)        c.endDate,#(lf)        c.head,#(lf)        c.status,#(lf)        c.note,#(lf)        c.path,#(lf)        c.level,#(lf)        c.groupCode,#(lf)        c.headId,#(lf)        c.isVirtual,#(lf)        c.virtualOrganizationId,#(lf)        c.lastAction,#(lf)        CAST(p.FullPath + N' → ' + c.name AS NVARCHAR(MAX)) AS FullPath,#(lf)        p.LevelNum + 1 AS LevelNum#(lf)    FROM [VIOLATION_REPORT].[dbo].[organization] c#(lf)    INNER JOIN org_tree p ON c.parentId = p.id#(lf))#(lf)SELECT * FROM org_tree", CreateNavigationProperties=false]),
				    #"Split Column by Delimiter" = Table.SplitColumn(Source, "FullPath", Splitter.SplitTextByDelimiter("→", QuoteStyle.Csv), {"FullPath.1", "FullPath.2", "FullPath.3", "FullPath.4", "FullPath.5"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Split Column by Delimiter",{{"FullPath.1", type text}, {"FullPath.2", type text}, {"FullPath.3", type text}, {"FullPath.4", type text}, {"FullPath.5", type text}})
				in
				    #"Changed Type"


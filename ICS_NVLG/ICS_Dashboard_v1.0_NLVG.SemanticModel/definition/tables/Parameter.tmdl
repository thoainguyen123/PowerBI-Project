	measure So_Loi_7_Ngay =
			
			VAR _HomNay = DATE(YEAR(NOW()+7/24), MONTH(NOW()+7/24), DAY(NOW()+7/24))
			
			RETURN IF(ISBLANK(CALCULATE(
			    [Sự vụ (vi phạm)],
			    DATESINPERIOD('DateTable'[Date], _HomNay, -7, DAY),
			    REMOVEFILTERS('DateTable')
			)),0,CALCULATE(
			    [Sự vụ (vi phạm)],
			    DATESINPERIOD('DateTable'[Date], _HomNay, -7, DAY),
			    REMOVEFILTERS('DateTable')
			))
		formatString: 0
		lineageTag: b23891f7-37b6-4072-8be9-30a95775647c

	measure So_Loi_7_Ngay_truoc =
			
			VAR _HomNay = DATE(YEAR(NOW()+7/24), MONTH(NOW()+7/24), DAY(NOW()+7/24)) - 7
			
			RETURN CALCULATE(
			    [Sự vụ (vi phạm)],
			    DATESINPERIOD('DateTable'[Date], _HomNay, -14, DAY),
			    REMOVEFILTERS('DateTable')
			)
		formatString: 0
		lineageTag: 949a8425-4698-496d-ac86-3c5efb0501b3

	measure 'Chu Ky Theo Doi' = ```
			
			VAR _SelectedDate = TODAY() // Hoặc dùng TODAY() nếu muốn luôn cố định theo ngày hiện tại
			VAR _WeekdayNumber = WEEKDAY(_SelectedDate, 2) // Tham số 2: Thứ 2 = 1, Chủ Nhật = 7
			VAR _StartOfWeek = _SelectedDate - _WeekdayNumber - 2
			VAR _EndOfWeek = _SelectedDate - _WeekdayNumber + 5
			RETURN 
			    "Kỳ theo dõi :  " & FORMAT(_StartOfWeek, "dd/mm/yyyy") & 
			    " đến " & FORMAT(_EndOfWeek, "dd/mm/yyyy")
			```
		lineageTag: fda65b48-a3ea-4aa4-8f7b-3447a8c8f113

	measure 'Ngay Hom Nay' = ```
			
			VAR _Today = TODAY()
			VAR _DayName = FORMAT(_Today, "dddd", "vi-VN") -- Trả về "Thứ Sáu"
			VAR _DatePart = FORMAT(_Today, "\N\g\à\y d \t\h\á\n\g m, yyyy", "vi-VN") -- Trả về "Ngày 15 tháng 5, 2026"
			RETURN 
			    _DayName & ", " & _DatePart
			```
		lineageTag: ab35f2bc-815e-4ac3-a080-1cee34fcf42e

	measure 'Sự vụ (vi phạm) _30 ngày' =
			
			CALCULATE(
			    [Sự vụ (vi phạm)], -- Tái sử dụng lại measure gốc của bạn
			    DATESINPERIOD(
			        'ICS'[violationDate],    -- Cột chứa ngày chuẩn trong bảng Date của bạn
			        MAX('ICS'[violationDate]), -- Lấy ngày lớn nhất trong filter context hiện tại
			        -30,                  -- Lùi lại 30
			        DAY                   -- Đơn vị là ngày
			    )
			)
		formatString: 0
		lineageTag: e8cd8ba5-4583-49a8-8624-84500648eace


	measure So_Loi_Ngay_Hom_Nay = ```
			
			-- 1. Lấy ngày hôm nay
			VAR _HomNay = DATE(YEAR(NOW()+7/24), MONTH(NOW()+7/24), DAY(NOW()+7/24))
			
			RETURN
			    IF(ISBLANK(CALCULATE(
			        [Sự vụ (vi phạm)],
			        
			        -- Lọc dữ liệu: Cột Date phải BẰNG chính xác ngày hôm nay
			        'DateTable'[Date] = _HomNay,
			
			        -- Bỏ qua Slicer (để dù bạn đang chọn tháng trước, nó vẫn hiện số liệu hôm nay)
			        REMOVEFILTERS('DateTable') 
			    )),0,CALCULATE(
			        [Sự vụ (vi phạm)],
			        
			        -- Lọc dữ liệu: Cột Date phải BẰNG chính xác ngày hôm nay
			        'DateTable'[Date] = _HomNay,
			
			        -- Bỏ qua Slicer (để dù bạn đang chọn tháng trước, nó vẫn hiện số liệu hôm nay)
			        REMOVEFILTERS('DateTable') 
			    ))
			```
		formatString: 0
		lineageTag: 1bb983e5-4679-4300-a41e-0feab8660960

	measure So_Loi_Ngay_Hom_Qua =
			
			-- 1. Xác định thời điểm hiện tại theo giờ Việt Nam (UTC+7)
			VAR _GioHienTai_VN = NOW() + 7/24
			
			-- 2. Tính ra ngày hôm qua (Lấy ngày của hiện tại trừ đi 1)
			VAR _NgayHomQua_VN = DATE(YEAR(_GioHienTai_VN), MONTH(_GioHienTai_VN), DAY(_GioHienTai_VN)) - 1
			
			RETURN
			    CALCULATE(
			        [Sự vụ (vi phạm)],
			
			        -- Lọc dữ liệu bằng đúng ngày hôm qua
			        'DateTable'[Date] = _NgayHomQua_VN,
			
			        -- Bỏ qua Slicer để luôn hiển thị đúng ngày hôm qua
			        REMOVEFILTERS('DateTable')
			    )
		formatString: 0
		lineageTag: cfc1e8c3-6e1d-4ea2-b17d-a6a517e2347e

	measure '+-Hom qua' = [So_Loi_Ngay_Hom_Nay] - [So_Loi_Ngay_Hom_Qua]
		formatString: 0
		lineageTag: 2eab225e-5094-472e-9e1b-6cc08ea88dfa

	measure So_Loi_Quy_Nay = ```
			
			-- 1. Xác định ngày hiện tại (UTC+7)
			VAR _NgayHienTai = DATE(YEAR(NOW()+7/24), MONTH(NOW()+7/24), DAY(NOW()+7/24))
			
			-- 2. Tính toán ngày ĐẦU quý và CUỐI quý
			VAR _ThangHienTai = MONTH(_NgayHienTai)
			-- Công thức tìm tháng đầu tiên của quý (Ra kết quả: 1, 4, 7 hoặc 10)
			VAR _ThangDauQuy = _ThangHienTai - MOD(_ThangHienTai - 1, 3) 
			
			VAR _NgayDauQuy = DATE(YEAR(_NgayHienTai), _ThangDauQuy, 1)
			VAR _NgayCuoiQuy = EOMONTH(_NgayDauQuy, 2) -- Cộng thêm 2 tháng rồi lấy ngày cuối tháng
			
			-- 3. Tính toán số liệu
			VAR _KetQua = CALCULATE(
			    [Sự vụ (vi phạm)],
			
			    -- Lọc dữ liệu nằm trong khoảng từ đầu quý đến cuối quý
			    'DateTable'[Date] >= _NgayDauQuy,
			    'DateTable'[Date] <= _NgayCuoiQuy,
			
			    -- Bỏ qua Slicer để luôn hiện số liệu Quý thực tế
			    REMOVEFILTERS('DateTable') 
			)
			
			RETURN
			    -- Trả về 0 nếu không có dữ liệu
			    IF(ISBLANK(_KetQua), 0, _KetQua)
			```
		formatString: 0
		lineageTag: cb2b4e57-7358-47f0-afa7-7d72f5069cb6

	measure So_Loi_Quy_Nay_Hoan_Thanh = ```
			
			-- 1. Xác định ngày hiện tại (UTC+7)
			VAR _NgayHienTai = DATE(YEAR(NOW()+7/24), MONTH(NOW()+7/24), DAY(NOW()+7/24))
			
			-- 2. Tính toán ngày ĐẦU quý và CUỐI quý
			VAR _ThangHienTai = MONTH(_NgayHienTai)
			-- Công thức tìm tháng đầu tiên của quý (Ra kết quả: 1, 4, 7 hoặc 10)
			VAR _ThangDauQuy = _ThangHienTai - MOD(_ThangHienTai - 1, 3) 
			
			VAR _NgayDauQuy = DATE(YEAR(_NgayHienTai), _ThangDauQuy, 1)
			VAR _NgayCuoiQuy = EOMONTH(_NgayDauQuy, 2) -- Cộng thêm 2 tháng rồi lấy ngày cuối tháng
			
			-- 3. Tính toán số liệu
			VAR _KetQua = CALCULATE(
			    [Violation (Hoàn thành)],
			
			    -- Lọc dữ liệu nằm trong khoảng từ đầu quý đến cuối quý
			    'DateTable'[Date] >= _NgayDauQuy,
			    'DateTable'[Date] <= _NgayCuoiQuy,
			
			    -- Bỏ qua Slicer để luôn hiện số liệu Quý thực tế
			    REMOVEFILTERS('DateTable') 
			)
			
			RETURN
			    -- Trả về 0 nếu không có dữ liệu
			    IF(ISBLANK(_KetQua), 0, _KetQua)
			```
		formatString: 0
		lineageTag: ed8d5763-b9c0-45f0-b56c-4a730c48cb6f


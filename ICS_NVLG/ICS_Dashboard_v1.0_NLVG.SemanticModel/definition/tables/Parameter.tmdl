	measure T-1 = ```
			
			-- 1. Lấy ngày hôm nay
			VAR _HomNay = TODAY() 
			
			-- 2. Tính ra ngày đầu và ngày cuối của tháng trước
			-- Ví dụ: Nay 20/01/2026 -> Cuối tháng trước là 31/12/2025
			VAR _CuoiThangTruoc = EOMONTH(_HomNay, -1) 
			-- Lùi về 2 tháng rồi cộng 1 ngày -> Ra ngày 01/12/2025
			VAR _DauThangTruoc  = EOMONTH(_HomNay, -2) + 1 
			
			RETURN
			    CALCULATE(
			        [Sự vụ (vi phạm)],
			        
			        -- Điều kiện: Cột Date phải nằm trọn trong tháng trước
			        'DateTable'[Date] >= _DauThangTruoc,
			        'DateTable'[Date] <= _CuoiThangTruoc,
			
			        -- QUAN TRỌNG: Lệnh này giúp bỏ qua mọi Slicer ngày tháng bạn đang chọn
			        -- Để nó luôn tính theo ngày hệ thống
			        REMOVEFILTERS('DateTable') 
			    )
			```
		formatString: 0
		lineageTag: 7773b7c1-ed95-4677-8046-82c3218cbeb7

	measure T = ```
			
			-- 1. Lấy ngày hôm nay
			VAR _HomNay = TODAY() 
			
			-- 2. Tính ngày đầu và ngày cuối của tháng NÀY
			-- Ví dụ: Nay 20/01/2026 -> Đầu tháng là 01/01/2026
			VAR _DauThangNay = EOMONTH(_HomNay, -1) + 1
			-- Cuối tháng là 31/01/2026
			VAR _CuoiThangNay = EOMONTH(_HomNay, 0)
			
			RETURN
			    CALCULATE(
			        [Sự vụ (vi phạm)],
			        
			        -- Lọc dữ liệu nằm trong tháng này
			        ICS[violationDate] >= _DauThangNay,
			        ICS[violationDate] <= _CuoiThangNay,
			
			        -- Bỏ qua Slicer để luôn hiện số liệu tháng thực tế
			        REMOVEFILTERS('DateTable') 
			    )
			```
		formatString: 0
		lineageTag: 79e49478-b028-4a33-8a9e-a54b8aec80ec

	measure +- = [T] - [T-1]
		formatString: 0

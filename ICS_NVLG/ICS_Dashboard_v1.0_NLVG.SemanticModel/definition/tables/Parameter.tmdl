table Parameter
	lineageTag: 697926cb-9473-4f20-8966-b1e5b2b3821a

	measure So_Loi_Thang_Truoc = ```
			
			CALCULATE(
			    [Sự vụ (vi phạm)], 
			    DATEADD('DateTable'[Date], -1, MONTH)
			)
			```
		formatString: 0
		lineageTag: c94e988e-28bf-4e0a-8e78-1d4860fa4309

	measure Slope_Loi_Theo_Thang = ```
			
			VAR MaxDate = MAX('ICS'[violationDate]) 
			VAR MinDate = EDATE(MaxDate, -12)
			
			-- 1. Gom dữ liệu lại theo từng THÁNG (Thay vì từng ngày)
			VAR Tbl_Data = 
			    ADDCOLUMNS(
			        SUMMARIZE(
			            FILTER(
			                ALLSELECTED('DateTable'), 
			                'DateTable'[Date] <= MaxDate && 'DateTable'[Date] > MinDate
			            ),
			            'DateTable'[Năm],
			            'DateTable'[Tháng Số]
			        ),
			        -- Tạo Measure ảo tính tổng lỗi cho tháng đó
			        "So_Loi", [Sự vụ (vi phạm)],
			        
			        -- Tạo trục X (Biến độc lập): Dùng công thức (Năm * 12 + Tháng) để tạo dãy số tăng dần liên tục
			        -- Ví dụ: T12/2024 = 24300, T1/2025 = 24301. Khoảng cách luôn là 1 đơn vị.
			        "Month_Index", ('DateTable'[Năm] * 12) + 'DateTable'[Tháng Số]
			    )
			
			-- 2. Tính toán hồi quy tuyến tính: X là Month_Index, Y là So_Loi
			VAR Result = LINESTX(Tbl_Data, [So_Loi], [Month_Index])
			
			-- 3. Lấy hệ số góc (Slope)
			VAR Monthly_Slope = SELECTCOLUMNS(Result, "Slope", [Slope1])
			
			RETURN 
			    Monthly_Slope
			```
		lineageTag: c0962709-2f6b-41a9-a2b1-8efcb7fefdc2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Icon_XuHuong =
			
			VAR Slope = [Slope_Loi_Theo_Thang] -- Gọi lại kết quả tính toán Slope
			RETURN
			    SWITCH(
			        TRUE(),
			        Slope > 0, "▲",  -- Nếu dương (Tăng lỗi) -> Mũi tên lên
			        Slope < 0, "▼",  -- Nếu âm (Giảm lỗi) -> Mũi tên xuống
			        "-"              -- Nếu bằng 0 -> Gạch ngang
			    )
		lineageTag: 5c685577-fd7d-4807-b93d-3482e3a53dbf

	measure 'Số lượng hành vi' = CALCULATE(COUNT(ICS[behavior_name]),ISBLANK(ICS[behavior_name]) = FALSE())
		formatString: 0

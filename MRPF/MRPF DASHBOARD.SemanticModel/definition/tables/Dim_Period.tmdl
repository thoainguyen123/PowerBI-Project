		lineageTag: 19e5be2e-990c-4278-823d-2a743a238a03
		summarizeBy: none
		sourceColumn: QuarterStartDate

		variation Variation
			isDefault
			relationship: 0822cbb7-cdb4-4549-8a6c-eeb70c3cbcdc
			defaultHierarchy: LocalDateTable_c9caf710-4f0f-41ba-af0f-80a2d654e0c2.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column MonthKey
		dataType: int64
		formatString: 0
		lineageTag: 1c0cd092-e34a-43dc-aa61-473e64a47094
		summarizeBy: count
		sourceColumn: MonthKey

		annotation SummarizationSetBy = Automatic

	partition Dim_Period = m
		mode: import
		source =
				let
				    CurrentDate = Date.From(DateTime.LocalNow()),
				    CurrentYear = Date.Year(CurrentDate),
				    CurrentQuarter = Date.QuarterOfYear(CurrentDate),
				
				    Years = {2018..CurrentYear},
				    Quarters = {1..4},
				
				    TableList =
				        List.Transform(
				            Years,
				            (y) =>
				                List.Transform(
				                    Quarters,
				                    (q) => [
				                        year = y,
				                        quater = q
				                    ]
				                )
				        ),
				
				    CombinedList = List.Combine(TableList),
				    TableFromList = Table.FromRecords(CombinedList),
				
				    FilterCurrentQuarter =
				        Table.SelectRows(
				            TableFromList,
				            each
				                [year] < CurrentYear
				                or (
				                    [year] = CurrentYear
				                    and [quater] <= CurrentQuarter
				                )
				        ),
				
				    AddQuarterKey =
				        Table.AddColumn(
				            FilterCurrentQuarter,
				            "QuarterKey",
				            each [year] * 10 + [quater],
				            Int64.Type
				        ),
				
				    AddNamQuy =
				        Table.AddColumn(
				            AddQuarterKey,
				            "Năm - Quý",
				            each Text.From([year]) & "-0" & Text.From([quater]),
				            type text
				        ),
				
				    AddQuarterName =
				        Table.AddColumn(
				            AddNamQuy,
				            "Quarter_Name",
				            each "Quý " & Text.From([quater]) & "/" & Text.From([year]),
				            type text
				        ),
				
				    AddQuarterStartDate =
				        Table.AddColumn(
				            AddQuarterName,
				            "QuarterStartDate",
				            each #date(
				                [year],
				                ([quater] - 1) * 3 + 1,
				                1
				            ),
				            type date
				        ),
				
				    AddMonthKey =
				        Table.AddColumn(
				            AddQuarterStartDate,
				            "MonthKey",
				            each
				                Date.Year([QuarterStartDate]) * 100
				                + Date.Month([QuarterStartDate]),
				            Int64.Type
				        ),
				
				    AddDateKey =
				        Table.AddColumn(
				            AddMonthKey,
				            "DateKey",
				            each
				                Date.Year([QuarterStartDate]) * 10000
				                + Date.Month([QuarterStartDate]) * 100
				                + Date.Day([QuarterStartDate]),
				            Int64.Type
				        )
				in
				    AddDateKey

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


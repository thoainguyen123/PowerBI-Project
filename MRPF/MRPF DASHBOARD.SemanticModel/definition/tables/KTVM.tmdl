	partition KTVM = m
		mode: import
		source =
				let
				    Source = Sql.Database("10.16.19.14", "INVESTMENT_REPORT", [Query="SELECT #(lf)       A.[isDeactivated]#(lf)      ,A.[id]#(lf)      ,A.[createdAt]#(lf)      ,A.[updatedAt]#(lf)      ,A.[deletedAt]#(lf)      ,A.[createdById]#(lf)      ,A.[updatedById]#(lf)      ,A.[deletedById]#(lf)      ,A.[macroeconomicCategory1Id]#(lf)      ,A.[macroeconomicCategory2Id]#(lf)      ,A.[macroeconomicCategory3Id]#(lf)      ,A.[reportingFrequencyId]#(lf)      ,A.[period]#(lf)      ,A.[year]#(lf)      ,A.[levelId]#(lf)      ,A.[macroEconomicUnitId]#(lf)      ,A.[amount]#(lf)      ,A.[cityTypeId]#(lf)      ,A.[cityId]#(lf)      ,B.name AS macroeconomiccate_lv1#(lf)      ,C.name AS macroeconomiccate_lv2#(lf)      ,D.name AS macroeconomiccate_lv3#(lf)      ,E.label AS level_static#(lf)      ,F.label AS macro_economic_unit#(lf)      ,G.label AS frequency#(lf)  FROM [INVESTMENT_REPORT].[dbo].[mr_macroeconomic_data] A#(lf)  LEFT JOIN mr_macroeconomic_category_l1 B ON A.macroeconomicCategory1Id = B.id#(lf)  LEFT JOIN mr_macroeconomic_category_l2 C ON A.macroeconomicCategory2Id = C.id#(lf)  LEFT JOIN mr_macroeconomic_category_l3 D ON A.macroeconomicCategory3Id = D.id#(lf)  LEFT JOIN dropdown_option E ON A.levelId = E.id AND E.dropdownCode = 'mr_business_level_type'#(lf)  LEFT JOIN dropdown_option F ON A.macroEconomicUnitId = F.id and F.dropdownCode = 'mr_macro_economic_unit'#(lf)  LEFT JOIN dropdown_option G ON A.reportingFrequencyId = G.id AND G.dropdownCode = 'mr_frequency_type'"]),
				    #"Filtered Rows" = Table.SelectRows(Source, each ([isDeactivated] = false)),
				    #"Merged Queries" = Table.NestedJoin(#"Filtered Rows", {"macroeconomiccate_lv3"}, SortBank, {"Bank"}, "SortBank", JoinKind.LeftOuter),
				    #"Expanded SortBank" = Table.ExpandTableColumn(#"Merged Queries", "SortBank", {"STT"}, {"STT"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Expanded SortBank",{{"STT", "SortBank"}})
				in
				    #"Renamed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


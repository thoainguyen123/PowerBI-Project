	column Format_region =
			
			SWITCH(
			    TRUE(),
			    CONTAINSSTRING(KTVM[macroeconomiccate_lv3], "Châu Á"), "Châu Á",
			    CONTAINSSTRING(KTVM[macroeconomiccate_lv3], "Châu Âu"), "Châu Âu",
			    CONTAINSSTRING(KTVM[macroeconomiccate_lv3], "Châu Mỹ"), "Châu Mỹ",
			    CONTAINSSTRING(KTVM[macroeconomiccate_lv3], "Châu Úc"), "Châu Úc",
			    CONTAINSSTRING(KTVM[macroeconomiccate_lv3], "Châu Phi"), "Châu Phi",
			    BLANK() // Trả về BLANK nếu không chứa cả "Châu Á" hay "Châu Âu"
			)
		lineageTag: 0a3f17d0-5d35-4200-a223-4442b5d06b73
		summarizeBy: none

		annotation SummarizationSetBy = Automatic


table 'Measure KTVM'
	lineageTag: 43f15d0d-06c0-4f5f-8f0b-285705912d8e

	measure marco_economic_latest =
			
			VAR Latest =
			    CALCULATE(
			        MAXX( KTVM, KTVM[year])
			    )
			RETURN
			    IF(SELECTEDVALUE(KTVM[macro_economic_unit]) = "%",   CALCULATE(
			        SUM(KTVM[amount]),
			        KTVM[year] = Latest
			    )/100,CALCULATE(
			        SUM(KTVM[amount]),
			        KTVM[year] = Latest
			    )
			)
		lineageTag: 01cc2434-6df0-4dbb-b52e-2c15f841ab89

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Latest_Period = ```
			
			VAR x = MAX(KTVM[period])
			VAR y =
			    CALCULATE(
			        MAX(KTVM[period]),
			        KTVM[year] = MAX(KTVM[year]),
			        ALL(KTVM)
			    )
			
			RETURN x-y
			
			
			```
		formatString: 0
		lineageTag: 6aa20322-0c6d-4bba-a211-1e44cdee5937

		changedProperty = IsHidden

	measure PrevYear_Value_SameQuarter = ```
			
			VAR LatestYear =
			    CALCULATE(
			        MAX(KTVM[year]),
			        ALL(KTVM)
			    )
			VAR LatestQuarter = 
			    CALCULATE(
			        MAX(KTVM[period]),
			        KTVM[year] = LatestYear)
			
			VAR PrevYear = LatestYear - 1
			RETURN
			CALCULATE(
			    SUM(KTVM[amount]),
			    KTVM[year] = PrevYear,
			    KTVM[period] <= LatestQuarter
			)
			
			```
		lineageTag: b02ff0c7-c4c7-4545-b55c-f4a9f7edfbb1

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure pre_year_marco_economic =
			
			VAR Latest =
			    CALCULATE(
			        MAXX( KTVM, KTVM[year])
			    )
			RETURN
			    IF(SELECTEDVALUE(KTVM[macro_economic_unit]) = "%",   CALCULATE(
			        SUM(KTVM[amount]),
			        KTVM[year] = Latest - 1
			    )/100,CALCULATE(
			        SUM(KTVM[amount]),
			        KTVM[year] = Latest - 1
			    )
			)
		lineageTag: 5b87b61d-0c0b-41ff-8774-57e652235682

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure PrevYear_Value_SameMonth = ```
			
			VAR LatestYear =
			    CALCULATE(
			        MAX(KTVM[year]),
			        ALL(KTVM)
			    )
			VAR LatestMonth =
			    CALCULATE(
			        MAX(KTVM[period]),
			        KTVM[year] = LatestYear
			    )
			VAR PrevYear = LatestYear - 1
			RETURN
			CALCULATE(
			    SUM(KTVM[amount]),
			    KTVM[year] = PrevYear,
			    KTVM[period] <= LatestMonth
			)
			
			```
		lineageTag: 9ebaafe8-ac03-46b7-909d-f3b9b08ec1bb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure YoY_Growth_% = ```
			
			VAR CurrentYear = SELECTEDVALUE(KTVM[year])
			VAR CurrentYearValue =
			    CALCULATE(SUM(KTVM[amount]))
			VAR PrevYearValue =
			    CALCULATE(
			        SUM(KTVM[amount]),
			        KTVM[year] = CurrentYear - 1
			    )
			RETURN
			DIVIDE(CurrentYearValue - PrevYearValue, PrevYearValue)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 04020b87-b396-4282-adea-21da23baa6d8


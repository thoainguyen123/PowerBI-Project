	/// Tổng mở bán tích lũy tính đến trước quý đang xem = [Tổng mở bán tính tới quý đó] - [Nguồn cung mở bán mới]
	measure 'Tổng mở bán tính tới quý trước' = [Tổng mở bán tính tới quý đó] - [Nguồn cung mở bán mới]
		formatString: #,##0
		displayFolder: Nguồn cung
		lineageTag: c9d0e1f2-3a4b-5c6d-7e8f-9a0b1c2d3e4f

	/// Tổng sản phẩm unique theo project_name, phase_name, project_type, Nhóm và phase_status.2 rồi cộng tổng lại
	measure 'Tổng sản phẩm' =
			VAR _Entities =
			    SUMMARIZE(
			        'Project_BDS',
			        'Project_BDS'[project_name],
			        'Project_BDS'[phase_name],
			        'Project_BDS'[project_type],
			        'Project_BDS'[Nhóm],
			        'Project_BDS'[phase_status.2]
			    )
			RETURN
			    SUMX(
			        _Entities,
			        VAR _ProjName = 'Project_BDS'[project_name]
			        VAR _PhaseName = 'Project_BDS'[phase_name]
			        VAR _ProjType = 'Project_BDS'[project_type]
			        VAR _Nhom = 'Project_BDS'[Nhóm]
			        VAR _Status2 = 'Project_BDS'[phase_status.2]
			        RETURN
			            CALCULATE(
			                MAX('Project_BDS'[totalProducts]),
			                REMOVEFILTERS('Project_BDS'[Năm - Quý], 'Project_BDS'[year], 'Project_BDS'[quater], 'Project_BDS'[period]),
			                'Project_BDS'[project_name] = _ProjName,
			                'Project_BDS'[phase_name] = _PhaseName,
			                'Project_BDS'[project_type] = _ProjType,
			                'Project_BDS'[Nhóm] = _Nhom,
			                'Project_BDS'[phase_status.2] = _Status2
			            )
			    )
		formatString: #,##0
		displayFolder: Nguồn cung
		lineageTag: e8f9a0b1-2c3d-4e5f-6a7b-8c9d0e1f2a3b

	measure 'Tồn của quý này' = [Tổng mở bán tính tới quý đó] - COALESCE([Số căn đã bán lũy kế], 0)
		formatString: 0

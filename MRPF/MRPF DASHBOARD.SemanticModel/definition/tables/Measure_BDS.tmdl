	measure 'Table - SL mở bán' = SUM(Project_BDS[salesOpeningQuantity])
		formatString: #,0
		lineageTag: fcdcbd21-8b23-4985-a64f-ea1cd8e496ba

	/// Tồn của quý trước = [Tổng mở bán tính tới quý đó] - COALESCE([Số căn đã bán lũy kế quý trước], 0)
	measure 'Tồn của quý trước' = [Tổng mở bán tính tới quý trước] - COALESCE([Số căn đã bán lũy kế quý trước], 0)
		formatString: #,##0
		displayFolder: Nguồn cung
		lineageTag: 3ef64cd4-6b34-4af7-bfe2-4fd2343e8434

	/// Cộng salesOpeningQuantity của tất cả các tháng trong quý đang xem; ví dụ tháng 5 là 50 và tháng 6 là 100 thì quý 2 bằng 150.
	measure 'Nguồn cung mở bán mới' = ```
			
						VAR _IsTimeFiltered =
						    ISFILTERED('Project_BDS'[Năm - Quý])
						        || ISFILTERED('Project_BDS'[year])
						        || ISFILTERED('Project_BDS'[quater])
						        || ISFILTERED('Project_BDS'[period])
						        || ISINSCOPE('Project_BDS'[Năm - Quý])
						        || ISINSCOPE('Project_BDS'[year])
						        || ISINSCOPE('Project_BDS'[quater])
						
						RETURN
						    IF(
						        _IsTimeFiltered,
						        -- 1. Khi xem trên Biểu đồ/Bộ lọc theo Năm, Quý hoặc Tháng: 
						        --    Cộng dồn toàn bộ phát sinh mở bán mới trong đúng phạm vi đó (Cả năm / Cả quý).
						        CALCULATE(
						            SUM('Project_BDS'[salesOpeningQuantity]),
						            'Project_BDS'[phase_status.2] = "Đang mở bán"
						        ),
						        -- 2. Khi KHÔNG có bất kỳ bộ lọc thời gian nào (Card KPI mặc định): 
						        --    Giữ nguyên tính năng hiển thị theo Quý mới nhất có dữ liệu.
						        VAR _CurrentQuarterOrdinal = YEAR(TODAY()) * 4 + QUARTER(TODAY())
						        VAR _LatestQuarterOrdinal =
						            MAXX(
						                FILTER(
						                    CALCULATETABLE(
						                        SUMMARIZE('Project_BDS', 'Project_BDS'[year], 'Project_BDS'[quater]),
						                        REMOVEFILTERS('Project_BDS'[Năm - Quý], 'Project_BDS'[year], 'Project_BDS'[quater], 'Project_BDS'[period])
						                    ),
						                    'Project_BDS'[year] * 4 + 'Project_BDS'[quater] <= _CurrentQuarterOrdinal
						                ),
						                'Project_BDS'[year] * 4 + 'Project_BDS'[quater]
						            )
						        VAR _EffectiveYear = INT(DIVIDE(_LatestQuarterOrdinal - 1, 4))
						        VAR _EffectiveQuarter = _LatestQuarterOrdinal - _EffectiveYear * 4
						        RETURN
						            CALCULATE(
						                SUM('Project_BDS'[salesOpeningQuantity]),
						                REMOVEFILTERS('Project_BDS'[Năm - Quý], 'Project_BDS'[year], 'Project_BDS'[quater], 'Project_BDS'[period]),
						                'Project_BDS'[year] = _EffectiveYear,
						                'Project_BDS'[quater] = _EffectiveQuarter,
						                'Project_BDS'[phase_status.2] = "Đang mở bán"
						            )
						    )
			```
		formatString: #,##0
		displayFolder: Nguồn cung
		lineageTag: 326b68f4-4810-47fa-9eba-436e7d1ef619

	/// Nguồn cung sơ cấp bằng tồn đầu quý cộng tổng số sản phẩm mở bán phát sinh trong quý.
	measure 'Nguồn cung sơ cấp' = [Tồn của quý trước] + [Nguồn cung mở bán mới]
		formatString: #,##0
		displayFolder: Nguồn cung
		lineageTag: db2abb1b-2634-4e52-b296-17980b1268fb

	/// Trung bình giá bán snapshot gần nhất của từng đối tượng tính đến quý đang xem; không cộng giá qua các tháng.
	measure 'Giá bán TB' =
			VAR _CurrentQuarterOrdinal =
			    YEAR(TODAY()) * 4 + QUARTER(TODAY())
			VAR _HasQuarterSelection =
			    ISFILTERED('Project_BDS'[Năm - Quý])
			        || ISFILTERED('Project_BDS'[year])
			        || ISFILTERED('Project_BDS'[quater])
			VAR _SelectedQuarterOrdinal =
			    MAXX(
			        FILTER(
			            'Project_BDS',
			            NOT ISBLANK('Project_BDS'[year])
			                && NOT ISBLANK('Project_BDS'[quater])
			        ),
			        'Project_BDS'[year] * 4 + 'Project_BDS'[quater]
			    )
			VAR _LatestAvailableQuarterOrdinal =
			    MAXX(
			        FILTER(
			            CALCULATETABLE(
			                SUMMARIZE(
			                    'Project_BDS',
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater]
			                ),
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period]
			                )
			            ),
			            'Project_BDS'[year] * 4 + 'Project_BDS'[quater] <= _CurrentQuarterOrdinal
			        ),
			        'Project_BDS'[year] * 4 + 'Project_BDS'[quater]
			    )
			VAR _EffectiveQuarterOrdinal =
			    IF(
			        _HasQuarterSelection && NOT ISBLANK(_SelectedQuarterOrdinal),
			        _SelectedQuarterOrdinal,
			        _LatestAvailableQuarterOrdinal
			    )
			VAR _Entities =
			    CALCULATETABLE(
			        FILTER(
			            VALUES('Project_BDS'[realEstateProjectTypeId]),
			            NOT ISBLANK('Project_BDS'[realEstateProjectTypeId])
			        ),
			        REMOVEFILTERS(
			            'Project_BDS'[Năm - Quý],
			            'Project_BDS'[year],
			            'Project_BDS'[quater],
			            'Project_BDS'[period]
			        )
			    )
			RETURN
			    AVERAGEX(
			        _Entities,
			        VAR _HistoryRows =
			            CALCULATETABLE(
			                'Project_BDS',
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period]
			                )
			            )
			        VAR _LatestPriceRow =
			            TOPN(
			                1,
			                FILTER(
			                    _HistoryRows,
			                    'Project_BDS'[year] * 4 + 'Project_BDS'[quater] <= _EffectiveQuarterOrdinal
			                        && NOT ISBLANK('Project_BDS'[amount])
			                ),
			                'Project_BDS'[year], DESC,
			                'Project_BDS'[quater], DESC,
			                'Project_BDS'[period], DESC,
			                'Project_BDS'[updatedAt], DESC
			            )
			        RETURN
			            MAXX(_LatestPriceRow, 'Project_BDS'[amount])
			    )
		formatString: #,##0
		displayFolder: Giá bán
		lineageTag: 6419db52-1f2b-4da8-bcf7-ca8c963fede8

	/// Tổng sản phẩm cố định lấy một lần theo từng đối tượng, trừ tổng salesOpeningQuantity đã mở bán của tất cả các kỳ.
	measure 'Tồn chưa mở bán' =
			VAR _Entities =
			    CALCULATETABLE(
			        FILTER(
			            VALUES('Project_BDS'[realEstateProjectTypeId]),
			            NOT ISBLANK('Project_BDS'[realEstateProjectTypeId])
			        ),
			        REMOVEFILTERS(
			            'Project_BDS'[Năm - Quý],
			            'Project_BDS'[year],
			            'Project_BDS'[quater],
			            'Project_BDS'[period]
			        )
			    )
			RETURN
			    SUMX(
			        _Entities,
			        // totalProducts cố định và lặp theo thời gian: chỉ lấy một lần.
			        VAR _TotalProducts =
			            CALCULATE(
			                MAX('Project_BDS'[totalProducts]),
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period]
			                )
			            )
			        // salesOpeningQuantity là phát sinh: cộng toàn bộ các kỳ.
			        VAR _TotalOpened =
			            CALCULATE(
			                SUM('Project_BDS'[salesOpeningQuantity]),
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period]
			                )
			            )
			        RETURN
			            _TotalProducts - COALESCE(_TotalOpened, 0)
			    )
		formatString: #,##0
		displayFolder: Nguồn cung
		lineageTag: ed49d9cf-d3e9-4390-82e0-c0ef79b35889

	/// Nguồn cung của quý đang xem bằng tồn đầu quý cộng tổng số sản phẩm mở bán phát sinh trong quý.
	measure 'Nguồn cung quý hiện tại' = [Tồn của quý trước] + [Nguồn cung mở bán mới]
		formatString: #,##0
		displayFolder: Nguồn cung
		lineageTag: 846caa9a-729b-4479-bd2e-e36778dad919

	/// Số căn bán phát sinh trong quý, tính theo từng đối tượng bằng quantity lũy kế mới nhất trong quý trừ quantity lũy kế gần nhất trước quý. Không cộng quantity theo tháng.
	measure 'Số căn đã bán quý này' =
			VAR _CurrentQuarterOrdinal =
			    YEAR(TODAY()) * 4 + QUARTER(TODAY())
			VAR _HasQuarterSelection =
			    ISFILTERED('Project_BDS'[Năm - Quý])
			        || ISFILTERED('Project_BDS'[year])
			        || ISFILTERED('Project_BDS'[quater])
			VAR _SelectedQuarterOrdinal =
			    MAXX(
			        FILTER(
			            'Project_BDS',
			            NOT ISBLANK('Project_BDS'[year])
			                && NOT ISBLANK('Project_BDS'[quater])
			        ),
			        'Project_BDS'[year] * 4 + 'Project_BDS'[quater]
			    )
			VAR _LatestAvailableQuarterOrdinal =
			    MAXX(
			        FILTER(
			            CALCULATETABLE(
			                SUMMARIZE(
			                    'Project_BDS',
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater]
			                ),
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period]
			                )
			            ),
			            'Project_BDS'[year] * 4 + 'Project_BDS'[quater] <= _CurrentQuarterOrdinal
			        ),
			        'Project_BDS'[year] * 4 + 'Project_BDS'[quater]
			    )
			VAR _EffectiveQuarterOrdinal =
			    IF(
			        _HasQuarterSelection && NOT ISBLANK(_SelectedQuarterOrdinal),
			        _SelectedQuarterOrdinal,
			        _LatestAvailableQuarterOrdinal
			    )
			VAR _Entities =
			    CALCULATETABLE(
			        FILTER(
			            VALUES('Project_BDS'[realEstateProjectTypeId]),
			            NOT ISBLANK('Project_BDS'[realEstateProjectTypeId])
			        ),
			        REMOVEFILTERS(
			            'Project_BDS'[Năm - Quý],
			            'Project_BDS'[year],
			            'Project_BDS'[quater],
			            'Project_BDS'[period]
			        )
			    )
			RETURN
			    SUMX(
			        _Entities,
			        VAR _HistoryRows =
			            CALCULATETABLE(
			                'Project_BDS',
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period]
			                )
			            )
			        // quantity là lũy kế: lấy snapshot mới nhất trong quý.
			        VAR _LatestCurrentQuarterRow =
			            TOPN(
			                1,
			                FILTER(
			                    _HistoryRows,
			                    'Project_BDS'[year] * 4 + 'Project_BDS'[quater] = _EffectiveQuarterOrdinal
			                        && NOT ISBLANK('Project_BDS'[quantity])
			                ),
			                'Project_BDS'[period], DESC,
			                'Project_BDS'[updatedAt], DESC
			            )
			        // Lấy snapshot lũy kế cuối cùng trước quý đang xem.
			        VAR _LatestPreviousQuarterRow =
			            TOPN(
			                1,
			                FILTER(
			                    _HistoryRows,
			                    'Project_BDS'[year] * 4 + 'Project_BDS'[quater] < _EffectiveQuarterOrdinal
			                        && NOT ISBLANK('Project_BDS'[quantity])
			                ),
			                'Project_BDS'[year], DESC,
			                'Project_BDS'[quater], DESC,
			                'Project_BDS'[period], DESC,
			                'Project_BDS'[updatedAt], DESC
			            )
			        VAR _CurrentCumulativeSold =
			            MAXX(_LatestCurrentQuarterRow, 'Project_BDS'[quantity])
			        VAR _PreviousCumulativeSold =
			            MAXX(_LatestPreviousQuarterRow, 'Project_BDS'[quantity])
			        RETURN
			            IF(
			                ISBLANK(_CurrentCumulativeSold),
			                0,
			                _CurrentCumulativeSold - COALESCE(_PreviousCumulativeSold, 0)
			            )
			    )
		formatString: #,##0
		displayFolder: Bán hàng
		lineageTag: 3fafc306-a0c4-4cfb-9fa3-95e99ce35925

	/// Số căn đã bán lũy kế tính đến quý đang xem (lấy snapshot tháng/quý lớn nhất của từng nhóm project_name, phase_name, project_type, Nhóm với phase_status.2 là Đang mở bán)
	measure 'Số căn đã bán lũy kế' =
			VAR _CurrentQuarterKey = YEAR(TODAY()) * 10 + QUARTER(TODAY())
			VAR _HasQuarterSelection =
			    ISFILTERED('Project_BDS'[Năm - Quý])
			        || ISFILTERED('Project_BDS'[year])
			        || ISFILTERED('Project_BDS'[quater])
			VAR _SelectedQuarterKey =
			    MAXX(
			        FILTER(
			            'Project_BDS',
			            NOT ISBLANK('Project_BDS'[year]) && NOT ISBLANK('Project_BDS'[quater])
			        ),
			        'Project_BDS'[year] * 10 + 'Project_BDS'[quater]
			    )
			VAR _LatestAvailableQuarterKey =
			    MAXX(
			        FILTER(
			            CALCULATETABLE(
			                SUMMARIZE('Project_BDS', 'Project_BDS'[year], 'Project_BDS'[quater]),
			                REMOVEFILTERS('Project_BDS'[Năm - Quý], 'Project_BDS'[year], 'Project_BDS'[quater], 'Project_BDS'[period])
			            ),
			            'Project_BDS'[year] * 10 + 'Project_BDS'[quater] <= _CurrentQuarterKey
			        ),
			        'Project_BDS'[year] * 10 + 'Project_BDS'[quater]
			    )
			VAR _EffectiveQuarterKey =
			    IF(
			        _HasQuarterSelection && NOT ISBLANK(_SelectedQuarterKey),
			        _SelectedQuarterKey,
			        _LatestAvailableQuarterKey
			    )
			VAR _Entities =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'Project_BDS',
			            'Project_BDS'[project_name],
			            'Project_BDS'[phase_name],
			            'Project_BDS'[project_type],
			            'Project_BDS'[Nhóm]
			        ),
			        REMOVEFILTERS('Project_BDS'[Năm - Quý], 'Project_BDS'[year], 'Project_BDS'[quater], 'Project_BDS'[period]),
			        KEEPFILTERS('Project_BDS'[phase_status.2] = "Đang mở bán")
			    )
			RETURN
			    SUMX(
			        _Entities,
			        VAR _ProjName = 'Project_BDS'[project_name]
			        VAR _PhaseName = 'Project_BDS'[phase_name]
			        VAR _ProjType = 'Project_BDS'[project_type]
			        VAR _Nhom = 'Project_BDS'[Nhóm]
			        VAR _LatestRow =
			            CALCULATETABLE(
			                TOPN(
			                    1,
			                    FILTER(
			                        'Project_BDS',
			                        'Project_BDS'[project_name] = _ProjName
			                            && 'Project_BDS'[phase_name] = _PhaseName
			                            && 'Project_BDS'[project_type] = _ProjType
			                            && 'Project_BDS'[Nhóm] = _Nhom
			                            && 'Project_BDS'[year] * 10 + 'Project_BDS'[quater] <= _EffectiveQuarterKey
			                            && NOT ISBLANK('Project_BDS'[quantity])
			                    ),
			                    'Project_BDS'[year], DESC,
			                    'Project_BDS'[quater], DESC,
			                    'Project_BDS'[period], DESC,
			                    'Project_BDS'[updatedAt], DESC
			                ),
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period],
			                    'Project_BDS'[phase_status.2]
			                )
			            )
			        RETURN MAXX(_LatestRow, 'Project_BDS'[quantity])
			    )
		formatString: #,##0
		displayFolder: Nguồn cung
		lineageTag: b8c9d0e1-2f3a-4b5c-6d7e-8f9a0b1c2d3e

	/// Tổng mở bán tích lũy tính đến quý đang xem (<= _EffectiveQuarterKey) của các phân khu đang mở bán
	measure 'Tổng mở bán tính tới quý đó' =
			VAR _CurrentQuarterKey = YEAR(TODAY()) * 10 + QUARTER(TODAY())
			VAR _HasQuarterSelection =
			    ISFILTERED('Project_BDS'[Năm - Quý])
			        || ISFILTERED('Project_BDS'[year])
			        || ISFILTERED('Project_BDS'[quater])
			VAR _SelectedQuarterKey =
			    MAXX(
			        FILTER(
			            'Project_BDS',
			            NOT ISBLANK('Project_BDS'[year]) && NOT ISBLANK('Project_BDS'[quater])
			        ),
			        'Project_BDS'[year] * 10 + 'Project_BDS'[quater]
			    )
			VAR _LatestAvailableQuarterKey =
			    MAXX(
			        FILTER(
			            CALCULATETABLE(
			                SUMMARIZE('Project_BDS', 'Project_BDS'[year], 'Project_BDS'[quater]),
			                REMOVEFILTERS('Project_BDS'[Năm - Quý], 'Project_BDS'[year], 'Project_BDS'[quater], 'Project_BDS'[period])
			            ),
			            'Project_BDS'[year] * 10 + 'Project_BDS'[quater] <= _CurrentQuarterKey
			        ),
			        'Project_BDS'[year] * 10 + 'Project_BDS'[quater]
			    )
			VAR _EffectiveQuarterKey =
			    IF(
			        _HasQuarterSelection && NOT ISBLANK(_SelectedQuarterKey),
			        _SelectedQuarterKey,
			        _LatestAvailableQuarterKey
			    )
			VAR _Entities =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'Project_BDS',
			            'Project_BDS'[project_name],
			            'Project_BDS'[phase_name],
			            'Project_BDS'[project_type],
			            'Project_BDS'[Nhóm]
			        ),
			        REMOVEFILTERS('Project_BDS'[Năm - Quý], 'Project_BDS'[year], 'Project_BDS'[quater], 'Project_BDS'[period]),
			        KEEPFILTERS('Project_BDS'[phase_status.2] = "Đang mở bán")
			    )
			RETURN
			    SUMX(
			        _Entities,
			        VAR _ProjName = 'Project_BDS'[project_name]
			        VAR _PhaseName = 'Project_BDS'[phase_name]
			        VAR _ProjType = 'Project_BDS'[project_type]
			        VAR _Nhom = 'Project_BDS'[Nhóm]
			        RETURN
			            CALCULATE(
			                SUM('Project_BDS'[salesOpeningQuantity]),
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period],
			                    'Project_BDS'[phase_status.2]
			                ),
			                'Project_BDS'[project_name] = _ProjName,
			                'Project_BDS'[phase_name] = _PhaseName,
			                'Project_BDS'[project_type] = _ProjType,
			                'Project_BDS'[Nhóm] = _Nhom,
			                'Project_BDS'[year] * 10 + 'Project_BDS'[quater] <= _EffectiveQuarterKey
			            )
			    )
		formatString: #,##0
		displayFolder: Nguồn cung
		lineageTag: a7b8c9d0-1e2f-3a4b-5c6d-7e8f9a0b1c2d

	/// Số căn đã bán lũy kế tính đến trước quý đang xem (< _EffectiveQuarterKey) của từng nhóm project_name, phase_name, project_type, Nhóm với phase_status.2 là Đang mở bán
	measure 'Số căn đã bán lũy kế quý trước' =

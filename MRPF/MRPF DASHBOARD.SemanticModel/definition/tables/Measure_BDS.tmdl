			        _Entities,
			        VAR _ProjName = 'Project_BDS'[project_name]
			        VAR _PhaseName = 'Project_BDS'[phase_name]
			        VAR _ProjType = 'Project_BDS'[project_type]
			        VAR _Nhom = 'Project_BDS'[Nhóm]
			        VAR _LatestRow =
			            CALCULATETABLE(
			                TOPN(
			                    1,
			                    FILTER(
			                        'Project_BDS',
			                        'Project_BDS'[project_name] = _ProjName
			                            && 'Project_BDS'[phase_name] = _PhaseName
			                            && 'Project_BDS'[project_type] = _ProjType
			                            && 'Project_BDS'[Nhóm] = _Nhom
			                            && 'Project_BDS'[year] * 10 + 'Project_BDS'[quater] <= _EffectiveQuarterKey
			                            && NOT ISBLANK('Project_BDS'[quantity])
			                    ),
			                    'Project_BDS'[year], DESC,
			                    'Project_BDS'[quater], DESC,
			                    'Project_BDS'[period], DESC,
			                    'Project_BDS'[updatedAt], DESC
			                ),
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period],
			                    'Project_BDS'[phase_status.2]
			                )
			            )
			        RETURN MAXX(_LatestRow, 'Project_BDS'[quantity])
			    )
		formatString: 0
		displayFolder: Giá bán
		lineageTag: 66fe65f9-11a4-4acd-887d-c09d5131b3fc

	measure 'Tổng mở bán tính tới quý đó all status' =
			VAR _CurrentQuarterKey = YEAR(TODAY()) * 10 + QUARTER(TODAY())
			VAR _HasQuarterSelection =
			    ISFILTERED('Project_BDS'[Năm - Quý])
			        || ISFILTERED('Project_BDS'[year])
			        || ISFILTERED('Project_BDS'[quater])
			VAR _SelectedQuarterKey =
			    MAXX(
			        FILTER(
			            'Project_BDS',
			            NOT ISBLANK('Project_BDS'[year]) && NOT ISBLANK('Project_BDS'[quater])
			        ),
			        'Project_BDS'[year] * 10 + 'Project_BDS'[quater]
			    )
			VAR _LatestAvailableQuarterKey =
			    MAXX(
			        FILTER(
			            CALCULATETABLE(
			                SUMMARIZE('Project_BDS', 'Project_BDS'[year], 'Project_BDS'[quater]),
			                REMOVEFILTERS('Project_BDS'[Năm - Quý], 'Project_BDS'[year], 'Project_BDS'[quater], 'Project_BDS'[period])
			            ),
			            'Project_BDS'[year] * 10 + 'Project_BDS'[quater] <= _CurrentQuarterKey
			        ),
			        'Project_BDS'[year] * 10 + 'Project_BDS'[quater]
			    )
			VAR _EffectiveQuarterKey =
			    IF(
			        _HasQuarterSelection && NOT ISBLANK(_SelectedQuarterKey),
			        _SelectedQuarterKey,
			        _LatestAvailableQuarterKey
			    )
			VAR _Entities =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'Project_BDS',
			            'Project_BDS'[project_name],
			            'Project_BDS'[phase_name],
			            'Project_BDS'[project_type],
			            'Project_BDS'[Nhóm]
			        ),
			        REMOVEFILTERS('Project_BDS'[Năm - Quý], 'Project_BDS'[year], 'Project_BDS'[quater], 'Project_BDS'[period])
			    )
			RETURN
			    SUMX(
			        _Entities,
			        VAR _ProjName = 'Project_BDS'[project_name]
			        VAR _PhaseName = 'Project_BDS'[phase_name]
			        VAR _ProjType = 'Project_BDS'[project_type]
			        VAR _Nhom = 'Project_BDS'[Nhóm]
			        RETURN
			            CALCULATE(
			                SUM('Project_BDS'[salesOpeningQuantity]),
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period],
			                    'Project_BDS'[phase_status.2]
			                ),
			                'Project_BDS'[project_name] = _ProjName,
			                'Project_BDS'[phase_name] = _PhaseName,
			                'Project_BDS'[project_type] = _ProjType,
			                'Project_BDS'[Nhóm] = _Nhom,
			                'Project_BDS'[year] * 10 + 'Project_BDS'[quater] <= _EffectiveQuarterKey
			            )
			    )
		formatString: 0
		displayFolder: Giá bán
		lineageTag: 32d8f9f9-559c-45be-b9a9-867a28c582a6

	measure 'Tồn của quý này all status' = [Tổng mở bán tính tới quý đó all status] - COALESCE([Số căn đã bán lũy kế all status], 0) + [Nguồn cung dự kiến]
		formatString: 0
		displayFolder: Giá bán
		lineageTag: 23cd5b0e-9e10-4567-bcd8-14347ae2a378

	/// Phân bổ nguồn cung sơ cấp vào đúng một khoảng giá theo snapshot giá gần nhất có dữ liệu của từng dự án/phân khu tại quý đang xem. Lịch sử mở bán và bán lũy kế được tính ngoài filter khoảng giá để tránh số âm giả và bảo đảm tổng các khoảng giá khớp nguồn cung sơ cấp.
	measure 'Nguồn cung sơ cấp theo giá bán' =
			VAR _CurrentQuarterKey = YEAR(TODAY()) * 10 + QUARTER(TODAY())
			VAR _HasQuarterSelection =
			    ISFILTERED('Project_BDS'[Năm - Quý])
			        || ISFILTERED('Project_BDS'[year])
			        || ISFILTERED('Project_BDS'[quater])
			VAR _SelectedQuarterKey =
			    MAXX(
			        CALCULATETABLE(
			            FILTER(
			                'Project_BDS',
			                NOT ISBLANK('Project_BDS'[year])
			                    && NOT ISBLANK('Project_BDS'[quater])
			            ),
			            REMOVEFILTERS(
			                'Project_BDS'[Khoang_Gia_So],
			                'Project_BDS'[Khoang_Gia_Order]
			            )
			        ),
			        'Project_BDS'[year] * 10 + 'Project_BDS'[quater]
			    )
			VAR _LatestAvailableQuarterKey =
			    MAXX(
			        FILTER(
			            CALCULATETABLE(
			                SUMMARIZE(
			                    'Project_BDS',
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater]
			                ),
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period],
			                    'Project_BDS'[Khoang_Gia_So],
			                    'Project_BDS'[Khoang_Gia_Order]
			                )
			            ),
			            'Project_BDS'[year] * 10 + 'Project_BDS'[quater] <= _CurrentQuarterKey
			        ),
			        'Project_BDS'[year] * 10 + 'Project_BDS'[quater]
			    )
			VAR _EffectiveQuarterKey =
			    IF(
			        _HasQuarterSelection && NOT ISBLANK(_SelectedQuarterKey),
			        _SelectedQuarterKey,
			        _LatestAvailableQuarterKey
			    )
			VAR _SelectedPriceBands =
			    VALUES('Project_BDS'[Khoang_Gia_So])
			VAR _HasPriceBandFilter =
			    ISFILTERED('Project_BDS'[Khoang_Gia_So])
			VAR _Entities =
			    CALCULATETABLE(
			        SUMMARIZE(
			            'Project_BDS',
			            'Project_BDS'[project_name],
			            'Project_BDS'[phase_name],
			            'Project_BDS'[project_type],
			            'Project_BDS'[Nhóm]
			        ),
			        REMOVEFILTERS(
			            'Project_BDS'[Năm - Quý],
			            'Project_BDS'[year],
			            'Project_BDS'[quater],
			            'Project_BDS'[period],
			            'Project_BDS'[Khoang_Gia_So],
			            'Project_BDS'[Khoang_Gia_Order]
			        ),
			        KEEPFILTERS('Project_BDS'[phase_status.2] = "Đang mở bán")
			    )
			VAR _EntitiesWithLatestBand =
			    ADDCOLUMNS(
			        _Entities,
			        "__LatestPriceBand",
			            VAR _LatestRow =
			                CALCULATETABLE(
			                    TOPN(
			                        1,
			                        FILTER(
			                            'Project_BDS',
			                            'Project_BDS'[year] * 10 + 'Project_BDS'[quater] <= _EffectiveQuarterKey
			                                && NOT ISBLANK('Project_BDS'[Khoang_Gia_So])
			                        ),
			                        'Project_BDS'[year], DESC,
			                        'Project_BDS'[quater], DESC,
			                        'Project_BDS'[period], DESC,
			                        'Project_BDS'[updatedAt], DESC
			                    ),
			                    REMOVEFILTERS(
			                        'Project_BDS'[Năm - Quý],
			                        'Project_BDS'[year],
			                        'Project_BDS'[quater],
			                        'Project_BDS'[period],
			                        'Project_BDS'[Khoang_Gia_So],
			                        'Project_BDS'[Khoang_Gia_Order],
			                        'Project_BDS'[phase_status.2]
			                    )
			                )
			            RETURN
			                MAXX(_LatestRow, 'Project_BDS'[Khoang_Gia_So])
			    )
			VAR _EntitiesInSelectedBand =
			    FILTER(
			        _EntitiesWithLatestBand,
			        CONTAINS(
			            _SelectedPriceBands,
			            'Project_BDS'[Khoang_Gia_So],
			            [__LatestPriceBand]
			        )
			    )
			VAR _AllocatedPrimarySupply =
			    SUMX(
			        _EntitiesInSelectedBand,
			        VAR _OpenedThroughQuarter =
			            CALCULATE(
			                SUM('Project_BDS'[salesOpeningQuantity]),
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period],
			                    'Project_BDS'[Khoang_Gia_So],
			                    'Project_BDS'[Khoang_Gia_Order],
			                    'Project_BDS'[phase_status.2]
			                ),
			                'Project_BDS'[year] * 10 + 'Project_BDS'[quater] <= _EffectiveQuarterKey
			            )
			        VAR _LatestSoldRowBeforeQuarter =
			            CALCULATETABLE(
			                TOPN(
			                    1,
			                    FILTER(
			                        'Project_BDS',
			                        'Project_BDS'[year] * 10 + 'Project_BDS'[quater] < _EffectiveQuarterKey
			                            && NOT ISBLANK('Project_BDS'[quantity])
			                    ),
			                    'Project_BDS'[year], DESC,
			                    'Project_BDS'[quater], DESC,
			                    'Project_BDS'[period], DESC,
			                    'Project_BDS'[updatedAt], DESC
			                ),
			                REMOVEFILTERS(
			                    'Project_BDS'[Năm - Quý],
			                    'Project_BDS'[year],
			                    'Project_BDS'[quater],
			                    'Project_BDS'[period],
			                    'Project_BDS'[Khoang_Gia_So],
			                    'Project_BDS'[Khoang_Gia_Order],
			                    'Project_BDS'[phase_status.2]
			                )
			            )
			        VAR _SoldBeforeQuarter =
			            MAXX(_LatestSoldRowBeforeQuarter, 'Project_BDS'[quantity])
			        RETURN
			            COALESCE(_OpenedThroughQuarter, 0)
			                - COALESCE(_SoldBeforeQuarter, 0)
			    )
			RETURN
			    IF(
			        NOT _HasPriceBandFilter,
			        [Nguồn cung sơ cấp],
			        _AllocatedPrimarySupply
			    )
		formatString: #,##0
		displayFolder: Nguồn cung
		lineageTag: 2c80709c-9974-4ea4-b200-7f36ab0ea3a1


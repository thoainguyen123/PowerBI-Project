	measure 'Tỷ trọng số căn đã bán quý này' =
			
			VAR _SoldCurrentRow =
			    [Số căn đã bán quý này]
			
			VAR _TotalSoldVisible =
			    CALCULATE(
			        [Số căn đã bán quý này],
			        ALLSELECTED('Project_BDS'[project_name]),
			        ALLSELECTED('Project_BDS'[phase_name]),
			        ALLSELECTED('Project_BDS'[project_type])
			    )
			
			RETURN
			    DIVIDE(
			        _SoldCurrentRow,
			        _TotalSoldVisible,
			        0
			    )
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Nguồn cung
		lineageTag: eff16682-bca9-4eda-945d-02a95f108610


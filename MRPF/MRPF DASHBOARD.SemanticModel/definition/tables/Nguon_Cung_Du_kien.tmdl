	partition Nguon_Cung_Du_kien = m
		mode: import
		source =
				let
				    Source = Sql.Database("10.16.19.14", "INVESTMENT_REPORT", [Query="SELECT A.[isDeactivated]#(lf)      ,A.[id]#(lf)      ,A.[createdAt]#(lf)      ,A.[updatedAt]#(lf)      ,A.[deletedAt]#(lf)      ,A.[createdById]#(lf)      ,A.[updatedById]#(lf)      ,A.[deletedById]#(lf)      ,A.[code]#(lf)      ,A.[projectId]#(lf)      ,A.[subdivisionId]#(lf)      ,A.[projectTypeId]#(lf)      ,A.[scale]#(lf)      ,A.[mrAreaUnitId]#(lf)      ,A.[totalProducts]#(lf)      ,A.[salesOpeningDate]#(lf)      ,A.[endDate]#(lf)      ,A.[areaNFA]#(lf)      ,A.[areaGFA]#(lf)      ,A.[priorityIndustry]#(lf)      ,A.[basementFloors]#(lf)      ,A.[floors]#(lf)      ,A.[blocks]#(lf)      ,A.[priorityLevelId]#(lf)      ,B.name AS phase_name#(lf)      ,D.label AS phase_status#(lf)      ,C.name AS project_name#(lf)      ,H.name AS city#(lf)      ,K.label AS city_type#(lf)      ,L.name AS ward#(lf)      ,M.name AS leading_company#(lf)      ,G.label AS category#(lf)      ,F.label AS project_type#(lf)      ,C.centroid.Lat as Latitude#(lf)      ,C.centroid.Long AS longtitude#(lf)  FROM [INVESTMENT_REPORT].[dbo].[mr_real_estate_project_type] A#(lf)  LEFT JOIN mr_subdivision B ON A.subdivisionId = B.id#(lf)  LEFT JOIN dropdown_option D ON B.subdivisionStatusId = D.id#(lf)  LEFT JOIN mr_project C ON A.projectId = C.id#(lf)  LEFT JOIN city H ON C.cityId =H.id#(lf)  LEFT JOIN dropdown_option K ON C.cityTypeId =K.id#(lf)  LEFT JOIN ward L ON C.wardId = L.id#(lf)  LEFT JOIN mr_leading_companies M ON C.leadingCompanyId = M.id#(lf)  LEFT JOIN dropdown_option G ON C.projectCategoryId = G.id#(lf)  LEFT JOIN dropdown_option F ON A.projectTypeId = F.id#(lf)  WHERE A.isDeactivated = 0"]),
				    #"Filtered Rows" = Table.SelectRows(Source, each ([category] = "MRPF - NVLG") and ([phase_status] = "MRPF-Dự kiến mở bán" or [phase_status] = "MRPF-Hoãn")),
				    #"Split Column by Delimiter" = Table.SplitColumn(#"Filtered Rows", "phase_status", Splitter.SplitTextByDelimiter("-", QuoteStyle.Csv), {"phase_status.1", "phase_status.2"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Split Column by Delimiter",{{"phase_status.1", type text}, {"phase_status.2", type text}})
				in
				    #"Changed Type"


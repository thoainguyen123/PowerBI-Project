	partition Product_Project_BDS = m
		mode: import
		source =
				let
				    Source = Sql.Database("10.16.19.14", "INVESTMENT_REPORT", [Query="SELECT A.[isDeactivated]#(lf)      ,A.[id]#(lf)      ,A.[createdAt]#(lf)      ,A.[updatedAt]#(lf)      ,A.[deletedAt]#(lf)      ,A.[createdById]#(lf)      ,A.[updatedById]#(lf)      ,A.[deletedById]#(lf)      ,A.[code]#(lf)      ,A.[realEstateProjectTypeId]#(lf)      ,A.[productTypeId]#(lf)      ,A.[quantity]#(lf)      ,A.[area]#(lf)      ,A.[unitId]#(lf)      ,C.name AS project_name#(lf)      ,D.name AS phase_name#(lf)      ,F.label AS project_type#(lf)      ,E.label AS product_name#(lf)      ,H.name AS city#(lf)      ,K.label AS city_type#(lf)      ,L.name AS ward#(lf)      ,G.label AS category#(lf)      ,M.name AS leading_company#(lf)  FROM [INVESTMENT_REPORT].[dbo].[mr_real_estate_type] A#(lf)  LEFT JOIN mr_real_estate_project_type B ON A.realEstateProjectTypeId = B.id AND B.isDeactivated = 0#(lf)  LEFT JOIN mr_project C ON B.projectId = C.id AND C.isDeactivated = 0#(lf)  LEFT JOIN mr_subdivision D ON B.subdivisionId = D.id#(lf)  LEFT JOIN dropdown_option F ON B.projectTypeId = F.id#(lf)  LEFT JOIN dropdown_option E ON A.productTypeId = E.id#(lf)  LEFT JOIN city H ON C.cityId =H.id#(lf)  LEFT JOIN dropdown_option K ON C.cityTypeId =K.id#(lf)  LEFT JOIN ward L ON C.wardId = L.id#(lf)  LEFT JOIN dropdown_option G ON C.projectCategoryId = G.id#(lf)    LEFT JOIN mr_leading_companies M ON C.leadingCompanyId = M.id#(lf)#(lf)"]),
				    #"Filtered Rows" = Table.SelectRows(Source, each ([isDeactivated] = false))
				in
				    #"Filtered Rows"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


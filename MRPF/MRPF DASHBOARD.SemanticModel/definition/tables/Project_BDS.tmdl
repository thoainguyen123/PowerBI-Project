	column Khoang_Gia_So = ```
			
			VAR _LoaiHinh = Project_BDS[project_type]
			VAR _Gia = Project_BDS[amount] 
			
			RETURN SWITCH( TRUE(),
			
			    -- NHÓM 1: Nhà ở Xã hội
			    CONTAINSSTRING(_LoaiHinh, "Nhà ở xã hội"),
			        SWITCH( TRUE(),
			            _Gia < 15, "< 15",
			            _Gia < 30, "15 - 30",
			            _Gia < 50, "30 - 50",
			            _Gia < 70, "50 - 70",
			            "> 70"
			        ),
			
			    -- NHÓM 2: Nhà ở Thương mại - Thấp tầng
			    _LoaiHinh = "Nhà ở thương mại – Thấp tầng",
			        SWITCH( TRUE(),
			            _Gia < 100, "< 100",
			            _Gia < 200, "100 - 200",
			            _Gia < 300, "200 - 300",
			            _Gia < 400, "300 - 400",
			            "> 400"
			        ),
			
			    -- NHÓM 3: Các loại còn lại (TM Cao tầng, Nghỉ dưỡng...)
			    SWITCH( TRUE(),
			        _Gia < 50,  "< 50",
			        _Gia < 70,  "50 - 70",
			        _Gia < 100, "70 - 100",
			        _Gia < 120, "100 - 120",
			        "> 120"
			    )
			)
			```
		lineageTag: 06b81337-1e0f-4627-91ac-9b31017d7be6
		summarizeBy: none
		sortByColumn: Khoang_Gia_Order

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column Khoang_Gia_Order = ```
			
			VAR _LoaiHinh = Project_BDS[project_type]
			VAR _Gia = Project_BDS[amount] 
			
			RETURN SWITCH( TRUE(),
			
			    -- NHÓM 1: Nhà ở Xã hội (Đánh số 1 -> 5)
			    CONTAINSSTRING(_LoaiHinh, "Nhà ở xã hội"),
			        SWITCH( TRUE(),
			            _Gia < 15, 1,
			            _Gia < 30, 2,
			            _Gia < 50, 3,
			            _Gia < 70, 4,
			            5 -- > 70
			        ),
			
			    -- NHÓM 2: Nhà ở Thương mại - Thấp tầng (Đánh số 6 -> 10)
			    _LoaiHinh = "Nhà ở thương mại – Thấp tầng",
			        SWITCH( TRUE(),
			            _Gia < 100, 6,
			            _Gia < 200, 7,
			            _Gia < 300, 8,
			            _Gia < 400, 9,
			            10 -- > 400
			        ),
			
			    -- NHÓM 3: Các loại còn lại (Đánh số 11 -> 15)
			    SWITCH( TRUE(),
			        _Gia < 50,  11,
			        _Gia < 70,  12,
			        _Gia < 100, 13,
			        _Gia < 120, 14,
			        15 -- > 120
			    )
			)
			```
		formatString: 0
		lineageTag: 683ef27a-99f0-4695-b756-1537b62c744f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic


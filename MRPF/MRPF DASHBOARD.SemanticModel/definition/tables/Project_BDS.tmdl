	column Nhóm =
			SWITCH(
			    TRUE(),
			    CONTAINSSTRING(Project_BDS[project_type],"Nhà ở"),"Nhà ở",
			    CONTAINSSTRING(Project_BDS[project_type],"Nghỉ dưỡng"),"Nghỉ dưỡng",
			    CONTAINSSTRING(Project_BDS[project_type],"Khu công nghiệp"),"Khu công nghiệp",
			    "Bất động sản thương mại")
		lineageTag: ee658bca-24b8-4541-b776-bb9592c60d42
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column quater = IF(Project_BDS[frequency] = "Tháng",IF(Project_BDS[period] >= 1 && Project_BDS[period] <= 3,1,IF(Project_BDS[period] >= 4 && Project_BDS[period] <= 6,2,IF(Project_BDS[period] >= 7 && Project_BDS[period] <= 9,3,IF(Project_BDS[period] >= 10 && Project_BDS[period] <= 12,4,Project_BDS[period])))),Project_BDS[period])
		formatString: 0
		lineageTag: 60402b80-ac09-4adb-8168-1adcd500c592
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Năm - Quý' = Project_BDS[year]&"-0"&Project_BDS[quater]

		annotation SummarizationSetBy = Automatic

	column tags_NVLG =
			
			VAR _Code = Project[code]
			
			VAR _HasTag =
			    CONTAINSSTRING(Project[tag_ids], "NVLG")
			        || CONTAINSSTRING(Project[tag_ids], "NVG")
			
			VAR _IsDirect = _HasTag
			
			-- Lấy danh sách các code trực tiếp có NVLG hoặc NVG
			VAR _DirectNVLGCodes =
			    CALCULATETABLE(
			        VALUES(Project[code]),
			        FILTER(
			            ALL(Project),
			            (
			                CONTAINSSTRING(Project[tag_ids], "NVLG")
			                || CONTAINSSTRING(Project[tag_ids], "NVG")
			            )
			            && NOT(ISBLANK(Project[code]))
			        )
			    )
			
			-- Lấy danh sách parent_code của các dòng NVLG/NVG
			VAR _ParentCodes =
			    CALCULATETABLE(
			        VALUES(Project[parent_code]),
			        FILTER(
			            ALL(Project),
			            Project[code] IN _DirectNVLGCodes
			                && NOT(ISBLANK(Project[parent_code]))
			        )
			    )
			
			VAR _GrandParentCodes =
			    CALCULATETABLE(
			        VALUES(Project[parent_code]),
			        FILTER(
			            ALL(Project),
			            Project[code] IN _ParentCodes
			                && NOT(ISBLANK(Project[parent_code]))
			        )
			    )
			
			VAR _GreatGrandParentCodes =
			    CALCULATETABLE(
			        VALUES(Project[parent_code]),
			        FILTER(
			            ALL(Project),
			            Project[code] IN _GrandParentCodes
			                && NOT(ISBLANK(Project[parent_code]))
			        )
			    )
			
			VAR _IsAncestor =
			    _Code IN _ParentCodes
			        || _Code IN _GrandParentCodes
			        || _Code IN _GreatGrandParentCodes
			
			RETURN
			    IF(_IsDirect || _IsAncestor, "NVLG", BLANK())

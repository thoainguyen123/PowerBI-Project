table Project
	lineageTag: c6855d85-7a8d-44f9-a154-86abe55364ee

	measure Measure = ```
			
			COALESCE(
			    SELECTEDVALUE(Project[Chi tiết công viêc]),
			    ""
			)
			
			```
		lineageTag: daedb5b1-013d-400e-8e16-300592feb758

	measure 'Measure 3' =
			
			VAR x =
			    COALESCE(
			        CALCULATE(
			            MAX(Project[percent]),
			            CONTAINSSTRING(Project[title], "Số Hóa"),
			            Project[deep_level] = "Cấp 2"
			        ),
			        0
			    )
			
			VAR y =
			    COALESCE(
			        CALCULATE(
			            MAX(Project[percent]),
			            CONTAINSSTRING(Project[title], "AI"),
			            Project[deep_level] = "Cấp 2"
			        ),
			        0
			    )
			
			RETURN
			    "Số Hóa: " & FORMAT(x, "0%") & UNICHAR(10) &
			    "AI: " & FORMAT(y, "0%")
		lineageTag: 18c309b4-4758-47f4-86c4-66ab3b05c7c0

	/// Chỉ số hoàn thành AI & Số hóa dành riêng cho Novaland
	measure 'Chỉ số hoàn thành AI & Số hóa Novaland' =
			
			VAR x =
			    COALESCE(
			        CALCULATE(
			            AVERAGE(Project[percent]),
			            CONTAINSSTRING(Project[title], "Số Hóa"),
			            Project[progress_type] = "Theo % người dùng tự cập nhật",
			            Project[tags_NVLG] = "NVLG"
			        ),
			        0
			    )
			
			VAR y =
			    COALESCE(
			        CALCULATE(
			            AVERAGE(Project[percent]),
			            CONTAINSSTRING(Project[title], "AI"),
			            Project[progress_type] = "Theo % người dùng tự cập nhật",
			            Project[tags_NVLG] = "NVLG"
			        ),
			        0
			    )
			
			RETURN
			    "Số Hóa: " & FORMAT(x, "0%") & UNICHAR(10) &
			    "AI: " & FORMAT(y, "0%")
		lineageTag: a1b2c3d4-e5f6-7890-abcd-ef1234567890


	column Parent_title_format = ```
			
			SWITCH( TRUE(),
			    // 1. Nếu là Cấp 3: Tìm parent_title của dòng có code = parent_code hiện tại VÀ là Cấp 2
			    Project[deep_level] = "Cấp 3", 
			    LOOKUPVALUE(
			        Project[parent_title.1],      // Cột muốn lấy kết quả
			        Project[code], Project[parent_code],  // Điều kiện 1: Cột Code (bảng gốc) = Parent Code (dòng hiện tại)
			        Project[deep_level], "Cấp 2"          // Điều kiện 2: Phải là Cấp 2
			    ),
			
			    // 2. Logic cũ: Nếu parent_title.1 có dữ liệu thì lấy nó
			    NOT(ISBLANK(Project[parent_title.1])), 
			    Project[parent_title.1],
			
			    // 3. Mặc định: Lấy parent_title gốc
			    Project[parent_title]
			)
			```
		lineageTag: 72ca8dd6-e948-428c-b59e-7b7d95b51b5e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column percent
		dataType: double
		lineageTag: a4a80211-0bd8-4226-80f0-d3e7a9ccbce2
		summarizeBy: sum
		sourceColumn: percent

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Title_Cap_2_Tuong_Ung = ```
			
			VAR _4_Ky_Tu_Dau = LEFT(Project[parent_title], 4) -- Lấy 4 ký tự đầu của dòng hiện tại
			
			RETURN
			CALCULATE(
			    MAX(Project[title]), -- Lấy giá trị cột Title
			    FILTER(
			        ALL(Project), -- Quét toàn bộ bảng (bỏ qua các filter khác)
			        Project[deep_level] = "Cấp 1" && -- Điều kiện 1: Phải là Cấp 2
			        LEFT(TRIM(SUBSTITUTE(Project[title],UNICHAR(8195), " ")), 4) = _4_Ky_Tu_Dau -- Điều kiện 2: 4 ký tự đầu phải khớp nhau
			    )
			)
			
			
			
			```

table Project_a
	lineageTag: f662cb77-a939-4d93-8926-6bb88113cb13

	measure 'Measure 4' = ```
			
			VAR x = CALCULATE(AVERAGE(Project[percent]), CONTAINSSTRING(Project[title], "Số Hóa") && (Project[deep_level] = "Cấp 1"||Project[deep_level] = "Cấp 2"))
			VAR y = CALCULATE(AVERAGE(Project[percent]), CONTAINSSTRING(Project[title], "AI") && (Project[deep_level] = "Cấp 1"||Project[deep_level] = "Cấp 2"))
			
			RETURN 
			    "Số Hóa: " & FORMAT(x, "0%") & UNICHAR(10) & 
			    "AI: " & FORMAT(y, "0%")
			```
		lineageTag: 2e942fd1-7856-412b-ad8c-541ebf2d9363


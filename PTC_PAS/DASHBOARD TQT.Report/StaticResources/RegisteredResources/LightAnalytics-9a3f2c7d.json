{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.153.json",
  "name": "LightAnalytics-9a3f2c7d.json",
  "dataColors": [
    "#2B8FD8",
    "#E76F51",
    "#1F9D74",
    "#E39A2F",
    "#0E8F9C",
    "#D9534F",
    "#4F6D8A",
    "#5CB8E6",
    "#9A84E8",
    "#66C5A5",
    "#F1BD69"
  ],
  "good": "#1F9D74",
  "neutral": "#E39A2F",
  "bad": "#D9534F",
  "maximum": "#1F9D74",
  "center": "#FAECD7",
  "minimum": "#D9534F",
  "null": "#6B7A90",
  "foreground": "#172033",
  "foregroundNeutralSecondary": "#6B7A90",
  "foregroundNeutralTertiary": "#8794A7",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F7FB",
  "backgroundNeutral": "#F1F5F9",
  "tableAccent": "#2B8FD8",
  "textClasses": {
    "callout": {
      "fontSize": 31,
      "fontFace": "Segoe UI Semibold",
      "color": "#172033"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#172033"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#172033"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#6B7A90"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#DFE7F1"
              }
            },
            "width": 1,
            "radius": 16
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight",
            "color": {
              "solid": {
                "color": "#9AA8BA"
              }
            },
            "transparency": 96,
            "position": "Outer"
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 10,
            "right": 10
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "bold": true,
            "$id": "default"
          }
        ],
        "label": [
          {
            "show": true,
            "$id": "default"
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "labels": [
          {
            "show": true,
            "fontSize": 10,
            "color": {
              "solid": {
                "color": "#172033"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": false,
            "gridlineShow": false,
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "fontSize": 10,
            "labelColor": {
              "solid": {
                "color": "#6B7A90"
              }
            },
            "showAxisTitle": false,
            "innerPadding": 26,
            "gridlineShow": false
          }
        ],
        "legend": [
          {
            "show": false
          }
        ],
        "dataPoint": [
          {
            "borderShow": false
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "autoSizeColumnWidth": true,
            "columnAdjustment": "growToFit",
            "backColor": {
              "solid": {
                "color": "#F1F5F9"
              }
            },
            "fontColor": {
              "solid": {
                "color": "#172033"
              }
            },
            "bold": true
          }
        ],
        "values": [
          {
            "backColorPrimary": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#F8FAFC"
              }
            },
            "fontColorPrimary": {
              "solid": {
                "color": "#172033"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#172033"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontFamily": "Segoe UI Semibold",
            "textSize": 10,
            "fontColor": {
              "solid": {
                "color": "#6B7A90"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "outlineStyle": 0
          }
        ],
        "items": [
          {
            "fontFamily": "Segoe UI",
            "textSize": 10,
            "fontColor": {
              "solid": {
                "color": "#172033"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "outlineStyle": 0,
            "padding": 2
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ],
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "shape": {
      "*": {
        "border": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    }
  }
}
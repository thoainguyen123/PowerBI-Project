	/// Năm của ngày mục tiêu quyết toán. Trả BLANK khi chưa có ngày mục tiêu để tránh hiển thị năm giả 1900.
	column 'Năm mục tiêu' = IF(ISBLANK(Data[NGÀY MỤC TIÊU]), BLANK(), YEAR(Data[NGÀY MỤC TIÊU]))
		dataType: int64
		formatString: 0
		lineageTag: 97c7598c-d553-4d6a-a941-5b181ba23d72
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Cột tương thích cho các báo cáo cũ. Trang PIC mới dùng bảng 'Phân công PIC' để không bỏ sót HĐ có đồng thời PIC Xây dựng/Cung ứng và PIC MEP.
	column 'PIC phụ trách' = COALESCE(Data[PIC XÂY DỰNG/CUNG ỨNG], Data[PIC MEP])
		dataType: string
		isHidden
		lineageTag: a29a3e55-6a8d-4afa-a55e-51b78ac46828
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Nhãn kỳ mục tiêu dùng cho slicer; thay giá trị 1900 bằng nhãn dễ hiểu 'Chưa có mục tiêu'.
	column 'Kỳ mục tiêu' = IF(ISBLANK(Data[NGÀY MỤC TIÊU]), "Chưa có mục tiêu", FORMAT(Data[NGÀY MỤC TIÊU], "yyyy"))
		dataType: string
		displayFolder: Phân loại
		lineageTag: 0d4cea20-41cb-40b0-b67d-26085ee7ecb1
		summarizeBy: none

	/// Khu vực đã chuẩn hóa cho báo cáo. Gộp typo 'HỔ TRÀM' vào 'HỒ TRÀM' và dùng tên file Hồ Tràm làm fallback khi khu vực trống.
	column 'Khu vực chuẩn' =
			VAR _KhuVuc = UPPER(TRIM(COALESCE(Data[KHU VỰC], "")))
			RETURN
			    SWITCH(
			        TRUE(),
			        _KhuVuc = "HỔ TRÀM", "HỒ TRÀM",
			        _KhuVuc = "" && CONTAINSSTRING(UPPER(Data[File]), "HO TRAM"), "HỒ TRÀM",
			        _KhuVuc = "", "Chưa xác định",
			        Data[KHU VỰC]
			    )
		dataType: string
		displayFolder: Phân loại
		lineageTag: c5fd8162-6113-483b-9009-19e58bbf1373
		summarizeBy: none

	/// Cờ nghiệp vụ cho báo cáo quyết toán: dùng KPI QUYẾT TOÁN; riêng file Hồ Tràm fallback sang NGÀY MỤC TIÊU vì cột KPI của nguồn này trống toàn bộ.
	column 'Thuộc phạm vi quyết toán' =
			NOT ISBLANK(Data[KPI QUYẾT TOÁN])
			    || (
			        CONTAINSSTRING(UPPER(Data[File]), "HO TRAM")
			            && NOT ISBLANK(Data[NGÀY MỤC TIÊU])
			    )
		dataType: boolean
		isHidden
		lineageTag: d37631ad-3682-460c-9e0e-c110b97ac5e5
		summarizeBy: none

	partition Data = m
		mode: import
		source =
				let
				    Source =
				        SharePoint.Contents(
				            "https://novaland.sharepoint.com/sites/PRT",
				            [ApiVersion = 15]
				        ),
				
				    Documents =
				        Source{[Name = "Documents"]}[Content],
				
				    PRC =
				        Documents{[Name = "PRC"]}[Content],
				
				    NovaGen =
				        PRC{[Name = "00. NovaGen"]}[Content],
				
				    NghiepVu =
				        NovaGen{[Name = "07. Các nghiệp vụ"]}[Content],
				
				    PAS =
				        NghiepVu{[Name = "05. PAS"]}[Content],
				
				    TheoDoiFolder =
				        PAS{[Name = "01. THEO DOI HD & CPC"]}[Content],
				
				    #"Filtered Rows" =
				        Table.SelectRows(
				            TheoDoiFolder,
				            each
				                [Extension] <> null
				                and List.Contains(
				                    {".xlsx", ".xlsm", ".xls"},
				                    Text.Lower([Extension])
				                )
				                and not Text.StartsWith([Name], "~$")
				                and Text.StartsWith(
				                    Text.Upper(Text.Trim([Name])),
				                    "THEO DOI HD"
				                )
				        ),
				
				    #"Kept Columns" =
				        Table.SelectColumns(
				            #"Filtered Rows",
				            {"Name", "Content"}
				        ),
				
				    #"Added Workbook" =
				        Table.AddColumn(
				            #"Kept Columns",
				            "Workbook",
				            each try Excel.Workbook([Content], null, true) otherwise null
				        ),
				
				    #"Removed Invalid Workbooks" =
				        Table.SelectRows(
				            #"Added Workbook",
				            each [Workbook] <> null
				        ),
				
				    #"Expanded Workbook" =
				        Table.ExpandTableColumn(
				            #"Removed Invalid Workbooks",
				            "Workbook",
				            {"Item", "Kind", "Hidden", "Data"},
				            {"SheetName", "Kind", "Hidden", "Data"}
				        ),
				
				    #"Filtered Sheet" =
				        Table.SelectRows(
				            #"Expanded Workbook",
				            each
				                [Kind] = "Sheet"
				                and Text.Upper(Text.Trim([SheetName])) = "THEO DÕI HĐ"
				                and ([Hidden] = false or [Hidden] = null)
				        ),
				
				    #"Cleaned Each Sheet" =
				        Table.AddColumn(
				            #"Filtered Sheet",
				            "CleanData",
				            each
				                let
				                    FileName = [Name],
				                    RawData = [Data],
				
				                    ReplacedErrors =
				                        Table.ReplaceErrorValues(
				                            RawData,
				                            List.Transform(
				                                Table.ColumnNames(RawData),
				                                each {_, null}
				                            )
				                        ),
				
				                    PromotedHeaders =
				                        Table.PromoteHeaders(
				                            ReplacedErrors,
				                            [PromoteAllScalars = true]
				                        ),
				
				                    ReplacedErrorsAfterHeaders =
				                        Table.ReplaceErrorValues(
				                            PromotedHeaders,
				                            List.Transform(
				                                Table.ColumnNames(PromotedHeaders),
				                                each {_, null}
				                            )
				                        ),
				
				                    AddedFileName =
				                        Table.AddColumn(
				                            ReplacedErrorsAfterHeaders,
				                            "Source.FileName",
				                            each FileName,
				                            type text
				                        )
				                in
				                    AddedFileName
				        ),
				
				    #"Combined Data" =
				        if Table.RowCount(#"Cleaned Each Sheet") = 0 then
				            #table({}, {})
				        else
				            Table.Combine(
				                #"Cleaned Each Sheet"[CleanData]
				            ),

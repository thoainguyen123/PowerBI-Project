table Data
	lineageTag: 5ae4b80b-a693-414e-b542-ba6aeb077eb9

	/// Số HĐ thuộc phạm vi quyết toán. Dùng KPI QUYẾT TOÁN; riêng nguồn Hồ Tràm fallback sang HĐ có NGÀY MỤC TIÊU.
	measure 'Số HĐ cần quyết toán' =
			CALCULATE(
			    COUNTROWS(Data),
			    Data[Thuộc phạm vi quyết toán] = TRUE()
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: 9639839e-bdf7-4962-91fe-352b8252e2fd

	/// Số HĐ thuộc phạm vi quyết toán có năm mục tiêu bằng năm hiện tại.
	measure 'Số HĐ cần quyết toán (năm nay)' =
			CALCULATE(
			    [Số HĐ cần quyết toán],
			    Data[Năm mục tiêu] = YEAR(TODAY())
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: 680dcc39-2c65-4006-a0ae-93249c299933

	/// Số HĐ thuộc phạm vi quyết toán có tình trạng 'Đã quyết toán'.
	measure 'Số HĐ hoàn thành' =
			CALCULATE(
			    [Số HĐ cần quyết toán],
			    Data[TÌNH TRẠNG QUYẾT TOÁN] = "Đã quyết toán"
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: b991a008-7b8b-44ea-97a5-0d18340df600

	/// Tỷ lệ HĐ đã quyết toán trên tổng HĐ thuộc phạm vi.
	measure '% Hoàn thành' =
			DIVIDE(
			    [Số HĐ hoàn thành],
			    [Số HĐ cần quyết toán]
			)
		formatString: 0.0%
		displayFolder: KPI quyết toán
		lineageTag: bd4af6de-d836-43ba-a0bb-089ae0f999a4


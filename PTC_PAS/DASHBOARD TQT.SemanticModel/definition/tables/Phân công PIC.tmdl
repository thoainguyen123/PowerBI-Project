/// Bảng phân công theo vai trò, tạo một dòng cho mỗi lượt HĐ-PIC. Một HĐ có cả PIC Xây dựng/Cung ứng và PIC MEP sẽ xuất hiện hai lượt để không mất trách nhiệm phối hợp.
table 'Phân công PIC'
	lineageTag: e4ece5ba-98d8-42f5-9fdb-ca0b7971d330

	/// Số lượt HĐ thuộc phạm vi quyết toán theo PIC; bao gồm fallback ngày mục tiêu của nguồn Hồ Tràm.
	measure 'Số lượt HĐ cần quyết toán' =
			CALCULATE(
			    COUNTROWS('Phân công PIC'),
			    'Phân công PIC'[Thuộc phạm vi quyết toán] = TRUE()
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: cf0dc78b-72b7-46a1-b773-0db54645d1f0

	/// Số lượt HĐ thuộc phạm vi theo PIC có năm mục tiêu bằng năm hiện tại.
	measure 'Số lượt HĐ cần quyết toán (năm nay)' =
			CALCULATE(
			    [Số lượt HĐ cần quyết toán],
			    'Phân công PIC'[Năm mục tiêu] = YEAR(TODAY())
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: 2ae6e687-6091-442d-99f7-2bc58eb5ced4

	/// Số lượt HĐ thuộc phạm vi theo PIC có tình trạng 'Đã quyết toán'.
	measure 'Số lượt HĐ hoàn thành' =
			CALCULATE(
			    [Số lượt HĐ cần quyết toán],
			    'Phân công PIC'[Tình trạng quyết toán] = "Đã quyết toán"
			)
		formatString: 0
		displayFolder: KPI quyết toán
		lineageTag: 2c784507-cd82-4686-87cf-08726dc40d86

	/// Tỷ lệ hoàn thành theo lượt HĐ thuộc phạm vi được phân công cho PIC.
	measure '% Hoàn thành PIC' =
			DIVIDE(
			    [Số lượt HĐ hoàn thành],
			    [Số lượt HĐ cần quyết toán]
			)
		formatString: 0.0%
		displayFolder: KPI quyết toán
		lineageTag: 70813dfb-a52a-480c-a3d2-9fd403b7d3b0

	/// (1) theo PIC = số lượt phân công có NGÀY MỤC TIÊU hợp lệ. Một HĐ có cả PIC Xây dựng (cột AK) và PIC MEP (cột AL) được tính 2 lượt để không bỏ sót trách nhiệm.
	measure '(1) Số lượt cần quyết toán' =
			CALCULATE (
			    COUNTROWS ( 'Phân công PIC' ),
			    NOT ISBLANK ( 'Phân công PIC'[Năm mục tiêu] )
			)
		formatString: #,##0
		displayFolder: Tracking theo PIC\01. Số lượng
		lineageTag: 97de1068-05ee-44ed-bd63-6c5337defc02

	/// (2) theo PIC: lượt phân công có mục tiêu quyết toán năm 2026.
	measure '(2) Số lượt cần quyết toán 2026' =
			VAR _Nam = [Năm báo cáo]
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Phân công PIC' ),
			        'Phân công PIC'[Năm mục tiêu] = _Nam
			    )
		formatString: #,##0
		displayFolder: Tracking theo PIC\01. Số lượng
		lineageTag: c6e8fcd8-12dc-4b0c-96ef-2f8e67c7ea92

	/// (2.1) theo PIC: KPI QUYẾT TOÁN = 'KPI 417'.
	measure '(2.1) KPI đã đăng ký (PIC)' =
			VAR _Nam = [Năm báo cáo]
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Phân công PIC' ),
			        'Phân công PIC'[Năm mục tiêu] = _Nam,
			        'Phân công PIC'[Nhóm KPI quyết toán] = "KPI đã đăng ký"
			    )
		formatString: #,##0
		displayFolder: Tracking theo PIC\01. Số lượng
		lineageTag: 11a41e12-8e41-425c-bbf7-b9833aa8b208

	/// (2.2) theo PIC: KPI QUYẾT TOÁN = 'Ngoài 417'.
	measure '(2.2) Đăng ký thêm (PIC)' =
			VAR _Nam = [Năm báo cáo]
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Phân công PIC' ),
			        'Phân công PIC'[Năm mục tiêu] = _Nam,
			        'Phân công PIC'[Nhóm KPI quyết toán] = "Đăng ký thêm"
			    )
		formatString: #,##0
		displayFolder: Tracking theo PIC\01. Số lượng
		lineageTag: 0a1f7e11-f093-4559-ad34-96dc5140c3ce

	/// Phần còn lại để cân đối: (2) = (2.1) + (2.2) + (2.3).
	measure '(2.3) Chưa phân loại KPI (PIC)' =
			VAR _Nam = [Năm báo cáo]
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Phân công PIC' ),
			        'Phân công PIC'[Năm mục tiêu] = _Nam,
			        NOT 'Phân công PIC'[Nhóm KPI quyết toán] IN { "KPI đã đăng ký", "Đăng ký thêm" }
			    )
		formatString: #,##0
		displayFolder: Tracking theo PIC\01. Số lượng
		lineageTag: 04e16605-4e37-40d8-ac92-42ed59f8070e

	/// (3) theo PIC: lượt có ngày ký biên bản quyết toán từ 2026 trở đi, trong số lượt có mục tiêu 2026.
	measure '(3) Số lượt hoàn thành 2026' =
			VAR _Nam = [Năm báo cáo]
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Phân công PIC' ),
			        'Phân công PIC'[Năm mục tiêu] = _Nam,
			        'Phân công PIC'[Năm ký quyết toán] >= _Nam
			    )
		formatString: #,##0
		displayFolder: Tracking theo PIC\01. Số lượng
		lineageTag: 93a81616-7ba3-4542-8dab-baba86f7c765

	/// (3) / (2.1) theo từng PIC.
	measure '% Hoàn thành theo KPI đã đăng ký (PIC)' = DIVIDE ( [(3) Số lượt hoàn thành 2026], [(2.1) KPI đã đăng ký (PIC)] )
		formatString: 0.0%
		displayFolder: Tracking theo PIC\02. Tỷ lệ
		lineageTag: fc3878e2-6aaa-4370-b342-aec5712f3262

	/// (3) / (2) theo từng PIC.
	measure '% Hoàn thành 2026 (PIC)' = DIVIDE ( [(3) Số lượt hoàn thành 2026], [(2) Số lượt cần quyết toán 2026] )
		formatString: 0.0%
		displayFolder: Tracking theo PIC\02. Tỷ lệ
		lineageTag: f1da3afd-c86a-4c38-b755-ed41abafdafc

	/// CẢNH BÁO: hợp đồng có đồng thời PIC Xây dựng và PIC MEP sẽ được cộng giá trị 2 lần. Chỉ dùng để so sánh giữa các PIC, KHÔNG dùng dòng Tổng. Muốn tổng đúng hãy dùng [Giá trị đã quyết toán 2026] của bảng Data.
	measure 'Giá trị đã quyết toán 2026 (PIC)' =
			VAR _Nam = [Năm báo cáo]
			RETURN
			    CALCULATE (
			        SUM ( 'Phân công PIC'[Giá trị workdone gồm VAT] ),
			        'Phân công PIC'[Năm mục tiêu] = _Nam,
			        'Phân công PIC'[Năm ký quyết toán] >= _Nam
			    )
		formatString: #,##0
		displayFolder: Tracking theo PIC\03. Giá trị
		lineageTag: ed2b57d3-5953-47d3-803e-a14847d0e212

	/// Phần của (3) nằm đúng trong nhóm KPI 417, theo từng PIC.
	measure '(3.1) Số lượt hoàn thành thuộc KPI đã đăng ký' =
			VAR _Nam = [Năm báo cáo]
			RETURN
			    CALCULATE (
			        COUNTROWS ( 'Phân công PIC' ),
			        'Phân công PIC'[Năm mục tiêu] = _Nam,
			        'Phân công PIC'[Năm ký quyết toán] >= _Nam,
			        'Phân công PIC'[Nhóm KPI quyết toán] = "KPI đã đăng ký"
			    )
		formatString: #,##0
		displayFolder: Tracking theo PIC\04. Tham chiếu thêm
		lineageTag: 92390f8d-f60a-4926-b34f-9d01af510afc

	/// (3.1) / (2.1) theo PIC - luôn <= 100%.
	measure '% Hoàn thành KPI đăng ký (chặt) (PIC)' = DIVIDE ( [(3.1) Số lượt hoàn thành thuộc KPI đã đăng ký], [(2.1) KPI đã đăng ký (PIC)] )
		formatString: 0.0%
		displayFolder: Tracking theo PIC\04. Tham chiếu thêm
		lineageTag: 71cf155d-30a3-47ba-9ab3-85bebfd929dd


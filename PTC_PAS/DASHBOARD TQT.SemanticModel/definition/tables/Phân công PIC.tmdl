	column 'Khu vực'
		lineageTag: 84a030a1-9756-4fe4-9d39-1cab6dbd7836
		isNameInferred
		sourceColumn: [Khu vực]

	column 'Dự án'
		lineageTag: e074772c-1fe8-4560-9cdf-a35252f8228d
		isNameInferred
		sourceColumn: [Dự án]

	column 'Kỳ mục tiêu'
		lineageTag: e3d6329d-e99a-49e6-8f42-578960f279a4
		isNameInferred
		sourceColumn: [Kỳ mục tiêu]

	column 'Năm mục tiêu'
		lineageTag: 62344c8d-335c-42b7-8fc7-6042d3a7c7d8
		isNameInferred
		sourceColumn: [Năm mục tiêu]

	column 'KPI quyết toán'
		lineageTag: 7cec411e-58f1-4dec-87dc-81b37ec5050e
		isNameInferred
		sourceColumn: [KPI quyết toán]

	column 'Tình trạng quyết toán'
		lineageTag: be248471-272e-4597-91ac-69c4a4cc6043
		isNameInferred
		sourceColumn: [Tình trạng quyết toán]

	column File
		isNameInferred
		sourceColumn: [File]

	column 'Thuộc phạm vi quyết toán'
		isNameInferred
		sourceColumn: [Thuộc phạm vi quyết toán]

	partition 'Phân công PIC' = calculated
		mode: import
		source =
				VAR _XayDung =
				    SELECTCOLUMNS(
				        FILTER(
				            Data,
				            NOT ISBLANK(Data[PIC XÂY DỰNG/CUNG ỨNG])
				                && TRIM(Data[PIC XÂY DỰNG/CUNG ỨNG]) <> ""
				        ),
				        "Mã hợp đồng", Data[File] & "|" & FORMAT(Data[STT], "0"),
				        "PIC phụ trách", TRIM(Data[PIC XÂY DỰNG/CUNG ỨNG]),
				        "Nhóm PIC", "Xây dựng/Cung ứng",
				        "File", Data[File],
				        "Khu vực", Data[Khu vực chuẩn],
				        "Dự án", Data[TÊN VIẾT TẮT DỰ ÁN/ĐƠN VỊ],
				        "Kỳ mục tiêu", Data[Kỳ mục tiêu],
				        "Năm mục tiêu", Data[Năm mục tiêu],
				        "Thuộc phạm vi quyết toán", Data[Thuộc phạm vi quyết toán],
				        "KPI quyết toán", Data[KPI QUYẾT TOÁN],
				        "Tình trạng quyết toán", Data[TÌNH TRẠNG QUYẾT TOÁN]
				    )
				VAR _MEP =
				    SELECTCOLUMNS(
				        FILTER(
				            Data,
				            NOT ISBLANK(Data[PIC MEP])
				                && TRIM(Data[PIC MEP]) <> ""
				        ),
				        "Mã hợp đồng", Data[File] & "|" & FORMAT(Data[STT], "0"),
				        "PIC phụ trách", TRIM(Data[PIC MEP]),
				        "Nhóm PIC", "MEP",
				        "File", Data[File],
				        "Khu vực", Data[Khu vực chuẩn],
				        "Dự án", Data[TÊN VIẾT TẮT DỰ ÁN/ĐƠN VỊ],
				        "Kỳ mục tiêu", Data[Kỳ mục tiêu],
				        "Năm mục tiêu", Data[Năm mục tiêu],
				        "Thuộc phạm vi quyết toán", Data[Thuộc phạm vi quyết toán],
				        "KPI quyết toán", Data[KPI QUYẾT TOÁN],
				        "Tình trạng quyết toán", Data[TÌNH TRẠNG QUYẾT TOÁN]
				    )
				RETURN
				    UNION(_XayDung, _MEP)


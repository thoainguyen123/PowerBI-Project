	column 'TÌNH TRẠNG HỢP ĐỒNG'
		dataType: string
		lineageTag: 2d34f7ab-99f6-49ca-8072-b235da1c8044
		summarizeBy: none
		sourceColumn: TÌNH TRẠNG HỢP ĐỒNG

		annotation SummarizationSetBy = Automatic

	/// Năm ký biên bản quyết toán. Đọc được cả M/D/YYYY và D.M.YYYY. Có giá trị = hợp đồng đã hoàn thành quyết toán.
	column 'Năm ký quyết toán' =
			VAR _s =
			    TRIM ( SUBSTITUTE ( SUBSTITUTE ( Data[NGÀY KÝ BIÊN BẢN QUYẾT TOÁN], UNICHAR ( 10 ), "" ), UNICHAR ( 13 ), "" ) )
			VAR _y =
			    IFERROR ( VALUE ( RIGHT ( _s, 4 ) ), BLANK () )
			RETURN
			    IF ( _y >= 2000 && _y <= 2100, _y )
		dataType: int64
		formatString: 0
		displayFolder: Phân loại
		lineageTag: b33b7ae4-56f5-4304-987f-1f5db32b828e

	/// Chuẩn hóa cột KPI QUYẾT TOÁN (đã TRIM + UPPER để gộp các giá trị thừa khoảng trắng). 'Khác' gồm KPI 2027/2028...
	column 'Nhóm KPI quyết toán' =
			VAR _k =
			    UPPER ( TRIM ( COALESCE ( Data[KPI QUYẾT TOÁN], "" ) ) )
			RETURN
			    SWITCH (
			        TRUE (),
			        _k = "KPI 417", "KPI đã đăng ký",
			        _k = "NGOÀI 417", "Đăng ký thêm",
			        _k = "", "Chưa phân loại",
			        "Khác"
			    )
		dataType: string
		displayFolder: Phân loại
		lineageTag: 0e849c2e-f70f-4b2c-ac89-712f1f619f8c

	/// GIÁ TRỊ WORKDONE(GỒM VAT) đã đổi sang kiểu số để tính tổng (cột gốc lưu dạng text).
	column 'Giá trị workdone gồm VAT' = IFERROR ( VALUE ( Data[GIÁ TRỊ WORKDONE(GỒM VAT)] ), BLANK () )
		dataType: double
		formatString: #,##0
		displayFolder: Giá trị
		lineageTag: c9c806b0-2de6-48af-b959-2ec6f487d217

	/// TÌNH TRẠNG QUYẾT TOÁN đã chuẩn hóa: TRIM khoảng trắng thừa, gộp biến thể viết khác nhau, ô trống thành 'Chưa cập nhật'. Dùng cho biểu đồ tròn / cột chồng.
	column 'Tình trạng quyết toán (chuẩn)' =
			VAR _t =
			    TRIM ( COALESCE ( Data[TÌNH TRẠNG QUYẾT TOÁN], "" ) )
			VAR _u = UPPER ( _t )
			RETURN
			    SWITCH (
			        TRUE (),
			        _u = "", "Chưa cập nhật",
			        _u = "ĐÃ QUYẾT TOÁN", "Đã quyết toán",
			        _u IN { "ĐÃ QUYẾT TOÁN/ THANH LÝ", "ĐÃ QUYẾT TOÁN/THANH LÝ" }, "Đã quyết toán/thanh lý",
			        _u IN { "NT ĐÃ NỘP (THẤT LẠC HS)", "NT ĐÃ NỘP(THẤT LẠC HS)" }, "NT đã nộp (thất lạc HS)",
			        _u = "HOÀN THÀNH", "Hoàn thành",
			        _t
			    )
		dataType: string
		displayFolder: Phân loại
		lineageTag: ea4b58a3-c5ea-42b8-8dfa-881c4fc167f3

	/// Giá trị hợp đồng và phát sinh gồm VAT đã đổi từ cột text nguồn sang số để tính công nợ.
	column 'Giá trị HĐ + PS gồm VAT số' = IFERROR ( VALUE ( Data[ GIÁ TRỊ HĐ+PS(GỒM VAT) ] ), BLANK () )
		dataType: double
		isHidden
		formatString: #,##0
		displayFolder: Công nợ\Cột số
		lineageTag: b99329bb-b6c9-4115-aec6-c088f58f1a96
		summarizeBy: sum

	/// Giá trị Workdone/hóa đơn chưa VAT đã đổi từ cột text nguồn sang số.
	column 'Giá trị workdone chưa VAT số' = IFERROR ( VALUE ( Data[GIÁ TRỊ WORKDONE (CHƯA GỒM VAT)] ), BLANK () )
		dataType: double
		isHidden
		formatString: #,##0
		displayFolder: Công nợ\Cột số
		lineageTag: 17b7a061-ef52-4dfb-9d5b-28adc06e62e8
		summarizeBy: sum

	/// Giá trị công nợ đã có CPC gồm ứng và Workdone, chuyển từ text sang số.
	column 'Giá trị CPC gồm ứng + workdone số' = IFERROR ( VALUE ( Data[GIÁ TRỊ CÔNG NỢ ĐÃ CÓ CPC GỒM ỨNG +WORKDONE(GỒM VAT)] ), BLANK () )
		dataType: double
		isHidden
		formatString: #,##0
		displayFolder: Công nợ\Cột số
		lineageTag: 79a1f976-0513-4569-9b7d-cce468402ddd
		summarizeBy: sum

	/// Giá trị đã thanh toán gồm VAT đã đổi từ text sang số.
	column 'Giá trị đã thanh toán số' = IFERROR ( VALUE ( Data[GIÁ TRỊ ĐÃ THANH TOÁN(GỒM VAT)] ), BLANK () )
		dataType: double
		isHidden
		formatString: #,##0
		displayFolder: Công nợ\Cột số
		lineageTag: 317667bf-219d-45a8-b3be-82edd6c089b3
		summarizeBy: sum

	/// Giá trị TĐSP/Swap gồm VAT đã đổi từ text sang số.
	column 'Giá trị swap số' = IFERROR ( VALUE ( Data[GIÁ TRỊ TĐSP(GỒM VAT)] ), BLANK () )
		dataType: double
		isHidden
		formatString: #,##0
		displayFolder: Công nợ\Cột số
		lineageTag: 18268efa-d89a-41d7-b4e5-f6af006fbee4
		summarizeBy: sum

	/// Giá trị tạm ứng đã đổi từ cột text nguồn sang số.
	column 'Giá trị tạm ứng số' = IFERROR ( VALUE ( Data[GIÁ TRỊ TẠM ỨNG CHƯA VAT] ), BLANK () )
		dataType: double
		isHidden
		formatString: #,##0
		displayFolder: Công nợ\Cột số
		lineageTag: 7b0b3eeb-5860-4d32-9b47-b8873186da84
		summarizeBy: sum

	/// Giá trị khấu trừ tạm ứng đã đổi từ cột text nguồn sang số.
	column 'Giá trị khấu trừ tạm ứng số' = IFERROR ( VALUE ( Data[GIÁ TRỊ KHẤU TRỪ TẠM ỨNG] ), BLANK () )
		dataType: double
		isHidden
		formatString: #,##0
		displayFolder: Công nợ\Cột số
		lineageTag: 5dca635e-e00e-4486-ab5d-9e385b0bac27
		summarizeBy: sum

	/// Tiền bảo hành giữ lại theo từng dòng: 5% giá trị Workdone/hóa đơn chưa VAT khi giá trị Workdone gồm VAT khác CPC gồm ứng và Workdone.
	column 'Tiền bảo hành giữ lại dòng' =
			VAR _HoaDonVAT = COALESCE ( Data[Giá trị workdone gồm VAT], 0 )
			VAR _CPC = COALESCE ( Data[Giá trị CPC gồm ứng + workdone số], 0 )
			VAR _HoaDonChuaVAT = COALESCE ( Data[Giá trị workdone chưa VAT số], 0 )
			RETURN
			    ROUND ( IF ( _HoaDonVAT <> _CPC, _HoaDonChuaVAT * 0.05, 0 ), 0 )
		dataType: double
		isHidden
		formatString: #,##0
		displayFolder: Công nợ\Cột số
		lineageTag: e24d3980-de56-4470-b231-f08d3b1778f6
		summarizeBy: sum

	partition Data = m
		mode: import
		source = ```
				let
				    Source =
				        SharePoint.Contents(
				            "https://novaland.sharepoint.com/sites/PRT",
				            [ApiVersion = 15]
				        ),
				
				    Documents =
				        Source{[Name = "Documents"]}[Content],
				
				    PRC =
				        Documents{[Name = "PRC"]}[Content],
				
				    NovaGen =
				        PRC{[Name = "00. NovaGen"]}[Content],
				
				    NghiepVu =
				        NovaGen{[Name = "07. Các nghiệp vụ"]}[Content],
				
				    PAS =
				        NghiepVu{[Name = "05. PAS"]}[Content],
				
				    TheoDoiFolder =
				        PAS{[Name = "01. THEO DOI HD & CPC"]}[Content],
				
				    #"Filtered Rows" =
				        Table.SelectRows(
				            TheoDoiFolder,
				            each
				                [Extension] <> null
				                and List.Contains(
				                    {".xlsx", ".xlsm", ".xls"},
				                    Text.Lower([Extension])
				                )
				                and not Text.StartsWith([Name], "~$")
				                and Text.StartsWith(
				                    Text.Upper(Text.Trim([Name])),
				                    "THEO DOI HD"
				                )
				        ),
				
				    #"Kept Columns" =
				        Table.SelectColumns(
				            #"Filtered Rows",
				            {"Name", "Content"}
				        ),
				
				    #"Added Workbook" =
				        Table.AddColumn(
				            #"Kept Columns",
				            "Workbook",
				            each try Excel.Workbook([Content], null, true) otherwise null
				        ),
				
				    #"Removed Invalid Workbooks" =
				        Table.SelectRows(
				            #"Added Workbook",
				            each [Workbook] <> null
				        ),
				
				    #"Expanded Workbook" =
				        Table.ExpandTableColumn(
				            #"Removed Invalid Workbooks",
				            "Workbook",
				            {"Item", "Kind", "Hidden", "Data"},
				            {"SheetName", "Kind", "Hidden", "Data"}
				        ),
				
				    #"Filtered Sheet" =
				        Table.SelectRows(
				            #"Expanded Workbook",
				            each
				                [Kind] = "Sheet"
				                and Text.Upper(Text.Trim([SheetName])) = "THEO DÕI HĐ"
				                and ([Hidden] = false or [Hidden] = null)
				        ),
				
				#"Cleaned Each Sheet" =
				        Table.AddColumn(
				            #"Filtered Sheet",
				            "CleanData",
				            each
				                let
				                    FileName = [Name],
				                    RawData = [Data],
				
				                    // Tìm vị trí dòng có ô đầu tiên = "STT" -> đó chính là dòng header thật
				                    FirstColName = Table.ColumnNames(RawData){0},
				                    HeaderRowIndex =
				                        List.PositionOf(
				                            List.Transform(
				                                Table.Column(RawData, FirstColName),
				                                each Text.Trim(Text.From(_ ?? "" ))
				                            ),
				                            "STT"
				                        ),
				
				                    // Nếu tìm thấy thì skip tới đúng dòng đó, không thì giữ nguyên
				                    SkippedToHeader =
				                        if HeaderRowIndex = -1 then
				                            RawData
				                        else
				                            Table.Skip(RawData, HeaderRowIndex),
				
				                    ReplacedErrors =
				                        Table.ReplaceErrorValues(
				                            SkippedToHeader,
				                            List.Transform(
				                                Table.ColumnNames(SkippedToHeader),
				                                each {_, null}
				                            )
				                        ),
				
				                    PromotedHeaders =
				                        Table.PromoteHeaders(
				                            ReplacedErrors,
				                            [PromoteAllScalars = true]
				                        ),
				
				                    ReplacedErrorsAfterHeaders =
				                        Table.ReplaceErrorValues(
				                            PromotedHeaders,
				                            List.Transform(
				                                Table.ColumnNames(PromotedHeaders),
				                                each {_, null}
				                            )
				                        ),
				
				                    AddedFileName =
				                        Table.AddColumn(
				                            ReplacedErrorsAfterHeaders,
				                            "Source.FileName",
				                            each FileName,
				                            type text
				                        )
				                in
				                    AddedFileName
				        ),
				
				    #"Combined Data" =
				        if Table.RowCount(#"Cleaned Each Sheet") = 0 then
				            #table({}, {})
				        else
				            Table.Combine(
				                #"Cleaned Each Sheet"[CleanData]
				            ),
				        
				    #"Removed Errors" = Table.RemoveRowsWithErrors(#"Combined Data", {"STT"}),
				    #"Renamed Columns" = Table.RenameColumns(#"Removed Errors",{{"Source.FileName", "File"}})
				in
				    #"Renamed Columns"
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table


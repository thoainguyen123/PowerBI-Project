# === Bắt buộc ===
# Thiếu SECRET_KEY thì app dừng hẳn (không còn secret mặc định trong mã nguồn).
# Sinh giá trị ngẫu nhiên: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret

# === Tài khoản ===
# Nên đặt mật khẩu RIÊNG cho từng tài khoản. Nếu chỉ đặt USER_PASSWORD thì cả 4
# tài khoản dùng chung một mật khẩu, tức là biết mật khẩu manager là vào được admin.
USER_PASSWORD=replace-with-a-strong-password
# ADMIN_PASSWORD=
# MANAGER_DONGNAI_PASSWORD=
# MANAGER_HCM_PASSWORD=
# MANAGER_PHANTHIET_PASSWORD=
# Hoặc nạp sẵn hash để không để mật khẩu thô trong .env:
#   python -c "from werkzeug.security import generate_password_hash as g; print(g('mat-khau'))"
# ADMIN_PASSWORD_HASH=

# === Database ===
USE_POSTGRES=true
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
# Bắt buộc khi USE_POSTGRES=true
DB_PASSWORD=replace-with-a-strong-database-password
DB_NAME=hr_management_system
DB_PATH=hr_management.db

# === Đường dẫn dữ liệu ===
EXCEL_PATH=Data_structure_v1 (5).xlsx
MASTERDATA_TEMPLATE_PATH=../NVLG_PROJECT/Template_Nhap_Lieu_Master_Data_Du_An.xlsx

# === Tùy chọn ===
# Bật khi chạy sau HTTPS
# SESSION_COOKIE_SECURE=true
# Thời gian sống của phiên đăng nhập (giờ), mặc định 12
# SESSION_HOURS=12
# Chỉ khai báo khi frontend nằm ở origin khác; để trống thì CORS tắt hẳn
# CORS_ORIGINS=https://vi-du.noi-bo
# Chỉ dùng khi tự chạy `python app.py` để debug. KHÔNG bật trên môi trường dùng chung.
# FLASK_DEBUG=false
# FLASK_HOST=127.0.0.1
